# ============================================================

$Results |
    Export-Csv `
        -Path $ResultPath `
        -NoTypeInformation `
        -Encoding UTF8


$Results |
    Where-Object {
        -not $_.overall_pass
    } |
    Export-Csv `
        -Path $FailurePath `
        -NoTypeInformation `
        -Encoding UTF8


$Summary = [ordered]@{

    baseline_version = "phase_a_v0_1_corrected"

    source_baseline = $BaselineDir

    total_tests = $Results.Count

    overall = [ordered]@{
        passed = $OverallPassed
        failed = $Results.Count - $OverallPassed

        accuracy_pct = [Math]::Round(
            100.0 * $OverallPassed / $Results.Count,
            2
        )
    }

    metrics = [ordered]@{
        query_class = [ordered]@{
            scored = 0
            status = "NOT_AVAILABLE"
        }

        domain = $DomainMetric
        intent = $IntentMetric
        entities = $EntityMetric
        research = $ResearchMetric
        clarification = $ClarificationMetric
    }

    entity_diagnostics = [ordered]@{

        expected_empty_entity_tests = @(
            $Contract |
                Where-Object {
                    (
                        [string]$_.expected_entities_raw
                    ).Trim() -eq "-"
                }
        ).Count

        unexpected_validated_band_code_tests = `
            $UnexpectedBandCodes.Count
    }

    output = [ordered]@{
        results = $ResultPath
        failures = $FailurePath
    }
}


$Summary |
    ConvertTo-Json `
        -Depth 10 |
    Set-Content `
        -Path $SummaryPath `
        -Encoding UTF8


