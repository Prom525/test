                    ],
                }
                for key, value in drop_query_results.items()
            },
            "gpt_diagnosis": gpt_diagnosis,
            "lookup_or_side_objects": [
                {
                    "depth": item.get("depth"),
                    "object": f"{item.get('schema')}.{item.get('object')}",
                    "row_count": (item.get("health") or {}).get("row_count"),
                }
                for item in lookup_chain_health
            ],
