            SELECT COUNT(*)::int AS total_items
            FROM sb_inspection_items_v0
        """
    }

    for name, sql in checks.items():
        try:
            results[name] = {
                "status": "ok",
                "result": fetch_one(sql),
            }
        except Exception as exc:
            results[name] = {
                "status": "error",
                "error": str(exc),
            }

    return {
        "status": "ok",
        "debug": results,
        "write_actions_available": False,
    }
