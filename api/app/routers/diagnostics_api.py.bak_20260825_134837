def build_parser_source_diagnostics(parser_actions: list[dict], limit: int = 10) -> dict:
    """
    Geeft per parser_action detail over source_file/sheet waar ONBEKEND vandaan komt.
    Read-only.
    """

    safe_limit = max(1, min(int(limit or 10), 50))

    diagnostics = {
        "summary": {
            "parser_actions_checked": 0,
            "source_groups_total": 0,
        },
        "by_lijn": [],
    }

    for action in (parser_actions or [])[:safe_limit]:
        lijn_code = action.get("lijn_code")
        raw_locatie = action.get("raw_locatie")

        if not lijn_code:
            continue

        # Alleen parser ONBEKEND-diagnose hier.
        if raw_locatie != "ONBEKEND":
            continue

        rows = fetch_limited_rows("""
            SELECT
                p.lijn_code,
                p.source_file,
                p.sheet,
                COUNT(*) AS rows_total,
                MIN(p.row_nr) AS first_row_nr,
                MAX(p.row_nr) AS last_row_nr,
                COUNT(DISTINCT p.locatie_effective) AS distinct_locatie_effective,
                COUNT(DISTINCT p.band_locatie_norm) AS distinct_band_locatie_norm
            FROM sb_excel_positions_v1 p
            LEFT JOIN band_locatie_mapping m
              ON m.lijn_code = p.lijn_code
             AND m.raw_locatie = p.locatie_effective
            WHERE p.lijn_code = :lijn_code
              AND COALESCE(m.band_code, norm_band_code(p.locatie_effective)) = 'ONBEKEND'
              AND p.locatie_effective = 'ONBEKEND'
            GROUP BY
                p.lijn_code,
                p.source_file,
                p.sheet
            ORDER BY COUNT(*) DESC
        """, params={
            "lijn_code": lijn_code,
        }, limit=safe_limit)

        diagnostics["by_lijn"].append({
            "lijn_code": lijn_code,
            "raw_locatie": raw_locatie,
            "rows_total": action.get("rows_total"),
            "source_groups_returned": len(rows),
            "top_sources": rows,
        })

    diagnostics["summary"]["parser_actions_checked"] = len(diagnostics["by_lijn"])
    diagnostics["summary"]["source_groups_total"] = sum(
        item.get("source_groups_returned", 0)
        for item in diagnostics["by_lijn"]
    )

    return diagnostics

def compact_parser_source_diagnostics(parser_source_diagnostics: dict, line_limit: int = 3, source_limit: int = 3) -> dict:
    """
    Compacte variant voor GPT: alleen top lijnen en top sources.
    """

    compact = {
        "summary": parser_source_diagnostics.get("summary", {}),
        "by_lijn": [],
    }

    for item in (parser_source_diagnostics.get("by_lijn") or [])[:line_limit]:
        compact["by_lijn"].append({
            "lijn_code": item.get("lijn_code"),
            "raw_locatie": item.get("raw_locatie"),
            "rows_total": item.get("rows_total"),
            "source_groups_returned": item.get("source_groups_returned"),
            "top_sources": (item.get("top_sources") or [])[:source_limit],
        })

    return compact

def build_parser_row_context(parser_source_diagnostics: dict, line_limit: int = 3, source_limit: int = 3, row_limit: int = 5) -> dict:
    """
    Geeft voorbeeldregels rond parser/location gaps.
    Read-only.
    Compact bedoeld voor GPT: top lijnen, top sources, eerste rows.
    """

    safe_line_limit = max(1, min(int(line_limit or 3), 10))
    safe_source_limit = max(1, min(int(source_limit or 3), 10))
    safe_row_limit = max(1, min(int(row_limit or 5), 25))

    result = {
        "summary": {
            "lines_checked": 0,
            "source_groups_checked": 0,
            "rows_returned": 0,
        },
        "by_lijn": [],
    }

    for line_item in (parser_source_diagnostics.get("by_lijn") or [])[:safe_line_limit]:
        lijn_code = line_item.get("lijn_code")

        line_result = {
            "lijn_code": lijn_code,
            "raw_locatie": line_item.get("raw_locatie"),
            "rows_total": line_item.get("rows_total"),
            "sources": [],
        }

        for source_item in (line_item.get("top_sources") or [])[:safe_source_limit]:
            source_file = source_item.get("source_file")
            sheet = source_item.get("sheet")

            if not lijn_code or not source_file or not sheet:
                continue

            rows = fetch_limited_rows("""
                SELECT
                    p.lijn_code,
                    p.source_file,
                    p.sheet,
                    p.row_nr,
                    p.record_role,
                    p.locatie_effective,
                    p.band_locatie_norm,
                    COALESCE(m.band_code, norm_band_code(p.locatie_effective)) AS normalized_band_code,
                    p.scraper_type_effective_norm,
                    p.scraper_type_norm,
                    p.scraper_family,
                    p.scraper_role
                FROM sb_excel_positions_v1 p
                LEFT JOIN band_locatie_mapping m
                  ON m.lijn_code = p.lijn_code
                 AND m.raw_locatie = p.locatie_effective
                WHERE p.lijn_code = :lijn_code
                  AND p.source_file = :source_file
                  AND p.sheet = :sheet
                  AND COALESCE(m.band_code, norm_band_code(p.locatie_effective)) = 'ONBEKEND'
                  AND p.locatie_effective = 'ONBEKEND'
                ORDER BY p.row_nr
            """, params={
                "lijn_code": lijn_code,
                "source_file": source_file,
                "sheet": sheet,
            }, limit=safe_row_limit)

            line_result["sources"].append({
                "source_file": source_file,
                "sheet": sheet,
                "source_rows_total": source_item.get("rows_total"),
                "first_row_nr": source_item.get("first_row_nr"),
                "last_row_nr": source_item.get("last_row_nr"),
                "rows_returned": len(rows),
                "rows": rows,
            })

        result["by_lijn"].append(line_result)

    result["summary"]["lines_checked"] = len(result["by_lijn"])
    result["summary"]["source_groups_checked"] = sum(
        len(item.get("sources") or [])
        for item in result["by_lijn"]
    )
    result["summary"]["rows_returned"] = sum(
        source.get("rows_returned", 0)
        for item in result["by_lijn"]
        for source in (item.get("sources") or [])
    )

    return result

def classify_parser_root_cause_for_line(line_item: dict) -> dict:
    """
    Classificeert parser root-cause op basis van parser_row_context.
    Read-only.
    """

    rows = []

    for source in (line_item.get("sources") or []):
        for row in (source.get("rows") or []):
            rows.append(row)

    record_roles = [
        row.get("record_role")
        for row in rows
        if row.get("record_role")
    ]

    scraper_types = [
        row.get("scraper_type_effective_norm") or row.get("scraper_type_norm")
        for row in rows
        if row.get("scraper_type_effective_norm") or row.get("scraper_type_norm")
    ]

    has_position_like = any(
        role in ("POSITION", "SUB_POSITION")
        for role in record_roles
    )

    has_header_or_config = any(
        role in ("HEADER", "SUB_CONFIG", "CONFIG", "BAND_HEADER")
        for role in record_roles
    )

    has_only_comment = bool(record_roles) and all(
        role == "COMMENT_ONLY"
        for role in record_roles
    )

    has_real_scraper_type = any(
        value
        and not str(value).startswith("20")
        and value not in ("MERK + TYPE",)
        for value in scraper_types
    )

    duplicate_row_nrs = False
    row_keys = []

    for source in (line_item.get("sources") or []):
        seen = set()
        for row in (source.get("rows") or []):
            key = row.get("row_nr")
            if key in seen:
                duplicate_row_nrs = True
            seen.add(key)
            row_keys.append(key)

    if has_position_like and has_header_or_config:
        root_cause = "missing_parent_band_context"
        severity = "high"
        confidence = "high"
        reason = (
            "Er zijn positieachtige regels samen met header/config-regels, maar locatie_effective blijft ONBEKEND. "
            "Dit wijst op ontbrekende overname van bovenliggende band-/locatiecontext."
        )
        recommended_action = (
            "Controleer in de Excel-parser waar de band-/locatieheader boven deze blokken wordt gelezen en geërfd."
        )

    elif has_only_comment and duplicate_row_nrs:
        root_cause = "duplicate_comment_rows"
        severity = "low"
        confidence = "medium"
        reason = (
            "De sample bevat vooral COMMENT_ONLY-regels met herhaalde row_nr. "
            "Dit lijkt eerder commentaar/duplicatie dan een echte positie."
        )
        recommended_action = (
            "Controleer of COMMENT_ONLY-regels in deze bron/sheet uit assetmapping-diagnose gefilterd mogen worden."
        )

    elif has_only_comment:
        root_cause = "expected_non_position_noise"
        severity = "low"
        confidence = "medium"
        reason = (
            "De sample bevat alleen COMMENT_ONLY-regels. Dit lijkt waarschijnlijk niet-positionele ruis."
        )
        recommended_action = (
            "Laat laag in prioriteit, tenzij deze regels later toch als inspecteerbare positie bedoeld blijken."
        )

    elif has_header_or_config and not has_position_like:
        root_cause = "header_config_without_position_context"
        severity = "medium"
        confidence = "medium"
        reason = (
            "Er zijn header/config-regels zonder duidelijke positieachtige regels in de sample."
        )
        recommended_action = (
            "Controleer of de parser deze header/config-regels buiten assetpositie-diagnose moet houden."
        )

    else:
        root_cause = "parser_context_unclear"
        severity = "medium"
        confidence = "low"
        reason = (
            "De row-context is onvoldoende eenduidig om de parseroorzaak automatisch te bepalen."
        )
        recommended_action = (
            "Bekijk bronbestand/sheet handmatig en breid row_context eventueel uit met extra ruwe kolommen."
        )

    return {
        "lijn_code": line_item.get("lijn_code"),
        "raw_locatie": line_item.get("raw_locatie"),
        "rows_total": line_item.get("rows_total"),
        "root_cause": root_cause,
        "severity": severity,
        "confidence": confidence,
        "reason": reason,
        "recommended_action": recommended_action,
        "signals": {
            "record_roles": sorted(list(set(record_roles))),
            "has_position_like": has_position_like,
            "has_header_or_config": has_header_or_config,
            "has_only_comment": has_only_comment,
            "has_real_scraper_type": has_real_scraper_type,
            "duplicate_row_nrs": duplicate_row_nrs,
            "sample_rows": len(rows),
        },
    }

def build_parser_root_cause(parser_row_context: dict) -> dict:
    """
    Bouwt root-cause diagnose per lijn op basis van parser_row_context.
    Read-only.
    """

    items = []

    for line_item in (parser_row_context.get("by_lijn") or []):
        items.append(
            classify_parser_root_cause_for_line(line_item)
        )

    counts = {}

    for item in items:
        root_cause = item.get("root_cause") or "unknown"
        counts[root_cause] = counts.get(root_cause, 0) + 1

    high_priority = [
        item for item in items
        if item.get("severity") == "high"
    ]

    return {
        "summary": {
            "lines_classified": len(items),
            "root_cause_counts": counts,
            "high_priority_lines": [
                item.get("lijn_code")
                for item in high_priority
            ],
        },
        "by_lijn": items,
    }

def fetch_recursive_view_dependencies(schema_name: str, view_name: str, max_depth: int = 10) -> list[dict]:
    """
    Haalt recursief view/table dependencies op voor een view.
    Alleen read-only catalog queries.
    """

    return fetch_all("""
        WITH RECURSIVE deps AS (
            SELECT DISTINCT
                1 AS depth,
                source_ns.nspname AS source_schema,
                source_cls.relname AS source_object,
                source_cls.relkind AS source_kind,
                target_ns.nspname AS depends_on_schema,
                target_cls.relname AS depends_on_object,
                target_cls.relkind AS depends_on_kind,
                ARRAY[
                    source_ns.nspname || '.' || source_cls.relname,
                    target_ns.nspname || '.' || target_cls.relname
                ] AS path
            FROM pg_depend d
            JOIN pg_rewrite r
              ON r.oid = d.objid
            JOIN pg_class source_cls
              ON source_cls.oid = r.ev_class
            JOIN pg_namespace source_ns
              ON source_ns.oid = source_cls.relnamespace
            JOIN pg_class target_cls
              ON target_cls.oid = d.refobjid
            JOIN pg_namespace target_ns
              ON target_ns.oid = target_cls.relnamespace
            WHERE source_ns.nspname = :schema_name
              AND source_cls.relname = :view_name
              AND target_cls.relname <> source_cls.relname
              AND target_ns.nspname NOT IN ('pg_catalog', 'information_schema')

            UNION ALL

            SELECT DISTINCT
                deps.depth + 1 AS depth,
                source_ns.nspname AS source_schema,
                source_cls.relname AS source_object,
                source_cls.relkind AS source_kind,
                target_ns.nspname AS depends_on_schema,
                target_cls.relname AS depends_on_object,
                target_cls.relkind AS depends_on_kind,
                deps.path || (target_ns.nspname || '.' || target_cls.relname) AS path
            FROM deps
            JOIN pg_class next_source_cls
              ON next_source_cls.relname = deps.depends_on_object
            JOIN pg_namespace next_source_ns
              ON next_source_ns.oid = next_source_cls.relnamespace
             AND next_source_ns.nspname = deps.depends_on_schema
            JOIN pg_rewrite r
              ON r.ev_class = next_source_cls.oid
            JOIN pg_depend d
              ON d.objid = r.oid
            JOIN pg_class source_cls
              ON source_cls.oid = r.ev_class
            JOIN pg_namespace source_ns
              ON source_ns.oid = source_cls.relnamespace
            JOIN pg_class target_cls
              ON target_cls.oid = d.refobjid
            JOIN pg_namespace target_ns
              ON target_ns.oid = target_cls.relnamespace
            WHERE deps.depth < :max_depth
              AND target_cls.relname <> source_cls.relname
              AND target_ns.nspname NOT IN ('pg_catalog', 'information_schema')
              AND NOT (target_ns.nspname || '.' || target_cls.relname = ANY(deps.path))
              AND source_cls.relkind IN ('v', 'm')
        )
        SELECT DISTINCT
            depth,
            source_schema,
            source_object,
            source_kind,
            depends_on_schema,
            depends_on_object,
            depends_on_kind,
            array_to_string(path, ' -> ') AS dependency_path
        FROM deps
        ORDER BY depth, source_schema, source_object, depends_on_schema, depends_on_object
    """, {
        "schema_name": schema_name,
        "view_name": view_name,
        "max_depth": max_depth,
    }) or []

def build_gpt_diagnosis(
    first_major_drop: dict | None,
    largest_drop: dict | None,
    drop_analysis: dict,
    drop_query_results: dict,
) -> dict:
    """
    Bouwt compacte GPT-vriendelijke diagnose.
    Geen volledige chain/evidence, alleen conclusie + tellingen.
    """

    diagnosis = {
        "headline": None,
        "first_major_drop": None,
        "largest_drop": None,
        "top_causes": [],
        "interpretation": [],
        "recommended_actions": [],
    }

    if first_major_drop:
        diagnosis["first_major_drop"] = {
            "from": first_major_drop.get("from"),
            "to": first_major_drop.get("to"),
            "from_row_count": first_major_drop.get("from_row_count"),
            "to_row_count": first_major_drop.get("to_row_count"),
            "loss": first_major_drop.get("loss"),
            "loss_ratio": first_major_drop.get("loss_ratio"),
            "primary_type": (drop_analysis.get("first_major_drop") or {}).get("primary_type"),
        }

    if largest_drop:
        diagnosis["largest_drop"] = {
            "from": largest_drop.get("from"),
            "to": largest_drop.get("to"),
            "from_row_count": largest_drop.get("from_row_count"),
            "to_row_count": largest_drop.get("to_row_count"),
            "loss": largest_drop.get("loss"),
            "loss_ratio": largest_drop.get("loss_ratio"),
            "primary_type": (drop_analysis.get("largest_drop") or {}).get("primary_type"),
        }

    # Top oorzaken eerste grote drop: ignore terms
    first_results = (
        (drop_query_results.get("first_major_drop") or {})
        .get("query_results") or []
    )

    if first_results:
        rows = (
            (first_results[0].get("result") or {})
            .get("rows") or []
        )

        for row in rows[:10]:
            diagnosis["top_causes"].append({
                "drop": "first_major_drop",
                "type": "ignore_term",
                "label": row.get("term_norm"),
                "rows": row.get("rows_filtered"),
            })

    # Top oorzaken grootste drop: recordtypes
    largest_results = (
        (drop_query_results.get("largest_drop") or {})
        .get("query_results") or []
    )

    if largest_results:
        rows = (
            (largest_results[0].get("result") or {})
            .get("rows") or []
        )

        for row in rows:
            diagnosis["top_causes"].append({
                "drop": "largest_drop",
                "type": "record_type",
                "label": row.get("record_type"),
                "rows": row.get("rows_total"),
                "rows_without_band_locatie_norm": row.get("rows_without_band_locatie_norm"),
                "rows_with_band_locatie_norm": row.get("rows_with_band_locatie_norm"),
            })

    # Interpretatie
    first_type = (drop_analysis.get("first_major_drop") or {}).get("primary_type")
    largest_type = (drop_analysis.get("largest_drop") or {}).get("primary_type")

    if first_type == "ignore_list_filter":
        diagnosis["interpretation"].append(
            "De eerste grote daling wordt veroorzaakt door de ignore-list op genormaliseerde band/locatie-termen."
        )

    if largest_type == "record_type_and_band_location_filter":
        diagnosis["interpretation"].append(
            "De grootste daling is logisch: de view houdt alleen POSITION-records over; CONFIG, OBSERVATION, BAND_HEADER en HEADER vallen af."
        )

    # Headline
    diagnosis["headline"] = (
        "De lifecycle-keten is technisch gezond; de grootste rijdalingen worden verklaard door bewuste filters "
        "op ignore-termen en record_type=POSITION."
    )

    # Acties
    diagnosis["recommended_actions"] = [
        "Controleer vooral ONBEKEND in de ignore-list, omdat dit de grootste upstream filtering veroorzaakt.",
        "Controleer HOO6/ONBEKEND en PEFA/ONBEKEND als eerste bron van mogelijk ontbrekende bandmapping.",
        "Behandel de daling van full_dataset naar positions_clean als verwacht gedrag zolang alleen POSITION-regels bedoeld zijn.",
        "Voeg later asset_model_health toe om ONBEKEND en scraper-classificaties inhoudelijk te beoordelen.",
    ]

    return diagnosis

def get_response_profile(payload: DiagnosticsAnalyzeRequest) -> str:
    """
    Bepaalt hoeveel detail diagnostics/analyze teruggeeft.
    Mogelijke waarden:
    - full: volledige debug-response
    - gpt_compact: compacte GPT-response
    """

    profile = payload.filters.get("response_profile") or "full"
    profile = str(profile).strip().lower()

    if profile not in ("full", "gpt_compact"):
        return "full"

    return profile

