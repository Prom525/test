def fetch_limited_rows(sql: str, params: dict | None = None, limit: int = 25) -> list[dict]:
    """
    Kleine read-only helper voor vaste diagnostics queries.
    """
    safe_limit = max(1, min(int(limit or 25), 100))

    wrapped_sql = f"""
        SELECT *
        FROM (
            {sql.strip().rstrip(";")}
        ) AS diagnostics_asset_query
        LIMIT :limit
    """

    final_params = dict(params or {})
    final_params["limit"] = safe_limit

    return fetch_all(wrapped_sql, final_params) or []

def quote_ident(name: str) -> str:
    """
    Veilige identifier-quoting voor objecten/kolommen die eerst
    tegen information_schema zijn gevalideerd.
    """
    value = str(name or "").strip()

    if not re.match(r"^[A-Za-z_][A-Za-z0-9_]*$", value):
        raise HTTPException(
            status_code=400,
            detail=f"Unsafe SQL identifier: {value}",
        )

    return f'"{value}"'


def get_object_info(schema_name: str, object_name: str) -> dict | None:
    """
    Haalt tabel/view metadata op uit information_schema.
    """
    return fetch_one("""
        SELECT
            table_schema,
            table_name,
            table_type
        FROM information_schema.tables
        WHERE table_schema = :schema_name
          AND table_name = :object_name
    """, {
        "schema_name": schema_name,
        "object_name": object_name,
    })


def normalize_requested_objects(payload: DiagnosticsAnalyzeRequest) -> list[dict]:
    """
    Zet payload.objects om naar gevalideerde objecten met kolommen.
    """
    default_schema = get_filter_str(payload, "schema", "public")
    result = []

    for raw_name in payload.objects or []:
        schema_name, object_name = split_schema_object(
            str(raw_name),
            default_schema=default_schema,
        )

        info = get_object_info(schema_name, object_name)
        columns = get_object_columns(schema_name, object_name) if info else []
        column_names = [c.get("column_name") for c in columns]

        result.append({
            "requested_name": raw_name,
            "schema": schema_name,
            "object": object_name,
            "full_name": f"{schema_name}.{object_name}",
            "exists": bool(info),
            "object_info": info,
            "columns": columns,
            "column_names": column_names,
        })

    return result


def tokenize_discovery_question(question: str | None) -> list[str]:
    """
    V4 discovery-tokenizer.

    Houdt routing voorspelbaar en voegt expliciete termen toe voor:
    - parser / Excel / staging / inspection items;
    - checks / positions / fact views;
    - maintenance / lifecycle.
    """
    # PROMATI_OBJECT_DISCOVERY_V4
    text_value = str(question or "").lower()

    tokens = re.findall(r"[a-zA-Z0-9_]+", text_value)

    stopwords = {
        "waar", "valt", "weg", "waarom", "heeft", "maar", "met", "voor",
        "van", "naar", "de", "het", "een", "in", "op", "en", "of",
        "welke", "hoe", "zit", "er", "drie", "twee",
    }

    cleaned = [
        token
        for token in tokens
        if len(token) >= 3 and token not in stopwords
    ]

    synonym_map = {
        # Maintenance
        "onderhoud": [
            "maintenance",
            "onderhoud",
            "toplist",
            "planning",
        ],
        "onderhoudsplanning": [
            "maintenance",
            "onderhoud",
            "toplist",
            "planning",
        ],
        "onderhoudstoplijst": [
            "maintenance",
            "toplist",
            "historical",
        ],
        "toplijst": ["toplist"],
        "bandpositie": ["band_position", "position", "wear"],
        "positie": ["position"],
        "posities": ["position"],
        "slijtage": ["wear", "slijtage"],
        "mes": ["mes", "meshoogte"],
        "forecast": ["forecast", "historical", "planning"],
        "keten": ["lifecycle", "maintenance", "planning"],

        # Parser / inspection
        "parser": [
            "excel",
            "staging",
            "inspection",
            "item",
            "check",
            "position",
        ],
        "inspectie": [
            "inspection",
            "excel",
            "item",
            "check",
            "position",
        ],
        "inspecties": [
            "inspection",
            "excel",
            "item",
            "check",
            "position",
        ],
        "inspectieregel": [
            "inspection",
            "excel",
            "item",
            "check",
            "position",
        ],
        "inspectieregels": [
            "inspection",
            "excel",
            "item",
            "check",
            "position",
        ],
        "excel": [
            "excel",
            "staging",
            "inspection",
            "item",
            "position",
        ],
        "staging": [
            "staging",
            "inspection",
            "excel",
        ],
        "checks": [
            "check",
            "checks",
            "inspection",
            "excel",
        ],
    }

    expanded = list(cleaned)

    for token in cleaned:
        expanded.extend(
            synonym_map.get(token, [])
        )

    if any(
        token in cleaned
        for token in (
            "onderhoud",
            "onderhoudsplanning",
            "onderhoudstoplijst",
            "toplijst",
        )
    ):
        expanded.extend([
            "band_position",
            "wear",
            "maintenance",
            "historical",
            "planning",
            "toplist",
        ])

    if any(
        token in cleaned
        for token in (
            "parser",
            "inspectieregel",
            "inspectieregels",
            "excel",
            "staging",
            "checks",
        )
    ):
        expanded.extend([
            "inspection",
            "excel",
            "staging",
            "item",
            "check",
            "position",
        ])

    return sorted(list(set(expanded)))

def discover_database_objects_for_sql_deep_dive(
    payload: DiagnosticsAnalyzeRequest,
    limit: int = 10,
) -> dict:
    """
    V4: zoekt kandidaatobjecten voor sql_deep_dive.
    Read-only: alleen catalog search.
    """

    schema_name = get_filter_str(payload, "schema", "public")
    question = payload.question or ""
    tokens = tokenize_discovery_question(question)

    # Extra hints uit filters
    band_code = payload.filters.get("band_code") or payload.filters.get("band_norm")
    lijn_code = payload.filters.get("lijn_code")

    if band_code:
        tokens.append(str(band_code).lower())

    if lijn_code:
        tokens.append(str(lijn_code).lower())

    # Alleen objectnaam/definition zoeken, niet data scannen.
    rows = fetch_all("""
        SELECT
            t.table_schema,
            t.table_name,
            t.table_type,
            COALESCE(v.definition, '') AS view_definition
        FROM information_schema.tables t
        LEFT JOIN pg_views v
          ON v.schemaname = t.table_schema
         AND v.viewname = t.table_name
        WHERE t.table_schema = :schema_name
          AND t.table_type IN ('VIEW', 'BASE TABLE', 'MATERIALIZED VIEW')
          AND (
              t.table_name ILIKE '%mes%'
              OR t.table_name ILIKE '%maintenance%'
              OR t.table_name ILIKE '%onderhoud%'
              OR t.table_name ILIKE '%band%'
              OR t.table_name ILIKE '%scraper%'
              OR t.table_name ILIKE '%schraper%'
              OR t.table_name ILIKE '%wear%'
              OR t.table_name ILIKE '%lifecycle%'
              OR t.table_name ILIKE '%position%'
              OR t.table_name ILIKE '%toplist%'
              OR t.table_name ILIKE '%inspection%'
              OR t.table_name ILIKE '%inspectie%'
              OR t.table_name ILIKE '%excel%'
              OR t.table_name ILIKE '%check%'
              OR t.table_name ILIKE '%item%'
              OR t.table_name ILIKE '%staging%'
          )
        ORDER BY t.table_schema, t.table_name
    """, {
        "schema_name": schema_name,
    }) or []

    scored = []

    for row in rows:
        object_name = row.get("table_name") or ""
        definition = row.get("view_definition") or ""

        haystack = f"{object_name} {definition[:5000]}".lower()

        score = 0
        matched_terms = []

        for token in tokens:
            if not token:
                continue

            token_l = str(token).lower()

            if token_l in haystack:
                score += 1
                matched_terms.append(token_l)

            if token_l in object_name.lower():
                score += 3

        # V4: domeinprioriteit alleen toepassen als de vraag
        # daadwerkelijk bij dat domein hoort.
        name_l = object_name.lower()
        question_l = question.lower()

        priority_bonus = 0

        parser_inspection_question = any(
            term in question_l
            for term in (
                "parser",
                "inspectieregel",
                "inspectieregels",
                "excel",
                "staging",
                "inspection item",
                "inspection_item",
                "sb_excel",
                "sb_inspection",
                "vw_sb_excel",
                "checks",
            )
        )

        maintenance_question = any(
            term in question_l
            for term in (
                "onderhoud",
                "maintenance",
                "toplijst",
                "toplist",
                "slijtage",
                "wear",
                "forecast",
                "lifecycle",
                "meshoogte",
                "bandpositie",
            )
        )

        if parser_inspection_question:
            parser_priority = {
                "sb_inspection_items_v0": 120,
                "sb_excel_positions_v1": 110,
                "vw_excel_positions_clean_v1": 100,
                "vw_sb_excel_item_base": 90,
                "vw_sb_excel_checks": 80,
                "vw_fact_inspection_excel_v2": 70,
            }

            priority_bonus += parser_priority.get(
                name_l,
                0,
            )

        if maintenance_question:
            if "band_position_wear_summary" in name_l:
                priority_bonus += 100

            if "maintenance_positions_historical_weighted_planning" in name_l:
                priority_bonus += 90

            if "maintenance_toplist_historical" in name_l:
                priority_bonus += 80

            if "maintenance" in name_l:
                priority_bonus += 20

            if "toplist" in name_l:
                priority_bonus += 20

            if "lifecycle" in name_l:
                priority_bonus += 10

        if "candidate" in name_l:
            priority_bonus -= 25

        final_score = score + priority_bonus

        if final_score <= 0:
            continue

        scored.append({
            "schema": row.get("table_schema"),
            "object": object_name,
            "full_name": f"{row.get('table_schema')}.{object_name}",
            "object_type": row.get("table_type"),
            "score": final_score,
            "matched_terms": sorted(list(set(matched_terms)))[:20],
        })

    scored = sorted(
        scored,
        key=lambda item: item.get("score", 0),
        reverse=True,
    )

    return {
        "schema": schema_name,
        "question": question,
        "tokens": sorted(list(set(tokens)))[:50],
        "candidates": scored[:max(1, min(int(limit or 10), 25))],
    }



def pick_discovered_objects_for_chain(
    discovery: dict,
    payload: DiagnosticsAnalyzeRequest,
) -> list[str]:
    """
    V4: kiest een domeinspecifieke, voorspelbare objectketen.

    Parser/inspection krijgt voorrang op maintenance wanneer
    de vraag expliciet over parser, Excel, staging of inspectieregels gaat.

    Alleen objecten die daadwerkelijk door catalog discovery zijn
    gevonden worden teruggegeven.
    """

    candidates = discovery.get("candidates") or []

    candidate_names = {
        item.get("object"): item
        for item in candidates
        if item.get("object")
    }

    question_l = str(
        payload.question or ""
    ).lower()

    parser_inspection_question = any(
        term in question_l
        for term in (
            "parser",
            "inspectieregel",
            "inspectieregels",
            "excel",
            "staging",
            "inspection item",
            "inspection_item",
            "sb_excel",
            "sb_inspection",
            "vw_sb_excel",
            "checks",
        )
    )

    maintenance_question = any(
        term in question_l
        for term in (
            "onderhoud",
            "maintenance",
            "onderhoudsplanning",
            "onderhoudstoplijst",
            "toplijst",
            "toplist",
            "slijtage",
            "wear",
            "forecast",
            "lifecycle",
            "meshoogte",
            "bandpositie",
        )
    )

    if parser_inspection_question:
        preferred_chain = [
            "sb_inspection_items_v0",
            "sb_excel_positions_v1",
            "vw_excel_positions_clean_v1",
            "vw_sb_excel_item_base",
            "vw_sb_excel_checks",
            "vw_fact_inspection_excel_v2",
        ]

        selected = [
            name
            for name in preferred_chain
            if name in candidate_names
        ]

        if selected:
            return selected

    if maintenance_question:
        preferred_chain = [
            "vw_mes_band_position_wear_summary",
            "vw_mes_maintenance_positions_historical_weighted_planning",
            "vw_mes_maintenance_toplist_historical",
        ]

        selected = [
            name
            for name in preferred_chain
            if name in candidate_names
        ]

        if (
            selected
            and len(selected) == len(preferred_chain)
        ):
            return selected

    selected = []

    for item in candidates:
        object_name = item.get("object")

        if (
            object_name
            and object_name not in selected
        ):
            selected.append(object_name)

        if len(selected) >= 5:
            break

    return selected

def pick_band_column(column_names: list[str]) -> str | None:
    """
    Kies bandkolom. In inspectieviews wisselt dit tussen band_norm en band_code.
    """
    if "band_norm" in column_names:
        return "band_norm"
    if "band_code" in column_names:
        return "band_code"
    return None


def build_object_where_clause(
    column_names: list[str],
    filters: dict[str, Any],
) -> tuple[str, dict]:
    """
    Bouwt veilige WHERE-clause op basis van aanwezige kolommen.
    Alleen vaste bekende filters, waarden via parameters.
    """
    clauses = []
    params = {}

    lijn_code = filters.get("lijn_code")
    if lijn_code and "lijn_code" in column_names:
        clauses.append('"lijn_code" = :lijn_code')
        params["lijn_code"] = str(lijn_code).strip().upper()

    band_code = filters.get("band_code") or filters.get("band_norm")
    band_col = pick_band_column(column_names)
    if band_code and band_col:
        clauses.append(f'{quote_ident(band_col)} = :band_code')
        params["band_code"] = str(band_code).strip().upper()

    scraper_type = filters.get("scraper_type") or filters.get("scraper_type_norm")
    if scraper_type and "scraper_type_norm" in column_names:
        clauses.append('"scraper_type_norm" ILIKE :scraper_type')
        params["scraper_type"] = f"%{str(scraper_type).strip()}%"

    scraper_family = filters.get("scraper_family")
    if scraper_family and "scraper_family" in column_names:
        clauses.append('"scraper_family" = :scraper_family')
        params["scraper_family"] = str(scraper_family).strip().upper()

    scraper_role = filters.get("scraper_role")
    if scraper_role and "scraper_role" in column_names:
        clauses.append('"scraper_role" = :scraper_role')
        params["scraper_role"] = str(scraper_role).strip().upper()

    physical_position = (
        filters.get("physical_position_label_final")
        or filters.get("positie")
        or filters.get("position")
    )
    if physical_position and "physical_position_label_final" in column_names:
        clauses.append('"physical_position_label_final" = :physical_position')
        params["physical_position"] = str(physical_position).strip().upper()

    if not clauses:
        return "", params

    return "WHERE " + " AND ".join(clauses), params


