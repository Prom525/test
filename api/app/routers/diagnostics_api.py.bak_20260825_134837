@router.get("/inspections/orphans/date-repair-candidates-v2")
def diagnostics_inspection_orphan_date_repairs_v2():
    rows = fetch_all("""
        WITH orphan_keys AS (
            SELECT DISTINCT
                it.inspection_key,
                it.source_file,
                split_part(it.inspection_key, '|', 2) AS raw_label,
                split_part(it.inspection_key, '|', 3) AS parsed_date
            FROM sb_inspection_items_v0 it
            WHERE NOT EXISTS (
                SELECT 1
                FROM sb_inspections_v0 i
                WHERE i.inspection_key = it.inspection_key
            )
        ),

        parsed AS (
            SELECT
                inspection_key,
                source_file,
                raw_label,
                parsed_date,

                substring(raw_label FROM '^([0-9]{1,2})[-/]') AS raw_day,
                substring(raw_label FROM '^[0-9]{1,2}[-/]([0-9]{1,2})[-/]') AS raw_month,
                substring(raw_label FROM '[0-9]{1,2}[-/][0-9]{1,2}[-/]([0-9]{2})$') AS raw_year_2
            FROM orphan_keys
            WHERE parsed_date LIKE '2099-%'
               OR parsed_date LIKE '3999-%'
               OR parsed_date LIKE '3998-%'
        )

        SELECT
            inspection_key,
            source_file,
            raw_label,
            parsed_date,

            CASE
                WHEN raw_year_2 IS NOT NULL THEN
                    CASE
                        WHEN raw_year_2::int BETWEEN 0 AND 30 THEN
                            make_date(
                                2000 + raw_year_2::int,
                                raw_month::int,
                                raw_day::int
                            )::text
                        ELSE
                            make_date(
                                1900 + raw_year_2::int,
                                raw_month::int,
                                raw_day::int
                            )::text
                    END

                WHEN parsed_date LIKE '2099-%'
                    THEN REPLACE(parsed_date, '2099-', '1999-')

                WHEN parsed_date LIKE '3999-%'
                    THEN REPLACE(parsed_date, '3999-', '1999-')

                WHEN parsed_date LIKE '3998-%'
                    THEN REPLACE(parsed_date, '3998-', '1998-')

                ELSE NULL
            END AS suggested_date_fix,

            CASE
                WHEN raw_year_2 IS NOT NULL THEN 'RAW_LABEL_PARSE'
                ELSE 'PARSED_DATE_YEAR_REPLACE'
            END AS suggestion_method

        FROM parsed
        ORDER BY inspection_key
    """)

    return {
        "status": "ok",
        "domain": "inspections",
        "check": "orphan_date_repair_candidates_v2",
        "repair_candidates": len(rows),
        "candidates": rows,
        "write_actions_available": False,
    }


