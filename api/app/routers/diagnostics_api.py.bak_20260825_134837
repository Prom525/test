            "layer": "inspection_headers",
            "schema": "public",
            "object": "sb_inspections_v0",
            "meaning": "Inspectieheaders per bronbestand/sheet/datum.",
        },
        {
            "step": 3,
            "layer": "inspection_items",
            "schema": "public",
            "object": "sb_inspection_items_v0",
            "meaning": "Detailregels gekoppeld aan inspection_key.",
        },
        {
            "step": 4,
            "layer": "excel_positions",
            "schema": "public",
            "object": "sb_excel_positions_v1",
