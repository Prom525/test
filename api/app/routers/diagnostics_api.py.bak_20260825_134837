def fetch_object_diagnostic_rows(
    schema_name: str,
    object_name: str,
    column_names: list[str],
    filters: dict[str, Any],
    limit: int,
) -> dict:
    """
    Haalt gefilterde sample-rows op voor één gevalideerd object.
    """
    selected_columns = select_columns_for_diagnostics(column_names)

    if not selected_columns:
        return {
            "status": "no_columns",
            "rows_returned": 0,
            "rows": [],
            "selected_columns": [],
        }

    object_sql = f"{quote_ident(schema_name)}.{quote_ident(object_name)}"
    select_sql = ", ".join(quote_ident(c) for c in selected_columns)
    where_sql, params = build_object_where_clause(column_names, filters)

    sql = f"""
        SELECT {select_sql}
        FROM {object_sql}
        {where_sql}
        LIMIT :limit
    """

    params["limit"] = max(1, min(int(limit or 50), 500))

    try:
        rows = fetch_all(sql, params) or []
        return {
            "status": "ok",
            "rows_returned": len(rows),
            "selected_columns": selected_columns,
            "rows": rows,
        }
    except HTTPException as exc:
        return {
            "status": "error",
            "reason": str(exc.detail),
            "rows_returned": 0,
            "selected_columns": selected_columns,
            "rows": [],
        }


def fetch_object_status_counts(
    schema_name: str,
    object_name: str,
    column_names: list[str],
    filters: dict[str, Any],
    limit: int,
) -> dict:
    """
    Maakt statusverdelingen op basis van aanwezige statuskolommen.
    """
    status_columns = [
        c for c in [
            "forecast_status",
            "planning_prioriteit_historisch",
            "onderhoudsadvies",
            "planning_status_6mm_historisch",
            "planning_status_3mm_historisch",
            "inspectie_actualiteit",
            "data_quality_flag",
            "slijtage_curve_status",
        ]
        if c in column_names
    ]

    if not status_columns:
        return {
            "status": "no_status_columns",
            "status_columns": [],
            "rows_returned": 0,
            "rows": [],
        }

    object_sql = f"{quote_ident(schema_name)}.{quote_ident(object_name)}"
    select_sql = ", ".join(quote_ident(c) for c in status_columns)
    group_sql = ", ".join(quote_ident(c) for c in status_columns)
    where_sql, params = build_object_where_clause(column_names, filters)

    sql = f"""
        SELECT
            {select_sql},
            COUNT(*)::int AS rows_total
        FROM {object_sql}
        {where_sql}
        GROUP BY {group_sql}
        ORDER BY COUNT(*) DESC
        LIMIT :limit
    """

    params["limit"] = max(1, min(int(limit or 50), 500))

    try:
        rows = fetch_all(sql, params) or []
        return {
            "status": "ok",
            "status_columns": status_columns,
            "rows_returned": len(rows),
            "rows": rows,
        }
    except HTTPException as exc:
        return {
            "status": "error",
            "reason": str(exc.detail),
            "status_columns": status_columns,
            "rows_returned": 0,
            "rows": [],
        }


def normalize_compare_value(value) -> str | None:
    """
    Normaliseert vergelijkingswaarden voor cross-view matching.
    """
    if value is None:
        return None

    text_value = str(value).strip().upper()

    if text_value == "":
        return None

    return text_value


def row_compare_key(row: dict) -> tuple:
    """
    Bouwt een vergelijkingssleutel voor scraperposities.

    Belangrijk:
    - Gebruik geen position_display in de sleutel.
      Niet elke view heeft deze kolom.
    - position_display is afgeleid uit scraper_role + physical_position_label_final
      en is dus geen stabiele cross-view key.
    """
    band_value = row.get("band_norm") or row.get("band_code")

    return (
        normalize_compare_value(row.get("lijn_code")),
        normalize_compare_value(band_value),
        normalize_compare_value(row.get("scraper_family")),
        normalize_compare_value(row.get("scraper_type_norm")),
        normalize_compare_value(row.get("scraper_role")),
        normalize_compare_value(row.get("physical_position_label_final")),
    )


def compact_row_for_compare(row: dict) -> dict:
    """
    Houd alleen diagnose-relevante velden over.
    """
    keep = [
        "lijn_code",
        "band_norm",
        "band_code",
        "scraper_family",
        "scraper_type_norm",
        "scraper_role",
        "physical_position_label_final",
        "position_display",
        "laatste_meting_datum",
        "inspected_on",
        "actuele_meshoogte_mm",
        "meshoogte_mm",
        "analyse_meetpunten",
        "bruikbare_intervallen",
        "forecast_status",
        "planning_prioriteit_historisch",
        "onderhoudsadvies",
        "planning_status_3mm_historisch",
        "dagen_tot_3mm_historisch",
        "geschatte_vervangdatum_bij_3mm_historisch",
        "inspectie_actualiteit",
        "data_quality_flag",
        "slijtage_curve_status",
    ]

    return {
        key: row.get(key)
        for key in keep
        if key in row
    }


def compare_diagnostic_row_sets(source_rows: list[dict], target_rows: list[dict]) -> dict:
    """
    Vergelijkt twee objectoutputs op scraperpositie-sleutel.
    """
    source_map = {}
    target_map = {}

    for row in source_rows or []:
        source_map[row_compare_key(row)] = row

    for row in target_rows or []:
        target_map[row_compare_key(row)] = row

    source_keys = set(source_map.keys())
    target_keys = set(target_map.keys())

    # Null-safe deterministische sortering.
    # De originele tuple blijft ongewijzigd voor set/dict-semantiek;
    # alleen de sort key vertaalt None naar een veilig vergelijkbare waarde.
    def _compare_sort_key(key: tuple) -> tuple:
        return tuple(
            (value is None, "" if value is None else str(value))
            for value in key
        )

    in_both_keys = sorted(
        source_keys & target_keys,
        key=_compare_sort_key,
    )
    only_source_keys = sorted(
        source_keys - target_keys,
        key=_compare_sort_key,
    )
    only_target_keys = sorted(
        target_keys - source_keys,
        key=_compare_sort_key,
    )

    return {
        "source_rows": len(source_rows or []),
        "target_rows": len(target_rows or []),
        "in_both_count": len(in_both_keys),
        "only_in_source_count": len(only_source_keys),
        "only_in_target_count": len(only_target_keys),
        "in_both": [
            compact_row_for_compare(source_map[k])
            for k in in_both_keys[:50]
        ],
        "only_in_source": [
            compact_row_for_compare(source_map[k])
            for k in only_source_keys[:50]
        ],
        "only_in_target": [
            compact_row_for_compare(target_map[k])
            for k in only_target_keys[:50]
        ],
    }


