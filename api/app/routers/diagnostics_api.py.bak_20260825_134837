            "issue": "Inspection items zonder gekoppelde header.",
            "count": linkage.get("orphan_items"),
            "likely_layer": "inspection_items ↔ inspection_headers",
        })

    return DiagnosticsAnalyzeResponse(
        status="ok" if not findings else "warning",
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary=summary,
        findings=findings,
        evidence={
            "pipeline": pipeline,
            "linkage": linkage,
        },
        recommended_actions=[
            "Gebruik mode asset_model_health voor parser_root_cause analyse.",
            "Gebruik view_health met depth=deep voor keten- en row_count-diagnose.",
            "Controleer ontbrekende inspectie-pipeline objecten voordat je downstream views beoordeelt.",
        ],
        limitations=[
            "Deze analyse telt alleen objecten en koppelingen; hij beoordeelt nog niet of de assetclassificatie inhoudelijk klopt.",
            "Deze analyse leest nog geen PostgreSQL view-definities.",
        ],
        write_actions_available=False,
    )

def analyze_inspection_lineage(
    payload: DiagnosticsAnalyzeRequest,
) -> DiagnosticsAnalyzeResponse:
    """
    Gerichte read-only diagnose van inspectieheaders zonder gekoppelde items.

    Doel:
    - concrete probleeminspecties tonen;
    - patroon per bronbestand / sheet / lijn zichtbaar maken;
    - onderscheid maken tussen mogelijke inspection_key mismatch
      en een bronbestand waar helemaal geen items voor bestaan.

    Filters:
    - inspection_key
    - lijn_code
    - source_file_contains
    - sheet
    - diagnosis_code
    """

    limit = max(1, min(int(payload.limit or 50), 500))

    inspection_key = get_filter_str(payload, "inspection_key")
    lijn_code = get_filter_str(payload, "lijn_code")
    source_file_contains = get_filter_str(payload, "source_file_contains")
    sheet = get_filter_str(payload, "sheet")
    diagnosis_code = get_filter_str(payload, "diagnosis_code")

    # diagnosis_code wordt pas ná de SQL-query berekend.
    # Daarom eerst voldoende kandidaten ophalen.
    query_limit = 500 if diagnosis_code else limit

    conditions = []

    params: dict[str, Any] = {
        "limit": query_limit,
    }

    if inspection_key:
        conditions.append(
            "i.inspection_key::text = :inspection_key"
        )
        params["inspection_key"] = inspection_key

    if lijn_code:
        conditions.append(
            "UPPER(COALESCE(i.lijn_code, '')) = UPPER(:lijn_code)"
        )
        params["lijn_code"] = lijn_code

    if source_file_contains:
        conditions.append(
            "COALESCE(i.source_file, '') ILIKE :source_file_contains"
        )
        params["source_file_contains"] = (
            f"%{source_file_contains}%"
        )

    if sheet:
        conditions.append(
            "UPPER(COALESCE(i.sheet, '')) = UPPER(:sheet)"
        )
        params["sheet"] = sheet

    filter_sql = ""

    if conditions:
        filter_sql = " AND " + " AND ".join(conditions)

    # -----------------------------------------------------
    # 1. Totaal aantal probleemheaders vóór diagnosefilter
    # -----------------------------------------------------

    total_row = fetch_one(
        f"""
        SELECT
            COUNT(*)::int AS inspections_without_items
        FROM sb_inspections_v0 i
        WHERE NOT EXISTS (
            SELECT 1
            FROM sb_inspection_items_v0 it
            WHERE it.inspection_key = i.inspection_key
        )
        {filter_sql}
        """,
        params,
    ) or {}

    total_missing_before_diagnosis = int(
        total_row.get("inspections_without_items") or 0
    )

    # -----------------------------------------------------
    # 2. Concrete probleeminspecties + kandidaatverklaring
    # -----------------------------------------------------

    rows = fetch_all(
        f"""
        WITH stg_exact AS MATERIALIZED (
            SELECT
                COALESCE(source_file, '') AS source_file_key,
                COALESCE(sheet, '') AS sheet_key,

                regexp_replace(
                    lower(COALESCE(sheet, '')),
                    '[^a-z0-9]+',
                    '',
                    'g'
                ) AS sheet_norm,

                COUNT(*)::int AS row_count,

                COUNT(DISTINCT row_nr)::int
                    AS distinct_row_nrs,

                COUNT(DISTINCT loaded_at)::int
                    AS load_events,

                MIN(loaded_at)
                    AS first_loaded_at,

                MAX(loaded_at)
                    AS last_loaded_at

            FROM sb_stg_inspecties_raw

            GROUP BY
                COALESCE(source_file, ''),
                COALESCE(sheet, ''),
                regexp_replace(
                    lower(COALESCE(sheet, '')),
                    '[^a-z0-9]+',
                    '',
                    'g'
                )
        ),

        stg_source AS (
            SELECT
                source_file_key,
                SUM(row_count)::int AS row_count
            FROM stg_exact
            GROUP BY source_file_key
        ),

        stg_norm AS (
            SELECT
                source_file_key,
                sheet_norm,
                SUM(row_count)::int AS row_count,
                MIN(sheet_key) AS example_sheet
            FROM stg_exact

            GROUP BY
                source_file_key,
                sheet_norm
        )

        SELECT
            i.inspection_key::text AS inspection_key,
            i.lijn_code,
            i.source_file,
            i.sheet,
            i.sheet_kind,
            i.inspected_on,
            i.row_count,
            i.title,

            (
                SELECT COUNT(*)::int
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
            ) AS items_same_source_file,

            (
                SELECT COUNT(*)::int
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND COALESCE(it.sheet, '') =
                      COALESCE(i.sheet, '')
            ) AS items_same_source_sheet,

            (
                SELECT COUNT(*)::int
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND regexp_replace(
                        lower(COALESCE(it.sheet, '')),
                        '[[:space:]]+',
                        '',
                        'g'
                      ) =
                      regexp_replace(
                        lower(COALESCE(i.sheet, '')),
                        '[[:space:]]+',
                        '',
                        'g'
                      )
            ) AS items_same_sheet_whitespace_normalized,

            (
                SELECT MIN(it.inspection_key::text)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND regexp_replace(
                        lower(COALESCE(it.sheet, '')),
                        '[[:space:]]+',
                        '',
                        'g'
                      ) =
                      regexp_replace(
                        lower(COALESCE(i.sheet, '')),
                        '[[:space:]]+',
                        '',
                        'g'
                      )
            ) AS example_key_whitespace_normalized,

            (
                SELECT MIN(it.sheet)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND regexp_replace(
                        lower(COALESCE(it.sheet, '')),
                        '[[:space:]]+',
                        '',
                        'g'
                      ) =
                      regexp_replace(
                        lower(COALESCE(i.sheet, '')),
                        '[[:space:]]+',
                        '',
                        'g'
                      )
            ) AS example_sheet_whitespace_normalized,

            (
                SELECT COUNT(*)::int
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND regexp_replace(
                        lower(COALESCE(it.sheet, '')),
                        '[^a-z0-9]+',
                        '',
                        'g'
                      ) =
                      regexp_replace(
                        lower(COALESCE(i.sheet, '')),
                        '[^a-z0-9]+',
                        '',
                        'g'
                      )
            ) AS items_same_sheet_format_normalized,

            (
                SELECT MIN(it.inspection_key::text)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND regexp_replace(
                        lower(COALESCE(it.sheet, '')),
                        '[^a-z0-9]+',
                        '',
                        'g'
                      ) =
                      regexp_replace(
                        lower(COALESCE(i.sheet, '')),
                        '[^a-z0-9]+',
                        '',
                        'g'
                      )
            ) AS example_key_format_normalized,

            (
                SELECT MIN(it.sheet)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND regexp_replace(
                        lower(COALESCE(it.sheet, '')),
                        '[^a-z0-9]+',
                        '',
                        'g'
                      ) =
                      regexp_replace(
                        lower(COALESCE(i.sheet, '')),
                        '[^a-z0-9]+',
                        '',
                        'g'
                      )
            ) AS example_sheet_format_normalized,

            (
                SELECT COUNT(*)::int
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND i.inspected_on IS NOT NULL
                  AND RIGHT(it.inspection_key::text, 10) =
                      i.inspected_on::text
            ) AS items_same_source_date,

            (
                SELECT MIN(it.inspection_key::text)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND i.inspected_on IS NOT NULL
                  AND RIGHT(it.inspection_key::text, 10) =
                      i.inspected_on::text
            ) AS example_key_same_date,

            (
                SELECT MIN(it.sheet)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND i.inspected_on IS NOT NULL
                  AND RIGHT(it.inspection_key::text, 10) =
                      i.inspected_on::text
            ) AS example_sheet_same_date,

            (
                SELECT MIN(it.inspection_key::text)
                FROM sb_inspection_items_v0 it
                WHERE COALESCE(it.source_file, '') =
                      COALESCE(i.source_file, '')
                  AND COALESCE(it.sheet, '') =
                      COALESCE(i.sheet, '')
            ) AS example_item_inspection_key,

            COALESCE(
                stg_src.row_count,
                0
            )::int AS staging_rows_same_source_file,

            COALESCE(
                stg_exact_match.row_count,
                0
            )::int AS staging_rows_same_source_sheet,

            COALESCE(
                stg_exact_match.distinct_row_nrs,
                0
            )::int AS staging_distinct_row_nrs,

            COALESCE(
                stg_exact_match.load_events,
                0
            )::int AS staging_load_events,

            stg_exact_match.first_loaded_at
                AS staging_first_loaded_at,

            stg_exact_match.last_loaded_at
                AS staging_last_loaded_at,

            CASE
                WHEN COALESCE(
                    stg_exact_match.distinct_row_nrs,
                    0
                ) > 0
                THEN ROUND(
                    stg_exact_match.row_count::numeric
                    /
                    stg_exact_match.distinct_row_nrs::numeric,
                    2
                )
                ELSE NULL
            END AS staging_duplicate_factor,

            CASE
                WHEN COALESCE(
                    stg_exact_match.load_events,
                    0
                ) > 1
                AND COALESCE(
                    stg_exact_match.row_count,
                    0
                ) > COALESCE(
                    stg_exact_match.distinct_row_nrs,
                    0
                )
                THEN TRUE
                ELSE FALSE
            END AS staging_duplicate_load,

            COALESCE(
                stg_norm_match.row_count,
                0
            )::int AS staging_rows_normalized_sheet,

            NULLIF(
                stg_norm_match.example_sheet,
                ''
            ) AS example_staging_sheet

        FROM sb_inspections_v0 i

        LEFT JOIN stg_source stg_src
          ON stg_src.source_file_key =
             COALESCE(i.source_file, '')

        LEFT JOIN stg_exact stg_exact_match
          ON stg_exact_match.source_file_key =
             COALESCE(i.source_file, '')
         AND stg_exact_match.sheet_key =
             COALESCE(i.sheet, '')

        LEFT JOIN stg_norm stg_norm_match
          ON stg_norm_match.source_file_key =
             COALESCE(i.source_file, '')
         AND stg_norm_match.sheet_norm =
             regexp_replace(
                 lower(COALESCE(i.sheet, '')),
                 '[^a-z0-9]+',
                 '',
                 'g'
             )

        WHERE NOT EXISTS (
            SELECT 1
            FROM sb_inspection_items_v0 it
            WHERE it.inspection_key = i.inspection_key
        )
        {filter_sql}

        ORDER BY
            i.inspected_on DESC NULLS LAST,
            i.source_file,
            i.sheet

        LIMIT :limit
        """,
        params,
    )

    # -----------------------------------------------------
    # 3. Classificeren
    # -----------------------------------------------------

    classified_rows = []

    duplicate_staging_loads = 0

    for row in rows:
        clean = dict(row)

        if clean.get("staging_duplicate_load") is True:
            duplicate_staging_loads += 1

        same_sheet = int(
            clean.get("items_same_source_sheet") or 0
        )

        same_sheet_ws = int(
            clean.get("items_same_sheet_whitespace_normalized") or 0
        )

        same_sheet_format = int(
            clean.get("items_same_sheet_format_normalized") or 0
        )

        same_date = int(
            clean.get("items_same_source_date") or 0
        )

        same_file = int(
            clean.get("items_same_source_file") or 0
        )

        staging_same_file = int(
            clean.get("staging_rows_same_source_file") or 0
        )

        staging_same_sheet = int(
            clean.get("staging_rows_same_source_sheet") or 0
        )

        staging_normalized_sheet = int(
            clean.get("staging_rows_normalized_sheet") or 0
        )

        if same_sheet > 0:
            clean["diagnosis_code"] = (
                "POSSIBLE_INSPECTION_KEY_MISMATCH"
            )
            clean["diagnosis"] = (
                "Er bestaan items voor exact hetzelfde bronbestand "
                "en dezelfde sheet, maar niet met deze inspection_key."
            )
            clean["next_check"] = (
                "Vergelijk header- en item-inspection_key."
            )

        elif same_sheet_ws > 0:
            clean["diagnosis_code"] = (
                "SHEET_WHITESPACE_MISMATCH"
            )
            clean["diagnosis"] = (
                "Na het negeren van spaties bestaat dezelfde sheet "
                "wel bij de inspection items."
            )
            clean["next_check"] = (
                "Controleer leading/trailing/dubbele spaties in "
                "sheetnaam en inspection_key-generatie."
            )

        elif same_sheet_format > 0:
            clean["diagnosis_code"] = (
                "SHEET_FORMAT_MISMATCH"
            )
            clean["diagnosis"] = (
                "Na normalisatie van spaties en leestekens bestaat "
                "een overeenkomstige sheet bij de inspection items."
            )
            clean["next_check"] = (
                "Controleer verschillen in '-', '&', spaties, "
                "weeknotatie en andere sheetnaam-formattering."
            )

        elif same_date > 0:
            clean["diagnosis_code"] = (
                "SAME_DATE_DIFFERENT_SHEET"
            )
            clean["diagnosis"] = (
                "In hetzelfde bronbestand bestaan inspection items "
                "met dezelfde inspectiedatum, maar onder een andere sheetnaam."
            )
            clean["next_check"] = (
                "Vergelijk sheetnaam en example_sheet_same_date."
            )

        elif same_file > 0 and staging_same_sheet > 0:
            clean["diagnosis_code"] = (
                "STAGING_HAS_SHEET_ITEMS_MISSING"
            )
            clean["diagnosis"] = (
                "De probleem-sheet staat exact in staging, maar er zijn "
                "geen canonical inspection items voor aangemaakt."
            )
            clean["next_check"] = (
                "Controleer de promotie/parserflow van staging naar "
                "sb_inspection_items_v0 voor deze bron en sheet."
            )

        elif same_file > 0 and staging_normalized_sheet > 0:
            clean["diagnosis_code"] = (
                "STAGING_SHEET_NORMALIZATION_MISMATCH"
            )
            clean["diagnosis"] = (
                "In staging bestaat een overeenkomstige sheet na "
                "normalisatie van spaties/leestekens."
            )
            clean["next_check"] = (
                "Vergelijk header-sheet met example_staging_sheet en "
                "controleer sheet-normalisatie tijdens promotie."
            )

        elif same_file > 0 and staging_same_file > 0:
            clean["diagnosis_code"] = (
                "STAGING_SOURCE_PRESENT_SHEET_MISSING"
            )
            clean["diagnosis"] = (
                "Het bronbestand staat in staging, maar deze specifieke "
                "sheet is daar niet teruggevonden."
            )
            clean["next_check"] = (
                "Controleer of de sheet tijdens Excel-import/selectie "
                "is overgeslagen of als niet-inspectiesheet is beoordeeld."
            )

        elif same_file > 0:
            clean["diagnosis_code"] = (
                "SOURCE_NOT_FOUND_IN_STAGING"
            )
            clean["diagnosis"] = (
                "De header bestaat en hetzelfde bronbestand heeft andere "
                "canonical items, maar voor deze bron is geen stagingrecord gevonden."
            )
            clean["next_check"] = (
                "Controleer de oudere importflow of stagingdata later "
                "is opgeschoond/vervangen."
            )

        else:
            clean["diagnosis_code"] = (
                "NO_ITEMS_FOR_SOURCE"
            )
            clean["diagnosis"] = (
                "Voor dit bronbestand zijn helemaal geen gekoppelde "
                "inspection items gevonden."
            )
            clean["next_check"] = (
                "Controleer of de item-import voor het bronbestand "
                "is overgeslagen of mislukt."
            )

        classified_rows.append(clean)

    # -----------------------------------------------------
    # 4. Optioneel filter op berekende diagnosis_code
    # -----------------------------------------------------

    if diagnosis_code:
        diagnosis_code_norm = diagnosis_code.strip().upper()

        classified_rows = [
            row
            for row in classified_rows
            if str(
                row.get("diagnosis_code") or ""
            ).strip().upper() == diagnosis_code_norm
        ]

    # Bewaar totaal ná diagnosis-filter, vóór output-limit.
    filtered_total = len(classified_rows)

    # -----------------------------------------------------
    # 5. Groeperingen op gefilterde set
    # -----------------------------------------------------

    by_source_file: dict[str, int] = {}
    by_line: dict[str, int] = {}
    by_diagnosis: dict[str, int] = {}

    for row in classified_rows:
        source = row.get("source_file") or "(leeg)"
        line = row.get("lijn_code") or "(leeg)"
        diagnosis = (
            row.get("diagnosis_code") or "UNKNOWN"
        )

        by_source_file[source] = (
            by_source_file.get(source, 0) + 1
        )

        by_line[line] = (
            by_line.get(line, 0) + 1
        )

        by_diagnosis[diagnosis] = (
            by_diagnosis.get(diagnosis, 0) + 1
        )

    source_groups = [
        {
            "source_file": key,
            "count": value,
        }
        for key, value in sorted(
            by_source_file.items(),
            key=lambda x: x[1],
            reverse=True,
        )
    ]

    line_groups = [
        {
            "lijn_code": key,
            "count": value,
        }
        for key, value in sorted(
            by_line.items(),
            key=lambda x: x[1],
            reverse=True,
        )
    ]

    diagnosis_groups = [
        {
            "diagnosis_code": key,
            "count": value,
        }
        for key, value in sorted(
            by_diagnosis.items(),
            key=lambda x: x[1],
            reverse=True,
        )
    ]

    # -----------------------------------------------------
    # 6. Pas output-limit pas als laatste toe
    # -----------------------------------------------------

    result_rows = classified_rows[:limit]

    if diagnosis_code:
        effective_total = filtered_total
    else:
        effective_total = total_missing_before_diagnosis

    # -----------------------------------------------------
    # 7. Findings
    # -----------------------------------------------------

    findings = []

    if effective_total > 0:
        findings.append({
            "severity": "high",
            "issue": (
                "Inspectieheaders zonder exact gekoppelde items."
            ),
            "count": effective_total,
            "likely_layer": (
                "inspection_headers ↔ inspection_items"
            ),
        })

    mismatch_count = by_diagnosis.get(
        "POSSIBLE_INSPECTION_KEY_MISMATCH",
        0,
    )

    if mismatch_count > 0:
        findings.append({
            "severity": "high",
            "issue": (
                "Mogelijke inspection_key mismatch."
            ),
            "count": mismatch_count,
            "likely_layer": (
                "inspection_key generation / import"
            ),
        })

    no_source_items = by_diagnosis.get(
        "NO_ITEMS_FOR_SOURCE",
        0,
    )

    if no_source_items > 0:
        findings.append({
            "severity": "medium",
            "issue": (
                "Headers waarvan het bronbestand geen "
                "inspection items bevat."
            ),
            "count": no_source_items,
            "likely_layer": "item import",
        })

    # -----------------------------------------------------
    # 8. Response
    # -----------------------------------------------------

    return DiagnosticsAnalyzeResponse(
        status="warning" if effective_total > 0 else "ok",
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary={
            "inspections_without_items": effective_total,
            "inspections_without_items_before_diagnosis_filter":
                total_missing_before_diagnosis,
            "rows_returned": len(result_rows),
            "filters_used": payload.filters,
            "diagnosis_counts": by_diagnosis,
            "staging_duplicate_loads": duplicate_staging_loads,
        },
        findings=findings,
        evidence={
            "problem_inspections": result_rows,
            "grouped_by_source_file": source_groups,
            "grouped_by_line": line_groups,
            "grouped_by_diagnosis": diagnosis_groups,
        },
        recommended_actions=[
            (
                "Onderzoek eerst "
                "POSSIBLE_INSPECTION_KEY_MISMATCH records."
            ),
            (
                "Vergelijk header- en item-inspection_key bij "
                "hetzelfde bronbestand en sheet."
            ),
            (
                "Controleer daarna NO_ITEMS_FOR_SOURCE op "
                "mislukte of overgeslagen item-import."
            ),
        ],
        limitations=[
            (
                "Deze diagnose is read-only en herstelt "
                "geen koppelingen."
            ),
            (
                "Eenzelfde bronbestand/sheet bewijst nog niet "
                "automatisch dat twee records bij elkaar horen."
            ),
            (
                "Maximaal 500 kandidaten worden onderzocht "
                "voor een berekende diagnosis_code."
            ),
            (
                "Staging-inhoud wordt in deze lineage-versie "
                "nog niet inhoudelijk vergeleken."
            ),
        ],
        write_actions_available=False,
    )

def get_filter_str(payload: DiagnosticsAnalyzeRequest, key: str, default: str | None = None) -> str | None:
    value = payload.filters.get(key)
    if value is None:
        return default
    return str(value)

def get_object_columns(schema_name: str, object_name: str) -> list[dict]:
    return fetch_all("""
        SELECT
            column_name,
            data_type
        FROM information_schema.columns
        WHERE table_schema = :schema_name
          AND table_name = :object_name
        ORDER BY ordinal_position
    """, {
        "schema_name": schema_name,
        "object_name": object_name,
    }) or []


def has_column(columns: list[dict], column_name: str) -> bool:
    return any(c.get("column_name") == column_name for c in columns)

def classify_drop_definition(definition: str | None) -> dict:
    """
    Eenvoudige read-only interpretatie van SQL-viewdefinitie.
    Doel: filtertype en verdachte clausules herkennen.
    """

    sql = definition or ""
    sql_lower = sql.lower()

    detected = []
    suspected_clauses = []
    recommended_queries = []

    if " where " in sql_lower or "\n  where " in sql_lower or "\n where " in sql_lower:
        detected.append("filter")

    if " join " in sql_lower:
        detected.append("join")

    if "left join" in sql_lower:
        detected.append("left_join")

    if "inner join" in sql_lower or "\njoin " in sql_lower:
        detected.append("join")

    if "ignore" in sql_lower or "ignore_terms" in sql_lower:
        detected.append("ignore_list")

    if "record_type" in sql_lower:
        detected.append("record_type_filter")

    if "band_locatie_norm is not null" in sql_lower:
        detected.append("band_location_required")

    if " is not null" in sql_lower:
        detected.append("not_null_filter")

    if "coalesce" in sql_lower:
        detected.append("coalesce_normalization")

    # Probeer WHERE-clausule compact te isoleren
    where_idx = sql_lower.find(" where ")
    if where_idx == -1:
        where_idx = sql_lower.find("\n  where ")
    if where_idx == -1:
        where_idx = sql_lower.find("\n where ")

    if where_idx >= 0:
        where_clause = sql[where_idx:].strip()
        suspected_clauses.append(where_clause[:1000])

    primary_type = "unknown"

    if "ignore_list" in detected:
        primary_type = "ignore_list_filter"
    elif "record_type_filter" in detected and "band_location_required" in detected:
        primary_type = "record_type_and_band_location_filter"
    elif "record_type_filter" in detected:
        primary_type = "record_type_filter"
    elif "not_null_filter" in detected:
        primary_type = "not_null_filter"
    elif "join" in detected:
        primary_type = "join_or_mapping_effect"
    elif "filter" in detected:
        primary_type = "where_filter"

    return {
        "primary_type": primary_type,
        "detected_patterns": sorted(list(set(detected))),
        "suspected_clauses": suspected_clauses,
        "confidence": "medium" if primary_type != "unknown" else "low",
    }

def build_drop_next_queries(drop: dict, target_view: str, analysis: dict) -> list[str]:
    """
    Genereert read-only vervolgqueries om de oorzaak van een daling te kwantificeren.
    Geeft SQL als tekst terug; voert niets uit.
    """

    primary_type = analysis.get("primary_type")
    queries = []

    if primary_type == "ignore_list_filter":
        queries.append("""
SELECT
    i.term_norm,
    COUNT(*) AS rows_filtered
FROM sb_excel_positions_v1 p
LEFT JOIN band_locatie_mapping m
  ON m.lijn_code = p.lijn_code
 AND m.raw_locatie = p.locatie_effective
JOIN band_locatie_ignore_terms i
  ON i.term_norm = COALESCE(m.band_code, norm_band_code(p.locatie_effective))
GROUP BY i.term_norm
ORDER BY COUNT(*) DESC;
""".strip())

        queries.append("""
SELECT
    p.lijn_code,
    COALESCE(m.band_code, norm_band_code(p.locatie_effective)) AS normalized_band_code,
    COUNT(*) AS rows_filtered
FROM sb_excel_positions_v1 p
LEFT JOIN band_locatie_mapping m
  ON m.lijn_code = p.lijn_code
 AND m.raw_locatie = p.locatie_effective
JOIN band_locatie_ignore_terms i
  ON i.term_norm = COALESCE(m.band_code, norm_band_code(p.locatie_effective))
GROUP BY p.lijn_code, COALESCE(m.band_code, norm_band_code(p.locatie_effective))
ORDER BY COUNT(*) DESC;
""".strip())

    elif primary_type == "record_type_and_band_location_filter":
        queries.append("""
SELECT
    record_type,
    COUNT(*) AS rows_total,
    COUNT(*) FILTER (WHERE band_locatie_norm IS NULL) AS rows_without_band_locatie_norm,
    COUNT(*) FILTER (WHERE band_locatie_norm IS NOT NULL) AS rows_with_band_locatie_norm
FROM vw_inspection_full_dataset_clean_v2
GROUP BY record_type
ORDER BY COUNT(*) DESC;
""".strip())

        queries.append("""
SELECT
    record_type,
    data_quality_flag,
    COUNT(*) AS rows_total
FROM vw_inspection_full_dataset_clean_v2
GROUP BY record_type, data_quality_flag
ORDER BY COUNT(*) DESC;
""".strip())

    elif primary_type == "record_type_filter":
        queries.append(f"""
SELECT
    record_type,
    COUNT(*) AS rows_total
FROM {target_view}
GROUP BY record_type
ORDER BY COUNT(*) DESC;
""".strip())

    elif primary_type == "not_null_filter":
        queries.append("""
SELECT
    COUNT(*) AS rows_total,
    COUNT(*) FILTER (WHERE band_locatie_norm IS NULL) AS rows_null_band_locatie_norm,
    COUNT(*) FILTER (WHERE band_locatie_norm IS NOT NULL) AS rows_filled_band_locatie_norm
FROM vw_inspection_full_dataset_clean_v2;
""".strip())

    return queries

def is_safe_readonly_sql(sql: str) -> bool:
    """
    Beperkte safety-check voor automatisch gegenereerde diagnostics queries.
    Alleen SELECT/WITH toegestaan.
    Geen writes, DDL, COPY, CALL, etc.
    """

    if not sql:
        return False

    clean = sql.strip().rstrip(";").strip()
    lower = clean.lower()

    # Eerste keyword toestaan met spatie, newline, tab of einde string erna.
    first_token = lower.split(None, 1)[0] if lower.split(None, 1) else ""

    if first_token not in ("select", "with"):
        return False

    forbidden_tokens = [
        "insert",
        "update",
        "delete",
        "drop",
        "alter",
        "create",
        "truncate",
        "grant",
        "revoke",
        "call",
        "copy",
        "execute",
        "merge",
    ]

    # Simpele token-check op losse woorden.
    # Hiermee wordt bijvoorbeeld 'updated_at' niet foutief geblokkeerd door 'update'.
    import re
    tokens = set(re.findall(r"\b[a-z_]+\b", lower))

    if any(token in tokens for token in forbidden_tokens):
        return False

    # Geen multi-statement uitvoeren
    if ";" in clean:
        return False

    return True

def execute_generated_readonly_query(sql: str, limit: int = 100) -> dict:
    """
    Voert één automatisch gegenereerde read-only query uit.
    De query wordt gewrapt met LIMIT om responses beheersbaar te houden.
    """

    clean_sql = (sql or "").strip().rstrip(";").strip()

    if not is_safe_readonly_sql(clean_sql):
        return {
            "status": "blocked",
            "reason": "Query is niet als veilige read-only SELECT/WITH herkend.",
            "sql_preview": clean_sql[:500],
            "rows_returned": 0,
            "rows": [],
        }

    safe_limit = max(1, min(int(limit or 100), 500))

    wrapped_sql = f"""
        SELECT *
        FROM (
            {clean_sql}
        ) AS diagnostics_generated_query
        LIMIT :limit
    """

    try:
        rows = fetch_all(wrapped_sql, {"limit": safe_limit}) or []

        return {
            "status": "ok",
            "limit": safe_limit,
            "rows_returned": len(rows),
            "rows": rows,
        }

    except HTTPException as exc:
        return {
            "status": "error",
            "reason": str(exc.detail),
            "sql_preview": clean_sql[:500],
            "rows_returned": 0,
            "rows": [],
        }

def execute_drop_analysis_queries(drop_analysis: dict, limit: int = 100) -> dict:
    """
    Voert recommended_next_queries uit voor elke drop-analyse.
    Alleen queries die door onze eigen builder zijn gemaakt worden hier uitgevoerd.
    """

    results = {}

    for drop_label, analysis in (drop_analysis or {}).items():
        query_results = []

        for idx, sql in enumerate(analysis.get("recommended_next_queries") or [], start=1):
            result = execute_generated_readonly_query(
                sql=sql,
                limit=limit,
            )

            query_results.append({
                "query_index": idx,
                "status": result.get("status"),
                "rows_returned": result.get("rows_returned"),
                "result": result,
            })

        results[drop_label] = {
            "target_object": analysis.get("target_object"),
            "primary_type": analysis.get("primary_type"),
            "queries_executed": len(query_results),
            "query_results": query_results,
        }

    return results

def sql_array_literal(values: list | None) -> str:
    """
    Maakt een PostgreSQL ARRAY[...] literal voor SQL-preview.
    Alleen bedoeld voor read-only preview, niet voor directe uitvoering.
    """

    if not values:
        return "NULL"

    cleaned = [
        str(value).strip()
        for value in values
        if value is not None and str(value).strip()
    ]

    if not cleaned:
        return "NULL"

    return "ARRAY[" + ", ".join(sql_literal(value) for value in cleaned) + "]"

