def safe_count_object(schema_name: str, object_name: str) -> dict:
    """
    Telt regels in een tabel/view als deze bestaat.
    Alleen gebruiken met vaste objectnamen uit code, niet met vrije user input.
    """

    exists = fetch_one("""
        SELECT
            table_schema,
            table_name,
            table_type
        FROM information_schema.tables
        WHERE table_schema = :schema_name
          AND table_name = :object_name
    """, {
        "schema_name": schema_name,
        "object_name": object_name,
    })

    if not exists:
        return {
            "schema": schema_name,
            "object": object_name,
            "exists": False,
            "row_count": None,
            "status": "missing",
        }

    quoted_object = f'"{schema_name}"."{object_name}"'

    try:
        row = fetch_one(f"""
            SELECT COUNT(*)::int AS row_count
            FROM {quoted_object}
        """) or {}

        return {
            "schema": schema_name,
            "object": object_name,
            "exists": True,
            "object_type": exists.get("table_type"),
            "row_count": row.get("row_count", 0),
            "status": "ok",
        }

    except HTTPException as exc:
        return {
            "schema": schema_name,
            "object": object_name,
            "exists": True,
            "object_type": exists.get("table_type"),
            "row_count": None,
            "status": "error",
            "error": str(exc.detail),
        }



def is_main_dataset_object(item: dict) -> bool:
    """
    Alleen hoofd-datasetlagen meenemen voor row_count vergelijking.
    Mapping/lookup-tabellen blijven wel zichtbaar in evidence,
    maar tellen niet mee als dataverlies tussen lagen.
    """

    kind = item.get("kind")
    object_name = item.get("object") or ""

    if kind in ("start", "v", "m"):
        return True

    # Brontabellen die wél hoofddata zijn
    if object_name in (
        "sb_excel_positions_v1",
        "sb_inspection_items_v0",
        "sb_inspections_v0",
        "sb_stg_inspecties_raw",
    ):
        return True

    return False

def get_view_definition(schema_name: str, view_name: str) -> dict | None:
    return fetch_one("""
        SELECT
            schemaname,
            viewname,
            definition
        FROM pg_views
        WHERE schemaname = :schema_name
          AND viewname = :view_name
    """, {
        "schema_name": schema_name,
        "view_name": view_name,
    })

def split_schema_object(full_name: str, default_schema: str = "public") -> tuple[str, str]:
    if not full_name:
        return default_schema, ""

    parts = full_name.split(".", 1)

    if len(parts) == 2:
        return parts[0], parts[1]

    return default_schema, full_name

