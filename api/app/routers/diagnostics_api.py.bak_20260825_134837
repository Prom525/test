@router.get("/inspections/orphans/date-repair-candidates")
def diagnostics_inspection_orphan_date_repairs():
    rows = fetch_all("""
        WITH orphan_keys AS (
            SELECT DISTINCT
                it.inspection_key,
                it.source_file,
                split_part(it.inspection_key, '|', 2) AS raw_label,
                split_part(it.inspection_key, '|', 3) AS parsed_date
            FROM sb_inspection_items_v0 it
            WHERE NOT EXISTS (
                SELECT 1
                FROM sb_inspections_v0 i
                WHERE i.inspection_key = it.inspection_key
            )
        )

        SELECT
            inspection_key,
            source_file,
            raw_label,
            parsed_date,

            CASE
                WHEN parsed_date LIKE '2099-%'
                    THEN REPLACE(parsed_date, '2099-', '1999-')

                WHEN parsed_date LIKE '3999-%'
                    THEN REPLACE(parsed_date, '3999-', '1999-')

                WHEN parsed_date LIKE '3998-%'
                    THEN REPLACE(parsed_date, '3998-', '1998-')

                ELSE NULL
            END AS suggested_date_fix

        FROM orphan_keys
        WHERE parsed_date LIKE '2099-%'
           OR parsed_date LIKE '3999-%'
           OR parsed_date LIKE '3998-%'

        ORDER BY inspection_key
    """)

    return {
        "status": "ok",
        "domain": "inspections",
        "check": "orphan_date_repair_candidates",
