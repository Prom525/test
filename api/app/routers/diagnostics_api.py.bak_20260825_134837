def _provenance_filter_where(
    object_name: str,
    filters: dict | None,
    prefix: str,
) -> tuple[str, dict]:
    """
    Beperkte parameterized filter-builder voor V3 provenance-SQL.
    Geen vrije SQL uit gebruikersinput.
    """

    filters = filters or {}

    columns = {
        row.get("column_name")
        for row in get_object_columns(
            schema_name="public",
            object_name=object_name,
        )
        if row.get("column_name")
    }

    conditions = []
    params = {}

    def add_exact(
        filter_name: str,
        candidate_columns: list[str],
    ):
        value = filters.get(filter_name)

        if value is None or str(value).strip() == "":
            return

        column = next(
            (
                candidate
                for candidate in candidate_columns
                if candidate in columns
            ),
            None,
        )

        if not column:
            return

        param_name = f"{prefix}_{filter_name}"

        conditions.append(
            f'{quote_ident(column)} = :{param_name}'
        )

        params[param_name] = value

    add_exact(
        "inspection_key",
        ["inspection_key"],
    )

    add_exact(
        "lijn_code",
        ["lijn_code", "line_hint"],
    )

    add_exact(
        "band_code",
        ["band_code", "band_norm"],
    )

    add_exact(
        "source_file",
        ["source_file"],
    )

    add_exact(
        "section_idx",
        ["section_idx"],
    )

    add_exact(
        "row_nr",
        ["row_nr"],
    )

    add_exact(
        "check_code",
        ["check_code"],
    )

    source_contains = filters.get(
        "source_file_contains"
    )

    if (
        source_contains is not None
        and str(source_contains).strip()
        and "source_file" in columns
    ):
        param_name = (
            f"{prefix}_source_file_contains"
        )

        conditions.append(
            f'{quote_ident("source_file")} '
            f'ILIKE :{param_name}'
        )

        params[param_name] = (
            f"%{str(source_contains).strip()}%"
        )

    if not conditions:
        return "", params

    return (
        "WHERE " + " AND ".join(conditions),
        params,
    )


def _append_sql_condition(
    where_sql: str,
    condition: str | None,
) -> str:
    if not condition:
        return where_sql

    if where_sql:
        return (
            where_sql
            + " AND "
            + condition
        )

    return "WHERE " + condition


def _fetch_provenance_edge_comparison(
    source_object: str,
    target_object: str,
    spec: dict,
    filters: dict | None,
    limit: int,
) -> dict:
    """
    Vergelijkt echte provenance-keys via SQL.

    Geen sample-based vergelijking.
    """

    key_columns = list(
        spec.get("key_columns") or []
    )

    if not key_columns:
        raise RuntimeError(
            "V3 edge zonder key_columns."
        )

    source_where, source_params = (
        _provenance_filter_where(
            source_object,
            filters,
            "src",
        )
    )

    target_where, target_params = (
        _provenance_filter_where(
            target_object,
            filters,
            "tgt",
        )
    )

    source_where = _append_sql_condition(
        source_where,
        spec.get("source_extra_condition"),
    )

    source_table = (
        f'{quote_ident("public")}.'
        f'{quote_ident(source_object)}'
    )

    target_table = (
        f'{quote_ident("public")}.'
        f'{quote_ident(target_object)}'
    )

    key_sql = ", ".join(
        quote_ident(column)
        for column in key_columns
    )

    params = {
        **source_params,
        **target_params,
    }

    ctes = f"""
        WITH source_rows AS (
            SELECT
                {key_sql}
            FROM {source_table}
            {source_where}
        ),
        target_rows AS (
            SELECT
                {key_sql}
            FROM {target_table}
            {target_where}
        ),
        source_keys AS (
            SELECT DISTINCT
                {key_sql}
            FROM source_rows
        ),
        target_keys AS (
            SELECT DISTINCT
                {key_sql}
            FROM target_rows
        ),
        only_source AS (
            SELECT *
            FROM source_keys

            EXCEPT

            SELECT *
            FROM target_keys
        ),
        only_target AS (
            SELECT *
            FROM target_keys

            EXCEPT

            SELECT *
            FROM source_keys
        )
    """

    # PROMATI_COMPARISON_PERF_V32
    #
    # Performance-optimalisatie zonder semantiekwijziging:
    #
    # Voorheen:
    # - source_rows / target_rows
    # - DISTINCT source_keys / target_keys
    # - EXCEPT only_source / only_target
    # - extra JOIN voor in_both
    #
    # Nu:
    # beide datasets Ã©Ã©n keer als UNION ALL aanbieden en
    # per provenance-key groeperen. Hierdoor kunnen raw rows,
    # distinct keys, overlap en beide verschillen in Ã©Ã©n
    # aggregate-query worden afgeleid.
    #
    # GROUP BY behandelt gelijke NULL-keywaarden bovendien als
    # Ã©Ã©n groep, overeenkomstig DISTINCT/set-semantiek.
    count_ctes = f"""
        WITH keyed_rows AS (
            SELECT
                {key_sql},
                1::bigint AS source_row_count,
                0::bigint AS target_row_count
            FROM {source_table}
            {source_where}

            UNION ALL

            SELECT
                {key_sql},
                0::bigint AS source_row_count,
                1::bigint AS target_row_count
            FROM {target_table}
            {target_where}
        ),
        per_key AS (
            SELECT
                {key_sql},
                SUM(source_row_count)::bigint
                    AS source_rows,
                SUM(target_row_count)::bigint
                    AS target_rows
            FROM keyed_rows
            GROUP BY
                {key_sql}
        )
    """

    counts = fetch_one(
        count_ctes
        + """
        SELECT
            COALESCE(
                SUM(source_rows),
                0
            )::bigint
                AS source_raw_rows,

            COALESCE(
                SUM(target_rows),
                0
            )::bigint
                AS target_raw_rows,

            COUNT(*) FILTER (
                WHERE source_rows > 0
            )
                AS source_key_count,

            COUNT(*) FILTER (
                WHERE target_rows > 0
            )
                AS target_key_count,

            COUNT(*) FILTER (
                WHERE
                    source_rows > 0
                    AND target_rows > 0
            )
                AS in_both_count,

            COUNT(*) FILTER (
                WHERE
                    source_rows > 0
                    AND target_rows = 0
            )
                AS only_in_source_count,

            COUNT(*) FILTER (
                WHERE
                    source_rows = 0
                    AND target_rows > 0
            )
                AS only_in_target_count
        FROM per_key
        """,
        params,
    ) or {}

    example_limit = max(
        1,
        min(
            int(limit or 25),
            25,
        ),
    )

    example_params = {
        **params,
        "example_limit": example_limit,
    }

    order_sql = ", ".join(
        quote_ident(column)
        for column in key_columns
    )

    # V3.1:
    # examples pas ophalen wanneer een verschil ONVERWACHT is.
    # Verwachte filter/expansion/enrichment-verschillen hoeven
    # niet opnieuw met zware EXCEPT-querysets gesampled te worden.
    only_source_examples = []
    only_target_examples = []

    observed_source = int(
        counts.get(
            "only_in_source_count"
        )
        or 0
    )

    observed_target = int(
        counts.get(
            "only_in_target_count"
        )
        or 0
    )

    if spec.get(
        "source_difference_expected"
    ):
        unexpected_source = 0
        expected_source = observed_source
    else:
        unexpected_source = observed_source
        expected_source = 0

    if spec.get(
        "target_difference_expected"
    ):
        unexpected_target = 0
        expected_target = observed_target
    else:
        unexpected_target = observed_target
        expected_target = 0

    # --------------------------------------------------------
    # V3.1 performance:
    # Alleen voorbeelden ophalen voor ECHT onverwachte verschillen.
    # De count-query hierboven blijft altijd leidend.
    # --------------------------------------------------------

    if unexpected_source > 0:
        only_source_examples = fetch_all(
            ctes
            + f"""
            SELECT *
            FROM only_source
            ORDER BY {order_sql}
            LIMIT :example_limit
            """,
            example_params,
        ) or []

    if unexpected_target > 0:
        only_target_examples = fetch_all(
            ctes
            + f"""
            SELECT *
            FROM only_target
            ORDER BY {order_sql}
            LIMIT :example_limit
            """,
            example_params,
        ) or []

    intentional_excluded_count = 0

    if spec.get(
        "report_intentional_exclusion"
    ):
        exclusion_where = _append_sql_condition(
            _provenance_filter_where(
                source_object,
                filters,
                "exc",
            )[0],
            (
                "check_code = "
                "'band_algemene_staat'::text"
            ),
        )

        exclusion_params = (
            _provenance_filter_where(
                source_object,
                filters,
                "exc",
            )[1]
        )

        exclusion = fetch_one(
            f"""
            SELECT
                COUNT(*)::bigint
                    AS rows_total
            FROM {source_table}
            {exclusion_where}
            """,
            exclusion_params,
        ) or {}

        intentional_excluded_count = int(
            exclusion.get("rows_total")
            or 0
        )

    return {
        "compare_mode": "chain",
        "comparison_version": "v3.1_provenance",
        "edge_type": spec.get("edge_type"),
        "expectation": spec.get("expectation"),
        "expected_behavior_reason": spec.get(
            "reason"
        ),
        "source_object": (
            f"public.{source_object}"
        ),
        "target_object": (
            f"public.{target_object}"
        ),
        "comparison_key": key_columns,
        "comparison": {
            "source_rows": int(
                counts.get("source_raw_rows")
                or 0
            ),
            "target_rows": int(
                counts.get("target_raw_rows")
                or 0
            ),
            "source_key_count": int(
                counts.get("source_key_count")
                or 0
            ),
            "target_key_count": int(
                counts.get("target_key_count")
                or 0
            ),
            "in_both_count": int(
                counts.get("in_both_count")
                or 0
            ),
            "only_in_source_count":
                observed_source,
            "only_in_target_count":
                observed_target,
            "only_in_source":
                only_source_examples,
            "only_in_target":
                only_target_examples,
        },
        "summary": {
            # Deze twee velden betekenen vanaf V3:
            # ONVERWACHT verschil. Daarmee blijft bestaande
            # presentatiecode backwards-compatible.
            "only_in_source_count":
                unexpected_source,
            "only_in_target_count":
                unexpected_target,

            "observed_only_in_source_count":
                observed_source,
            "observed_only_in_target_count":
                observed_target,

            "expected_only_in_source_count":
                expected_source,
            "expected_only_in_target_count":
                expected_target,

            "source_rows": int(
                counts.get("source_raw_rows")
                or 0
            ),
            "target_rows": int(
                counts.get("target_raw_rows")
                or 0
            ),
            "source_key_count": int(
                counts.get("source_key_count")
                or 0
            ),
            "target_key_count": int(
                counts.get("target_key_count")
                or 0
            ),
            "in_both_count": int(
                counts.get("in_both_count")
                or 0
            ),

            "intentional_excluded_count":
                intentional_excluded_count,

            "has_loss_downstream":
                unexpected_source > 0,
            "has_gain_downstream":
                unexpected_target > 0,
        },
    }


def build_inspection_provenance_comparisons(
    object_results: list[dict],
    filters: dict | None,
    limit: int,
) -> list[dict] | None:
    """
    V3 specialisatie voor de inspectie/Excel-keten.

    Return None wanneer de objectketen niet volledig door
    bekende provenance-edge semantics wordt gedekt.
    """

    existing = [
        item
        for item in object_results or []
        if item.get("exists")
    ]

    if len(existing) < 2:
        return None

    pairs = []

    for idx in range(
        0,
        len(existing) - 1,
    ):
        source = existing[idx]
        target = existing[idx + 1]

        source_name = source.get("object")
        target_name = target.get("object")

        spec = (
            INSPECTION_PROVENANCE_EDGE_SPECS.get(
                (
                    source_name,
                    target_name,
                )
            )
        )

        if not spec:
            return None

        pairs.append(
            (
                source_name,
                target_name,
                spec,
            )
        )

    comparisons = []

    for source_name, target_name, spec in pairs:
        comparisons.append(
            _fetch_provenance_edge_comparison(
                source_object=source_name,
                target_object=target_name,
                spec=spec,
                filters=filters,
                limit=limit,
            )
        )

    return comparisons

def build_sql_deep_dive_comparisons(
    object_results: list[dict],
    compare_mode: str = "chain",
    filters: dict | None = None,
    limit: int = 50,
) -> list[dict]:
    """
    V2: vergelijkt meerdere objecten.

    compare_mode:
    - chain: object1 -> object2 -> object3
    - all_pairs: elk object met elk later object

    Alleen objecten met geldige sample-rows worden meegenomen.
    """

    compare_mode = str(
        compare_mode or "chain"
    ).strip().lower()

    if compare_mode == "chain":
        provenance_comparisons = (
            build_inspection_provenance_comparisons(
                object_results=object_results,
                filters=filters,
                limit=limit,
            )
        )

        if provenance_comparisons is not None:
            return provenance_comparisons

    # V2 fallback voor niet-inspectie-ketens.
    comparable_results = [
        item for item in object_results
        if item.get("exists")
        and (item.get("sample") or {}).get("status") == "ok"
    ]

    comparisons = []

    if len(comparable_results) < 2:
        return comparisons

    compare_mode = str(compare_mode or "chain").strip().lower()

    pairs = []

    if compare_mode == "all_pairs":
        for source_idx in range(0, len(comparable_results)):
            for target_idx in range(source_idx + 1, len(comparable_results)):
                pairs.append((
                    source_idx,
                    target_idx,
                    comparable_results[source_idx],
                    comparable_results[target_idx],
                ))
    else:
        for idx in range(0, len(comparable_results) - 1):
            pairs.append((
                idx,
                idx + 1,
                comparable_results[idx],
                comparable_results[idx + 1],
            ))

    for source_idx, target_idx, source, target in pairs:
        source_rows = (source.get("sample") or {}).get("rows") or []
        target_rows = (target.get("sample") or {}).get("rows") or []

        comparison = compare_diagnostic_row_sets(
            source_rows=source_rows,
            target_rows=target_rows,
        )

        comparisons.append({
            "compare_mode": compare_mode,
            "source_index": source_idx,
            "target_index": target_idx,
            "source_object": source.get("full_name"),
            "target_object": target.get("full_name"),
            "comparison_key": [
                "lijn_code",
                "band_norm_or_band_code",
                "scraper_family",
                "scraper_type_norm",
                "scraper_role",
                "physical_position_label_final",
            ],
            "comparison": comparison,
            "summary": {
                "source_rows": comparison.get("source_rows"),
                "target_rows": comparison.get("target_rows"),
                "in_both_count": comparison.get("in_both_count"),
                "only_in_source_count": comparison.get("only_in_source_count"),
                "only_in_target_count": comparison.get("only_in_target_count"),
                "has_loss_downstream": comparison.get("only_in_source_count", 0) > 0,
                "has_gain_downstream": comparison.get("only_in_target_count", 0) > 0,
            },
        })

    return comparisons


def summarize_sql_deep_dive_comparisons(comparisons: list[dict]) -> dict:
    """
    Compacte ketensamenvatting voor GPT.
    """

    chain_steps = []

    total_only_in_source = 0
    total_only_in_target = 0
    steps_with_loss = 0
    steps_with_gain = 0

    first_loss = None

    for idx, item in enumerate(comparisons or [], start=1):
        summary = item.get("summary") or {}
        only_source = summary.get("only_in_source_count") or 0
        only_target = summary.get("only_in_target_count") or 0

        total_only_in_source += only_source
        total_only_in_target += only_target

        if only_source > 0:
            steps_with_loss += 1

            if first_loss is None:
                first_loss = {
                    "step": idx,
                    "source_object": item.get("source_object"),
                    "target_object": item.get("target_object"),
                    "only_in_source_count": only_source,
                    "first_only_in_source": (
                        (item.get("comparison") or {}).get("only_in_source") or [None]
                    )[0],
                }

        if only_target > 0:
            steps_with_gain += 1

        chain_steps.append({
            "step": idx,
            "comparison_version": item.get(
                "comparison_version",
                "v2_sample",
            ),
            "edge_type": item.get("edge_type"),
            "expectation": item.get("expectation"),
            "source_object": item.get("source_object"),
            "target_object": item.get("target_object"),
            "source_rows": summary.get("source_rows"),
            "target_rows": summary.get("target_rows"),
            "source_key_count": summary.get(
                "source_key_count"
            ),
            "target_key_count": summary.get(
                "target_key_count"
            ),
            "in_both_count": summary.get("in_both_count"),

            # only_in_* zijn hier alleen ONVERWACHTE
            # verschillen voor V3.
            "only_in_source_count": only_source,
            "only_in_target_count": only_target,

            "observed_only_in_source_count":
                summary.get(
                    "observed_only_in_source_count",
                    only_source,
                ),

            "observed_only_in_target_count":
                summary.get(
                    "observed_only_in_target_count",
                    only_target,
                ),

            "expected_only_in_source_count":
                summary.get(
                    "expected_only_in_source_count",
                    0,
                ),

            "expected_only_in_target_count":
                summary.get(
                    "expected_only_in_target_count",
                    0,
                ),

            "intentional_excluded_count":
                summary.get(
                    "intentional_excluded_count",
                    0,
                ),

            "has_loss_downstream": only_source > 0,
            "has_gain_downstream": only_target > 0,
        })

    return {
        "comparisons_count": len(comparisons or []),
        "steps_with_loss": steps_with_loss,
        "steps_with_gain": steps_with_gain,
        "total_only_in_source": total_only_in_source,
        "total_only_in_target": total_only_in_target,
        "first_loss": first_loss,
        "chain_steps": chain_steps,
    }

