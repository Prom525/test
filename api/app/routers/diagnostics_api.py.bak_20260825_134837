def analyze_inspection_pipeline(payload: DiagnosticsAnalyzeRequest) -> DiagnosticsAnalyzeResponse:
    """
    Analyseert de inspectiedataketen laag voor laag.

    Doel:
    Excel/staging → inspections → items → positions → clean views → lifecycle → maintenance
    """

    pipeline_objects = [
        {
            "step": 1,
            "layer": "staging",
            "schema": "public",
            "object": "sb_stg_inspecties_raw",
            "meaning": "Ruwe Excelregels uit staging.",
        },
        {
