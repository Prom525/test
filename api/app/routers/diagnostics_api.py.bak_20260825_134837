                    "De eerste ontbrekende bronpositie heeft verklarende statusvelden: "
                    + ", ".join(status_bits)
                    + "."
                )

        if cmp_summary.get("only_in_source_count", 0) == 0 and cmp_summary.get("only_in_target_count", 0) == 0:
            interpretation.append(
                "De vergeleken objecten bevatten dezelfde posities voor de opgegeven filters."
            )

    for item in object_results:
        sample = item.get("sample") or {}
        status_counts = item.get("status_counts") or {}

        if sample.get("rows_returned") == 0:
            interpretation.append(
                f"{item.get('full_name')} geeft geen sample-rows terug voor de opgegeven filters."
            )

        if status_counts.get("status") == "ok" and status_counts.get("rows"):
            interpretation.append(
                f"{item.get('full_name')} heeft statusverdelingen beschikbaar; gebruik evidence.status_counts voor de belangrijkste oorzaken."
            )

    recommended_actions.append(
        "Gebruik evidence.object_results voor samples, kolommen en statusverdelingen per object."
    )

    if comparisons:
        recommended_actions.append(
            "Gebruik evidence.comparisons.only_in_source om te zien welke positie downstream ontbreekt."
        )

    recommended_actions.append(
        "Als een positie ontbreekt door forecast_status, intervaldata of data_quality_flag, is dat meestal een datalogica-verklaring en niet direct een databasefout."
    )

    return {
        "headline": "SQL deep dive heeft objecten, filters, samples, statusverdelingen en vergelijkingen automatisch uitgevoerd.",
        "interpretation": interpretation,
        "recommended_actions": recommended_actions,
    }


def analyze_sql_deep_dive(payload: DiagnosticsAnalyzeRequest) -> DiagnosticsAnalyzeResponse:
    """
    V1/V2/V3: veilige GPT deep-dive voor databaseproblemen.

    Wat deze versie doet:
    - ontdekt objecten als payload.objects leeg is
    - valideert opgegeven of ontdekte objecten via information_schema
    - leest kolommen
    - haalt gefilterde samples op
    - haalt statusverdelingen op
    - vergelijkt objecten in chain-mode of all_pairs-mode

    Read-only. Geen vrije write-SQL.
    """

    limit = max(1, min(int(payload.limit or 50), 500))

    discovery = None
    effective_payload = payload

    if not payload.objects:
        discovery = discover_database_objects_for_sql_deep_dive(
            payload=payload,
            limit=10,
        )

        discovered_objects = pick_discovered_objects_for_chain(
            discovery=discovery,
            payload=payload,
        )

        if not discovered_objects:
            return DiagnosticsAnalyzeResponse(
                status="error",
                domain=payload.domain,
                topic=payload.topic,
                mode=payload.mode,
                summary={
                    "message": "Geen objecten opgegeven en object-discovery vond geen bruikbare kandidaten.",
                    "question": payload.question,
                    "discovery": discovery,
                },
                findings=[{
                    "severity": "high",
                    "issue": "No objects and discovery found no candidates",
                }],
                evidence={
                    "discovery": discovery,
                },
                recommended_actions=[
                    "Geef objects expliciet mee of maak de vraag specifieker met termen zoals onderhoud, toplist, band_position of lifecycle.",
                ],
                limitations=[
                    "sql_deep_dive V3 object-discovery zoekt alleen op catalog/objectnamen en viewdefinities.",
                    "Deze mode is read-only.",
                ],
                write_actions_available=False,
            )

        if hasattr(payload, "model_copy"):
            effective_payload = payload.model_copy(
                update={
                    "objects": discovered_objects,
                }
            )
        else:
            effective_payload = payload.copy(
                update={
                    "objects": discovered_objects,
                }
            )

    objects = normalize_requested_objects(effective_payload)

    findings = []
    object_results = []

    for obj in objects:
        if not obj.get("exists"):
            findings.append({
                "severity": "medium",
                "issue": "Object niet gevonden.",
                "object": obj.get("full_name"),
            })

            object_results.append({
                **obj,
                "sample": {
                    "status": "missing_object",
                    "rows_returned": 0,
                    "rows": [],
                },
                "status_counts": {
                    "status": "missing_object",
                    "rows_returned": 0,
                    "rows": [],
                },
            })
            continue

        column_names = obj.get("column_names") or []

        sample = fetch_object_diagnostic_rows(
            schema_name=obj["schema"],
            object_name=obj["object"],
            column_names=column_names,
            filters=payload.filters,
            limit=limit,
        )

        status_counts = fetch_object_status_counts(
            schema_name=obj["schema"],
            object_name=obj["object"],
            column_names=column_names,
            filters=payload.filters,
            limit=limit,
        )

        object_results.append({
            "requested_name": obj.get("requested_name"),
            "schema": obj.get("schema"),
            "object": obj.get("object"),
            "full_name": obj.get("full_name"),
            "exists": obj.get("exists"),
            "object_type": (obj.get("object_info") or {}).get("table_type"),
            "columns_count": len(column_names),
            "key_columns_present": {
                "lijn_code": "lijn_code" in column_names,
                "band_norm": "band_norm" in column_names,
                "band_code": "band_code" in column_names,
                "scraper_family": "scraper_family" in column_names,
                "scraper_type_norm": "scraper_type_norm" in column_names,
                "scraper_role": "scraper_role" in column_names,
                "physical_position_label_final": "physical_position_label_final" in column_names,
                "position_display": "position_display" in column_names,
                "forecast_status": "forecast_status" in column_names,
                "data_quality_flag": "data_quality_flag" in column_names,
            },
            "sample": sample,
            "status_counts": status_counts,
        })

        if sample.get("rows_returned") == 0:
            findings.append({
                "severity": "info",
                "issue": "Object heeft geen rijen voor opgegeven filters.",
                "object": obj.get("full_name"),
            })

    compare_mode = str(payload.filters.get("compare_mode") or "chain").strip().lower()

    comparisons = build_sql_deep_dive_comparisons(
        object_results=object_results,
        compare_mode=compare_mode,
        filters=payload.filters,
        limit=limit,
    )

    comparison_summary = summarize_sql_deep_dive_comparisons(
        comparisons=comparisons,
    )

    for item in comparisons:
        summary = item.get("summary") or {}

        if summary.get("only_in_source_count", 0) > 0:
            findings.append({
                "severity": "info",
                "issue": "Er zijn posities die wel in bronobject zitten maar niet in doelobject.",
                "source_object": item.get("source_object"),
                "target_object": item.get("target_object"),
                "only_in_source_count": summary.get("only_in_source_count"),
            })

        if summary.get("only_in_target_count", 0) > 0:
            findings.append({
                "severity": "info",
                "issue": "Er zijn posities die wel in doelobject zitten maar niet in bronobject.",
                "source_object": item.get("source_object"),
                "target_object": item.get("target_object"),
                "only_in_target_count": summary.get("only_in_target_count"),
            })

    gpt_diagnosis = build_sql_deep_dive_answer(
        payload=payload,
        object_results=object_results,
        comparisons=comparisons,
    )

    response_profile = get_response_profile(payload)

    if response_profile == "gpt_compact":
        compact_object_results = []

        for item in object_results:
            compact_object_results.append({
                "full_name": item.get("full_name"),
                "exists": item.get("exists"),
                "object_type": item.get("object_type"),
                "columns_count": item.get("columns_count"),
                "key_columns_present": item.get("key_columns_present"),
                "sample": {
                    "status": (item.get("sample") or {}).get("status"),
                    "rows_returned": (item.get("sample") or {}).get("rows_returned"),
                    "rows": ((item.get("sample") or {}).get("rows") or [])[:10],
                },
                "status_counts": {
                    "status": (item.get("status_counts") or {}).get("status"),
                    "status_columns": (item.get("status_counts") or {}).get("status_columns"),
                    "rows_returned": (item.get("status_counts") or {}).get("rows_returned"),
                    "rows": ((item.get("status_counts") or {}).get("rows") or [])[:20],
                },
            })

        evidence = {
            "response_profile": "gpt_compact",
            "discovery": discovery,
            "object_results": compact_object_results,
            "comparison_summary": comparison_summary,
            "comparisons": comparisons[:10],
        }
    else:
        evidence = {
            "response_profile": "full",
            "discovery": discovery,
            "object_results": object_results,
            "comparison_summary": comparison_summary,
            "comparisons": comparisons,
        }
    return DiagnosticsAnalyzeResponse(
        status="ok" if not findings else "warning",
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary={
            "question": payload.question,
            "objects_requested": len(payload.objects or []),
            "objects_discovered": len((discovery or {}).get("candidates") or []) if discovery else 0,
            "objects_effective": effective_payload.objects,
            "objects_checked": len(object_results),
            "compare_mode": compare_mode,
            "comparisons_made": len(comparisons),
            "comparison_summary": comparison_summary,
            "filters_used": payload.filters,
            "gpt_diagnosis": gpt_diagnosis,
        },
        findings=findings,
        evidence=evidence,
        recommended_actions=gpt_diagnosis.get("recommended_actions", []),
        limitations=[
            "sql_deep_dive V2 vergelijkt meerdere objecten in chain-mode of all_pairs-mode.",
            "Vergelijking gebeurt op algemene scraperpositie-sleutels; domeinspecifieke uitzonderingen volgen later.",
            "Deze mode is read-only en voert geen writes uit.",
            "Objecten mogen expliciet worden meegegeven; als objects leeg is probeert V3 automatisch kandidaatobjecten te ontdekken.",
        ],
        write_actions_available=False,
    )

