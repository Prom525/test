def analyze_view_dependencies(payload: DiagnosticsAnalyzeRequest) -> DiagnosticsAnalyzeResponse:
    schema_name = get_filter_str(payload, "schema", "public")
    view_name = (
        get_filter_str(payload, "view_name")
        or get_filter_str(payload, "object_name")
        or (payload.objects[0] if payload.objects else None)
    )

    if not view_name:
        return DiagnosticsAnalyzeResponse(
            status="error",
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary={
                "message": "Geen view_name opgegeven.",
            },
            findings=[
                {
                    "severity": "high",
                    "issue": "Missing view_name",
                    "recommended_filter": {
                        "schema": "public",
                        "view_name": "vw_mes_lifecycle_cycles_clean",
                    },
                }
            ],
            evidence={
                "requested_filters": payload.filters,
                "requested_objects": payload.objects,
            },
            recommended_actions=[
                "Geef filters.schema en filters.view_name mee, of zet de viewnaam in objects[0].",
            ],
            limitations=[],
            write_actions_available=False,
        )

    view_exists = fetch_one("""
        SELECT
            c.oid,
            n.nspname AS schema_name,
            c.relname AS view_name,
            c.relkind
        FROM pg_class c
        JOIN pg_namespace n
          ON n.oid = c.relnamespace
        WHERE n.nspname = :schema_name
          AND c.relname = :view_name
          AND c.relkind IN ('v', 'm')
    """, {
        "schema_name": schema_name,
        "view_name": view_name,
    })

    if not view_exists:
        return DiagnosticsAnalyzeResponse(
            status="not_found",
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary={
                "schema": schema_name,
                "view_name": view_name,
                "found": False,
            },
            findings=[
                {
                    "severity": "medium",
                    "issue": "View niet gevonden in pg_class.",
                    "schema": schema_name,
                    "view_name": view_name,
                }
            ],
            evidence={},
            recommended_actions=[
                "Controleer of de view bestaat via /diagnostics/database/views.",
            ],
            limitations=[],
            write_actions_available=False,
        )

    dependencies = fetch_all("""
        SELECT DISTINCT
            source_ns.nspname AS source_schema,
            source_cls.relname AS source_view,
            source_cls.relkind AS source_kind,
            target_ns.nspname AS depends_on_schema,
            target_cls.relname AS depends_on_object,
            target_cls.relkind AS depends_on_kind
        FROM pg_depend d
        JOIN pg_rewrite r
          ON r.oid = d.objid
        JOIN pg_class source_cls
          ON source_cls.oid = r.ev_class
        JOIN pg_namespace source_ns
          ON source_ns.oid = source_cls.relnamespace
        JOIN pg_class target_cls
          ON target_cls.oid = d.refobjid
        JOIN pg_namespace target_ns
          ON target_ns.oid = target_cls.relnamespace
        WHERE source_ns.nspname = :schema_name
          AND source_cls.relname = :view_name
          AND target_cls.relname <> source_cls.relname
          AND target_ns.nspname NOT IN ('pg_catalog', 'information_schema')
        ORDER BY
            target_ns.nspname,
            target_cls.relname
    """, {
        "schema_name": schema_name,
        "view_name": view_name,
    }) or []

    kind_map = {
        "r": "table",
        "v": "view",
        "m": "materialized_view",
        "p": "partitioned_table",
        "f": "foreign_table",
    }

    normalized_dependencies = []
    for dep in dependencies:
        normalized_dependencies.append({
            **dep,
            "depends_on_type": kind_map.get(dep.get("depends_on_kind"), dep.get("depends_on_kind")),
            "source_type": kind_map.get(dep.get("source_kind"), dep.get("source_kind")),
        })

    recursive_dependencies = []

    if payload.depth == "deep":
        max_depth = 20
        recursive_raw = fetch_recursive_view_dependencies(
            schema_name=schema_name,
            view_name=view_name,
            max_depth=max_depth,
        )

        for dep in recursive_raw:
            recursive_dependencies.append({
                **dep,
                "source_type": kind_map.get(dep.get("source_kind"), dep.get("source_kind")),
                "depends_on_type": kind_map.get(dep.get("depends_on_kind"), dep.get("depends_on_kind")),
            })

    findings = []

    if not normalized_dependencies:
        findings.append({
            "severity": "medium",
            "issue": "Geen dependencies gevonden.",
            "likely_meaning": "De view is leeg, zeer simpel, of dependencies worden niet via pg_depend zichtbaar.",
        })

    direct_views = [
        d for d in normalized_dependencies
        if d.get("depends_on_kind") in ("v", "m")
    ]

    direct_tables = [
        d for d in normalized_dependencies
        if d.get("depends_on_kind") in ("r", "p", "f")
    ]

    return DiagnosticsAnalyzeResponse(
        status="ok" if normalized_dependencies else "warning",
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary={
            "schema": schema_name,
            "view_name": view_name,
            "depth_mode": payload.depth,
            "dependencies_found": len(normalized_dependencies),
            "direct_view_dependencies": len(direct_views),
            "direct_table_dependencies": len(direct_tables),
            "direct_views": [
                f"{d.get('depends_on_schema')}.{d.get('depends_on_object')}"
                for d in direct_views
            ],
            "direct_tables": [
                f"{d.get('depends_on_schema')}.{d.get('depends_on_object')}"
                for d in direct_tables
            ],
            "recursive_dependencies_found": len(recursive_dependencies),
            "recursive_max_depth_seen": max(
                [d.get("depth", 0) for d in recursive_dependencies],
                default=0,
            ),
            "recursive_base_tables": sorted(list({
                f"{d.get('depends_on_schema')}.{d.get('depends_on_object')}"
                for d in recursive_dependencies
                if d.get("depends_on_kind") in ("r", "p", "f")
            })),
            "recursive_views": sorted(list({
                f"{d.get('depends_on_schema')}.{d.get('depends_on_object')}"
                for d in recursive_dependencies
                if d.get("depends_on_kind") in ("v", "m")
            })),
        },
        findings=findings,
        evidence={
            "view": view_exists,
            "dependencies": normalized_dependencies,
            "recursive_dependencies": recursive_dependencies,
        },
        recommended_actions=[
            "Gebruik view_definition op de belangrijkste onderliggende view.",
            "Gebruik later recursive view_dependencies om de volledige keten te volgen.",
            "Gebruik view_health om te zien waar rijen of waarden wegvallen.",
        ],
        limitations=[
            "Bij depth=normal worden alleen directe dependencies getoond.",
            "Bij depth=deep wordt recursief gezocht tot maximaal 10 lagen.",
            "Kolomniveau-dependencies worden nog niet apart getoond.",
        ],
        write_actions_available=False,
    )

def get_basic_object_health(schema_name: str, object_name: str) -> dict:
    """
    Basis-health voor één tabel/view.
    Gebruikt alleen read-only queries.
    """

    object_info = fetch_one("""
        SELECT
            table_schema,
            table_name,
            table_type
        FROM information_schema.tables
        WHERE table_schema = :schema_name
          AND table_name = :object_name
    """, {
        "schema_name": schema_name,
        "object_name": object_name,
    })

    if not object_info:
        return {
            "schema": schema_name,
            "object": object_name,
            "exists": False,
            "status": "missing",
        }

    columns = get_object_columns(schema_name, object_name)
    column_names = [c.get("column_name") for c in columns]

    quoted_object = f'"{schema_name}"."{object_name}"'

    row = fetch_one(f"""
        SELECT COUNT(*)::int AS row_count
        FROM {quoted_object}
    """) or {}

    result = {
        "schema": schema_name,
        "object": object_name,
        "object_type": object_info.get("table_type"),
        "exists": True,
        "status": "ok",
        "row_count": row.get("row_count", 0),
        "columns_count": len(columns),
        "key_columns_present": {
            "inspected_on": has_column(columns, "inspected_on"),
            "lijn_code": has_column(columns, "lijn_code"),
            "locatie": has_column(columns, "locatie"),
            "band_norm": has_column(columns, "band_norm"),
            "band_code": has_column(columns, "band_code"),
            "scraper_family": has_column(columns, "scraper_family"),
            "scraper_type_norm": has_column(columns, "scraper_type_norm"),
            "scraper_role": has_column(columns, "scraper_role"),
            "meshoogte_mm": has_column(columns, "meshoogte_mm"),
            "cycle_id": has_column(columns, "cycle_id"),
        },
        "metrics": {},
    }

    if has_column(columns, "inspected_on"):
        result["metrics"]["inspected_on_range"] = fetch_one(f"""
            SELECT
                MIN(inspected_on)::text AS min_value,
                MAX(inspected_on)::text AS max_value,
                COUNT(*) FILTER (WHERE inspected_on IS NULL)::int AS null_count
            FROM {quoted_object}
        """)

    for col in [
        "lijn_code",
        "locatie",
        "band_norm",
        "band_code",
        "scraper_family",
        "scraper_type_norm",
        "scraper_role",
        "band_station",
    ]:
        if has_column(columns, col):
            result["metrics"][f"{col}_quality"] = fetch_one(f"""
                SELECT
                    COUNT(DISTINCT "{col}")::int AS distinct_count,
                    COUNT(*) FILTER (
                        WHERE "{col}" IS NULL OR TRIM("{col}"::text) = ''
                    )::int AS empty_count
                FROM {quoted_object}
            """)

    if has_column(columns, "meshoogte_mm"):
        result["metrics"]["meshoogte_mm_quality"] = fetch_one(f"""
            SELECT
                COUNT(*) FILTER (WHERE meshoogte_mm IS NOT NULL)::int AS filled_count,
                COUNT(*) FILTER (WHERE meshoogte_mm IS NULL)::int AS null_count,
                MIN(meshoogte_mm)::numeric AS min_value,
                MAX(meshoogte_mm)::numeric AS max_value,
                AVG(meshoogte_mm)::numeric(10,2) AS avg_value
            FROM {quoted_object}
        """)

    return result

