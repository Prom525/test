@router.get("/modules")
def diagnostics_modules(request: Request):
    routes = []

    for route in request.app.routes:
        path = getattr(route, "path", None)
        name = getattr(route, "name", None)
        methods = sorted(list(getattr(route, "methods", []) or []))

        if not path:
            continue

        category = _classify_route(path)
        risk = _classify_risk(path, methods)

        routes.append(
            {
                "path": path,
                "name": name,
                "methods": methods,
                "category": category,
                "risk": risk,
            }
        )

    summary = {}
    risk_summary = {}

    for r in routes:
        summary[r["category"]] = summary.get(r["category"], 0) + 1
        risk_summary[r["risk"]] = risk_summary.get(r["risk"], 0) + 1

    return {
        "status": "ok",
        "summary": summary,
        "risk_summary": risk_summary,
        "routes_count": len(routes),
        "routes": sorted(routes, key=lambda x: x["path"]),
        "write_actions_available": False,
    }


def _classify_risk(path: str, methods: list[str]) -> str:
    write_methods = {"POST", "PUT", "PATCH", "DELETE"}

    if path.startswith("/docs") or path.startswith("/redoc") or path.startswith("/openapi"):
        return "SYSTEM_DOCS"

    if path.startswith("/diagnostics"):
        return "SAFE_READ_ONLY"

    if path.startswith("/healthz") or path.endswith("/health"):
        return "SAFE_READ_ONLY"

    if "DELETE" in methods:
        return "WRITE_DELETE"

    if any(m in write_methods for m in methods):
        if path.startswith("/analysis/rfq/assistant"):
            return "CONTROLLED_WORKFLOW"
        if path.startswith("/analysis/rfq") and "/pdf-url/" in path:
            return "SAFE_READ_ONLY"
        if path.startswith("/rag/ingest"):
            return "WRITE_INGEST"
        if path.startswith("/files/presign"):
            return "WRITE_FILE_UPLOAD"
        if path.startswith("/lijn-mapping") or path.startswith("/calendar-line-mapping"):
            return "ADMIN_WRITE"
        if path.startswith("/chatdb/sql"):
            return "HIGH_RISK_SQL"
        if path.startswith("/machines"):
            return "WRITE_LEGACY"
        return "WRITE_REVIEW"

    return "SAFE_READ_ONLY"

def _classify_route(path: str) -> str:
    if path.startswith("/analysis/rfq"):
        return "RFQ"
    if path.startswith("/analysis"):
        return "ANALYSIS"
    if path.startswith("/inspecties"):
        return "INSPECTIONS"
    if path.startswith("/scrapers"):
        return "SCRAPERS"
    if path.startswith("/products"):
        return "PRODUCTS"
    if path.startswith("/rag"):
        return "RAG"
    if path.startswith("/files"):
        return "FILES"
    if path.startswith("/chatdb"):
        return "CHATDB"
    if path.startswith("/lijn-mapping"):
        return "ADMIN_MAPPING"
    if path.startswith("/calendar-line-mapping"):
        return "ADMIN_MAPPING"
    if path.startswith("/berekeningen"):
        return "CALCULATIONS"
    if path.startswith("/diagnostics"):
        return "DIAGNOSTICS"
    if path.startswith("/healthz"):
        return "HEALTH"
    if path.startswith("/docs") or path.startswith("/redoc") or path.startswith("/openapi"):
        return "FASTAPI_DOCS"
    if path.startswith("/machines"):
        return "MACHINES"

    return "OTHER"

