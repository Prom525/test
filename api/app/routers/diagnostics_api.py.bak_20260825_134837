        {
            "step": 5,
            "layer": "clean_positions",
            "schema": "public",
            "object": "vw_excel_positions_clean_v1",
            "meaning": "Opgeschoonde positie-view voor verdere analyse.",
        },
        {
            "step": 6,
            "layer": "full_dataset",
            "schema": "public",
            "object": "vw_inspection_full_dataset_v1",
            "meaning": "Gecombineerde inspectiedataset voor API-analyse.",
        },
        {
            "step": 7,
            "layer": "latest_mes",
            "schema": "public",
            "object": "vw_meshoogte_latest_per_scraper_clean",
            "meaning": "Laatste meshoogte per schraperpositie.",
        },
        {
            "step": 8,
            "layer": "lifecycle",
            "schema": "public",
            "object": "vw_mes_lifecycle_cycles_clean",
            "meaning": "Lifecycle- en meetpuntgeschiedenis.",
        },
        {
            "step": 9,
            "layer": "cycle_analysis",
            "schema": "public",
            "object": "vw_mes_cycle_analysis_clean",
            "meaning": "Slijtage-/cycle-analyse richting vervanggrens.",
        },
        {
            "step": 10,
            "layer": "maintenance",
            "schema": "public",
            "object": "vw_mes_maintenance_positions_latest",
            "meaning": "Laatste onderhoudsposities en prioriteiten.",
        },
        {
            "step": 11,
            "layer": "replacement_advice",
            "schema": "public",
            "object": "vw_all_replacement_advice",
            "meaning": "Vervangadvies op basis van historie/cycli.",
        },
        {
            "step": 12,
            "layer": "band_scraper_status",
            "schema": "public",
            "object": "vw_band_scraper_api_v1",
            "meaning": "Bandstatus: met/zonder schrapers.",
        },
        {
            "step": 13,
            "layer": "band_scraper_details",
            "schema": "public",
            "object": "vw_band_scraper_details_api_v1",
            "meaning": "Detailregels per band/schraper.",
        },
    ]

    pipeline = []

    for item in pipeline_objects:
        count_info = safe_count_object(item["schema"], item["object"])
        pipeline.append({
            **item,
            **count_info,
        })

    existing = [p for p in pipeline if p.get("exists")]
    missing = [p for p in pipeline if not p.get("exists")]

    summary = {
        "pipeline_steps_defined": len(pipeline),
        "objects_found": len(existing),
        "objects_missing": len(missing),
        "missing_objects": [p["object"] for p in missing],
    }

    findings = []

    if missing:
        findings.append({
            "severity": "medium",
            "issue": "Niet alle verwachte inspectie-pipeline objecten bestaan.",
            "count": len(missing),
            "objects": [p["object"] for p in missing],
        })

    # Basis waarschuwingen bij bekende koppelproblemen
    linkage = fetch_one("""
        SELECT
            (
                SELECT COUNT(*)::int
                FROM sb_inspections_v0 i
                WHERE NOT EXISTS (
                    SELECT 1
                    FROM sb_inspection_items_v0 it
                    WHERE it.inspection_key = i.inspection_key
