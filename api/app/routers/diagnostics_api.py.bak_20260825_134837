def analyze_view_chain_health(payload: DiagnosticsAnalyzeRequest) -> DiagnosticsAnalyzeResponse:
    schema_name = get_filter_str(payload, "schema", "public")
    view_name = (
        get_filter_str(payload, "view_name")
        or get_filter_str(payload, "object_name")
        or (payload.objects[0] if payload.objects else None)
    )

    response_profile = get_response_profile(payload)

    if not view_name:
        return DiagnosticsAnalyzeResponse(
            status="error",
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary={"message": "Geen view_name/object_name opgegeven."},
            findings=[{
                "severity": "high",
                "issue": "Missing object name",
                "recommended_filter": {
                    "schema": "public",
                    "view_name": "vw_mes_lifecycle_cycles_clean"
                },
            }],
            evidence={
                "requested_filters": payload.filters,
                "requested_objects": payload.objects,
            },
            recommended_actions=[
                "Geef filters.view_name mee of zet de viewnaam in objects[0]."
            ],
            limitations=[],
            write_actions_available=False,
        )

    max_depth = 20

    recursive_raw = fetch_recursive_view_dependencies(
        schema_name=schema_name,
        view_name=view_name,
        max_depth=max_depth,
    )

    # Maak lijst van unieke objecten in ketenvolgorde:
    # startview + alle depends_on views/tables uit de recursive dependencies.
    chain_objects = [{
        "depth": 0,
        "schema": schema_name,
        "object": view_name,
        "kind": "start",
    }]

    seen = {f"{schema_name}.{view_name}"}

    for dep in recursive_raw:
        key = f"{dep.get('depends_on_schema')}.{dep.get('depends_on_object')}"
        if key in seen:
            continue

        seen.add(key)
        chain_objects.append({
            "depth": dep.get("depth"),
            "schema": dep.get("depends_on_schema"),
            "object": dep.get("depends_on_object"),
            "kind": dep.get("depends_on_kind"),
            "type": dep.get("depends_on_type"),
            "dependency_path": dep.get("dependency_path"),
        })

    chain_health = []

    for obj in chain_objects:
        if response_profile == "gpt_compact":
            health = get_compact_object_health(
                schema_name=obj["schema"],
                object_name=obj["object"],
            )
        else:
            health = get_basic_object_health(
                schema_name=obj["schema"],
                object_name=obj["object"],
            )

        chain_health.append({
            **obj,
            "health": health,
        })

    # Alleen bestaande objecten met row_count
    main_chain_health = [
        item for item in chain_health
        if is_main_dataset_object(item)
    ]

    dataflow_chain_health = sorted(
        main_chain_health,
        key=lambda item: item.get("depth", 0),
        reverse=True,
    )

    dataflow_row_counts = []

    for item in dataflow_chain_health:
        health = item.get("health") or {}
        if health.get("exists") and health.get("row_count") is not None:
            dataflow_row_counts.append({
                "depth": item.get("depth"),
                "object": f"{item.get('schema')}.{item.get('object')}",
                "row_count": health.get("row_count"),
            })

    dataflow_row_count_changes = []

    for idx in range(1, len(dataflow_row_counts)):
        previous = dataflow_row_counts[idx - 1]
        current = dataflow_row_counts[idx]

        prev_count = previous.get("row_count") or 0
        curr_count = current.get("row_count") or 0

        change = curr_count - prev_count
        loss = prev_count - curr_count

        ratio = None
        loss_ratio = None

        if prev_count > 0:
            ratio = round(curr_count / prev_count, 4)
            loss_ratio = round(loss / prev_count, 4)

        dataflow_row_count_changes.append({
            "from": previous.get("object"),
            "to": current.get("object"),
            "from_row_count": prev_count,
            "to_row_count": curr_count,
            "change": change,
            "loss": loss,
            "ratio_to_previous": ratio,
            "loss_ratio": loss_ratio,
        })

    dataflow_drops = [
        change for change in dataflow_row_count_changes
        if change.get("loss", 0) > 0
    ]

    first_major_drop = None
    for change in dataflow_drops:
        loss_ratio = change.get("loss_ratio")
        if loss_ratio is not None and loss_ratio >= 0.10:
            first_major_drop = change
            break

    largest_drop = None
    if dataflow_drops:
        largest_drop = sorted(
            dataflow_drops,
            key=lambda c: c.get("loss", 0),
            reverse=True,
        )[0]

    drop_view_definitions = {}

    for label, drop in [
        ("first_major_drop", first_major_drop),
        ("largest_drop", largest_drop),
    ]:
        if not drop:
            continue

        target_object = drop.get("to")
        target_schema, target_view = split_schema_object(
            target_object,
            default_schema=schema_name,
        )

        definition_row = get_view_definition(
            schema_name=target_schema,
            view_name=target_view,
        )

        drop_view_definitions[label] = {
            "target_object": target_object,
            "target_schema": target_schema,
            "target_view": target_view,
            "definition_found": bool(definition_row),
            "definition_length": len((definition_row or {}).get("definition") or ""),
            "definition": (definition_row or {}).get("definition"),
        }

    drop_analysis = {}

    for label, drop_definition in drop_view_definitions.items():
        definition = drop_definition.get("definition")
        sql_analysis = classify_drop_definition(definition)

        target_object = drop_definition.get("target_object")
        drop = first_major_drop if label == "first_major_drop" else largest_drop

        next_queries = build_drop_next_queries(
            drop=drop,
            target_view=target_object,
            analysis=sql_analysis,
        )

        drop_analysis[label] = {
            "target_object": target_object,
            "drop": drop,
            "primary_type": sql_analysis.get("primary_type"),
            "detected_patterns": sql_analysis.get("detected_patterns"),
            "confidence": sql_analysis.get("confidence"),
            "suspected_clauses": sql_analysis.get("suspected_clauses"),
            "recommended_next_queries": next_queries,
        }

    lookup_chain_health = [
        item for item in chain_health
        if not is_main_dataset_object(item)
    ]

    row_counts = []
    for item in main_chain_health:
        health = item.get("health") or {}
        if health.get("exists") and health.get("row_count") is not None:
            row_counts.append({
                "depth": item.get("depth"),
                "object": f"{item.get('schema')}.{item.get('object')}",
                "row_count": health.get("row_count"),
            })

    # Row count drops tussen opeenvolgende objecten in de keten.
    row_count_changes = []
    for idx in range(1, len(row_counts)):
        previous = row_counts[idx - 1]
        current = row_counts[idx]

        prev_count = previous.get("row_count") or 0
        curr_count = current.get("row_count") or 0

        change = curr_count - prev_count
        ratio = None
        if prev_count > 0:
            ratio = round(curr_count / prev_count, 4)

        row_count_changes.append({
            "from": previous.get("object"),
            "to": current.get("object"),
            "from_row_count": prev_count,
            "to_row_count": curr_count,
            "change": change,
            "ratio_to_previous": ratio,
        })

    if response_profile == "gpt_compact":
        drop_query_results = {}
    else:
        drop_query_results = execute_drop_analysis_queries(
            drop_analysis=drop_analysis,
            limit=payload.limit,
        )

    gpt_diagnosis = build_gpt_diagnosis(
        first_major_drop=first_major_drop,
        largest_drop=largest_drop,
        drop_analysis=drop_analysis,
        drop_query_results=drop_query_results,
    )

    findings = []

    for change in row_count_changes:
        ratio = change.get("ratio_to_previous")
        if ratio is not None and ratio < 0.5:
            findings.append({
                "severity": "medium",
                "issue": "Sterke row_count daling tussen opeenvolgende dependency-objecten.",
                **change,
            })

    missing_objects = [
        f"{item.get('schema')}.{item.get('object')}"
        for item in chain_health
        if not (item.get("health") or {}).get("exists")
    ]

    if missing_objects:
        findings.append({
            "severity": "high",
            "issue": "Objecten in dependency-keten niet gevonden.",
            "objects": missing_objects,
        })

    if first_major_drop:
        findings.append({
            "severity": "medium",
            "issue": "Eerste grote row_count-daling in dataflow.",
            **first_major_drop,
        })

    if largest_drop and largest_drop != first_major_drop:
        findings.append({
            "severity": "medium",
            "issue": "Grootste row_count-daling in dataflow.",
            **largest_drop,
        })

    for label, analysis in drop_analysis.items():
        findings.append({
            "severity": "info",
            "issue": f"Automatische SQL-interpretatie voor {label}.",
            "target_object": analysis.get("target_object"),
            "primary_type": analysis.get("primary_type"),
            "confidence": analysis.get("confidence"),
            "detected_patterns": analysis.get("detected_patterns"),
        })

    for label, result in drop_query_results.items():
        failed = [
            q for q in result.get("query_results") or []
            if q.get("status") != "ok"
        ]

        if failed:
            findings.append({
                "severity": "medium",
                "issue": f"Niet alle vervolgqueries voor {label} konden worden uitgevoerd.",
                "target_object": result.get("target_object"),
                "failed_count": len(failed),
            })
        else:
            findings.append({
                "severity": "info",
                "issue": f"Vervolgqueries voor {label} succesvol uitgevoerd.",
                "target_object": result.get("target_object"),
                "queries_executed": result.get("queries_executed"),
            })

    recommended_actions = [
        "Gebruik evidence.parser_row_context om de eerste concrete ONBEKEND-regels per bronbestand/sheet te controleren.",
        "Begin met HOO6, PEFA en GSL; deze lijnen staan in de compacte parser_source_diagnostics.",
        "Controleer vooral of row_nr, record_role en scraper_type laten zien dat locatie-overname uit een bovenliggend bandblok ontbreekt.",
        "Voeg niet blind ONBEKEND toe aan band_locatie_mapping; ONBEKEND wijst waarschijnlijk op ontbrekende locatiecontext.",
        "Gebruik scraper_type_mapping_actions apart voor scraper_type_mapping; meng dit niet met parser/location-inheritance.",
    ]

    limitations = [
        "Deze chain-health vergelijkt row_counts tussen dependency-objecten; join- en mappingtabellen kunnen logisch andere aantallen hebben.",
        "De volgorde is dependency-volgorde, niet altijd exact uitvoeringsvolgorde van de SQL.",
        "Kolomniveau-lineage volgt later.",
    ]

    response_status = "ok" if not findings else "warning"

    if response_profile == "gpt_compact":
        return build_compact_chain_health_response(
            payload=payload,
            schema_name=schema_name,
            view_name=view_name,
            status=response_status,
            findings=findings,
            gpt_diagnosis=gpt_diagnosis,
            first_major_drop=first_major_drop,
            largest_drop=largest_drop,
            drop_query_results=drop_query_results,
            drop_analysis=drop_analysis,
            missing_objects=missing_objects,
            recommended_actions=recommended_actions,
            limitations=limitations,
        )

    return DiagnosticsAnalyzeResponse(
        status=response_status,
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary={
            "schema": schema_name,
            "view_name": view_name,
            "depth_mode": payload.depth,
            "chain_objects_found": len(chain_health),
            "main_chain_objects_found": len(main_chain_health),
            "lookup_or_side_objects_found": len(lookup_chain_health),
            "recursive_dependencies_found": len(recursive_raw),
            "max_depth": max_depth,
            "row_counts": row_counts,
            "dataflow_row_counts": dataflow_row_counts,
            "first_major_drop": first_major_drop,
            "largest_drop": largest_drop,
            "drop_view_definitions_available": {
                key: {
                    "target_object": value.get("target_object"),
                    "definition_found": value.get("definition_found"),
                    "definition_length": value.get("definition_length"),
                }
                for key, value in drop_view_definitions.items()
            },
            "drop_analysis_summary": {
                key: {
                    "target_object": value.get("target_object"),
                    "primary_type": value.get("primary_type"),
                    "confidence": value.get("confidence"),
                    "recommended_next_queries_count": len(value.get("recommended_next_queries") or []),
                }
                for key, value in drop_analysis.items()
            },
            "drop_query_results_summary": {
                key: {
                    "target_object": value.get("target_object"),
