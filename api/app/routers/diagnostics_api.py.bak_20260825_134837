def analyze_overview(
    payload: DiagnosticsAnalyzeRequest,
    request: Request | None = None,
) -> DiagnosticsAnalyzeResponse:
    # PROMATI_SYSTEM_DIAGNOSTICS_OVERVIEW_V1
    if payload.domain == "system":
        findings = []

        # ----------------------------------------------------
        # Database-connectiviteit
        # ----------------------------------------------------
        database_status = "ok"
        database_evidence = {}

        try:
            database_evidence = fetch_one(
                """
                SELECT
                    1::int AS connectivity_ok,
                    current_database() AS database_name,
                    current_schema() AS schema_name,
                    current_setting(
                        'server_version'
                    ) AS postgres_version
                """
            ) or {}

        except HTTPException as exc:
            database_status = "error"

            findings.append({
                "severity": "high",
                "issue": "Database-connectiviteit mislukt",
                "classification": "DATA_REVIEW_REQUIRED",
                "detail": str(
                    getattr(exc, "detail", exc)
                )[:300],
            })

        # ----------------------------------------------------
        # Actuele FastAPI-route-inventaris
        #
        # PROMATI_SYSTEM_DIAGNOSTICS_OVERVIEW_V11
        #
        # FastAPI 0.141 kan included routers in app.routes
        # representeren als _IncludedRouter placeholders.
        # Die placeholders hebben geen bruikbare path/methods.
        #
        # Het gegenereerde OpenAPI-schema is in deze runtime
        # wel de volledige, effectieve route-inventaris.
        # ----------------------------------------------------
        routes = []
        openapi_paths = {}

        if request is not None:
            try:
                schema = (
                    getattr(
                        request.app,
                        "openapi_schema",
                        None,
                    )
                    or request.app.openapi()
                )

                openapi_paths = (
                    schema.get("paths", {})
                    if isinstance(schema, dict)
                    else {}
                )

            except Exception as exc:
                findings.append({
                    "severity": "high",
                    "issue": (
                        "OpenAPI route-inventaris "
                        "kon niet worden gelezen"
                    ),
                    "classification":
                        "CODE_OR_PARSER_FIX",
                    "detail": str(exc)[:300],
                })

                openapi_paths = {}

        http_method_keys = {
            "get",
            "post",
            "put",
            "patch",
            "delete",
            "options",
            "head",
            "trace",
        }

        for route_path, path_item in sorted(
            openapi_paths.items()
        ):
            if not isinstance(path_item, dict):
                continue

            methods = sorted(
                key.upper()
                for key in path_item.keys()
                if key.casefold()
                in http_method_keys
            )

            routes.append({
                "path": route_path,
                "name": None,
                "methods": methods,
                "category": _classify_route(
                    route_path
                ),
                "risk": _classify_risk(
                    route_path,
                    methods,
                ),
            })

        required_route_specs = [
            (
                "/orchestrator/ask",
                "POST",
            ),
            (
                "/diagnostics/assistant/ask",
                "POST",
            ),
            (
                "/diagnostics/analyze",
                "POST",
            ),
            (
                "/diagnostics/modules",
                "GET",
            ),
            (
                "/system/capabilities",
                "GET",
            ),
        ]

        required_routes = []

        for route_path, method in required_route_specs:
            path_item = openapi_paths.get(
                route_path
            )

            available_methods = set()

            if isinstance(path_item, dict):
                available_methods = {
                    key.upper()
                    for key in path_item.keys()
                    if key.casefold()
                    in http_method_keys
                }

            available = (
                method.upper()
                in available_methods
            )

            required_routes.append({
                "path": route_path,
                "method": method,
                "available": available,
            })

            if (
                request is not None
                and not available
            ):
                findings.append({
                    "severity": "high",
                    "issue": (
                        "Verplichte systeemroute ontbreekt"
                    ),
                    "classification":
                        "CODE_OR_PARSER_FIX",
                    "path": route_path,
                    "method": method,
                })

        routes_available = sum(
            1
            for item in required_routes
            if item["available"]
        )

        required_routes_ok = (
            routes_available
            == len(required_route_specs)
        )

        # ----------------------------------------------------
        # Risicoverdeling routes
        # ----------------------------------------------------
        route_risk_summary = {}

        for item in routes:
            risk = item["risk"]

            route_risk_summary[risk] = (
                route_risk_summary.get(
                    risk,
                    0,
                )
                + 1
            )

        # ----------------------------------------------------
        # Feature/build markers
        #
        # Geen versie aannemen uit vrije tekst:
        # alleen markers in werkelijk geladen broncode.
        # ----------------------------------------------------
        diagnostics_source = ""

        try:
            diagnostics_source = Path(
                __file__
            ).read_text(
                encoding="utf-8",
                errors="replace",
            )
        except Exception:
            diagnostics_source = ""

        understanding_source = ""

        try:
            understanding_path = (
                Path(__file__)
                .resolve()
                .parents[1]
                / "orchestrator"
                / "understanding.py"
            )

            understanding_source = (
                understanding_path.read_text(
                    encoding="utf-8",
                    errors="replace",
                )
            )
        except Exception:
            understanding_source = ""

        feature_flags = {
            "object_discovery_v4": (
                "PROMATI_OBJECT_DISCOVERY_V4"
                in diagnostics_source
            ),
            "comparison_v3_1": (
                "PROMATI_COMPARISON_V31"
                in diagnostics_source
            ),
            "comparison_performance_v3_2": (
                "PROMATI_COMPARISON_PERF_V32"
                in diagnostics_source
            ),
            "bandcode_version_guard_v1": (
                "PROMATI_BANDCODE_VERSION_GUARD_V1"
                in understanding_source
            ),
            "diagnostics_meta_routing_v1": (
                "PROMATI_DIAGNOSTICS_META_ROUTING_V1"
                in understanding_source
            ),
        }

        feature_labels = {
            "object_discovery_v4":
                "Object Discovery V4",
            "comparison_v3_1":
                "Comparison V3.1",
            "comparison_performance_v3_2":
                "Comparison Performance V3.2",
            "bandcode_version_guard_v1":
                "Bandcode Version Guard V1",
            "diagnostics_meta_routing_v1":
                "Diagnostics Meta-Routing V1",
        }

        active_features = [
            feature_labels[key]
            for key, enabled
            in feature_flags.items()
            if enabled
        ]

        # ----------------------------------------------------
        # Compact systeemantwoord
        # ----------------------------------------------------
        if request is None:
            route_text = (
                "route-inventaris niet beschikbaar"
            )
        else:
            route_text = (
                f"{routes_available}/"
                f"{len(required_route_specs)} "
                "kernroutes beschikbaar"
            )

        message = (
            "System diagnostics: "
            "API runtime ok; "
            f"database {database_status}; "
            f"{route_text}."
        )

        if active_features:
            message += (
                " Actieve features: "
                + ", ".join(active_features)
                + "."
            )

        limitations = [
            (
                "Deze overview is read-only en "
                "voert geen systeem- of databasewrites uit."
            ),
            (
                "Featurestatus is gebaseerd op "
                "markers in de werkelijk geladen broncode."
            ),
        ]

        if request is None:
            limitations.append(
                "FastAPI route-inventaris kon zonder Request "
                "niet worden gecontroleerd."
            )

        return DiagnosticsAnalyzeResponse(
            status=(
                "warning"
                if findings
                else "ok"
            ),
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary={
                "message": message,
                "api_runtime_status": "ok",
                "database_status":
                    database_status,
                "python_version":
                    sys.version.split()[0],
                "routes_count":
                    len(routes),
                "required_routes_ok":
                    required_routes_ok,
                "required_routes_available":
                    routes_available,
                "required_routes_total":
                    len(required_route_specs),
                "feature_flags":
                    feature_flags,
            },
            findings=findings,
            evidence={
                "runtime": {
                    "python_version":
                        sys.version.split()[0],
                },
                "database":
                    database_evidence,
                "required_routes":
                    required_routes,
                "route_risk_summary":
                    route_risk_summary,
                "active_features":
                    active_features,
            },
            recommended_actions=(
                []
                if not findings
                else [
                    (
                        "Controleer de ontbrekende "
                        "systeemroute of databaseverbinding."
                    )
                ]
            ),
            limitations=limitations,
            write_actions_available=False,
        )

    if payload.domain == "inspections":
        summary = fetch_one("""
            SELECT
                (SELECT COUNT(*)::int FROM sb_inspections_v0) AS total_inspections,
                (SELECT COUNT(*)::int FROM sb_inspection_items_v0) AS total_inspection_items,
                (
                    SELECT COUNT(*)::int
                    FROM sb_inspections_v0 i
                    WHERE NOT EXISTS (
                        SELECT 1
                        FROM sb_inspection_items_v0 it
                        WHERE it.inspection_key = i.inspection_key
                    )
                ) AS inspections_without_items,
                (
                    SELECT COUNT(*)::int
                    FROM sb_inspection_items_v0 it
                    WHERE NOT EXISTS (
                        SELECT 1
                        FROM sb_inspections_v0 i
                        WHERE i.inspection_key = it.inspection_key
                    )
                ) AS orphan_items
        """) or {}

        findings = []

        if summary.get("inspections_without_items", 0) > 0:
            findings.append({
                "severity": "high",
                "issue": "Inspecties zonder gekoppelde items",
                "count": summary.get("inspections_without_items"),
            })

        if summary.get("orphan_items", 0) > 0:
            findings.append({
                "severity": "high",
                "issue": "Inspection items zonder gekoppelde header",
                "count": summary.get("orphan_items"),
            })

        return DiagnosticsAnalyzeResponse(
            status="ok" if not findings else "warning",
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary=summary,
            findings=findings,
            evidence={
                "source_tables": [
                    "sb_inspections_v0",
                    "sb_inspection_items_v0",
                ]
            },
            recommended_actions=[
                "Gebruik mode inspection_pipeline voor laag-voor-laag analyse.",
                "Gebruik later inspection_lineage voor analyse van één inspectie, band of sheet.",
            ],
            limitations=[
                "Deze overview kijkt nog niet naar PostgreSQL view-definities.",
                "Deze overview kijkt nog niet naar assetmodel-classificatie.",
            ],
            write_actions_available=False,
        )

    return DiagnosticsAnalyzeResponse(
        status="ok",
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary={
            "message": f"Overview voor domein {payload.domain} is nog minimaal.",
        },
        findings=[],
        evidence={},
        recommended_actions=[],
        limitations=[
            "Alleen inspections-overview is in stap 1 uitgewerkt.",
        ],
        write_actions_available=False,
    )

def analyze_asset_model_health(payload: DiagnosticsAnalyzeRequest) -> DiagnosticsAnalyzeResponse:
    """
    Analyseert assetmodel-kwaliteit rond bandcodes, ONBEKEND,
    scraper_family en scraper_role.
    Read-only.
    """

    limit = max(1, min(int(payload.limit or 25), 100))
    response_profile = get_response_profile(payload)

    # 1. ONBEKEND per lijn
    unknown_by_line = fetch_limited_rows("""
        SELECT
            p.lijn_code,
            COALESCE(m.band_code, norm_band_code(p.locatie_effective)) AS normalized_band_code,
            COUNT(*) AS rows_total
        FROM sb_excel_positions_v1 p
        LEFT JOIN band_locatie_mapping m
          ON m.lijn_code = p.lijn_code
         AND m.raw_locatie = p.locatie_effective
        WHERE COALESCE(m.band_code, norm_band_code(p.locatie_effective)) = 'ONBEKEND'
        GROUP BY
            p.lijn_code,
            COALESCE(m.band_code, norm_band_code(p.locatie_effective))
        ORDER BY COUNT(*) DESC
    """, limit=limit)

    # 2. ONBEKEND per ruwe locatie
    unknown_by_raw_location = fetch_limited_rows("""
        SELECT
            p.lijn_code,
            p.locatie_effective,
            p.band_locatie_norm,
            COUNT(*) AS rows_total
        FROM sb_excel_positions_v1 p
        LEFT JOIN band_locatie_mapping m
          ON m.lijn_code = p.lijn_code
         AND m.raw_locatie = p.locatie_effective
        WHERE COALESCE(m.band_code, norm_band_code(p.locatie_effective)) = 'ONBEKEND'
        GROUP BY
            p.lijn_code,
            p.locatie_effective,
            p.band_locatie_norm
        ORDER BY COUNT(*) DESC
    """, limit=limit)

    # 3. Mogelijke mapping-kandidaten: ruwe locaties die vaak ONBEKEND worden
    # Belangrijk: record_role meenemen, zodat HEADER/SUB_CONFIG/COMMENT_ONLY
    # niet meer als echte parser/location gaps worden behandeld.
    mapping_candidates = fetch_limited_rows("""
        SELECT
            p.lijn_code,
            p.locatie_effective AS raw_locatie,
            p.band_locatie_norm,
            p.record_role,
            COUNT(*) AS rows_total,
            COUNT(*) FILTER (
                WHERE p.record_role IN ('POSITION', 'SUB_POSITION')
            ) AS position_like_rows,
            COUNT(*) FILTER (
                WHERE p.record_role IN ('HEADER', 'SUB_CONFIG', 'CONFIG', 'BAND_HEADER', 'COMMENT_ONLY')
            ) AS non_position_rows,
            MIN(p.source_file) AS example_source_file,
            MIN(p.sheet) AS example_sheet
        FROM sb_excel_positions_v1 p
        LEFT JOIN band_locatie_mapping m
          ON m.lijn_code = p.lijn_code
         AND m.raw_locatie = p.locatie_effective
        WHERE COALESCE(m.band_code, norm_band_code(p.locatie_effective)) = 'ONBEKEND'
          AND p.locatie_effective IS NOT NULL
        GROUP BY
            p.lijn_code,
            p.locatie_effective,
            p.band_locatie_norm,
            p.record_role
        ORDER BY COUNT(*) DESC
    """, limit=limit)

    # 4. Lege scraper_family per lijn/type
    scraper_family_empty = fetch_limited_rows("""
        SELECT
            lijn_code,
            scraper_type_effective_norm,
            scraper_type_norm,
            record_role,
            COUNT(*) AS rows_total
        FROM vw_excel_positions_bandcode_clean
        WHERE scraper_family IS NULL
           OR scraper_family = ''
        GROUP BY
            lijn_code,
            scraper_type_effective_norm,
            scraper_type_norm,
            record_role
        ORDER BY COUNT(*) DESC
    """, limit=limit)

    # 5. Lege scraper_role per lijn/type
    scraper_role_empty = fetch_limited_rows("""
        SELECT
            lijn_code,
            scraper_type_effective_norm,
            scraper_type_norm,
            record_role,
            COUNT(*) AS rows_total
        FROM vw_excel_positions_bandcode_clean
        WHERE scraper_role IS NULL
           OR scraper_role = ''
        GROUP BY
            lijn_code,
            scraper_type_effective_norm,
            scraper_type_norm,
            record_role
        ORDER BY COUNT(*) DESC
    """, limit=limit)

    # 6. Bestaande mappingdekking
    mapping_coverage = fetch_limited_rows("""
        SELECT
            p.lijn_code,
            COUNT(*) AS source_rows,
            COUNT(m.band_code) AS mapped_rows,
            COUNT(*) - COUNT(m.band_code) AS unmapped_rows,
            ROUND(
                CASE
                    WHEN COUNT(*) = 0 THEN 0
                    ELSE COUNT(m.band_code)::numeric / COUNT(*)::numeric
                END,
                4
            ) AS mapping_ratio
        FROM sb_excel_positions_v1 p
        LEFT JOIN band_locatie_mapping m
          ON m.lijn_code = p.lijn_code
         AND m.raw_locatie = p.locatie_effective
        GROUP BY p.lijn_code
        ORDER BY unmapped_rows DESC
    """, limit=limit)

    asset_issue_classification = {
        "unknown_band_mapping": [
            {
                "row": row,
                "classification": classify_asset_issue("unknown_band_mapping", row),
            }
            for row in mapping_candidates[:limit]
        ],
        "scraper_family_empty": [
            {
                "row": row,
                "classification": classify_asset_issue("scraper_family_empty", row),
            }
            for row in scraper_family_empty[:limit]
        ],
        "scraper_role_empty": [
            {
                "row": row,
                "classification": classify_asset_issue("scraper_role_empty", row),
            }
            for row in scraper_role_empty[:limit]
        ],
    }

    classification_counts = {}

    for group_name, items in asset_issue_classification.items():
        for item in items:
            cls = (item.get("classification") or {}).get("classification") or "unknown"
            classification_counts[cls] = classification_counts.get(cls, 0) + 1

    recommended_asset_actions = build_recommended_asset_actions(
        asset_issue_classification=asset_issue_classification,
        limit=limit,
    )

    recommended_asset_actions_compact = compact_recommended_asset_actions(
        recommended_asset_actions=recommended_asset_actions,
    )

    scraper_type_mapping_candidates = [
        action.get("mapping_candidate")
        for action in recommended_asset_actions.get("scraper_type_mapping_actions", [])
        if action.get("mapping_candidate")
    ]

    scraper_type_mapping_columns = get_object_columns(
        schema_name="public",
        object_name="scraper_type_mapping",
    )

    existing_scraper_type_mappings = fetch_existing_scraper_type_mappings([
        candidate.get("type_norm")
        for candidate in scraper_type_mapping_candidates
        if candidate.get("type_norm")
    ])

    scraper_type_mapping_sql_preview = build_scraper_type_mapping_sql_previews(
        scraper_type_mapping_candidates=scraper_type_mapping_candidates,
        table_columns=scraper_type_mapping_columns,
        existing_mappings=existing_scraper_type_mappings,
    )

    parser_source_diagnostics = build_parser_source_diagnostics(
        parser_actions=recommended_asset_actions.get("parser_actions", []),
        limit=limit,
    )

    parser_source_diagnostics_compact = compact_parser_source_diagnostics(
        parser_source_diagnostics=parser_source_diagnostics,
        line_limit=3,
        source_limit=3,
    )

    parser_row_context = build_parser_row_context(
        parser_source_diagnostics=parser_source_diagnostics_compact,
        line_limit=3,
        source_limit=3,
        row_limit=5,
    )

    parser_root_cause = build_parser_root_cause(
        parser_row_context=parser_row_context,
    )

    # Compacte GPT-diagnose
    top_unknown = unknown_by_line[0] if unknown_by_line else None
    top_candidate = mapping_candidates[0] if mapping_candidates else None

    gpt_diagnosis = {
        "headline": "Assetmodel-health analyseert vooral ONBEKEND, ontbrekende bandmapping en lege scraper-classificaties.",
        "main_risk": None,
        "top_unknown_by_line": unknown_by_line[:10],
        "top_mapping_candidates": mapping_candidates[:10],
        "scraper_family_empty_top": scraper_family_empty[:10],
        "scraper_role_empty_top": scraper_role_empty[:10],
        "classification_counts": classification_counts,
        "recommended_asset_actions_summary": recommended_asset_actions.get("summary"),
        "parser_source_diagnostics_summary": parser_source_diagnostics.get("summary"),
        "parser_row_context_summary": parser_row_context.get("summary"),
        "parser_root_cause_summary": parser_root_cause.get("summary"),
        "interpretation": [],
        "recommended_actions": [],
    }

    if top_unknown:
        gpt_diagnosis["main_risk"] = {
            "type": "unknown_band_mapping_or_non_position_noise",
            "lijn_code": top_unknown.get("lijn_code"),
            "rows_total": top_unknown.get("rows_total"),
        }

        if classification_counts.get("parser_location_gap"):
            gpt_diagnosis["interpretation"].append(
                f"De grootste assetmodel-verbetering zit waarschijnlijk bij lijn {top_unknown.get('lijn_code')}, "
                f"waar {top_unknown.get('rows_total')} regels naar ONBEKEND normaliseren."
            )
        else:
            gpt_diagnosis["interpretation"].append(
                "De grootste ONBEKEND-groepen lijken momenteel vooral niet-positionele header/config/commentaarregels. "
                "Er zijn geen parser_location_gap acties actief."
            )

    top_candidate_item = (
        asset_issue_classification.get("unknown_band_mapping", [None])[0]
        if asset_issue_classification.get("unknown_band_mapping")
        else None
    )

    top_candidate_classification = (
        (top_candidate_item or {}).get("classification") or {}
    )

    if top_candidate:
        top_class = top_candidate_classification.get("classification")

        if top_class == "parser_location_gap":
            gpt_diagnosis["recommended_actions"].append(
                f"Controleer parser/location-inheritance voor {top_candidate.get('lijn_code')} / ONBEKEND "
