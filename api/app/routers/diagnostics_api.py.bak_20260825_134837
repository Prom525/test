def analyze_view_health(payload: DiagnosticsAnalyzeRequest) -> DiagnosticsAnalyzeResponse:
    if payload.depth == "deep":
        return analyze_view_chain_health(payload)

    schema_name = get_filter_str(payload, "schema", "public")
    object_name = (
        get_filter_str(payload, "view_name")
        or get_filter_str(payload, "object_name")
        or (payload.objects[0] if payload.objects else None)
    )

    if not object_name:
        return DiagnosticsAnalyzeResponse(
            status="error",
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary={"message": "Geen view_name/object_name opgegeven."},
            findings=[{
                "severity": "high",
                "issue": "Missing object name",
                "recommended_filter": {
                    "schema": "public",
                    "view_name": "vw_mes_lifecycle_cycles_clean"
                },
            }],
            evidence={
                "requested_filters": payload.filters,
                "requested_objects": payload.objects,
            },
            recommended_actions=[
                "Geef filters.view_name mee of zet de viewnaam in objects[0]."
            ],
            limitations=[],
            write_actions_available=False,
        )

    object_info = fetch_one("""
        SELECT
            table_schema,
            table_name,
            table_type
        FROM information_schema.tables
        WHERE table_schema = :schema_name
          AND table_name = :object_name
    """, {
        "schema_name": schema_name,
        "object_name": object_name,
    })

    if not object_info:
        return DiagnosticsAnalyzeResponse(
            status="not_found",
            domain=payload.domain,
            topic=payload.topic,
            mode=payload.mode,
            summary={
                "schema": schema_name,
                "object_name": object_name,
                "found": False,
            },
            findings=[{
                "severity": "medium",
                "issue": "Object niet gevonden in information_schema.tables.",
                "schema": schema_name,
                "object_name": object_name,
            }],
            evidence={},
            recommended_actions=[
                "Controleer de naam via /diagnostics/database/views of /diagnostics/database/tables."
            ],
            limitations=[],
            write_actions_available=False,
        )

    columns = get_object_columns(schema_name, object_name)
    column_names = [c.get("column_name") for c in columns]

    # Objectnaam komt uit vaste diagnostics input, schema/object bestaan al.
    quoted_object = f'"{schema_name}"."{object_name}"'

    row_count = fetch_one(f"""
        SELECT COUNT(*)::int AS row_count
        FROM {quoted_object}
    """) or {}

    summary = {
        "schema": schema_name,
        "object_name": object_name,
        "object_type": object_info.get("table_type"),
        "row_count": row_count.get("row_count", 0),
        "columns_count": len(columns),
        "columns": column_names,
    }

    metrics = {}

    # Datumkolommen
    for date_col in ["inspected_on", "inspection_date", "created_at"]:
        if has_column(columns, date_col):
            metrics[f"{date_col}_range"] = fetch_one(f"""
                SELECT
                    MIN("{date_col}")::text AS min_value,
                    MAX("{date_col}")::text AS max_value,
                    COUNT(*) FILTER (WHERE "{date_col}" IS NULL)::int AS null_count
                FROM {quoted_object}
            """)

    # Veelvoorkomende dimensies
    dimension_columns = [
        "lijn_code",
        "locatie",
        "band_code",
        "band_norm",
        "band_station",
        "scraper_family",
        "scraper_type_norm",
        "scraper_role",
        "physical_position_label_final",
        "physical_position_source",
    ]

    for col in dimension_columns:
        if has_column(columns, col):
            metrics[f"{col}_quality"] = fetch_one(f"""
                SELECT
                    COUNT(DISTINCT "{col}")::int AS distinct_count,
                    COUNT(*) FILTER (
                        WHERE "{col}" IS NULL OR TRIM("{col}"::text) = ''
                    )::int AS empty_count
                FROM {quoted_object}
            """)

    # Meshoogte specifiek
    if has_column(columns, "meshoogte_mm"):
        metrics["meshoogte_mm_quality"] = fetch_one(f"""
            SELECT
                COUNT(*) FILTER (WHERE meshoogte_mm IS NOT NULL)::int AS filled_count,
                COUNT(*) FILTER (WHERE meshoogte_mm IS NULL)::int AS null_count,
                MIN(meshoogte_mm)::numeric AS min_value,
                MAX(meshoogte_mm)::numeric AS max_value,
                AVG(meshoogte_mm)::numeric(10,2) AS avg_value
            FROM {quoted_object}
        """)

    # Vervanging / cycle specifiek
    if has_column(columns, "replace_event"):
        metrics["replace_event_quality"] = fetch_one(f"""
            SELECT
                COUNT(*) FILTER (WHERE replace_event IS TRUE)::int AS true_count,
                COUNT(*) FILTER (WHERE replace_event IS FALSE)::int AS false_count,
                COUNT(*) FILTER (WHERE replace_event IS NULL)::int AS null_count
            FROM {quoted_object}
        """)

    if has_column(columns, "cycle_id"):
        metrics["cycle_id_quality"] = fetch_one(f"""
            SELECT
                COUNT(DISTINCT cycle_id)::int AS distinct_count,
                COUNT(*) FILTER (WHERE cycle_id IS NULL)::int AS null_count
            FROM {quoted_object}
        """)

    findings = []

    if summary["row_count"] == 0:
        findings.append({
            "severity": "high",
            "issue": "View/tabel bevat geen rijen.",
            "likely_meaning": "Object bestaat, maar levert geen data op.",
        })

    # Algemene waarschuwingen op basis van bekende kolommen
    for key, value in metrics.items():
        if not isinstance(value, dict):
            continue

        empty_count = value.get("empty_count")
        null_count = value.get("null_count")

        if empty_count and summary["row_count"] > 0:
            ratio = empty_count / summary["row_count"]
            if ratio > 0.5:
                findings.append({
                    "severity": "medium",
                    "issue": f"Veel lege waarden in {key}.",
                    "empty_count": empty_count,
                    "row_count": summary["row_count"],
                    "empty_ratio": round(ratio, 3),
                })

        if key == "meshoogte_mm_quality":
            filled = value.get("filled_count", 0)
            if summary["row_count"] > 0 and filled == 0:
                findings.append({
                    "severity": "high",
                    "issue": "Geen enkele meshoogte gevuld.",
                    "column": "meshoogte_mm",
                })

    return DiagnosticsAnalyzeResponse(
        status="ok" if not findings else "warning",
        domain=payload.domain,
        topic=payload.topic,
        mode=payload.mode,
        summary=summary,
        findings=findings,
        evidence={
            "object": object_info,
            "columns": columns,
            "metrics": metrics,
        },
        recommended_actions=[
            "Vergelijk view_health tussen opeenvolgende views uit de dependency-keten.",
            "Let vooral op sterke daling in row_count of plots veel lege band/schraper/meshoogte-velden.",
            "Gebruik view_definition op de view waar de afwijking begint.",
        ],
        limitations=[
            "Deze analyse gebruikt generieke kolomchecks; domeinlogica zoals actief/historisch volgt later in asset_model_health.",
            "Deze analyse voert geen writes uit.",
        ],
        write_actions_available=False,
    )

def parse_scraper_type_code(scraper_type: str | None) -> dict | None:
    """
    Parseert echte schrapertypecodes.
    Read-only interpretatie voor diagnostics.

    Domeinregel:
    I = INOX / RVS
    H = H-schraper
    """

    text_value = str(scraper_type or "").strip().upper()

    if not text_value:
        return None

    # Voorbeelden:
    # HI 1200-1000 VB
    # HI 1200-1000 SP/M3
    match = re.match(
        r"^(?P<prefix>HI)\s+(?P<frame>\d{3,4})[-/](?P<blade>\d{3,4})(?:\s+(?P<variant>.+))?$",
        text_value,
    )

    if match:
        return {
            "raw_type": scraper_type,
            "type_prefix": match.group("prefix"),
            "scraper_family": "H",
            "material": "INOX",
            "frame_width_mm": int(match.group("frame")),
            "blade_width_mm": int(match.group("blade")),
            "variant": (match.group("variant") or "").strip() or None,
            "confidence": "high",
            "reason": "HI-code: H-schraper, I = INOX.",
        }

    # Voorbeeld:
    # TPHI 1200/1050 HD
    match = re.match(
        r"^(?P<prefix>TPHI)\s+(?P<frame>\d{3,4})[-/](?P<blade>\d{3,4})\s+(?P<variant>.+)$",
        text_value,
    )

    if match:
        return {
            "raw_type": scraper_type,
            "type_prefix": match.group("prefix"),
            "scraper_family": "TPH",
            "material": "INOX",
            "frame_width_mm": int(match.group("frame")),
            "blade_width_mm": int(match.group("blade")),
            "variant": match.group("variant").strip(),
            "position_context": "TUSSENPART",
            "confidence": "high",
            "reason": "TPHI-code: TPH-family, I = INOX, met tussenpart/context.",
        }

    # Voorbeeld:
    # RVI 1400/1200 VB
    match = re.match(
        r"^(?P<prefix>RVI)\s+(?P<frame>\d{3,4})[-/](?P<blade>\d{3,4})\s+(?P<variant>.+)$",
        text_value,
    )

    if match:
        return {
            "raw_type": scraper_type,
            "type_prefix": match.group("prefix"),
            "scraper_family": "RV",
            "material": "INOX",
            "frame_width_mm": int(match.group("frame")),
            "blade_width_mm": int(match.group("blade")),
            "variant": match.group("variant").strip(),
            "confidence": "high",
            "reason": "RVI-code: RV-family, I = INOX.",
        }

    return None

def build_scraper_type_mapping_candidate(scraper_type: str | None) -> dict | None:
    """
    Bouwt een read-only kandidaatregel voor scraper_type_mapping.
    Schrijft niets weg.

    Doel:
    - veilige SQL/JSON-kandidaat maken
    - alleen voor echte schrapertypecodes
    - geen onderhoudsnotities, locatie/context-termen of beschermkappen
    """

    parsed = parse_scraper_type_code(scraper_type)

    if not parsed:
        return None

    family = parsed.get("scraper_family")

    return {
        "raw_type": parsed.get("raw_type"),
        "type_norm": str(parsed.get("raw_type") or "").strip().upper(),
        "scraper_family": family,
        "material": parsed.get("material"),
        "frame_width_mm": parsed.get("frame_width_mm"),
        "blade_width_mm": parsed.get("blade_width_mm"),
        "variant": parsed.get("variant"),
        "position_context": parsed.get("position_context"),
        "confidence": parsed.get("confidence"),
        "needs_human_confirmation": family is None,
        "candidate_status": "needs_family_confirmation" if family is None else "ready_for_review",
        "reason": parsed.get("reason"),
    }

def fetch_existing_scraper_type_mappings(type_norms: list[str]) -> dict:
    """
    Haalt bestaande scraper_type_mapping regels op voor kandidaat raw types.
    Read-only.
    """

    cleaned = [
        str(value).strip().upper()
        for value in (type_norms or [])
        if value
    ]

    if not cleaned:
        return {}

    rows = fetch_all("""
        SELECT
            raw_scraper_type,
            scraper_type_clean,
            scraper_family_clean,
            materiaal_clean,
            features_clean,
            mapping_source,
            created_at,
            updated_at
        FROM scraper_type_mapping
        WHERE UPPER(TRIM(raw_scraper_type)) = ANY(:type_norms)
    """, {
        "type_norms": cleaned,
    }) or []

    return {
        str(row.get("raw_scraper_type") or "").strip().upper(): row
        for row in rows
    }

def sql_literal(value) -> str:
    """
    Maakt een veilige SQL-literal voor previewtekst.
    Alleen bedoeld voor read-only preview, niet voor directe uitvoering.
    """

    if value is None:
        return "NULL"

    if isinstance(value, bool):
        return "TRUE" if value else "FALSE"

    if isinstance(value, (int, float)):
        return str(value)

    text_value = str(value).replace("'", "''")
    return f"'{text_value}'"


def pick_first_column(existing_columns: set[str], candidates: list[str]) -> str | None:
    for column in candidates:
        if column in existing_columns:
            return column
    return None

def build_scraper_type_mapping_sql_previews(
    scraper_type_mapping_candidates: list[dict],
    table_columns: list[dict],
    existing_mappings: dict | None = None,
) -> dict:
    """
    Bouwt read-only SQL-previewregels voor scraper_type_mapping.
    Voert niets uit.
    """

    existing_columns = {
        row.get("column_name")
        for row in (table_columns or [])
        if row.get("column_name")
    }

    type_column = pick_first_column(
        existing_columns,
        [
            "raw_scraper_type",
            "scraper_type_norm",
            "scraper_type",
            "type_norm",
            "raw_type",
        ],
    )

    clean_type_column = pick_first_column(
        existing_columns,
        [
            "scraper_type_clean",
            "type_clean",
        ],
    )

    family_column = pick_first_column(
        existing_columns,
        [
            "scraper_family_clean",
            "scraper_family",
            "family",
        ],
    )

    material_column = pick_first_column(
        existing_columns,
        [
            "materiaal_clean",
            "material_clean",
            "material",
            "materiaal",
        ],
    )

    features_column = pick_first_column(
        existing_columns,
        [
            "features_clean",
            "features",
        ],
    )

    mapping_source_column = pick_first_column(
        existing_columns,
        [
            "mapping_source",
            "source",
        ],
    )

    if not type_column or not family_column:
        return {
            "status": "blocked_schema_unknown",
            "reason": (
                "Kan geen veilige SQL-preview maken: type- of family-kolom niet gevonden "
                "in scraper_type_mapping."
            ),
            "table_columns": sorted(existing_columns),
            "previews": [],
        }

    previews = []
    review_required = []
    already_exists_ok = []

    for candidate in scraper_type_mapping_candidates or []:
        if candidate.get("candidate_status") != "ready_for_review":
            continue

        if candidate.get("needs_human_confirmation"):
            continue

        if not candidate.get("scraper_family"):
            continue

        existing = (existing_mappings or {}).get(
            str(candidate.get("type_norm") or "").strip().upper()
        )

        if existing:
            existing_family = str(existing.get("scraper_family_clean") or "").strip().upper()
            existing_material = str(existing.get("materiaal_clean") or "").strip().upper()
            candidate_family = str(candidate.get("scraper_family") or "").strip().upper()
            candidate_material = str(candidate.get("material") or "").strip().upper()

            family_matches = existing_family == candidate_family
            material_matches = (
                not candidate_material
                or existing_material == candidate_material
            )

            existing_status = "already_exists_ok" if family_matches and material_matches else "already_exists_review_required"

            item = {
                "type_norm": candidate.get("type_norm"),
                "status": existing_status,
                "existing_mapping": existing,
                "candidate": candidate,
                "differences": {
                    "family": {
                        "existing": existing.get("scraper_family_clean"),
                        "candidate": candidate.get("scraper_family"),
                        "matches": family_matches,
                    },
                    "material": {
                        "existing": existing.get("materiaal_clean"),
                        "candidate": candidate.get("material"),
                        "matches": material_matches,
                    },
                },
            }

            if existing_status == "already_exists_ok":
                already_exists_ok.append(item)
            else:
                review_required.append(item)

            continue

        features = []

        if candidate.get("frame_width_mm"):
            features.append(f"FRAME {candidate.get('frame_width_mm')}")

        if candidate.get("blade_width_mm"):
            features.append(f"BLADE {candidate.get('blade_width_mm')}")

        if candidate.get("variant"):
            features.append(str(candidate.get("variant")))

        if candidate.get("position_context"):
            features.append(str(candidate.get("position_context")))

        features_clean = features if features else None

        columns = [type_column, family_column]
        values = [
            candidate.get("type_norm"),
            candidate.get("scraper_family"),
        ]

        if clean_type_column:
            columns.append(clean_type_column)
            values.append(candidate.get("type_norm"))

        if material_column:
            columns.append(material_column)
            values.append(candidate.get("material"))

        if features_column:
            columns.append(features_column)
            values.append(features_clean)

        if mapping_source_column:
            columns.append(mapping_source_column)
            values.append("diagnostics_scraper_type_candidate")

        column_sql = ", ".join(columns)

        rendered_values = []
        for column, value in zip(columns, values):
            if column == features_column:
                rendered_values.append(sql_array_literal(value))
            else:
                rendered_values.append(sql_literal(value))

        value_sql = ", ".join(rendered_values)

        sql = (
            f"INSERT INTO scraper_type_mapping ({column_sql})\n"
            f"SELECT {value_sql}\n"
            f"WHERE NOT EXISTS (\n"
            f"    SELECT 1\n"
            f"    FROM scraper_type_mapping\n"
            f"    WHERE {type_column} = {sql_literal(candidate.get('type_norm'))}\n"
            f");"
        )

        previews.append({
            "type_norm": candidate.get("type_norm"),
            "candidate_status": candidate.get("candidate_status"),
            "sql": sql,
            "candidate": candidate,
        })

    ready_to_apply_sql = "\n\n".join(
        preview.get("sql")
        for preview in previews
        if preview.get("sql")
    )

    return {
        "status": "ok",
        "type_column": type_column,
        "family_column": family_column,
        "table_columns_used": sorted([
            column for column in [
                type_column,
                clean_type_column,
                family_column,
                material_column,
                features_column,
                mapping_source_column,
            ]
            if column
        ]),
        "previews_count": len(previews),
        "previews": previews,
        "ready_to_apply_sql": ready_to_apply_sql,
        "already_exists_ok_count": len(already_exists_ok),
        "review_required_count": len(review_required),
        "already_exists_ok": already_exists_ok,
        "review_required": review_required,
        "ready_to_apply_sql_count": len(previews),
        "execution_mode": "manual_review_only",
        "write_actions_available": False,
    }


def classify_asset_issue(issue_type: str, row: dict) -> dict:
    """
    Classificeert assetmodel-issues en geeft routeadvies.
    Read-only advies; voert niets uit.
    """

    classification = {
        "issue_type": issue_type,
        "classification": "unknown",
        "severity": "medium",
        "reason": None,
        "recommended_route": None,
        "recommended_action": None,
        "write_target_candidate": None,
    }

    if issue_type == "unknown_band_mapping":
        raw_locatie = row.get("raw_locatie")
        band_locatie_norm = row.get("band_locatie_norm")
        lijn_code = row.get("lijn_code")
        record_role = row.get("record_role")

        non_position_roles = {
            "HEADER",
            "SUB_CONFIG",
            "CONFIG",
            "BAND_HEADER",
            "COMMENT_ONLY",
        }

        position_like_roles = {
            "POSITION",
            "SUB_POSITION",
        }

        if raw_locatie == "ONBEKEND" or band_locatie_norm == "ONBEKEND":
            if record_role in non_position_roles:
                classification.update({
                    "classification": "non_position_unknown_noise",
                    "severity": "low",
                    "reason": (
                        f"Record_role {record_role} met locatie ONBEKEND is waarschijnlijk "
                        "header/config/commentaar en geen echte inspecteerbare assetpositie."
                    ),
                    "recommended_route": "filter_from_asset_mapping_diagnosis",
                    "recommended_action": (
                        "Geen bandmapping maken. Deze ONBEKEND-regel hoort waarschijnlijk niet "
                        "als assetmapping-probleem of parser-location gap mee te tellen."
                    ),
                    "write_target_candidate": None,
                })
                return classification

            if record_role in position_like_roles or record_role is None:
                classification.update({
                    "classification": "parser_location_gap",
                    "severity": "high",
                    "reason": (
                        "De ruwe locatie is ONBEKEND bij een positieachtige regel; dit wijst eerder "
                        "op ontbrekende locatie-overname/parsercontext dan op een simpele mappingregel."
                    ),
                    "recommended_route": "inspect_excel_block_context",
                    "recommended_action": (
                        f"Controleer voor lijn {lijn_code} de bronbestanden en bloklocatie-overname. "
                        "Voeg niet blind 'ONBEKEND' toe aan band_locatie_mapping."
                    ),
                    "write_target_candidate": "parser/location inheritance logic",
                })
                return classification

            classification.update({
                "classification": "parser_or_record_role_unclear",
                "severity": "medium",
                "reason": (
                    f"Locatie is ONBEKEND bij record_role {record_role}; deze rol is niet duidelijk "
                    "als positie of niet-positie geclassificeerd."
                ),
                "recommended_route": "inspect_record_role",
                "recommended_action": (
                    f"Controleer of record_role '{record_role}' voor lijn {lijn_code} "
                    "als assetpositie moet meetellen."
                ),
                "write_target_candidate": None,
            })
            return classification

        if raw_locatie and raw_locatie not in ("ONBEKEND", "", None):
            classification.update({
                "classification": "mapping_action_required",
                "severity": "medium",
                "reason": "Er is een concrete ruwe locatie die niet goed naar een bandcode normaliseert.",
                "recommended_route": "review_band_locatie_mapping",
                "recommended_action": (
                    f"Controleer of {lijn_code} / {raw_locatie} een echte bandpositie is. "
                    "Zo ja: kandidaat voor band_locatie_mapping."
                ),
                "write_target_candidate": "band_locatie_mapping",
            })
            return classification

    if issue_type == "scraper_family_empty":
        scraper_type = row.get("scraper_type_effective_norm") or row.get("scraper_type_norm")
        lijn_code = row.get("lijn_code")
        scraper_type_text = str(scraper_type or "").strip().upper()

        # Voorbeelden:
        # "8X H 200" = onderhoudsnotitie: 8 messen vervangen voor H-schraper, 200 mm.
        if re.match(r"^(?:[A-Z]{2,5}\s+)?\d+\s*X\s+H\s+\d+", scraper_type_text):
            classification.update({
                "classification": "maintenance_note_misclassified_as_type",
                "severity": "low",
                "reason": (
                    "Dit lijkt geen scraper_type maar een onderhoudsnotitie: aantal messen, "
                    "H-schraper en mesmaat."
                ),
                "recommended_route": "review_parser_maintenance_note_detection",
                "recommended_action": (
                    f"Behandel '{scraper_type}' op lijn {lijn_code} niet als scraper_type_mapping. "
                    "Parse dit later als onderhouds-/vervangingsnotitie."
                ),
                "write_target_candidate": "parser/maintenance note logic",
            })
            return classification

        # TUSSENPARTSCHRAPER / TUSSEPARTSCHRAPER = locatie/context, geen schrapertype.
        if scraper_type_text in ("TUSSENPARTSCHRAPER", "TUSSEPARTSCHRAPER"):
            classification.update({
                "classification": "location_term_misclassified_as_type",
                "severity": "low",
                "reason": (
                    "Deze waarde is een locatie- of contextaanduiding, geen scraper_type."
                ),
                "recommended_route": "review_location_or_context_detection",
                "recommended_action": (
                    f"Behandel '{scraper_type}' op lijn {lijn_code} als locatie/context-term, "
                    "niet als scraper_type_mapping."
                ),
                "write_target_candidate": "parser/location-context logic",
            })
            return classification

        # SAFE-GUARD = beschermkap / bandschadepreventie, geen klassieke bandschraper.
        if scraper_type_text.startswith("SAFE-GUARD") or scraper_type_text.startswith("SAFE GUARD"):
            classification.update({
                "classification": "protection_component_not_scraper",
                "severity": "low",
                "reason": (
                    "SAFE-GUARD is een beschermkap/bandschadepreventiecomponent en geen klassieke scraper."
                ),
                "recommended_route": "review_component_classification",
                "recommended_action": (
                    f"Behandel '{scraper_type}' op lijn {lijn_code} als protection/guard component. "
                    "Niet als standaard scraper_family."
                ),
                "write_target_candidate": "component classification / parser logic",
            })
            return classification

        # ROLLAX = stuurrol, geen schraper.
        if scraper_type_text == "ROLLAX":
            classification.update({
                "classification": "roller_component_not_scraper",
                "severity": "low",
                "reason": (
                    "ROLLAX is een stuurrol/rolcomponent en geen bandschraper."
                ),
                "recommended_route": "review_component_classification",
                "recommended_action": (
                    f"Behandel '{scraper_type}' op lijn {lijn_code} als stuurrol/component. "
                    "Niet als scraper_type_mapping."
                ),
                "write_target_candidate": "component classification / parser logic",
            })
            return classification

        # NVT = niet van toepassing, geen schrapertype.
        if scraper_type_text in ("NVT", "N.V.T.", "NIET VAN TOEPASSING"):
            classification.update({
                "classification": "not_applicable_not_scraper",
                "severity": "low",
                "reason": (
                    "NVT betekent niet van toepassing en is geen bandschraper-type."
                ),
                "recommended_route": "review_parser_not_applicable_detection",
                "recommended_action": (
                    f"Behandel '{scraper_type}' op lijn {lijn_code} als niet-van-toepassing. "
                    "Niet als scraper_type_mapping."
                ),
                "write_target_candidate": "parser/not-applicable classification",
            })
            return classification

        # DUO-SEAL = bandafdichting bij stortpunt, geen schraper.
        if scraper_type_text in ("DUO-SEAL", "DUO SEAL"):
            classification.update({
                "classification": "sealing_component_not_scraper",
                "severity": "low",
                "reason": (
                    "DUO-SEAL is een bandafdichting/sealing component bij een stortpunt en geen bandschraper."
                ),
                "recommended_route": "review_component_classification",
                "recommended_action": (
                    f"Behandel '{scraper_type}' op lijn {lijn_code} als bandafdichting/stortpuntcomponent. "
                    "Niet als scraper_type_mapping."
                ),
                "write_target_candidate": "component classification / parser logic",
            })
            return classification

        # HI 1200-1000 VB / HI 1200-1200 VB = INOX H-schraper.
        parsed_type = parse_scraper_type_code(scraper_type)

        mapping_candidate = build_scraper_type_mapping_candidate(scraper_type)

        if parsed_type:
            classification.update({
                "classification": "scraper_type_mapping_gap",
                "severity": "medium",
                "reason": parsed_type.get("reason"),
                "recommended_route": "review_scraper_type_mapping",
                "recommended_action": (
                    f"Controleer scraper_type_mapping voor type '{scraper_type}' op lijn {lijn_code}. "
                    f"Voorstel: family={parsed_type.get('scraper_family')}, "
                    f"material={parsed_type.get('material')}, "
                    f"frame={parsed_type.get('frame_width_mm')} mm, "
                    f"blade={parsed_type.get('blade_width_mm')} mm, "
                    f"variant={parsed_type.get('variant')}."
                ),
                "write_target_candidate": "scraper_type_mapping",
                "parsed_type": parsed_type,
                "mapping_candidate": mapping_candidate,
            })
            return classification

        if scraper_type:
            classification.update({
                "classification": "scraper_type_mapping_gap",
                "severity": "medium",
                "reason": "Er is een scraper_type aanwezig, maar scraper_family blijft leeg.",
                "recommended_route": "review_scraper_type_mapping",
                "recommended_action": (
                    f"Controleer scraper_type_mapping voor type '{scraper_type}' op lijn {lijn_code}. "
                    "Voeg normalisatie/familie toe als dit een echte scraper is."
                ),
                "write_target_candidate": "scraper_type_mapping",
            })
            return classification

        record_role = row.get("record_role")

        if record_role in ("COMMENT_ONLY", "BAND_HEADER", "SUB_CONFIG", "HEADER", "CONFIG", "EMPTY"):
            classification.update({
                "classification": "expected_non_position_without_scraper_type",
                "severity": "low",
                "reason": (
                    f"Record_role {record_role} heeft geen scraper_type, maar lijkt geen inspecteerbare scraperpositie."
                ),
                "recommended_route": "no_action_or_low_priority",
                "recommended_action": (
                    "Geen scraper_type_mapping maken. Deze regel hoort waarschijnlijk buiten scraper-family diagnose."
                ),
                "write_target_candidate": None,
            })
            return classification

        classification.update({
            "classification": "parser_scraper_type_gap",
            "severity": "medium",
            "reason": "Zowel scraper_family als scraper_type ontbreken bij een mogelijk positieachtige regel.",
            "recommended_route": "inspect_parser_extraction",
            "recommended_action": "Controleer of de Excel-regel een echte positie is of alleen commentaar/config.",
            "write_target_candidate": "parser/extraction logic",
        })
        return classification

    if issue_type == "scraper_role_empty":
        record_role = row.get("record_role")
        scraper_type = row.get("scraper_type_effective_norm") or row.get("scraper_type_norm")

        if record_role in ("COMMENT_ONLY", "BAND_HEADER", "SUB_CONFIG", "HEADER", "CONFIG"):
            classification.update({
                "classification": "expected_non_position_record",
                "severity": "low",
                "reason": f"Record_role {record_role} is waarschijnlijk geen echte inspecteerbare scraperpositie.",
                "recommended_route": "no_action_or_low_priority",
                "recommended_action": "Geen directe actie nodig, tenzij deze records later toch als positie bedoeld zijn.",
                "write_target_candidate": None,
            })
            return classification

        if scraper_type:
            classification.update({
                "classification": "role_inference_gap",
                "severity": "medium",
                "reason": "Er is een scraper_type aanwezig, maar scraper_role ontbreekt.",
                "recommended_route": "review_role_inference",
                "recommended_action": (
                    f"Controleer rol-inferentie voor scraper_type '{scraper_type}' "
                    f"en record_role '{record_role}'."
                ),
                "write_target_candidate": "load_sb_excel_positions_v5.py / role inference",
            })
            return classification

        classification.update({
            "classification": "parser_or_non_position_unclear",
            "severity": "low",
            "reason": "Scraper_role ontbreekt, maar er is ook geen scraper_type zichtbaar.",
            "recommended_route": "inspect_record_role",
            "recommended_action": "Controleer of dit record überhaupt als inspecteerbare positie moet meetellen.",
            "write_target_candidate": None,
        })
        return classification

    return classification

def build_recommended_asset_actions(asset_issue_classification: dict, limit: int = 10) -> dict:
    """
    Bouwt concrete, compacte route-acties uit asset_issue_classification.
    Read-only: geeft alleen advies, voert niets uit.
    """

    safe_limit = max(1, min(int(limit or 10), 50))

    actions = {
        "parser_actions": [],
        "scraper_type_mapping_actions": [],
        "mapping_actions_safe_only": [],
        "no_action_low_priority": [],
        "summary": {
            "parser_actions": 0,
            "scraper_type_mapping_actions": 0,
            "mapping_actions_safe_only": 0,
            "no_action_low_priority": 0,
        },
    }

    for group_name, items in (asset_issue_classification or {}).items():
        for item in items:
            row = item.get("row") or {}
            cls = item.get("classification") or {}

            classification = cls.get("classification")
            severity = cls.get("severity")
            recommended_route = cls.get("recommended_route")
            recommended_action = cls.get("recommended_action")
            write_target_candidate = cls.get("write_target_candidate")

            if classification == "parser_location_gap":
                actions["parser_actions"].append({
                    "priority": "high",
                    "classification": classification,
                    "lijn_code": row.get("lijn_code"),
                    "raw_locatie": row.get("raw_locatie"),
                    "band_locatie_norm": row.get("band_locatie_norm"),
                    "rows_total": row.get("rows_total"),
                    "example_source_file": row.get("example_source_file"),
                    "example_sheet": row.get("example_sheet"),
                    "recommended_route": recommended_route,
                    "recommended_action": recommended_action,
                    "write_target_candidate": write_target_candidate,
                })

            elif classification == "scraper_type_mapping_gap":
                scraper_type = (
                    row.get("scraper_type_effective_norm")
                    or row.get("scraper_type_norm")
                )

                actions["scraper_type_mapping_actions"].append({
                    "priority": "medium",
                    "classification": classification,
                    "lijn_code": row.get("lijn_code"),
                    "scraper_type": scraper_type,
                    "rows_total": row.get("rows_total"),
                    "recommended_route": recommended_route,
                    "recommended_action": recommended_action,
                    "write_target_candidate": write_target_candidate,
                    "parsed_type": cls.get("parsed_type"),
                    "mapping_candidate": cls.get("mapping_candidate"),
                })

            elif classification == "mapping_action_required":
                raw_locatie = row.get("raw_locatie")

                # Veiligheidsregel: ONBEKEND nooit als mappingactie voorstellen.
                if raw_locatie and raw_locatie != "ONBEKEND":
                    actions["mapping_actions_safe_only"].append({
                        "priority": "medium",
                        "classification": classification,
                        "lijn_code": row.get("lijn_code"),
                        "raw_locatie": raw_locatie,
                        "band_locatie_norm": row.get("band_locatie_norm"),
                        "rows_total": row.get("rows_total"),
                        "recommended_route": recommended_route,
                        "recommended_action": recommended_action,
                        "write_target_candidate": write_target_candidate,
                    })

            elif classification in (
                "expected_non_position_record",
                "non_position_unknown_noise",
                "maintenance_note_misclassified_as_type",
                "location_term_misclassified_as_type",
                "protection_component_not_scraper",
                "roller_component_not_scraper",
                "not_applicable_not_scraper",
                "expected_non_position_without_scraper_type",
                "sealing_component_not_scraper",
            ):
                actions["no_action_low_priority"].append({
                    "priority": "low",
                    "classification": classification,
                    "lijn_code": row.get("lijn_code"),
                    "record_role": row.get("record_role"),
                    "raw_locatie": row.get("raw_locatie"),
                    "band_locatie_norm": row.get("band_locatie_norm"),
                    "rows_total": row.get("rows_total"),
                    "recommended_route": recommended_route,
                    "recommended_action": recommended_action,
                    "write_target_candidate": write_target_candidate,
                })

    # Sorteer per bucket op grootste impact
    for key in [
        "parser_actions",
        "scraper_type_mapping_actions",
        "mapping_actions_safe_only",
        "no_action_low_priority",
    ]:
        actions[key] = sorted(
            actions[key],
            key=lambda x: x.get("rows_total") or 0,
            reverse=True,
        )

        actions["summary"][key] = len(actions[key])
        actions[key] = actions[key][:safe_limit]

    return actions

