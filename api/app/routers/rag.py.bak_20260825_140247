def _delete_qdrant_points_by_doc_id(doc_id: str) -> int | None:
    """
    Verwijdert alle Qdrant-points met payload doc_id.
    Returnt aantal verwijderde points als count beschikbaar is, anders None.
    """
    qfilter = Filter(
        must=[
            FieldCondition(
                key="doc_id",
                match=MatchValue(value=doc_id),
            )
        ]
    )

    try:
        count_result = _qdr.count(
            collection_name=settings.QDRANT_COLLECTION,
            count_filter=qfilter,
            exact=True,
        )
        deleted_count = int(getattr(count_result, "count", 0))
    except Exception:
        deleted_count = None

    _qdr.delete(
        collection_name=settings.QDRANT_COLLECTION,
        points_selector=FilterSelector(filter=qfilter),
        wait=True,
    )

    return deleted_count


@router.post("/ingest")
def rag_ingest(body: RAGIngest):
    provider, model, expected_dim = _get_embedding_provider()
    _ensure_collection(expected_dim)

    chunks = _chunk_text(body.text, chunk_size=body.chunk_size, chunk_overlap=body.chunk_overlap)
    if not chunks:
        return {"status": "ok", "doc_id": body.doc_id, "chunks_upserted": 0, "provider": provider, "model": model}

    try:
        if provider == "openai":
            vectors, real_dim = _openai_embed(chunks, model=model)
            _ensure_collection(real_dim)
        else:
            vectors = [_local_embed_384(c) for c in chunks]
            real_dim = 384

        points = [
            PointStruct(
                id=str(uuid.uuid4()),
                vector=vec,
                payload={"doc_id": body.doc_id, "chunk_index": idx, "text": repair_mojibake_text(chunk)},
            )
            for idx, (chunk, vec) in enumerate(zip(chunks, vectors))
        ]

        _qdrant_upsert_batched(points)
        return {"status": "ok", "doc_id": body.doc_id, "chunks_upserted": len(points), "provider": provider, "model": model, "vector_size": real_dim}
    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/replace")
def rag_replace(body: RAGReplace):
    """
    Vervangt alle bestaande Qdrant chunks voor één doc_id
    en publiceert daarna de nieuwe tekst opnieuw.
    Gebruikt door org-admin RAG-documenten.
    """
    doc_id = (body.doc_id or "").strip()

    if not doc_id:
        raise HTTPException(status_code=422, detail="doc_id is verplicht.")

    try:
        deleted_count = _delete_qdrant_points_by_doc_id(doc_id)

        result = rag_ingest(
            RAGIngest(
                doc_id=doc_id,
                text=body.text,
                chunk_size=body.chunk_size,
                chunk_overlap=body.chunk_overlap,
            )
        )

        result["mode"] = "replace"
        result["points_deleted_before_replace"] = deleted_count
        result["write_actions_available"] = True

        return result

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/ingest-file")
async def rag_ingest_file(
    file: UploadFile = File(...),
    doc_id: Optional[str] = Form(None),
    chunk_size: int = Form(1200),
    chunk_overlap: int = Form(200),
):
    provider, model, expected_dim = _get_embedding_provider()
    _ensure_collection(expected_dim)

    try:
        data = await file.read()
        filename = file.filename or "document"
        effective_doc_id = doc_id or filename

        text = _extract_text(filename, data)
        text = _clean_extracted_text(text)

        if not text:
            raise HTTPException(status_code=422, detail="Kon geen tekst extraheren uit dit bestand.")

        chunks = _chunk_text(text, chunk_size=int(chunk_size), chunk_overlap=int(chunk_overlap))
        chunks = [_clean_extracted_text(c) for c in chunks]

        if not chunks:
            return {
                "status": "ok",
                "doc_id": effective_doc_id,
                "chunks_upserted": 0,
                "provider": provider,
                "model": model,
            }

        if provider == "openai":
            vectors, real_dim = _openai_embed(chunks, model=model)
            _ensure_collection(real_dim)
        else:
            vectors = [_local_embed_384(c) for c in chunks]
            real_dim = 384

        points = [
            PointStruct(
                id=str(uuid.uuid4()),
                vector=vec,
                payload={
                    "doc_id": effective_doc_id,
                    "chunk_index": idx,
                    "text": _clean_extracted_text(chunk),
                },
            )
            for idx, (chunk, vec) in enumerate(zip(chunks, vectors))
        ]

        _qdrant_upsert_batched(points)

        return {
            "status": "ok",
            "doc_id": effective_doc_id,
            "chunks_upserted": len(points),
            "provider": provider,
            "model": model,
            "vector_size": real_dim,
        }

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/ingest-product-document")
async def rag_ingest_product_document(
    file: UploadFile = File(...),

    title: Optional[str] = Form(None),
    brand: Optional[str] = Form(None),
    model: Optional[str] = Form(None),
    category: Optional[str] = Form(None),
    variant: Optional[str] = Form(None),
    language: str = Form("nl"),
    document_type: str = Form("product_document"),
    revision: Optional[str] = Form(None),
    status: str = Form("concept"),

    product_id: Optional[str] = Form(None),

    chunk_size: int = Form(1200),
    chunk_overlap: int = Form(200),
):
    """
    Productgerichte document-ingest:
    1. Extract tekst uit PDF/DOCX/TXT
    2. Schrijf document naar sb_docs_v0
    3. Schrijf chunks naar sb_doc_chunks_v0
    4. Schrijf chunks naar Qdrant met productmetadata
    """

    provider, embed_model, expected_dim = _get_embedding_provider()
    _ensure_collection(expected_dim)

    try:
        data = await file.read()
        filename = file.filename or "document"
        content_type = file.content_type or "application/octet-stream"

        effective_title = _safe_metadata_value(title) or filename

        extracted_text = _extract_text(filename, data)
        if not extracted_text:
            raise HTTPException(
                status_code=422,
                detail="Kon geen tekst extraheren uit dit bestand."
            )

        chunks = _chunk_text(
            extracted_text,
            chunk_size=int(chunk_size),
            chunk_overlap=int(chunk_overlap),
        )

        if not chunks:
            raise HTTPException(
                status_code=422,
                detail="Geen bruikbare chunks aangemaakt."
            )

        doc_id = _new_bigint_id()

        _insert_sb_doc_with_id(
            doc_id=doc_id,
            title=effective_title,
            filename=filename,
            content_type=content_type,
            minio_bucket="rag-documents",
            minio_key=f"product-documents/{doc_id}/{filename}",
        )

        db_chunks_inserted = _insert_sb_doc_chunks(doc_id, chunks)

        if provider == "openai":
            vectors, real_dim = _openai_embed(chunks, model=embed_model)
            _ensure_collection(real_dim)
        else:
            vectors = [_local_embed_384(c) for c in chunks]
            real_dim = 384

        metadata = {
            "doc_id": str(doc_id),
            "doc_id_int": doc_id,
            "title": effective_title,
            "filename": filename,
            "content_type": content_type,
            "source_type": "product_document",

            "brand": _safe_metadata_value(brand),
            "model": _safe_metadata_value(model),
            "category": _safe_metadata_value(category),
            "variant": _safe_metadata_value(variant),
            "language": _safe_metadata_value(language),
            "document_type": _safe_metadata_value(document_type),
            "revision": _safe_metadata_value(revision),
            "status": _safe_metadata_value(status),
            "product_id": _safe_metadata_value(product_id),

            "ingested_at": datetime.now(timezone.utc).isoformat(),
        }

        points = [
            PointStruct(
                id=str(uuid.uuid4()),
                vector=vec,
                payload={
                    **metadata,
                    "chunk_index": idx,
                    "text": repair_mojibake_text(chunk),
                },
            )
            for idx, (chunk, vec) in enumerate(zip(chunks, vectors))
        ]

        _qdrant_upsert_batched(points)

        return {
            "status": "ok",
            "doc_id": doc_id,
            "filename": filename,
            "title": effective_title,
            "chunks_inserted_db": db_chunks_inserted,
            "chunks_upserted_qdrant": len(points),
            "provider": provider,
            "embed_model": embed_model,
            "vector_size": real_dim,
            "metadata": {
                "brand": brand,
                "model": model,
                "category": category,
                "variant": variant,
                "language": language,
                "document_type": document_type,
                "revision": revision,
                "status": status,
                "product_id": product_id,
            },
            "write_actions_available": True,
        }

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/query")
def rag_query(body: RAGQuery):
    provider, embed_model, expected_dim = _get_embedding_provider()
    _ensure_collection(expected_dim)

    try:
        top_k = int(getattr(body, "top_k", 5) or 5)
        answer_mode = getattr(body, "answer_mode", os.getenv("RAG_DEFAULT_MODE", "extractive"))
        rerank_candidates = int(getattr(body, "rerank_candidates", os.getenv("RAG_RERANK_CANDIDATES", "30")) or 30)

        if getattr(body, "doc_id_contains", None) or getattr(body, "doc_id_not_contains", None):
            rerank_candidates = max(rerank_candidates, 500)
        use_mmr = bool(getattr(body, "use_mmr", str(os.getenv("RAG_USE_MMR", "true")).lower() == "true"))

        # embed query
        if provider == "openai":
            vectors, real_dim = _openai_embed([body.vraag], model=embed_model)
            _ensure_collection(real_dim)
            qvec = vectors[0]
        else:
            qvec = _local_embed_384(body.vraag)

         # filters on doc_id(s) + product metadata
        must_filters = []

        # Meerdere expliciet toegestane documenten.
        # Als doc_ids gevuld is, krijgt dit voorrang op enkelvoudig doc_id.
        raw_doc_ids = getattr(body, "doc_ids", None) or []
        clean_doc_ids = [
            str(value).strip()
            for value in raw_doc_ids
            if str(value).strip()
        ]

        if clean_doc_ids:
            must_filters.append(
                FieldCondition(
                    key="doc_id",
                    match=MatchAny(any=clean_doc_ids),
                )
            )

        filter_fields = [
            "doc_id",
            "brand",
            "model",
            "category",
            "variant",
            "document_type",
            "status",
            "product_id",
        ]

        for field in filter_fields:
            # Voorkom doc_id AND doc_ids als beide per ongeluk worden meegestuurd.
            if field == "doc_id" and clean_doc_ids:
                continue

            value = getattr(body, field, None)

            if isinstance(value, str) and value.strip():
                must_filters.append(
                    FieldCondition(
                        key=field,
                        match=MatchValue(value=value.strip()),
                    )
                )

        qfilter = Filter(must=must_filters) if must_filters else None

        # fetch candidates with vectors (for MMR)
        res = _qdr.query_points(
            collection_name=settings.QDRANT_COLLECTION,
            query=qvec,
            limit=rerank_candidates,
            with_payload=True,
            with_vectors=True,
            query_filter=qfilter,
        )
        points = res.points if hasattr(res, "points") else res

        candidates = [
            {"id": p.id, "score": float(p.score), "vector": p.vector, "payload": (p.payload or {})}
            for p in points
        ]

        doc_id_contains = getattr(body, "doc_id_contains", None)
        if isinstance(doc_id_contains, str) and doc_id_contains.strip():
            needle = doc_id_contains.strip().lower()
            candidates = [
                c for c in candidates
                if needle in str((c.get("payload") or {}).get("doc_id", "")).lower()
            ]

        doc_id_not_contains = getattr(body, "doc_id_not_contains", None)
        if isinstance(doc_id_not_contains, str) and doc_id_not_contains.strip():
            needle = doc_id_not_contains.strip().lower()
            candidates = [
                c for c in candidates
                if needle not in str((c.get("payload") or {}).get("doc_id", "")).lower()
            ]

        # hybrid rerank
        reranked = _hybrid_rerank(body.vraag, candidates, top_n=max(rerank_candidates, top_k))

        # mmr select
        final_hits = reranked
        if use_mmr and len(reranked) > top_k and isinstance(qvec, list):
            final_hits = _mmr_select(qvec, reranked, k=top_k)

        # build context & citations
        context_chunks: list[str] = []
        citations: list[dict] = []
        for i, h in enumerate(final_hits[:top_k], start=1):
            payload = h.get("payload") or {}
            context_chunks.append(repair_mojibake_text(payload.get("text") or ""))
            citations.append(
                {
                    "n": i,
                    "doc_id": payload.get("doc_id"),
                    "chunk_index": payload.get("chunk_index"),
                    "score": float(h.get("final_score", h.get("score", 0.0))),
                    "keyword_score": float(h.get("keyword_score", 0.0)),
                }
            )

        # answer
        if str(answer_mode).lower() == "llm":
            answer = _llm_answer(body.vraag, context_chunks)
        else:
            answer = _extractive_answer(body.vraag, context_chunks)

        return {
            "vraag": body.vraag,
            "antwoord": answer,
            "used_context": [
                {
                    "doc_id": citations[i]["doc_id"],
                    "chunk_index": citations[i]["chunk_index"],
                    "score": citations[i]["score"],
                    "text": context_chunks[i],
                }
                for i in range(min(3, len(context_chunks)))
            ],
            "context_hits": citations,
            "provider": provider,
            "embed_model": embed_model,
            "opmerking": "Hybrid rerank (vector+keyword) + optioneel MMR + optioneel LLM antwoord.",
        }

    except HTTPException:
        raise
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))


@router.post("/chunks")
def rag_chunks(body: RAGChunksRequest):
    provider, model, expected_dim = _get_embedding_provider()
    _ensure_collection(expected_dim)

    doc_id = (body.doc_id or "").strip()
    if not doc_id:
        raise HTTPException(status_code=422, detail="doc_id is verplicht.")

    limit = int(body.limit or 100)
    limit = max(1, min(limit, 500))

    qfilter = Filter(
        must=[
            FieldCondition(
                key="doc_id",
                match=MatchValue(value=doc_id),
            )
        ]
    )

    try:
        count_result = _qdr.count(
            collection_name=settings.QDRANT_COLLECTION,
            count_filter=qfilter,
            exact=True,
        )
        total_count = int(getattr(count_result, "count", 0))

        points, next_page_offset = _qdr.scroll(
            collection_name=settings.QDRANT_COLLECTION,
            scroll_filter=qfilter,
            limit=limit,
            with_payload=True,
            with_vectors=False,
        )

        chunks = []

        for p in points:
            payload = p.payload or {}
            text = repair_mojibake_text(payload.get("text") or "")

            chunks.append({
                "point_id": str(p.id),
                "doc_id": payload.get("doc_id"),
                "chunk_index": payload.get("chunk_index"),
                "text": text,
                "text_length": len(text),
                "preview": text[:300],
            })

        chunks.sort(key=lambda x: int(x.get("chunk_index") or 0))

        return {
            "status": "ok",
            "doc_id": doc_id,
            "total_count": total_count,
            "returned_count": len(chunks),
            "limit": limit,
            "has_more": next_page_offset is not None,
            "chunks": chunks,
            "provider": provider,
            "model": model,
        }

    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))