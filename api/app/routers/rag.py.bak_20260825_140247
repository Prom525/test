def _normalize_ws(s: str) -> str:
    return re.sub(r"\s+", " ", (s or "").strip())

def _clean_extracted_text(s: str) -> str:
    if not s:
        return ""

    s = repair_mojibake_text(s)

    # Probeer eerst algemene mojibake-fix.
    for enc in ("latin1", "cp1252"):
        try:
            fixed = s.encode(enc).decode("utf-8")
            if fixed.count("Ã") < s.count("Ã") or fixed.count("â") < s.count("â"):
                s = fixed
                break
        except Exception:
            pass

    replacements = {
        "â€¢": "•",
        "â¢": "•",
        "â€“": "–",
        "â€”": "—",
        "â€˜": "'",
        "â€™": "'",
        "â€œ": '"',
        "â€": '"',
        "â„¢": "™",
        "Â®": "®",
        "Â©": "©",
        "Â°": "°",
        "Â±": "±",
        "Â": "",

        "Ã©": "é",
        "Ã¨": "è",
        "Ã«": "ë",
        "Ã¯": "ï",
        "Ã´": "ô",
        "Ã¶": "ö",
        "Ã¼": "ü",
        "Ã¡": "á",
        "Ã ": "à",
        "Ãª": "ê",
        "Ã§": "ç",
    }

    for bad, good in replacements.items():
        s = s.replace(bad, good)

    # Engelse contractions: arenât, doesnât, donât, wonât, canât
    s = re.sub(r"\b([A-Za-z]+)nât\b", r"\1n't", s)

    # Possessives: beltâs, systemâs, cleanerâs
    s = re.sub(r"\b([A-Za-z]+)âs\b", r"\1's", s)

    # Losse quotes rond woorden: âwalkâ -> 'walk'
    s = re.sub(r"â([^â\n]{1,80})â", r"'\1'", s)

    # Resterende losse â meestal apostrophe/quote uit PDF.
    s = s.replace("â", "'")

    return repair_mojibake_text(s)

def _chunk_text(text: str, chunk_size: int = 1200, chunk_overlap: int = 200) -> list[str]:
    """
    Char-based chunker. Voor engineering docs (tabellen/formules) werkt dit stabiel.
    """
    text = (text or "").strip()
    if not text:
        return []

    chunk_size = int(chunk_size)
    chunk_overlap = int(chunk_overlap)
    if chunk_size <= 0:
        return [text]

    chunk_overlap = max(0, min(chunk_overlap, chunk_size - 1))
    step = chunk_size - chunk_overlap

    chunks: list[str] = []
    i = 0
    while i < len(text):
        chunk = text[i : i + chunk_size].strip()
        if chunk:
            chunks.append(chunk)
        i += step
    return chunks


def _extractive_answer(vraag: str, context_chunks: list[str], max_chars: int = 800) -> str:
    """
    Simpele extractieve 'demo' answer (zonder LLM).
    """
    if not context_chunks:
        return "Geen relevante context gevonden."

    combined = "\n".join(context_chunks)
    parts = re.split(r"(?<=[\.\!\?])\s+|\n[-*]\s+|\n\d+\.\s+", combined)
    parts = [_normalize_ws(p) for p in parts if _normalize_ws(p)]

    out: list[str] = []
    total = 0
    for p in parts:
        if total + len(p) + 1 > max_chars:
            break
        out.append(p)
        total += len(p) + 1

    if not out:
        return _normalize_ws(combined)[:max_chars]

    return (f"Op basis van de gevonden documentstukken voor: '{vraag}': " + " ".join(out))[: max_chars + 120]

def _new_bigint_id() -> int:
    """
    Genereert een positieve bigint-id.
    Bewust geen dependency op sequence, omdat sb_docs_v0 nog leeg is
    en niet zeker is of doc_id auto-increment heeft.
    """
    return uuid.uuid4().int >> 65


def _safe_metadata_value(value: Optional[str]) -> Optional[str]:
    value = (value or "").strip()
    return value or None


def _insert_sb_doc_with_id(
    *,
    doc_id: int,
    title: str,
    filename: str,
    content_type: str | None,
    minio_bucket: str,
    minio_key: str,
) -> int:
    sql = sql_text("""
        INSERT INTO sb_docs_v0 (
            doc_id,
            title,
            filename,
            content_type,
            minio_bucket,
            minio_key,
            created_at
        )
        VALUES (
            :doc_id,
            :title,
            :filename,
            :content_type,
            :minio_bucket,
            :minio_key,
            now()
        )
        RETURNING doc_id
    """)

    with engine.begin() as conn:
        row = conn.execute(sql, {
            "doc_id": doc_id,
            "title": title,
            "filename": filename,
            "content_type": content_type,
            "minio_bucket": minio_bucket,
            "minio_key": minio_key,
        }).mappings().first()

    return int(row["doc_id"])


def _insert_sb_doc_chunks(doc_id: int, chunks: list[str]) -> int:
    if not chunks:
        return 0

    sql = sql_text("""
        INSERT INTO sb_doc_chunks_v0 (
            chunk_id,
            doc_id,
            chunk_idx,
            text,
            created_at
        )
        VALUES (
            :chunk_id,
            :doc_id,
            :chunk_idx,
            :text,
            now()
        )
    """)

    rows = [
        {
            "chunk_id": _new_bigint_id(),
            "doc_id": doc_id,
            "chunk_idx": idx,
            "text": repair_mojibake_text(chunk),
        }
        for idx, chunk in enumerate(chunks)
    ]

    with engine.begin() as conn:
        conn.execute(sql, rows)

    return len(rows)


