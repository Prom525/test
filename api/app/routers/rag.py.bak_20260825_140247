# Embeddings
# -----------------------------


def _local_embed_384(text: str) -> list[float]:
    """
    Fallback embedding (demo): hashing trick -> 384 dims.
    """
    h = hashlib.sha256((text or "").encode("utf-8")).digest()
    vals = list(h) * (384 // len(h) + 1)
    return [(v / 255.0) for v in vals[:384]]


def _openai_embed(texts: list[str], model: str) -> tuple[list[list[float]], int]:
    """
    OpenAI embeddings in batches.
    Voorkomt max_tokens_per_request errors bij grote PDF's.
    """
    try:
        from openai import OpenAI  # type: ignore
    except Exception as e:
        raise RuntimeError("OpenAI package ontbreekt. Installeer 'openai'.") from e

    api_key = os.getenv("OPENAI_API_KEY") or getattr(settings, "OPENAI_API_KEY", None)
    if not api_key:
        raise RuntimeError("OPENAI_API_KEY ontbreekt.")

    client = OpenAI(api_key=api_key)

    # Veilig conservatief: 64 chunks per request.
    # Bij chunk_size 1200 blijft dit ruim onder OpenAI tokenlimieten.
    batch_size = int(os.getenv("OPENAI_EMBED_BATCH_SIZE", "64"))

    all_vectors: list[list[float]] = []

    for i in range(0, len(texts), batch_size):
        batch = texts[i:i + batch_size]

        resp = client.embeddings.create(
            model=model,
            input=batch,
        )

        all_vectors.extend([d.embedding for d in resp.data])

    dim = len(all_vectors[0]) if all_vectors and all_vectors[0] else 0
    if dim <= 0:
        raise RuntimeError("Kon embedding-dimensie niet bepalen.")

    return all_vectors, dim


def _get_embedding_provider() -> tuple[str, str, int]:
    """
    provider, model, expected_dim
    """
    model = (
        os.getenv("OPENAI_EMBEDDING_MODEL")
        or getattr(settings, "OPENAI_EMBEDDING_MODEL", None)
        or "text-embedding-3-small"
    )
    api_key = os.getenv("OPENAI_API_KEY") or getattr(settings, "OPENAI_API_KEY", None)

    if api_key:
        # best-effort expected dims
        expected = 1536
        if model.endswith("3-large"):
            expected = 3072
        return "openai", model, expected

    return "local", "local-384", 384


