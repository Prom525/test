_qdr = QdrantClient(url=settings.QDRANT_URL, api_key=getattr(settings, "QDRANT_API_KEY", None))


def _ensure_collection(vector_size: int) -> None:
    name = settings.QDRANT_COLLECTION
    try:
        existing = [c.name for c in _qdr.get_collections().collections]
        if name not in existing:
            _qdr.create_collection(
                collection_name=name,
                vectors_config=VectorParams(size=int(vector_size), distance=Distance.COSINE),
            )
            return

        # Check size if exists (defensive, qdrant-client versions differ)
        info = _qdr.get_collection(name)
        size = None
        try:
            size = info.config.params.vectors.size  # type: ignore
        except Exception:
            try:
                size = info.config.params.vectors_config.size  # type: ignore
            except Exception:
                size = None

        if size is not None and int(size) != int(vector_size):
            raise HTTPException(
                status_code=409,
                detail=(
                    f"Qdrant collection '{name}' bestaat al met vector size={size}, "
                    f"maar embeddings verwachten size={vector_size}. "
                    f"Gebruik een andere QDRANT_COLLECTION of recreate de collection."
                ),
            )
    except HTTPException:
        raise
    except Exception:
        return


def _qdrant_upsert_batched(points: list[PointStruct], batch_size: int | None = None) -> None:
    """
    Upsert Qdrant points in batches.
    Voorkomt Qdrant payload limit errors bij grote PDF's.
    """
    if not points:
        return

    batch_size = batch_size or int(os.getenv("QDRANT_UPSERT_BATCH_SIZE", "64"))

    for i in range(0, len(points), batch_size):
        batch = points[i:i + batch_size]
        _qdr.upsert(
            collection_name=settings.QDRANT_COLLECTION,
            points=batch,
            wait=True,
        )

# -----------------------------
# File text extraction
# -----------------------------


def _extract_text_from_pdf(data: bytes) -> str:
    reader = PdfReader(io.BytesIO(data))
    parts: list[str] = []
    for page in reader.pages:
        t = page.extract_text() or ""
        if t.strip():
            parts.append(t)
    return "\n\n".join(parts).strip()


def _extract_text_from_docx(data: bytes) -> str:
    doc = Document(io.BytesIO(data))
    parts = [p.text for p in doc.paragraphs if p.text and p.text.strip()]
    return "\n".join(parts).strip()


def _extract_text(filename: str, data: bytes) -> str:
    ext = filename.rsplit(".", 1)[-1].lower() if "." in filename else ""
    if ext == "pdf":
        return _clean_extracted_text(_extract_text_from_pdf(data))
    if ext == "docx":
        return _clean_extracted_text(_extract_text_from_docx(data))

    # fallback: try decode
    try:
        return _clean_extracted_text(data.decode("utf-8", errors="ignore").strip())
    except Exception:
        return ""


# -----------------------------
# Hybrid rerank + MMR
# -----------------------------


def _keyword_score(query: str, text: str) -> float:
    q = _normalize_ws(query).lower()
    t = _normalize_ws(text).lower()

    q_terms = {w for w in re.findall(r"[a-z0-9\=\.\-]+", q) if len(w) >= 3}
    if not q_terms:
        return 0.0

    hits = sum(1 for w in q_terms if w in t)
    score = hits / max(1, len(q_terms))

    # anchor bonus voor conveyor capacity/formules/tabellen
    anchors = ["capacity", "cross", "section", "surcharge", "trough", "3600", "rho", "q", "a", "v"]
    bonus = 0.0
    for a in anchors:
        if a in q and a in t:
            bonus += 0.03

    return min(1.0, score + bonus)


def _hybrid_rerank(query: str, candidates: list[dict], top_n: int) -> list[dict]:
    ranked = []
    for c in candidates:
        payload = c.get("payload") or {}
        text = repair_mojibake_text(payload.get("text") or "")
        vscore = float(c.get("score") or 0.0)
        kscore = _keyword_score(query, text)

        # weging: vector zwaar, keyword lift formules/tabellen
        final = (0.75 * vscore) + (0.25 * kscore)
        ranked.append({**c, "keyword_score": kscore, "final_score": final})

    ranked.sort(key=lambda x: x["final_score"], reverse=True)
    return ranked[:top_n]


def _cosine(a: list[float], b: list[float]) -> float:
    import math

    dot = sum(x * y for x, y in zip(a, b))
    na = math.sqrt(sum(x * x for x in a)) or 1.0
    nb = math.sqrt(sum(y * y for y in b)) or 1.0
    return dot / (na * nb)


def _mmr_select(query_vec: list[float], candidates: list[dict], k: int, lambda_mult: float = 0.7) -> list[dict]:
    selected: list[dict] = []
    pool = candidates[:]

    while pool and len(selected) < k:
        best = None
        best_score = -1e9

        for c in pool:
            rel = float(c.get("final_score", c.get("score", 0.0)))
            if not selected:
                mmr = rel
            else:
                sim = max(_cosine(c["vector"], s["vector"]) for s in selected)
                mmr = (lambda_mult * rel) - ((1 - lambda_mult) * sim)

            if mmr > best_score:
                best_score = mmr
                best = c

        assert best is not None
        selected.append(best)
        pool.remove(best)

    return selected


# -----------------------------
# LLM answer with citations
# -----------------------------


def _llm_answer(question: str, context_chunks: list[str]) -> str:
    """
    LLM antwoord, met bronnen genummerd [1], [2], ...
    """
    try:
        from openai import OpenAI  # type: ignore
    except Exception:
        return _extractive_answer(question, context_chunks)

    api_key = os.getenv("OPENAI_API_KEY") or getattr(settings, "OPENAI_API_KEY", None)
    if not api_key:
        return _extractive_answer(question, context_chunks)

    chat_model = os.getenv("OPENAI_CHAT_MODEL", "gpt-4o-mini")

    sources = "\n\n".join([f"[{i}] {c}" for i, c in enumerate(context_chunks, start=1)])

    system = (
        "Je bent een technische assistent. "
        "Antwoord kort en correct. "
        "Gebruik uitsluitend de gegeven bronnen. "
        "Als iets niet in de bronnen staat, zeg dat expliciet. "
        "Gebruik bronverwijzingen als [1], [2] bij beweringen."
    )
    user = f"Vraag: {question}\n\nBronnen:\n{sources}"

    client = OpenAI(api_key=api_key)
    resp = client.chat.completions.create(
        model=chat_model,
        messages=[
            {"role": "system", "content": system},
            {"role": "user", "content": user},
        ],
        temperature=0.1,
    )
    return (resp.choices[0].message.content or "").strip()


