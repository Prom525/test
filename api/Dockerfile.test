FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/workspace
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz0b libharfbuzz-subset0 \
    libffi-dev libcairo2 libgdk-pixbuf-2.0-0 libglib2.0-0 shared-mime-info \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-test.txt
COPY app ./app
COPY tests ./tests
COPY pytest.ini ./pytest.ini
RUN adduser --disabled-password --gecos '' appuser && chown -R appuser:appuser /workspace
USER appuser

ENTRYPOINT ["python", "-m", "pytest"]
