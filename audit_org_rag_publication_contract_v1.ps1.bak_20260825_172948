# ============================================================
# 6. Publication response structure
#
# Alleen JSON keys, geen response-inhoud.
# ============================================================

Invoke-PgAudit `
    -Title "7. PUBLICATION RESPONSE KEY PROFILE" `
    -Sql @'
WITH keys AS (
    SELECT
        d.doc_id,
        jsonb_object_keys(
            CASE
                WHEN jsonb_typeof(
                    d.laatste_publicatie_response
                ) = 'object'
                THEN d.laatste_publicatie_response
                ELSE '{}'::jsonb
            END
        ) AS response_key

    FROM org_rag_documenten d
)
SELECT
    response_key,
    COUNT(*)::int AS document_count
FROM keys
GROUP BY response_key
ORDER BY
    document_count DESC,
    response_key;
'@


# ============================================================
# 7. Publication-state distribution
# ============================================================

Invoke-PgAudit `
    -Title "8. PUBLICATION STATUS DISTRIBUTION" `
    -Sql @'
SELECT
    actief,
    COALESCE(
        laatste_publicatie_status,
        '<NULL>'
    ) AS publication_status,

    COUNT(*)::int AS document_count,

    MIN(laatst_gepubliceerd_op)
        AS first_published,

    MAX(laatst_gepubliceerd_op)
        AS last_published

FROM org_rag_documenten

GROUP BY
    actief,
    laatste_publicatie_status

ORDER BY
    actief DESC,
    publication_status;
'@


# ============================================================
# 8. Search-term linkage
# ============================================================

Invoke-PgAudit `
    -Title "9. RAG SEARCH TERM LINKAGE" `
    -Sql @'
SELECT
    d.doc_id,
    d.actief,

    COUNT(s.id)::int
        AS search_term_count,

    COUNT(s.id) FILTER (
        WHERE s.active = TRUE
    )::int
        AS active_search_term_count

FROM org_rag_documenten d

LEFT JOIN rag_doc_search_terms s
  ON s.doc_id = d.doc_id

GROUP BY
    d.doc_id,
    d.actief

ORDER BY d.doc_id;
'@


