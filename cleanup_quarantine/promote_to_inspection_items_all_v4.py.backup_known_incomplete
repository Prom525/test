def load_inspection_lookup(conn):
    rows = conn.execute(text("""
        SELECT
            customer_code,
            site_code,
            source_file,
            sheet,
            inspection_key,
            lijn_code,
            inspected_on
        FROM sb_inspections_v0
        WHERE inspected_on IS NOT NULL
    """)).fetchall()

    lookup = {}
    by_file = defaultdict(list)

    for customer_code, site_code, source_file, sheet, inspection_key, lijn_code, inspected_on in rows:
        key = (customer_code, site_code, source_file, normalize_sheet(sheet), inspected_on)
        record = {
            "customer_code": customer_code,
            "site_code": site_code,
            "inspection_key": inspection_key,
            "lijn_code": lijn_code,
            "inspected_on": inspected_on,
            "sheet": sheet,
        }
        lookup[key] = record
        by_file[(customer_code, site_code, source_file)].append(record)

    return lookup, by_file


def load_raw_grouped(conn, mode: str = "incremental"):
    if mode == "full-rebuild":
        sql = """
            SELECT
                customer_code,
                site_code,
                source_file,
                sheet,
                row_nr,
                data->'row' AS row_json
            FROM sb_stg_inspecties_raw
            WHERE customer_code IS NOT NULL
              AND site_code IS NOT NULL
            ORDER BY customer_code, site_code, source_file, sheet, row_nr
        """
    else:
        sql = """
            SELECT
                r.customer_code,
                r.site_code,
                r.source_file,
                r.sheet,
                r.row_nr,
                r.data->'row' AS row_json
            FROM sb_stg_inspecties_raw r
            JOIN vw_changed_inspection_sheets_todo_v1 c
              ON c.customer_code = r.customer_code
             AND c.site_code = r.site_code
             AND c.source_file = r.source_file
             AND c.sheet = r.sheet
            WHERE r.customer_code IS NOT NULL
              AND r.site_code IS NOT NULL
            ORDER BY r.customer_code, r.site_code, r.source_file, r.sheet, r.row_nr
        """

    rows = conn.execute(text(sql)).fetchall()

    grouped = defaultdict(list)
    for customer_code, site_code, source_file, sheet, row_nr, row_json in rows:
        grouped[(customer_code, site_code, source_file, sheet)].append((row_nr, row_json))

    return grouped


def find_header_date(rows):
    # Alleen de expliciete Datum-rij gebruiken.
    for row_nr, row_json in rows:
        if row_nr > 25:
            break

        if not isinstance(row_json, dict):
            continue

        values = [
            "" if value is None else str(value).strip()
            for value in row_json.values()
        ]

        row_lower = " ".join(
            value.lower()
            for value in values
            if value
        )

        if "datum" not in row_lower:
            continue

        # Datum staat normaal rechts van het label.
        for value in reversed(values):
            dt = parse_inspected_on(value)
            if dt:
                return dt

    return None


def determine_workbook_year(customer_code, site_code, source_file, sheets_for_file, inspection_by_file, raw_grouped):
    years = []

    for rec in inspection_by_file.get((customer_code, site_code, source_file), []):
        if rec.get("inspected_on"):
            years.append(rec["inspected_on"].year)

    for raw_sheet in sheets_for_file:
        explicit_dt = parse_explicit_date_from_sheet_name(raw_sheet)
        if explicit_dt:
            years.append(explicit_dt.year)
            continue

        rows = raw_grouped.get((source_file, raw_sheet), [])
        header_dt = find_header_date(rows)
        if header_dt:
            years.append(header_dt.year)

    file_year = infer_year_from_source_file(source_file)
    if file_year:
        years.append(file_year)

    if years:
        return Counter(years).most_common(1)[0][0]

    return None

def ensure_schema(conn) -> None:
    conn.execute(text("ALTER TABLE sb_inspection_items_v0 ADD COLUMN IF NOT EXISTS customer_code text"))
    conn.execute(text("ALTER TABLE sb_inspection_items_v0 ADD COLUMN IF NOT EXISTS site_code text"))

def main(mode: str = "incremental"):
    with engine.begin() as conn:
        ensure_schema(conn)

        if mode == "full-rebuild":
            print("[INFO] FULL REBUILD: sb_inspection_items_v0 volledig opnieuw opbouwen ...")
            conn.execute(text("TRUNCATE TABLE sb_inspection_items_v0 RESTART IDENTITY"))
        else:
            print("[INFO] INCREMENTAL: alleen changed sheets verwerken ...")

        inspection_lookup, inspection_by_file = load_inspection_lookup(conn)
        raw_grouped = load_raw_grouped(conn, mode=mode)

        if mode == "incremental":
            if not raw_grouped:
                print("[INFO] Geen changed sheets gevonden. Niets te doen.")
                return

            print(f"[INFO] Changed sheets gevonden: {len(raw_grouped)}")

        all_target_keys = [
            (customer_code, site_code, source_file, sheet)
            for (customer_code, site_code, source_file, sheet) in raw_grouped.keys()
            if is_target_excel_source(source_file)
        ]
        all_target_keys.sort()

        skipped_auxiliary_keys = [
            key
            for key in all_target_keys
            if is_known_auxiliary_sheet(
                key[2],
                key[3],
            )
        ]

        target_keys = [
            key
            for key in all_target_keys
            if not is_known_auxiliary_sheet(
                key[2],
                key[3],
            )
        ]

        print(
            f"[INFO] doel-sheets (Lijsten*, excl. totaal.xlsx): "
            f"{len(target_keys)}"
        )
        print(
            f"[INFO] skipped auxiliary sheets: "
            f"{len(skipped_auxiliary_keys)}"
        )

        sheets_by_file = defaultdict(list)
        for customer_code, site_code, source_file, raw_sheet in target_keys:
            sheets_by_file[(customer_code, site_code, source_file)].append(raw_sheet)

        workbook_year_by_file = {}

        for (customer_code, site_code, source_file), sheets_for_file in sheets_by_file.items():
            workbook_year_by_file[(customer_code, site_code, source_file)] = determine_workbook_year(
                customer_code=customer_code,
                site_code=site_code,
                source_file=source_file,
                sheets_for_file=sheets_for_file,
                inspection_by_file=inspection_by_file,
                raw_grouped={
                    (sf, sh): rows
                    for (cc, sc, sf, sh), rows in raw_grouped.items()
                    if cc == customer_code and sc == site_code and sf == source_file
                },
            )
        n_inserted = 0
        n_skipped_no_date = 0
        n_skipped_no_header = 0
        n_skipped_no_match = 0
        n_skipped_duplicate_in_run = 0

        skipped_examples = []
        seen_rows = set()

        for customer_code, site_code, source_file, raw_sheet in target_keys:
            rows = raw_grouped[(customer_code, site_code, source_file, raw_sheet)]
            sheet_norm = normalize_sheet(raw_sheet)

            inspection_key = None
            inspected_on = None
            lijn_code = infer_lijn_code_from_source(source_file)
            hit = None

            file_headers = inspection_by_file.get(
                (customer_code, site_code, source_file),
                [],
            )

            # 1. Exacte raw sheet heeft voorrang.
            #
            # Dit voorkomt collisions zoals:
            # week02 / week 02 / week  02 / week2
            exact_candidates = [
                rec
                for rec in file_headers
                if rec.get("sheet") == raw_sheet
            ]

            # Als de exacte sheet slechts één header heeft,
            # is die bestaande canonical header leidend.
            if len(exact_candidates) == 1:
                hit = exact_candidates[0]
                inspected_on = hit["inspected_on"]

            else:
                # 2. Alleen als exact-sheet niet uniek is:
                # bepaal datum uit sheet/header/week.
                inspected_on = get_inspection_date_override(
                    source_file,
                    raw_sheet,
                )

                if inspected_on is None:
                    inspected_on = parse_explicit_date_from_sheet_name(
                        raw_sheet
                    )

                if inspected_on is None:
                    inspected_on = find_header_date(rows)

                if inspected_on is None:
                    # Geen datum afleiden uit alleen weeknummer + workbookjaar.
                    # Zonder expliciete sheetdatum of Datum-rij is koppelen
                    # aan een canonical inspectie niet betrouwbaar.
                    pass

                # 3. Probeer eerst exact sheet + datum.
                if inspected_on is not None:
                    exact_date_candidates = [
                        rec
                        for rec in exact_candidates
                        if rec.get("inspected_on") == inspected_on
                    ]

                    if len(exact_date_candidates) == 1:
                        hit = exact_date_candidates[0]

                # 4. Laatste fallback:
                # normalized sheet + datum, maar ALLEEN indien uniek.
                if hit is None and inspected_on is not None:
                    normalized_candidates = [
                        rec
                        for rec in file_headers
                        if normalize_sheet(rec.get("sheet")) == sheet_norm
                        and rec.get("inspected_on") == inspected_on
                    ]

                    if len(normalized_candidates) == 1:
                        hit = normalized_candidates[0]

            if hit is not None:
                inspection_key = hit["inspection_key"]
                inspected_on = hit["inspected_on"]

                if hit["lijn_code"]:
                    lijn_code = hit["lijn_code"]

            # 3. Items mogen NOOIT zelf een inspection_key bouwen.
            # Headers zijn leidend. Zonder bestaande header geen item-insert,
            # anders ontstaan orphan-items.
            if inspected_on is None:
                n_skipped_no_date += 1
                if len(skipped_examples) < 50:
                    skipped_examples.append((source_file, f"{raw_sheet} [geen datum]"))
                continue

            if inspection_key is None:
                n_skipped_no_header += 1
                if len(skipped_examples) < 50:
                    skipped_examples.append((source_file, f"{raw_sheet} [geen header-match voor {inspected_on}]"))
                continue

            # Pas verwijderen NADAT exact bekend is welke
            # canonical inspection opnieuw opgebouwd wordt.
            if mode == "incremental":
                conn.execute(
                    text("""
                        DELETE FROM sb_inspection_items_v0
                        WHERE inspection_key = :inspection_key
                    """),
                    {
                        "inspection_key": inspection_key,
                    },
                )

            inserted_for_this_sheet = 0
            candidate_rows_this_sheet = 0

            for row_nr, row_json in rows:
                if row_json is None:
                    continue

                if not isinstance(row_json, dict):
                    row_json = dict(row_json)

                if not is_data_row(row_nr, row_json):
                    continue

                candidate_rows_this_sheet += 1

                # dedupe op echte inspection_key + raw sheet + row_nr
                dedupe_key = (inspection_key, source_file, raw_sheet, row_nr)
                if dedupe_key in seen_rows:
                    n_skipped_duplicate_in_run += 1
                    continue

                seen_rows.add(dedupe_key)

                row_json_clean = clean_json_dict(row_json)

                locatie = row_json_clean.get("Unnamed: 0")
                band_breedte = row_json_clean.get("Unnamed: 1")
                merk_type = row_json_clean.get("Unnamed: 2")

                demontage = x_to_bool(row_json_clean.get("Unnamed: 3"))
                reinigen = x_to_bool(row_json_clean.get("Unnamed: 4"))
                vervangen = x_to_bool(row_json_clean.get("Unnamed: 5"))

                conn.execute(text("""
                    INSERT INTO sb_inspection_items_v0 (
                        customer_code,
                        site_code,
                        inspection_key,
                        lijn_code,
                        source_file,
                        sheet,
                        section_idx,
                        row_nr,
                        locatie,
                        band_breedte,
                        merk_type,
                        demontage,
                        reinigen,
                        vervangen,
                        row_json
                    )
                    VALUES (
                        :customer_code,
                        :site_code,
                        :inspection_key,
                        :lijn_code,
                        :source_file,
                        :sheet,
                        1,
                        :row_nr,
                        :locatie,
                        :band_breedte,
                        :merk_type,
                        :demontage,
                        :reinigen,
                        :vervangen,
                        CAST(:row_json AS jsonb)
                    )
                    ON CONFLICT (inspection_key, section_idx, row_nr)
                    DO NOTHING
                """), {
                    "customer_code": customer_code,
                    "site_code": site_code,
                    "inspection_key": inspection_key,
                    "lijn_code": lijn_code,
                    "source_file": source_file,
                    "sheet": sheet_norm,
                    "row_nr": row_nr,
                    "locatie": locatie,
                    "band_breedte": None if band_breedte is None else str(band_breedte),
                    "merk_type": merk_type,
                    "demontage": demontage,
                    "reinigen": reinigen,
                    "vervangen": vervangen,
                    "row_json": json.dumps(row_json_clean, ensure_ascii=False, default=str),
                })

                inserted_for_this_sheet += 1
                n_inserted += 1

            if inserted_for_this_sheet == 0:
                n_skipped_no_match += 1
                if len(skipped_examples) < 50 and candidate_rows_this_sheet > 0:
                    skipped_examples.append(
                        (source_file, f"{raw_sheet} [0 inserted / {candidate_rows_this_sheet} candidates]")
                    )

        print(f"[DONE] inserted items: {n_inserted}")
        print(f"[DONE] skipped no date: {n_skipped_no_date}")
        print(f"[DONE] skipped no header match: {n_skipped_no_header}")
        print(f"[DONE] skipped empty sheets: {n_skipped_no_match}")
        print(f"[DONE] skipped duplicates in run: {n_skipped_duplicate_in_run}")

        if skipped_examples:
            print("[INFO] eerste skipped voorbeelden:")
            for source_file, raw_sheet in skipped_examples[:20]:
                print(f"  - {raw_sheet} | {source_file}")


