        ("AFGRAAFLIJN MV1", "MV1"),
        ("OPWERPLIJN MV1", "MV1"),
        ("MENGVELD 1", "MV1"),
        ("MV1", "MV1"),
        ("AFGRAAFLIJN MV2", "MV2"),
        ("OPWERPLIJN MV2", "MV2"),
        ("MENGVELD 2", "MV2"),
        ("MV2", "MV2"),
        ("EO-1", "EO1"),
        ("EO 1", "EO1"),
        ("EO1", "EO1"),
        ("E200", "EO1"),
        ("E300", "EO1"),
        ("PEFA", "PEFA"),
