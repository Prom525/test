        ("KOOKSLIJN KOFA1", "KOFA1"),
        ("KOFA 1", "KOFA1"),
        ("KOFA1", "KOFA1"),
        ("KOOKSLIJN KOFA2", "KOFA2"),
        ("KOFA 2", "KOFA2"),
