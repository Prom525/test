RE_SHEET_DATE = re.compile(
    r"^\s*(\d{1,2})\s*-\s*(\d{1,2})\s*-\s*(\d{2,4})\s*$"
)

# 05 & 06-03-24 / 11&13-09-18
RE_SHEET_DATE_RANGE = re.compile(
    r"^\s*(\d{1,2})\s*[&+]\s*(\d{1,2})\s*-\s*(\d{1,2})\s*-\s*(\d{2,4})\s*$"
)

# 19-01 & 20-01-26 / 30-06 & 03-07-25
RE_SHEET_DATE_RANGE_FULL = re.compile(
    r"^\s*(\d{1,2})\s*-\s*(\d{1,2})\s*[&+]\s*"
    r"\d{1,2}\s*-\s*\d{1,2}\s*-\s*(\d{2,4})\s*$"
)
RE_WEEK_ANY = re.compile(r"^\s*week\s*\d+\s*$", re.I)
RE_WEEK_EXTRACT = re.compile(r"(?i)\bweek\b\W*0*(\d{1,2})\b")
RE_YEAR_ONLY = re.compile(r"^\s*((?:19|20)\d{2})\s*$")

