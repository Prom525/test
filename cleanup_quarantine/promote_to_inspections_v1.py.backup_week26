def is_known_auxiliary_sheet(source_file: str, sheet: str) -> bool:
    filename = PureWindowsPath(source_file or "").name.strip().lower()

    sheet_label = re.sub(
        r"\s+",
        " ",
        (sheet or "").strip(),
    ).lower()

    return (filename, sheet_label) in KNOWN_AUXILIARY_SHEETS

def parse_dutch_date_string(raw: str) -> date | None:
    raw = (raw or "").strip()
    if not raw:
        return None

    m = RE_DUTCH_DATE.search(raw)
    if not m:
        return None

    d = int(m.group(1))
    month_raw = m.group(2).lower()
    y = normalize_two_digit_year(int(m.group(3)))

    month_num = DUTCH_MONTHS.get(month_raw) or DUTCH_MONTHS.get(month_raw[:3])
    if month_num is None:
        return None

    return build_valid_date(y, month_num, d)


def parse_date_string(raw: str) -> date | None:
    raw = (raw or "").strip()
    if not raw:
        return None

    # Excel-typo zoals 31_05-13.
    raw = re.sub(r"(?<=\d)_(?=\d)", "-", raw)

    # 1. ISO datetime eerst
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S"):
        try:
            dt = datetime.strptime(raw, fmt).date()
            return dt if is_reasonable_inspection_date(dt) else None
        except ValueError:
            pass

    # 2. ISO date direct
    try:
        dt = datetime.strptime(raw, "%Y-%m-%d").date()
        return dt if is_reasonable_inspection_date(dt) else None
    except ValueError:
        pass

    # 3. Nederlandse datum met maandnaam
    dt = parse_dutch_date_string(raw)
    if dt:
        return dt

    # 4. overige bekende formaten
    for fmt in ("%d-%m-%Y", "%d-%m-%y", "%d/%m/%Y", "%d/%m/%y", "%d.%m.%Y", "%d.%m.%y"):
        try:
            dt = datetime.strptime(raw, fmt).date()
            return dt if is_reasonable_inspection_date(dt) else None
        except ValueError:
            pass

    # 5. fragmenten
    iso_fragment = re.search(r"\b(\d{4}-\d{2}-\d{2})(?:\s+\d{2}:\d{2}:\d{2})?\b", raw)
    if iso_fragment:
        frag = iso_fragment.group(1)
        try:
            dt = datetime.strptime(frag, "%Y-%m-%d").date()
            return dt if is_reasonable_inspection_date(dt) else None
        except ValueError:
            pass

    numeric_fragment = re.search(r"\b(\d{1,2}[-/.]\d{1,2}[-/.]\d{2,4})\b", raw)
    if numeric_fragment:
        frag = numeric_fragment.group(1)
        for fmt in ("%d-%m-%Y", "%d-%m-%y", "%d/%m/%Y", "%d/%m/%y", "%d.%m.%Y", "%d.%m.%y"):
            try:
                dt = datetime.strptime(frag, fmt).date()
                return dt if is_reasonable_inspection_date(dt) else None
            except ValueError:
                pass

    dutch_fragment = RE_DUTCH_DATE.search(raw)
    if dutch_fragment:
        return parse_dutch_date_string(dutch_fragment.group(0))

    return None


def parse_any_date_value(raw) -> tuple[date | None, str | None]:
    s = "" if raw is None else str(raw).strip()
    if not s:
        return None, None

    d = parse_date_string(s)
    if d:
        return d, s

    return None, None


def is_target_excel_source(source_file: str) -> bool:
    if not source_file:
        return False

    sf = source_file.lower()
    if ROOT_PATH.lower() not in sf:
        return False
    if not sf.endswith((".xls", ".xlsx", ".xlsm", ".xlsb")):
        return False
    if os.path.basename(sf) == "totaal.xlsx":
        return False

    parts = [p.lower() for p in PureWindowsPath(source_file).parts]
    return any(part.startswith("lijsten") for part in parts)


