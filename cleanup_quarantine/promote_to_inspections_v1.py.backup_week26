def ensure_schema(conn) -> None:
    conn.execute(text("""
      create table if not exists sb_inspections_v0 (
        id bigserial primary key,
        inspection_key text unique,
        customer_code text,
        site_code text,
        lijn_code text not null,
        source_file text not null,
        sheet text not null,
        sheet_norm text,
        sheet_kind text,
        inspected_on date,
        inspected_on_source text,
        performed_by text,
        title text,
        row_count int,
        created_at timestamptz default now()
      )
    """))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists customer_code text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists site_code text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists sheet_norm text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists sheet_kind text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists inspected_on_source text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists performed_by text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists title text"))
    conn.execute(text("alter table sb_inspections_v0 add column if not exists row_count int"))


def main(mode: str = "incremental") -> None:
    engine = create_engine(DB_URL)

    if mode == "full-rebuild":
        q_groups = text("""
          select customer_code, site_code, source_file, sheet, count(*) as row_count
          from sb_stg_inspecties_raw
          where customer_code is not null
            and site_code is not null
            and source_file is not null
            and sheet is not null
          group by customer_code, site_code, source_file, sheet
          order by customer_code, site_code, source_file, sheet
        """)
    else:
        q_groups = text("""
          select
              r.customer_code,
              r.site_code,
              r.source_file,
              r.sheet,
              count(*) as row_count
          from sb_stg_inspecties_raw r
          join vw_changed_inspection_sheets_todo_v1 c
            on c.customer_code = r.customer_code
           and c.site_code = r.site_code
           and c.source_file = r.source_file
           and c.sheet = r.sheet
          where r.customer_code is not null
            and r.site_code is not null
            and r.source_file is not null
            and r.sheet is not null
          group by r.customer_code, r.site_code, r.source_file, r.sheet
          order by r.customer_code, r.site_code, r.source_file, r.sheet
        """)

    q_header_scan = text("""
      select
        row_nr,
        trim(coalesce(data->'row'->>'Unnamed: 0','')) as u0,
        trim(coalesce(data->'row'->>'Unnamed: 1','')) as u1,
        trim(coalesce(data->'row'->>'Unnamed: 2','')) as u2,
        trim(coalesce(data->'row'->>'Unnamed: 3','')) as u3,
        trim(coalesce(data->'row'->>'Unnamed: 4','')) as u4
      from sb_stg_inspecties_raw
      where customer_code = :customer_code
        and site_code = :site_code
        and source_file = :source_file
        and sheet = :sheet
        and row_nr between 0 and 15
      order by row_nr
    """)

    q_performed_by = text("""
      select trim(coalesce(data->'row'->>'Unnamed: 3','')) as v
      from sb_stg_inspecties_raw
      where customer_code = :customer_code
        and site_code = :site_code
        and source_file = :source_file
        and sheet = :sheet
        and lower(trim(coalesce(data->'row'->>'Unnamed: 0',''))) like 'uitgevoerd door%'
      order by row_nr
      limit 1
    """)

    q_title = text("""
      select trim(coalesce(data->'row'->>'Unnamed: 0','')) as v
      from sb_stg_inspecties_raw
      where customer_code = :customer_code
        and site_code = :site_code
        and source_file = :source_file
        and sheet = :sheet
        and row_nr = 5
        and coalesce(data->'row'->>'Unnamed: 0','') <> ''
      limit 1
    """)

    upsert = text("""
      insert into sb_inspections_v0
        (
          inspection_key,
          customer_code,
          site_code,
          lijn_code,
          source_file,
          sheet,
          sheet_norm,
          sheet_kind,
          inspected_on,
          inspected_on_source,
          performed_by,
          title,
          row_count
        )
      values
        (
          :inspection_key,
          :customer_code,
          :site_code,
          :lijn_code,
          :source_file,
          :sheet,
          :sheet_norm,
          :sheet_kind,
          :inspected_on,
          :inspected_on_source,
          :performed_by,
          :title,
          :row_count
        )
      on conflict (inspection_key) do update
        set customer_code = excluded.customer_code,
            site_code = excluded.site_code,
            lijn_code = excluded.lijn_code,
            sheet_norm = excluded.sheet_norm,
            sheet_kind = excluded.sheet_kind,
            inspected_on = excluded.inspected_on,
            inspected_on_source = excluded.inspected_on_source,
            performed_by = excluded.performed_by,
            title = excluded.title,
            row_count = excluded.row_count
    """)

    total = 0
    no_date = 0
    skipped_non_target = 0
    skipped_auxiliary = 0
    invalid_date_rejections = 0

    with engine.begin() as conn:
        ensure_schema(conn)

        if mode == "full-rebuild":
            logger.info("FULL REBUILD: sb_inspections_v0 volledig opnieuw opbouwen ...")
            conn.execute(text("TRUNCATE TABLE sb_inspections_v0 RESTART IDENTITY CASCADE"))

        groups = conn.execute(q_groups).fetchall()
        logger.info("groups: %s", len(groups))

        if mode == "incremental" and not groups:
            logger.info("INCREMENTAL: geen changed sheets gevonden. Niets te doen.")
            return

        for customer_code, site_code, source_file, sheet, row_count in groups:
            if is_known_auxiliary_sheet(source_file, sheet):
                skipped_auxiliary += 1
                continue

            if not is_target_excel_source(source_file):
                skipped_non_target += 1
                continue

            lijn_code = infer_lijn_code_from_source(source_file)
            sk = sheet_kind(sheet)
            sn = normalize_sheet(sheet)

            inspected: date | None = None
            source: str | None = None

            logger.info(
                "Parsing customer=%s | site=%s | file=%s | sheet=%s",
                customer_code,
                site_code,
                source_file,
                sheet,
            )

            sheet_dt = parse_sheet_date(sheet)
            if sheet_dt:
                inspected = sheet_dt
                source = "sheet"

            if not inspected:
                header_rows = conn.execute(
                    q_header_scan,
                      {
                        "customer_code": customer_code,
                        "site_code": site_code,
                        "source_file": source_file,
                        "sheet": sheet,
                    },
                ).fetchall()

                for r in header_rows:
                    row_values = [
                        str(r.u0 or "").strip(),
                        str(r.u1 or "").strip(),
                        str(r.u2 or "").strip(),
                        str(r.u3 or "").strip(),
                        str(r.u4 or "").strip(),
                    ]

                    row_lower = " ".join(v.lower() for v in row_values if v)
                    if "datum" not in row_lower:
                        continue

                    for idx in range(len(row_values) - 1, -1, -1):
                        raw_val = row_values[idx]
                        d = parse_dutch_date_string(raw_val)
                        if d:
                            inspected = d
                            source = f"header_dutch_field_r{int(r.row_nr)}_c{idx}"
                            break
                    if inspected:
                        break

                    for idx in range(len(row_values) - 1, -1, -1):
                        raw_val = row_values[idx]
                        d = parse_date_string(raw_val)
                        if d:
                            inspected = d
                            source = f"header_field_r{int(r.row_nr)}_c{idx}"
                            break
                    if inspected:
                        break

                    combined = " ".join(v for v in row_values if v).strip()

                    d = parse_dutch_date_string(combined)
                    if d:
                        inspected = d
                        source = f"header_dutch_row_r{int(r.row_nr)}"
                        break

                    d = parse_date_string(combined)
                    if d:
                        inspected = d
                        source = f"header_row_r{int(r.row_nr)}"
                        break

            if not inspected:
                year_dt = parse_year_only_sheet(sheet)
                if year_dt:
                    inspected = year_dt
                    source = "sheet_year_only"

            if inspected and not is_reasonable_inspection_date(inspected):
                inspected = None
                source = None
                invalid_date_rejections += 1

            if not inspected:
                no_date += 1
                logger.warning(
                    "SKIP GEEN DATUM: customer=%s | site=%s | file=%s | sheet=%s | kind=%s",
                    customer_code,
                    site_code,
                    source_file,
                    sheet,
                    sk,
                )
                continue

            performed = conn.execute(
                q_performed_by,
                {
                    "customer_code": customer_code,
                    "site_code": site_code,
                    "source_file": source_file,
                    "sheet": sheet,
                },
            ).scalar()
            performed = (performed or "").strip() or None

            title = conn.execute(
                q_title,
                {
                    "customer_code": customer_code,
                    "site_code": site_code,
                    "source_file": source_file,
                    "sheet": sheet,
                },
            ).scalar()
            title = (title or "").strip() or None

            inspection_key = (
                f"{customer_code}|{site_code}|{source_file}|{sn}|{inspected.isoformat()}"
            )
            logger.info(
                "Datum gevonden: file=%s | sheet=%s | inspected_on=%s | source=%s",
                source_file, sheet, inspected.isoformat(), source
            )

            conn.execute(
                upsert,
                {
                    "inspection_key": inspection_key,
                    "customer_code": customer_code,
                    "site_code": site_code,
                    "lijn_code": lijn_code,
                    "source_file": source_file,
                    "sheet": sheet,
                    "sheet_norm": sn,
                    "sheet_kind": sk,
                    "inspected_on": inspected,
                    "inspected_on_source": source,
                    "performed_by": performed,
                    "title": title,
                    "row_count": int(row_count),
                },
            )

            total += 1
            if total % 250 == 0:
                logger.info("processed %s", total)

    logger.info("DONE inspections upserted: %s", total)
    logger.info("DONE inspections without date: %s", no_date)
    logger.info("DONE skipped auxiliary sheets: %s", skipped_auxiliary)
    logger.info("DONE skipped non-target sheets: %s", skipped_non_target)
    logger.info("DONE invalid date rejections: %s", invalid_date_rejections)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Promote Excel inspection headers naar sb_inspections_v0"
    )
    parser.add_argument(
        "--mode",
        choices=["incremental", "full-rebuild"],
        default="incremental",
        help="incremental = alleen changed sheets; full-rebuild = volledige herbouw",
    )
    args = parser.parse_args()

    main(mode=args.mode)