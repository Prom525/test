    },
    "/analysis/context/org/function-info": {
      "post": {
        "tags": [
          "org-context"
        ],
        "operationId": "function_info",
        "x-openai-isConsequential": false,
        "summary": "Haal functieomschrijving en gekoppelde personen op",
        "description": "Gebruik dit endpoint voor vragen over functies, functieomschrijvingen, kerntaken, bevoegdheden, KPI's, VCA-verantwoordelijkheden en wie welke functie heeft binnen Promati.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["q"],
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "De volledige originele gebruikersvraag."
                  },
                  "person_name": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optioneel: naam van de persoon, bijvoorbeeld John Koenders."
                  },
                  "functie_code": {
                    "type": "string",
                    "nullable": true,
                    "description": "Optioneel: functie_code, bijvoorbeeld TECHNICUS_VCA_COORDINATOR."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Functie-informatie gevonden of not_found status.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "query": {
                      "type": "string"
                    },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "write_actions_available": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
