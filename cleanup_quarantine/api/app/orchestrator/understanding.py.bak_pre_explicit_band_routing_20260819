    FamilyPattern(
        code="BB-U",
        patterns=(
            r"\bbelle\s+banne\s+u\b",
            r"\bbb[\s-]*u\b",
            r"\bbb[\s-]*u\s*\d{3,4}\b",
            r"\bu(?:\s+\d{3,4})?\s+bb\s+schraper\b",
            r"\bu(?:\s+\d{3,4})?\s+schraper\b",
        ),
    ),
    FamilyPattern(
        code="BB-H",
        patterns=(
            r"\bbelle\s+banne\s+h\b",
            r"\bbb[\s-]*h\b",
            r"\bh(?:\s+\d{3,4})?\s+bb\s+schraper\b",
            r"\bh(?:\s+\d{3,4})?\s+schraper\b",
        ),
    ),
    FamilyPattern(
        code="BB-P",
        patterns=(
            r"\bbelle\s+banne\s+p\b",
            r"\bbb[\s-]*p\b",
            r"\bp(?:\s+\d{3,4})?\s+schraper\b",
        ),
    ),
    FamilyPattern(
        code="BB-R",
        patterns=(
            r"\bbelle\s+banne\s+r\b",
            r"\bbb[\s-]*r\b",
            r"\br(?:\s+\d{3,4})?\s+schraper\b",
        ),
    ),
    FamilyPattern(
        code="PROM-KF",
        patterns=(
            r"\bpromati\s+kf\b",
            r"\bkf[\s-]*schraper\b",
        ),
    ),
    FamilyPattern(
        code="PROM-KS",
        patterns=(
            r"\bpromati\s+ks\b",
            r"\bks[\s-]*schraper\b",
        ),
    ),
    FamilyPattern(
        code="PROM-TPH-HD",
        patterns=(
            r"\btph[\s-]*hd\b",
