    {assumptions_html}

    {advice_html}

    {internal_html}

    <div class="footer">
      Concept specificatieblad gegenereerd door Promati RFQ systeem. Controle door engineering blijft vereist vóór vrijgave aan klant of leverancier.
    </div>
  </div>
</body>
</html>
"""
    return HTMLResponse(content=html_doc)


@router.get("/{rfq_id}/positions/{position_id}/datasheet/pdf")
def get_rfq_position_datasheet_pdf(
    rfq_id: str,
    position_id: str,
    commercial_approved: bool = Query(default=False),
    view_mode: str = Query(default="internal", pattern="^(internal|supplier)$"),
):
    from weasyprint import HTML
    from fastapi.responses import Response

    html_response = get_rfq_position_datasheet_html(
        rfq_id,
        position_id,
        commercial_approved=commercial_approved,
        view_mode=view_mode,
    )
    html_content = html_response.body.decode("utf-8")

    pdf_bytes = HTML(string=html_content).write_pdf()

    filename = f"trommel-datasheet-{rfq_id}-{position_id}.pdf"

    return Response(
        content=pdf_bytes,
        media_type="application/pdf",
        headers={
            "Content-Disposition": f'attachment; filename="{filename}"'
        },
    )


@router.post("/{rfq_id}/positions/{position_id}/datasheet/pdf/generate")
def generate_rfq_position_datasheet_pdf_artifact(
    rfq_id: str,
    position_id: str,
    commercial_approved: bool = Query(default=False),
    view_mode: str = Query(default="internal", pattern="^(internal|supplier)$"),
):
    from weasyprint import HTML

    html_response = get_rfq_position_datasheet_html(
        rfq_id,
        position_id,
        commercial_approved=commercial_approved,
        view_mode=view_mode,
    )
    html_content = html_response.body.decode("utf-8")

    pdf_bytes = HTML(string=html_content).write_pdf()

    doc_type = "SUPPLIER_RFQ" if view_mode == "supplier" else "INTERNAL_ENGINEERING"

    artifact_type = (
        "supplier_package_pdf"
        if view_mode == "supplier"
        else "internal_engineering_pdf"
    )

    filename = f"RFQ_{rfq_id}_POS_{position_id}_{doc_type}_TROMMEL_DATASHEET.pdf"

    upload_result = upload_pdf_artifact(
        rfq_id=rfq_id,
        position_id=position_id,
        filename=filename,
        pdf_bytes=pdf_bytes,
    )

    artifact = execute_one(
        """
        INSERT INTO rfq.artifact (
            rfq_id,
            position_id,
            artifact_type,
            file_name,
            object_key,
            content_type,
            file_size_bytes,
            sha256
        )
        VALUES (
            :rfq_id,
            :position_id,
            :artifact_type,
            :file_name,
            :object_key,
            'application/pdf',
            :file_size_bytes,
            :sha256
        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "artifact_type": artifact_type,
            "file_name": filename,
            "object_key": upload_result["object_key"],
            "file_size_bytes": upload_result["file_size_bytes"],
            "sha256": upload_result["sha256"],
        },
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "datasheet_pdf_artifact",
        "artifact": dict(artifact),
        "write_actions_available": True,
    }


@router.get("/{rfq_id}/positions/{position_id}/datasheet/pdf-url")
def get_rfq_position_datasheet_pdf_url(
    rfq_id: str,
    position_id: str,
    request: Request,
):
    artifact = fetch_one(
        """
        SELECT *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
          AND artifact_type = 'datasheet_pdf'
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if artifact:
        download_path = f"/analysis/rfq/artifacts/{artifact['artifact_id']}/download"
        absolute_url = str(request.base_url).rstrip("/") + download_path

        return {
            "status": "ok",
            "domain": "rfq",
            "type": "datasheet_pdf_artifact_url",
            "rfq_id": rfq_id,
            "position_id": position_id,
            "artifact_id": artifact["artifact_id"],
            "file_name": artifact["file_name"],
            "sha256": artifact["sha256"],
            "absolute_download_url": absolute_url,
            "source": "stored_artifact",
            "write_actions_available": False,
        }

    pdf_path = (
        f"/analysis/rfq/{rfq_id}/positions/"
        f"{position_id}/datasheet/pdf"
    )
    absolute_url = str(request.base_url).rstrip("/") + pdf_path

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "datasheet_pdf_live_url",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "absolute_download_url": absolute_url,
        "source": "live_pdf",
        "write_actions_available": False,
    }


@router.get("/artifacts/{artifact_id}/download")
def download_rfq_artifact(artifact_id: str):
    from fastapi.responses import StreamingResponse

    artifact = fetch_one(
        """
        SELECT *
        FROM rfq.artifact
        WHERE artifact_id = :artifact_id
        """,
        {"artifact_id": artifact_id},
    )

    if not artifact:
        raise HTTPException(status_code=404, detail="Artifact not found")

    try:
        response = minio_client.get_object(
            bucket_name=MINIO_BUCKET,
            object_name=artifact["object_key"],
        )
    except Exception as exc:
        raise HTTPException(
            status_code=404,
            detail=f"Artifact object not found in MinIO: {exc}",
        )

    return StreamingResponse(
        response,
        media_type=artifact.get("content_type") or "application/octet-stream",
        headers={
            "Content-Disposition": f'attachment; filename="{artifact["file_name"]}"'
        },
    )


@router.get("/{rfq_id}/artifacts")
def list_rfq_artifacts(rfq_id: str, request: Request):
    artifacts = fetch_all(
        """
        SELECT *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
        ORDER BY extracted_at DESC
        """,
        {"rfq_id": rfq_id},
    )

    result = []
    for artifact in artifacts:
        download_path = f"/analysis/rfq/artifacts/{artifact['artifact_id']}/download"
        absolute_url = str(request.base_url).rstrip("/") + download_path

        result.append({
            "artifact_id": artifact["artifact_id"],
            "rfq_id": artifact["rfq_id"],
            "position_id": artifact["position_id"],
            "artifact_type": artifact["artifact_type"],
            "file_name": artifact["file_name"],
            "content_type": artifact["content_type"],
            "file_size_bytes": artifact["file_size_bytes"],
            "sha256": artifact["sha256"],
            "extracted_at": artifact["extracted_at"],
            "absolute_download_url": absolute_url,
        })

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "rfq_artifacts",
        "rfq_id": rfq_id,
        "count": len(result),
        "artifacts": result,
        "write_actions_available": False,
    }


@router.get("/{rfq_id}/artifacts/latest")
def list_latest_rfq_artifacts(rfq_id: str, request: Request):
    rows = fetch_all(
        """
        SELECT DISTINCT ON (artifact_type)
            *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
          AND artifact_type IN (
              'supplier_package_pdf',
              'internal_engineering_pdf'
          )
        ORDER BY artifact_type, extracted_at DESC
        """,
        {"rfq_id": rfq_id},
    )

    result = []
    for artifact in rows:
        download_path = f"/analysis/rfq/artifacts/{artifact['artifact_id']}/download"
        absolute_url = str(request.base_url).rstrip("/") + download_path

        result.append({
            "artifact_id": artifact["artifact_id"],
            "artifact_type": artifact["artifact_type"],
            "file_name": artifact["file_name"],
            "position_id": artifact["position_id"],
            "extracted_at": artifact["extracted_at"],
            "absolute_download_url": absolute_url,
        })

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "latest_rfq_artifacts",
        "rfq_id": rfq_id,
        "count": len(result),
        "artifacts": result,
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/suppliers/select")
def select_suppliers_for_rfq(rfq_id: str, payload: SupplierSelectIn):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    selected = []
    for rank, supplier_id in enumerate(payload.supplier_ids, start=1):
        supplier = fetch_one("SELECT * FROM rfq.supplier WHERE supplier_id = :supplier_id", {"supplier_id": supplier_id})
        if not supplier:
            raise HTTPException(status_code=404, detail=f"Leverancier niet gevonden: {supplier_id}")
        row = execute_one(
            """
            INSERT INTO rfq.request_supplier (rfq_id, supplier_id, selection_rank, selection_reason, selected_by)
            VALUES (:rfq_id, :supplier_id, :selection_rank, :selection_reason, :selected_by)
            RETURNING *
            """,
            {"rfq_id": rfq_id, "supplier_id": supplier_id, "selection_rank": rank, "selection_reason": payload.notes, "selected_by": payload.selected_by},
        )
        selected.append(row)
        execute_one(
            """
            INSERT INTO rfq.supplier_rfq_event (rfq_id, supplier_id, event_type, event_note)
            VALUES (:rfq_id, :supplier_id, 'RFQ_SENT', :event_note)
            RETURNING supplier_rfq_event_id
            """,
            {"rfq_id": rfq_id, "supplier_id": supplier_id, "event_note": payload.notes},
        )
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, final_decision, approved_by, approved_at)
        VALUES (:rfq_id, 'SUPPLIERS_SELECTED', CAST(:final_decision AS jsonb), :approved_by, now())
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "final_decision": json_dumps({"selected_suppliers": selected, "notes": payload.notes}), "approved_by": payload.selected_by},
    )
    return {"intent": "rfq_suppliers_selected", "rfq_id": rfq_id, "selected": selected}


@router.post("/{rfq_id}/suppliers/event")
def add_supplier_event(rfq_id: str, payload: SupplierEventIn):
    rfq = fetch_one("SELECT rfq_id FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    event = execute_one(
        """
        INSERT INTO rfq.supplier_rfq_event (rfq_id, supplier_id, event_type, event_note, offer_value, order_value, response_days)
        VALUES (:rfq_id, :supplier_id, :event_type, :event_note, :offer_value, :order_value, :response_days)
        RETURNING *
        """,
        {"rfq_id": rfq_id, **payload.model_dump()},
    )
    return {"intent": "rfq_supplier_event_added", "event": event}


@router.post("/{rfq_id}/canonical/build")
def build_canonical_model(rfq_id: str):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    positions = fetch_all("SELECT * FROM rfq.position WHERE rfq_id = :rfq_id ORDER BY pos_nr", {"rfq_id": rfq_id})
    suppliers = fetch_all(
        """
        SELECT rs.*, s.supplier_name
        FROM rfq.request_supplier rs
        LEFT JOIN rfq.supplier s ON s.supplier_id = rs.supplier_id
        WHERE rs.rfq_id = :rfq_id
        ORDER BY rs.selection_rank
        """,
        {"rfq_id": rfq_id},
    )
    missing_data, assumptions, warnings = [], [], []
    for p in positions:
        for field in p.get("missing_fields") or []:
            item = f"{p.get('pos_nr')}: {field}"
            if item not in missing_data:
                missing_data.append(item)
    if rfq.get("selected_route") == "OEM":
        assumptions.append("OEM-route: prijs, levertijd en reproduceerbaarheid zijn leidend.")
    elif rfq.get("selected_route") == "PREMIUM":
        assumptions.append("Premium-route: betrouwbaarheid, documentatie en levensduur zijn leidend.")
    else:
        warnings.append("Geen definitieve OEM/Premium-route gekozen.")
    if not suppliers:
        warnings.append("Nog geen leveranciers geselecteerd.")
    if not positions:
        warnings.append("Nog geen posities vastgelegd.")

    canonical = {
        "customer_context": {"customer_type": rfq.get("customer_type"), "selected_route": rfq.get("selected_route"), "customer_value_score": rfq.get("customer_value_score"), "customer_context": rfq.get("customer_context")},
        "conveyor_data": {"source": "nog niet volledig ingevuld", "request_type": rfq.get("request_type")},
        "engineering_requirements": {"route": rfq.get("selected_route"), "product_scope": sorted(list({p.get("product_type") for p in positions if p.get("product_type")}))},
        "documentation_requirements": {"material_certificates": "onbekend", "fat": "onbekend", "manuals": "onbekend"},
        "commercial_strategy": {"verkoper": rfq.get("verkoper"), "odoo_reference": rfq.get("odoo_reference"), "customer_name_on_supplier_pdf": False},
        "supplier_strategy": {"selected_suppliers": suppliers, "approval_required_before_sending": True},
        "position_summary": positions,
        "missing_data": missing_data,
        "assumptions": assumptions,
        "warnings": warnings,
    }
    row = execute_one(
        """
        INSERT INTO rfq.canonical_model (
            rfq_id, customer_context, conveyor_data, engineering_requirements, documentation_requirements,
            commercial_strategy, supplier_strategy, position_summary, missing_data, assumptions, warnings
        ) VALUES (
            :rfq_id, CAST(:customer_context AS jsonb), CAST(:conveyor_data AS jsonb), CAST(:engineering_requirements AS jsonb),
            CAST(:documentation_requirements AS jsonb), CAST(:commercial_strategy AS jsonb), CAST(:supplier_strategy AS jsonb),
            CAST(:position_summary AS jsonb), CAST(:missing_data AS jsonb), CAST(:assumptions AS jsonb), CAST(:warnings AS jsonb)
        ) RETURNING *
        """,
        {"rfq_id": rfq_id, **{k: json_dumps(v) for k, v in canonical.items()}},
    )
    execute_one("INSERT INTO rfq.decision_log (rfq_id, step, gpt_suggestion) VALUES (:rfq_id, 'CANONICAL_MODEL_BUILT', CAST(:gpt_suggestion AS jsonb)) RETURNING decision_id", {"rfq_id": rfq_id, "gpt_suggestion": json_dumps(canonical)})
    return {"intent": "rfq_canonical_model_built", "rfq_id": rfq_id, "canonical_model": row}


@router.get("/{rfq_id}/canonical/latest")
def get_latest_canonical_model(rfq_id: str):
    row = fetch_one("SELECT * FROM rfq.vw_rfq_canonical_latest WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not row:
