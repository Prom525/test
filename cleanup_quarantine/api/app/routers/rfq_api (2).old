    }


@router.post("/{rfq_id}/pdf/generate")
def generate_rfq_pdf(rfq_id: str, approved_by: str = Query(..., min_length=1)):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    positions = fetch_all("SELECT * FROM rfq.position WHERE rfq_id = :rfq_id ORDER BY pos_nr", {"rfq_id": rfq_id})
    if not positions:
        raise HTTPException(status_code=400, detail="Geen posities aanwezig. PDF kan niet worden gemaakt.")
    suppliers = fetch_all("SELECT rs.*, s.supplier_name FROM rfq.request_supplier rs LEFT JOIN rfq.supplier s ON s.supplier_id = rs.supplier_id WHERE rs.rfq_id = :rfq_id ORDER BY rs.selection_rank", {"rfq_id": rfq_id})
    pdf_name = f"{safe_file_part(rfq.get('odoo_reference'))}_{rfq_id}_{RFQ_TEMPLATE_VERSION}.pdf"
    pdf_path = RFQ_PDF_DIR / pdf_name
    build_supplier_package_pdf_landscape(
        rfq=rfq,
        positions=positions,
        output_path=pdf_path,
    )
    pdf_hash = sha256_file(pdf_path)
    snapshot = {"template_version": RFQ_TEMPLATE_VERSION, "approved_by": approved_by, "pdf_rules": {"customer_name_on_pdf": False, "only_odoo_reference": True}, "rfq": {"rfq_id": rfq.get("rfq_id"), "odoo_reference": rfq.get("odoo_reference"), "request_type": rfq.get("request_type"), "customer_type": rfq.get("customer_type"), "selected_route": rfq.get("selected_route")}, "positions": positions, "suppliers": suppliers}
    pdf_row = execute_one(
        """
        INSERT INTO rfq.pdf_output (rfq_id, template_version, input_snapshot, pdf_path, pdf_hash_sha256)
        VALUES (:rfq_id, :template_version, CAST(:input_snapshot AS jsonb), :pdf_path, :pdf_hash_sha256)
        RETURNING *
        """,
        {"rfq_id": rfq_id, "template_version": RFQ_TEMPLATE_VERSION, "input_snapshot": json_dumps(snapshot), "pdf_path": str(pdf_path), "pdf_hash_sha256": pdf_hash},
    )
    execute_one("INSERT INTO rfq.decision_log (rfq_id, step, final_decision, approved_by, approved_at) VALUES (:rfq_id, 'PDF_GENERATED', CAST(:final_decision AS jsonb), :approved_by, now()) RETURNING decision_id", {"rfq_id": rfq_id, "final_decision": json_dumps({"pdf_id": pdf_row["pdf_id"], "pdf_path": str(pdf_path), "pdf_hash_sha256": pdf_hash, "template_version": RFQ_TEMPLATE_VERSION}), "approved_by": approved_by})
    return {"intent": "rfq_pdf_generated", "rfq_id": rfq_id, "pdf": pdf_row, "download_url": f"/analysis/rfq/{rfq_id}/pdf/latest"}


