            CAST(:documentation_requirements AS jsonb), CAST(:commercial_strategy AS jsonb), CAST(:supplier_strategy AS jsonb),
            CAST(:position_summary AS jsonb), CAST(:missing_data AS jsonb), CAST(:assumptions AS jsonb), CAST(:warnings AS jsonb)
        ) RETURNING *
        """,
        {"rfq_id": rfq_id, "customer_context": json_dumps(payload.customer_context), "conveyor_data": json_dumps(payload.conveyor_data), "engineering_requirements": json_dumps(payload.engineering_requirements), "documentation_requirements": json_dumps(payload.documentation_requirements), "commercial_strategy": json_dumps(payload.commercial_strategy), "supplier_strategy": json_dumps(payload.supplier_strategy), "position_summary": json_dumps(payload.position_summary), "missing_data": json_dumps(payload.missing_data), "assumptions": json_dumps(payload.assumptions), "warnings": json_dumps(payload.warnings)},
    )
    return {"intent": "rfq_canonical_manual_created", "canonical_model": row}


@router.post("/{rfq_id}/canonical/approve")
def approve_latest_canonical_model(rfq_id: str, payload: CanonicalApproveIn):
    latest = fetch_one("SELECT canonical_id FROM rfq.vw_rfq_canonical_latest WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not latest:
        raise HTTPException(status_code=404, detail="Geen canonical model gevonden")
    row = execute_one(
        """
        UPDATE rfq.canonical_model
        SET approved = true, approved_by = :approved_by, approved_at = now(), updated_at = now()
        WHERE canonical_id = :canonical_id
        RETURNING *
        """,
        {"canonical_id": latest["canonical_id"], "approved_by": payload.approved_by},
    )
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, final_decision, approved_by, approved_at)
        VALUES (:rfq_id, 'CANONICAL_MODEL_APPROVED', CAST(:final_decision AS jsonb), :approved_by, now())
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "final_decision": json_dumps({"canonical_id": row["canonical_id"], "model_version": row["model_version"]}), "approved_by": payload.approved_by},
    )
    return {"intent": "rfq_canonical_model_approved", "canonical_model": row}


