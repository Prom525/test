    }


@router.post("/{rfq_id}/pdf/generate-from-canonical")
def generate_rfq_pdf_from_canonical(
    rfq_id: str,
    approved_by: str = Query(..., min_length=1),
    require_approved: bool = Query(default=True),
    language: str = Query(default="nl", pattern="^(nl|en|de|fr)$"),
):
    canonical = fetch_one("SELECT * FROM rfq.vw_rfq_canonical_latest WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not canonical:
        raise HTTPException(status_code=404, detail="Geen canonical model gevonden")
    if require_approved and not canonical.get("approved"):
        raise HTTPException(status_code=400, detail="Canonical model is nog niet goedgekeurd. Keur eerst goed of gebruik require_approved=false.")
    if not (canonical.get("position_summary") or []):
        raise HTTPException(status_code=400, detail="Canonical model bevat geen posities.")

    pdf_name = f"{safe_file_part(canonical.get('odoo_reference'))}_{rfq_id}_{canonical.get('model_version')}_{RFQ_TEMPLATE_VERSION}_{language}.pdf"
    pdf_path = RFQ_PDF_DIR / pdf_name
    build_rfq_pdf_from_canonical(canonical=canonical, output_path=pdf_path, language=language)
    pdf_hash = sha256_file(pdf_path)
    snapshot = {
        "source": "canonical_model",
        "canonical_id": canonical.get("canonical_id"),
        "model_version": canonical.get("model_version"),
        "template_version": RFQ_TEMPLATE_VERSION,
        "language": language,
        "balancing": infer_balancing(canonical),
        "approved_by": approved_by,
        "pdf_rules": {"customer_name_on_pdf": False, "only_odoo_reference": True},
        "canonical_snapshot": canonical,
    }
    pdf_row = execute_one(
        """
        INSERT INTO rfq.pdf_output (rfq_id, template_version, input_snapshot, pdf_path, pdf_hash_sha256)
        VALUES (:rfq_id, :template_version, CAST(:input_snapshot AS jsonb), :pdf_path, :pdf_hash_sha256)
        RETURNING *
        """,
        {"rfq_id": rfq_id, "template_version": RFQ_TEMPLATE_VERSION, "input_snapshot": json_dumps(snapshot), "pdf_path": str(pdf_path), "pdf_hash_sha256": pdf_hash},
    )
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, final_decision, approved_by, approved_at)
        VALUES (:rfq_id, 'PDF_GENERATED_FROM_CANONICAL', CAST(:final_decision AS jsonb), :approved_by, now())
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "final_decision": json_dumps({"pdf_id": pdf_row["pdf_id"], "canonical_id": canonical.get("canonical_id"), "model_version": canonical.get("model_version"), "language": language, "pdf_path": str(pdf_path), "pdf_hash_sha256": pdf_hash, "template_version": RFQ_TEMPLATE_VERSION}), "approved_by": approved_by},
    )
    return {"intent": "rfq_pdf_generated_from_canonical", "rfq_id": rfq_id, "canonical_id": canonical.get("canonical_id"), "language": language, "pdf": pdf_row, "download_url": f"/analysis/rfq/{rfq_id}/pdf/latest"}


@router.post("/{rfq_id}/pdf/generate-all-languages")
def generate_rfq_pdf_all_languages(
    rfq_id: str,
    approved_by: str = Query(..., min_length=1),
    require_approved: bool = Query(default=True),
):
    generated = []
    for language in RFQ_LANGUAGES:
        result = generate_rfq_pdf_from_canonical(
            rfq_id=rfq_id,
            approved_by=approved_by,
            require_approved=require_approved,
            language=language,
        )
        generated.append({"language": language, "pdf": result["pdf"], "download_url": result["download_url"]})
    return {"intent": "rfq_pdfs_generated_all_languages", "rfq_id": rfq_id, "languages": RFQ_LANGUAGES, "generated": generated}


@router.get("/{rfq_id}/pdf/latest")
def download_latest_rfq_pdf(
    rfq_id: str,
    language: Optional[str] = Query(default=None, pattern="^(nl|en|de|fr)$"),
):
    where_extra = ""
    params = {"rfq_id": rfq_id}

    if language:
        where_extra = "AND input_snapshot->>'language' = :language"
        params["language"] = language

    pdf = fetch_one(
        f"""
        SELECT *
        FROM rfq.pdf_output
        WHERE rfq_id = :rfq_id
        {where_extra}
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        params,
    )

    if not pdf:
        raise HTTPException(status_code=404, detail="Geen PDF gevonden")

    pdf_path = Path(pdf["pdf_path"])

    if not pdf_path.exists():
        raise HTTPException(status_code=404, detail="PDF-bestand bestaat niet meer op schijf")

    return FileResponse(
        path=str(pdf_path),
        media_type="application/pdf",
        filename=pdf_path.name,
    )


@router.get("/{rfq_id}/pdf/latest-link")
def latest_rfq_pdf_link(
    rfq_id: str,
    language: Optional[str] = Query(default=None, pattern="^(nl|en|de|fr)$"),
):
    where_extra = ""
    params = {"rfq_id": rfq_id}

    if language:
        where_extra = "AND input_snapshot->>'language' = :language"
        params["language"] = language

    pdf = fetch_one(
        f"""
        SELECT
            pdf_id,
            rfq_id,
            template_version,
            input_snapshot->>'language' AS language,
            pdf_path,
            pdf_hash_sha256,
            extracted_at
        FROM rfq.pdf_output
        WHERE rfq_id = :rfq_id
        {where_extra}
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        params,
    )

    if not pdf:
        raise HTTPException(status_code=404, detail="Geen PDF gevonden")

    return {
        "intent": "rfq_pdf_latest_link",
        "rfq_id": rfq_id,
        "language": pdf.get("language") or language,
        "pdf_id": pdf.get("pdf_id"),
        "pdf_hash_sha256": pdf.get("pdf_hash_sha256"),
        "download_url": f"/analysis/rfq/{rfq_id}/pdf/latest?language={pdf.get('language') or language}",
        "absolute_download_url": f"https://uninveighing-nguyet-hilly.ngrok-free.dev/analysis/rfq/{rfq_id}/pdf/latest?language={pdf.get('language') or language}",
    }


@router.get("/{rfq_id}/pdf/list")
def list_rfq_pdfs(rfq_id: str):
    pdfs = fetch_all(
        """
