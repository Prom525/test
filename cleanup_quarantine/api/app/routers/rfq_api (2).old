# PLAATS HIER DE NIEUWE FUNCTIE
def save_pdf_artifact(
    rfq_id: str,
    position_id: str,
    artifact_type: str,
    filename: str,
    pdf_bytes: bytes,
):
    artifact_id = str(uuid4())

    output_dir = Path("/app/generated/rfq_artifacts")
    output_dir.mkdir(parents=True, exist_ok=True)

    file_path = output_dir / filename

    with open(file_path, "wb") as f:
        f.write(pdf_bytes)

    execute_one(
        """
        INSERT INTO rfq.pdf_output (
            artifact_id,
            rfq_id,
            position_id,
            output_type,
            filename,
            file_path
        ) VALUES (
            :artifact_id,
            :rfq_id,
            :position_id,
            :output_type,
            :filename,
            :file_path
        )
        """,
        {
            "artifact_id": artifact_id,
            "rfq_id": rfq_id,
            "position_id": position_id,
            "output_type": artifact_type,
            "filename": filename,
            "file_path": str(file_path),
        },
    )

    return {
        "artifact_id": artifact_id,
        "filename": filename,
        "file_path": str(file_path),
    }


