def extract_structured_specs_from_text(text: str) -> dict:
    raw = text or ""

    def find_number(pattern):
        match = re.search(pattern, raw, re.IGNORECASE)
        return float(match.group(1)) if match else None

    specs = {
        "diameter_mm": find_number(r"(?:diameter|ø|Ø)\s*[:\-]?\s*(\d{2,5})"),
        "drum_width_mm": find_number(r"(?:drum width|mantellengte|trommelbreedte)\s*[:\-]?\s*(\d{2,5})"),
        "shaft_diameter_mm": find_number(r"(?:shaft diameter|asdiameter)\s*[:\-]?\s*(\d{2,5})"),
        "bearing_housing": None,
        "bearing_type": None,
        "adapter_type": None,
        "seal_type": None,
        "balancing_norm": None,
        "tolerance_class": None,
        "surface_roughness": None,
        "part_number": None,
        "doc_number": None,
        "drawing_description": None,
    }

    part_number = re.search(r"\b\d{3}\.\d{3}\.\d{3}\b", raw)
    if part_number:
        specs["part_number"] = part_number.group(0)

    doc_number = re.search(r"\b\d{3}\.\d{3}\.\d{3}\.dwg\b", raw, re.IGNORECASE)
    if doc_number:
        specs["doc_number"] = doc_number.group(0)

    description = re.search(
        r"(Drive pulley[^\n\r]+D=\d+(?:[.,]\d+)?[^\n\r]*|Aandrijfrol[^\n\r]+D=\d+(?:[.,]\d+)?[^\n\r]*)",
        raw,
        re.IGNORECASE,
    )
    if description:
        specs["drawing_description"] = description.group(0).strip()

    diameter = re.search(
        r"\bD\s*=\s*(\d+(?:[.,]\d+)?)\b",
        raw,
        re.IGNORECASE,
    )
    if diameter:
        specs["diameter_mm"] = float(
            diameter.group(1).replace(",", ".")
        )

    bw = re.search(
        r"\b(?:bw|bb)\s*=\s*(\d{3,4})(?=\s|$)",
        raw,
        re.IGNORECASE,
    )
    if bw:
        specs["drum_width_mm"] = float(
            bw.group(1).replace(",", ".")
        )

    tensioning_set = re.search(
        r"\bTensioning set\s+d\s*=\s*(\d{2,4})\b",
        raw,
        re.IGNORECASE,
    )

    shaft_candidates = [
        float(x.replace(",", "."))
        for x in re.findall(r"\bn\s*(\d+(?:[.,]\d+)?)\b", raw, re.IGNORECASE)
    ]

    shaft_candidates = [
        x for x in shaft_candidates
        if 30 <= x <= 150
    ]

    if tensioning_set:
        specs["shaft_diameter_mm"] = float(tensioning_set.group(1))
        if shaft_candidates:
            specs["shaft_end_diameter_mm"] = min(shaft_candidates)
            specs["shaft_diameter_candidates_mm"] = sorted(set(shaft_candidates))
    else:
        if shaft_candidates:
            specs["shaft_diameter_mm"] = max(shaft_candidates)
            specs["shaft_diameter_candidates_mm"] = sorted(set(shaft_candidates))

    torque = re.search(
        r"\b(\d+(?:[.,]\d+)?)\s*Nm\b",
        raw,
        re.IGNORECASE,
    )
    if torque:
        specs["torque_nm"] = float(
            torque.group(1).replace(",", ".")
        )

    bearing_housing = re.search(r"\bSNL\s*\d{3,4}\b", raw, re.IGNORECASE)
    if bearing_housing:
        specs["bearing_housing"] = bearing_housing.group(0).upper().replace(" ", "")

    bearing = re.search(r"\b222\d{2}\s*(?:CCK|CK|K|E)?\b", raw, re.IGNORECASE)
    if bearing:
        specs["bearing_type"] = bearing.group(0).upper().strip()

    adapter = re.search(r"\bH\s*\d{3,5}\b", raw, re.IGNORECASE)
    if adapter:
        specs["adapter_type"] = adapter.group(0).upper().replace(" ", "")

    seal = re.search(r"\bTSN\s*\d{3,4}\s*[A-Z]?\b", raw, re.IGNORECASE)
    if seal:
        specs["seal_type"] = seal.group(0).upper().replace(" ", "")

    balancing = re.search(r"\bISO\s*1940(?:[-\s]?\d+)?\b", raw, re.IGNORECASE)
    if balancing:
        specs["balancing_norm"] = balancing.group(0).upper()

    tolerance = re.search(r"\bISO\s*2768[-\s]?[A-Z]{1,2}\b", raw, re.IGNORECASE)
    if tolerance:
        specs["tolerance_class"] = tolerance.group(0).upper()

    roughness = re.search(r"(?:surface roughness|ruwheid)\s*[:\-]?\s*([0-9.,/]+)", raw, re.IGNORECASE)
    if roughness:
        specs["surface_roughness"] = roughness.group(1)

    required = [
        "diameter_mm",
        "drum_width_mm",
        "shaft_diameter_mm",
        "bearing_type",
        "bearing_housing",
        "balancing_norm",
    ]

    missing_fields = [field for field in required if not specs.get(field)]
    filled_count = len(required) - len(missing_fields)
    confidence_score = round((filled_count / len(required)) * 100, 1)

    return {
        "extracted_fields": specs,
        "missing_fields": missing_fields,
        "warnings": [],
        "assumptions": [],
        "confidence_score": confidence_score,
    }

def render_pdf_pages_to_images(
    pdf_bytes: bytes,
    dpi: int = 200,
    max_pages: int = 5,
):
    import fitz

    images = []

    doc = fitz.open(stream=pdf_bytes, filetype="pdf")

    try:
        zoom = dpi / 72
        matrix = fitz.Matrix(zoom, zoom)

        page_count = min(len(doc), max_pages)

        for page_index in range(page_count):
            page = doc.load_page(page_index)
            pix = page.get_pixmap(matrix=matrix, alpha=False)

            image_bytes = pix.tobytes("png")

            images.append({
                "page_number": page_index + 1,
                "image_bytes": image_bytes,
                "content_type": "image/png",
                "file_size": len(image_bytes),
            })

    finally:
        doc.close()

    return images

def store_ocr_page_images(
    rfq_id: str,
    position_id: str,
    document_id: str,
    images: list[dict],
):
    ensure_minio_bucket()

    stored_pages = []

    for image in images:
        page_number = image["page_number"]

        object_name = (
            f"rfq/{rfq_id}/positions/{position_id}/"
            f"OCR/{document_id}/page-{page_number:03d}.png"
        )

        minio_client.put_object(
            bucket_name=MINIO_BUCKET,
            object_name=object_name,
            data=BytesIO(image["image_bytes"]),
            length=image["file_size"],
            content_type=image["content_type"],
        )

        stored_pages.append({
            "page_number": page_number,
            "object_name": object_name,
            "content_type": image["content_type"],
            "file_size": image["file_size"],
        })

    return stored_pages

def fetch_one(sql: str, params: dict[str, Any] | None = None):
    with engine.connect() as conn:
        row = conn.execute(text(sql), params or {}).mappings().first()
        return dict(row) if row else None


def fetch_all(sql: str, params: dict[str, Any] | None = None):
    with engine.connect() as conn:
        rows = conn.execute(text(sql), params or {}).mappings().all()
        return [dict(r) for r in rows]


def execute_one(sql: str, params: dict[str, Any] | None = None):
    with engine.begin() as conn:
        row = conn.execute(text(sql), params or {}).mappings().first()
        return dict(row) if row else None


def calculate_position_completeness(position: dict[str, Any]) -> dict[str, Any]:
    specs = position.get("extracted_specs") or {}
    missing = position.get("missing_fields") or []

    required_fields = [
        "diameter_de_mm",
        "drum_width_mm",
        "shaft_diameter_mm",
        "bearing_housing",
        "bearing",
        "adapter",
        "lagging_type",
        "lagging_dikte_mm",
    ]

    filled = sum(1 for field in required_fields if specs.get(field))
    base_score = round((filled / len(required_fields)) * 100, 1)

    penalty = min(len(missing) * 5, 40)
    completeness = max(0, min(100, base_score - penalty))

    if completeness >= 85 and not missing:
        status = "READY_FOR_RFQ"
    elif completeness >= 60:
        status = "ENGINEERING_REVIEW"
    else:
        status = "DRAFT"

    return {
        "position_status": status,
        "completeness_score": completeness,
        "filled_required": filled,
        "required_total": len(required_fields),
        "missing_count": len(missing),
    }


def update_rfq_workflow_status(rfq_id: str) -> dict[str, Any]:
    rfq = fetch_one(
        """
        SELECT *
        FROM rfq.request
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    positions = fetch_all(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    artifacts = fetch_all(
        """
        SELECT *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    supplier_rfqs = fetch_all(
        """
        SELECT *
        FROM rfq.supplier_rfq
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    has_positions = len(positions) > 0

    has_missing_fields = any(
        bool(p.get("missing_fields"))
        for p in positions
    )

    has_supplier_package = any(
        a.get("artifact_type") == "supplier_package_pdf"
        for a in artifacts
    )

    has_supplier_routing = len(supplier_rfqs) > 0

    has_sent_supplier_rfq = any(
        sr.get("status") == "SENT"
        for sr in supplier_rfqs
    )

    has_received_quote = any(
        sr.get("status") == "RECEIVED"
        for sr in supplier_rfqs
    )

    has_award = any(
        sr.get("selected") is True
        for sr in supplier_rfqs
    )

    commercial_status = (rfq.get("commercial_status") or "").upper()
    selected_route = (rfq.get("selected_route") or "").upper()

    if has_award:
        new_status = "AWARDED"
    elif has_received_quote:
        new_status = "QUOTATION_RECEIVED"
    elif has_sent_supplier_rfq:
        new_status = "SUPPLIER_RFQ_SENT"
    elif has_supplier_routing:
        new_status = "SUPPLIER_ROUTED"
    elif has_supplier_package:
        new_status = "SUPPLIER_PACKAGE_CREATED"
    elif has_positions and not has_missing_fields:
        if commercial_status in {"HOLD", "REJECT", "HOLD_OR_REJECT"}:
            new_status = "COMMERCIAL_GATE"
        elif selected_route in {"OEM", "PREMIUM", "REVIEW"}:
            new_status = "READY_FOR_RFQ"
        else:
            new_status = "ENGINEERING_REVIEW"
    elif has_positions:
        new_status = "ENGINEERING_REVIEW"
    else:
        new_status = "DRAFT"

    updated = execute_one(
        """
        UPDATE rfq.request
        SET status = :status,
            updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "status": new_status,
        },
    )

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            gpt_suggestion
        )
        VALUES (
            :rfq_id,
            'WORKFLOW_STATUS_UPDATED',
            CAST(:gpt_suggestion AS jsonb)
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq_id,
            "gpt_suggestion": json_dumps({
                "old_status": rfq.get("status"),
                "new_status": new_status,
                "has_positions": has_positions,
                "has_missing_fields": has_missing_fields,
                "has_supplier_package": has_supplier_package,
                "has_supplier_routing": has_supplier_routing,
                "has_sent_supplier_rfq": has_sent_supplier_rfq,
                "has_received_quote": has_received_quote,
                "has_award": has_award,
            }),
        },
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "old_status": rfq.get("status"),
        "new_status": new_status,
        "rfq": updated,
    }

def run_engineering_review_on_specs(specs: dict) -> dict:
    warnings = []
    missing_fields = []
    recommendations = []
    risk_score = 0

    required = [
        "diameter_mm",
        "drum_width_mm",
        "shaft_diameter_mm",
        "bearing_type",
        "bearing_housing",
        "balancing_norm",
        "materiaal_as",
        "materiaal_mantel",
    ]

    for field in required:
        if not specs.get(field):
            missing_fields.append(field)

    if specs.get("balancing_norm") == "ISO 1940":
        warnings.append("Balancing norm aanwezig, maar balanceerklasse ontbreekt.")
        recommendations.append("Controleer of G6.3, G2.5 of andere klasse vereist is.")
        risk_score += 10

    if not specs.get("materiaal_as"):
        recommendations.append("Asmarteriaal ontbreekt; minimaal C45 of projectspecifiek controleren.")
        risk_score += 15

    if not specs.get("materiaal_mantel"):
        recommendations.append("Mantelmateriaal ontbreekt; S355 of projectspecificatie controleren.")
        risk_score += 15

    if specs.get("shaft_diameter_mm") and specs.get("diameter_mm"):
        ratio = float(specs["shaft_diameter_mm"]) / float(specs["diameter_mm"])
        if ratio < 0.15:
            warnings.append("Asdiameter lijkt relatief laag t.o.v. trommeldiameter.")
            recommendations.append("Controleer asberekening op belt tension, torque en fatigue.")
            risk_score += 20

    if specs.get("bearing_type") and not specs.get("seal_type"):
        warnings.append("Lagering aanwezig, maar afdichting ontbreekt.")
        risk_score += 10

    review_status = (
        "ENGINEERING_REVIEW"
        if missing_fields or warnings
        else "READY_FOR_RFQ"
    )

    return {
        "review_status": review_status,
        "warnings": warnings,
        "missing_fields": missing_fields,
        "recommendations": recommendations,
        "risk_score": min(risk_score, 100),
    }

def json_dumps(data: Any) -> str:
    import json

    def default(o):
        if isinstance(o, Decimal):
            return float(o)
        if isinstance(o, (date, datetime)):
            return o.isoformat()
        return str(o)

    return json.dumps(data, ensure_ascii=False, default=default)


def val(value, fallback="Niet opgegeven"):
    if value is None:
        return fallback
    if value == "":
        return fallback
    return value


def yes_no(value):
    if value is True:
        return "Ja"
    if value is False:
        return "Nee"
    return "Niet opgegeven"

def build_drum_schema_svg(trommel_type: str | None) -> str:
    t = (trommel_type or "").lower()

    label = "Trommel"
    if "aandrijf" in t:
        label = "Aandrijftrommel"
    elif "keer" in t:
        label = "Keertrommel"
    elif "snub" in t or "buig" in t:
        label = "Buig / snub trommel"
    elif "span" in t or "take" in t:
        label = "Spantrommel"

    return f"""
    <svg viewBox="0 0 1000 360" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="arrow" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
          <path d="M0,0 L8,4 L0,8 Z" fill="#0b2545"/>
        </marker>

        <pattern id="hatch" width="6" height="6" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="6" stroke="#0b2545" stroke-width="1"/>
        </pattern>
      </defs>

      <style>
        .main {{ stroke:#0b2545; stroke-width:2; fill:none; }}
        .thin {{ stroke:#0b2545; stroke-width:1; fill:none; }}
        .dim {{ stroke:#0b2545; stroke-width:1; marker-start:url(#arrow); marker-end:url(#arrow); }}
        .center {{ stroke:#6b7c8f; stroke-width:1; stroke-dasharray:10 6; }}
        .txt {{ font-family:Arial,sans-serif; font-size:18px; fill:#0b2545; font-weight:700; }}
        .small {{ font-family:Arial,sans-serif; font-size:15px; fill:#0b2545; }}
        .label {{ font-family:Arial,sans-serif; font-size:15px; fill:#0b2545; font-weight:700; }}
      </style>

      <!-- title -->
      <text x="500" y="24" text-anchor="middle" class="txt">{label}</text>

      <!-- center line -->
      <line x1="60" y1="180" x2="940" y2="180" class="center"/>

      <!-- shaft -->
      <rect x="80" y="165" width="840" height="30" fill="#f8fafc" stroke="#0b2545" stroke-width="2"/>

      <!-- drum shell -->
      <rect x="300" y="95" width="400" height="170" fill="#ffffff" stroke="#0b2545" stroke-width="2"/>
      <rect x="315" y="83" width="370" height="12" fill="#111827" stroke="#0b2545" stroke-width="1"/>

      <!-- end plates -->
      <line x1="330" y1="95" x2="330" y2="265" class="thin"/>
      <line x1="670" y1="95" x2="670" y2="265" class="thin"/>

      <!-- hubs -->
      <rect x="270" y="137" width="70" height="86" fill="#f8fafc" stroke="#0b2545" stroke-width="2"/>
      <rect x="660" y="137" width="70" height="86" fill="#f8fafc" stroke="#0b2545" stroke-width="2"/>

      <!-- bearing blocks -->
      <rect x="120" y="130" width="90" height="100" fill="url(#hatch)" stroke="#0b2545" stroke-width="2"/>
      <rect x="790" y="130" width="90" height="100" fill="url(#hatch)" stroke="#0b2545" stroke-width="2"/>

      <!-- right gearbox / shaft extension -->
      <rect x="880" y="170" width="70" height="20" fill="#f8fafc" stroke="#0b2545" stroke-width="2"/>
      <rect x="950" y="174" width="35" height="12" fill="#f8fafc" stroke="#0b2545" stroke-width="1"/>

      <!-- dimension extension lines -->
      <line x1="120" y1="55" x2="120" y2="305" class="thin"/>
      <line x1="880" y1="55" x2="880" y2="305" class="thin"/>
      <line x1="300" y1="75" x2="300" y2="300" class="thin"/>
      <line x1="700" y1="75" x2="700" y2="300" class="thin"/>
      <line x1="80" y1="300" x2="80" y2="325" class="thin"/>
      <line x1="920" y1="300" x2="920" y2="325" class="thin"/>

      <!-- top dimensions -->
      <line x1="120" y1="55" x2="880" y2="55" class="dim"/>
      <text x="500" y="47" text-anchor="middle" class="label">A</text>

      <line x1="300" y1="78" x2="700" y2="78" class="dim"/>
      <text x="500" y="70" text-anchor="middle" class="label">L</text>

      <!-- bottom dimensions -->
      <line x1="80" y1="325" x2="920" y2="325" class="dim"/>
      <text x="500" y="350" text-anchor="middle" class="label">LA</text>

      <line x1="80" y1="300" x2="300" y2="300" class="dim"/>
      <text x="190" y="292" text-anchor="middle" class="label">L1</text>

      <line x1="700" y1="300" x2="880" y2="300" class="dim"/>
      <text x="790" y="292" text-anchor="middle" class="label">L2</text>

      <line x1="880" y1="270" x2="950" y2="270" class="dim"/>
      <text x="915" y="262" text-anchor="middle" class="label">M</text>

      <line x1="950" y1="245" x2="985" y2="245" class="dim"/>
      <text x="967" y="237" text-anchor="middle" class="label">N</text>

      <!-- vertical dimensions -->
      <line x1="55" y1="95" x2="55" y2="265" class="dim"/>
      <text x="35" y="185" transform="rotate(-90 35 185)" text-anchor="middle" class="label">ø DE</text>

      <line x1="565" y1="145" x2="565" y2="215" class="dim"/>
      <text x="585" y="185" class="label">ø D1</text>

      <line x1="755" y1="150" x2="755" y2="210" class="dim"/>
      <text x="775" y="185" class="label">ø D2</text>

      <line x1="982" y1="170" x2="982" y2="190" class="dim"/>
      <text x="958" y="165" class="label">ø D4</text>

      <!-- notes -->
      <text x="500" y="342" text-anchor="middle" class="small">schematische maatvoering — niet op schaal</text>
    </svg>
    """
def run_tesseract_ocr_on_image(image_bytes: bytes) -> str:
    from PIL import Image
    import pytesseract

    image = Image.open(BytesIO(image_bytes))

    text = pytesseract.image_to_string(
        image,
        lang="eng+nld",
        config="--psm 6",
    )

    return text.strip()

def render_landscape_rfq_html(
    rfq_id: str,
    position_id: str,
    view_mode: str = "supplier",
):
    rfq = fetch_one(
        """
        SELECT *
        FROM rfq.request
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    position = fetch_one(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not position:
        raise HTTPException(status_code=404, detail="RFQ position not found")

    specs = position.get("extracted_specs") or {}
    missing = position.get("missing_fields") or []
    classification = specs.get("classification") or {}

    template = jinja_env.get_template("rfq_supplier_package_landscape.html")

    bearing_housing = specs.get("bearing_housing") or specs.get("lagerhuis")
    bearing = specs.get("bearing") or specs.get("lagering")
    adapter = specs.get("adapter") or specs.get("adapter_type")
    seal = specs.get("seal") or specs.get("seal_type")
    frb_ring = specs.get("frb_ring")

    return template.render(
        view_mode=view_mode,
        today=date.today().isoformat(),

        rfq_id=rfq_id,
        odoo_reference=val(rfq.get("odoo_reference")),
        selected_route=val(rfq.get("selected_route")),
        customer_type=val(rfq.get("customer_type")),

        position_id=position_id,
        pos_nr=val(position.get("pos_nr")),
        product_type=val(position.get("product_type")),
        quantity=val(position.get("quantity")),

        drawing_number=val(specs.get("drawing_number")),
        model_number=val(specs.get("model_number")),
        description=val(
            specs.get("drawing_description")
            or specs.get("description")
        ),

        trommel_type=val(specs.get("trommel_type")),
        diameter_mm=val(
            specs.get("diameter_de_mm")
            or specs.get("diameter_mm")
        ),
        mantel_lengte_mm=val(
            specs.get("mantel_lengte_mm")
            or specs.get("drum_width_mm")
        ),
        shaft_diameter_mm=val(
            specs.get("shaft_diameter_mm")
            or specs.get("as_diameter_mm")
        ),

        bearing_housing_qty=2 if bearing_housing else "",
        bearing_housing=val(bearing_housing),
        bearing_qty=2 if bearing else "",
        bearing=val(bearing),
        adapter_qty=2 if adapter else "",
        adapter=val(adapter),
        seal_qty=2 if seal else "",
        seal=val(seal),
        frb_ring_qty=2 if frb_ring else "",
        frb_ring=val(frb_ring),

        lagging_type=val(specs.get("lagging_type")),
        lagging_dikte_mm=val(specs.get("lagging_dikte_mm")),
        balancering=val(specs.get("balancering")),
        tir_mm=val(specs.get("tir_mm")),
        materiaal_mantel=val(specs.get("materiaal_mantel")),
        materiaal_as=val(specs.get("materiaal_as")),
        fat_required=yes_no(specs.get("fat_required")),

        tolerance_class="Volgens tekening / leverancier bevestigen",
        balancing_norm="ISO 1940-1 / ISO 21940 indien vereist",
        general_tolerance="ISO 2768 of leveranciersstandaard",
        surface_roughness="Volgens tekening",

        shaft_fit="Volgens tekening",
        bearing_fit="Volgens lagerleverancier",
        adapter_mounting=(
            "Klembus binnen trommel houden"
            if adapter
            else "Niet van toepassing"
        ),

        supplier_notes=val(specs.get("supplier_notes")),
        missing_fields=(
            ", ".join(missing)
            if missing
            else "Geen kritische ontbrekende velden geregistreerd"
        ),
        confidence_score=val(position.get("confidence_score")),
        function_type=val(classification.get("function_type")),
        duty_class=val(classification.get("duty_class")),
        lagging_class=val(classification.get("lagging_class")),

        drum_schema_svg=build_drum_schema_svg(
            specs.get("trommel_type")
        ),
    )


@router.get("/{rfq_id}/positions/{position_id}/datasheet/pdf")
def get_rfq_position_datasheet_pdf(
    rfq_id: str,
    position_id: str,
    commercial_approved: bool = Query(default=False),
    view_mode: str = Query(default="internal", pattern="^(internal|supplier)$"),
):
    from fastapi.responses import Response
    from weasyprint import HTML

    html_content = render_landscape_rfq_html(
        rfq_id=rfq_id,
        position_id=position_id,
        view_mode=view_mode,
    )

    pdf_bytes = HTML(
        string=html_content,
        base_url=str(TEMPLATE_DIR),
    ).write_pdf()

    filename = (
        f"rfq-{view_mode}-"
        f"{rfq_id[:8]}-"
        f"{position_id[:8]}.pdf"
    )

    return Response(
        content=pdf_bytes,
        media_type="application/pdf",
        headers={
            "Content-Disposition": f'attachment; filename="{filename}"'
        },
    )

def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def safe_file_part(value: str | None) -> str:
    return "".join(c if c.isalnum() or c in "-_" else "_" for c in (value or "RFQ"))


