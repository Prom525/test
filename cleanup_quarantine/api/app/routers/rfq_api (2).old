@router.post("/{rfq_id}/positions/from-drawing")
def create_rfq_position_from_drawing(
    rfq_id: str,
    product_type: str = Form(default="TROMMEL"),
    quantity: float = Form(default=1),
    drawing: UploadFile = File(...),
):
    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    upload_dir = Path("/app/generated/rfq_uploads")
    upload_dir.mkdir(parents=True, exist_ok=True)

    safe_name = safe_file_part(drawing.filename)
    file_path = upload_dir / f"{rfq_id}_{safe_name}"

    with open(file_path, "wb") as f:
        f.write(drawing.file.read())

    drawing_text = extract_text_from_pdf_file(file_path)
    parsed = parse_pulley_specs_from_text(
        drawing_text,
        drawing_reference=drawing.filename,
    )

    row = fetch_one(
        """
        SELECT COUNT(*) AS position_count
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    next_nr = int(row.get("position_count") or 0) + 1
    pos_nr = f"POS-{next_nr:03d}"

    specs = parsed.get("extracted_specs") or {}
    specs["source_file"] = drawing.filename
    specs["file_path"] = str(file_path)
    specs["extracted_text_preview"] = drawing_text[:3000]

    missing_fields = parsed.get("missing_fields") or []

    temp_position = {
        "extracted_specs": specs,
        "missing_fields": missing_fields,
    }

    completeness = calculate_position_completeness(temp_position)

    position = execute_one(
        """
        INSERT INTO rfq.position (
            rfq_id,
            pos_nr,
            drawing_mark,
            product_type,
            quantity,
            extracted_specs,
            missing_fields,
            confidence_score,
            position_status,
            completeness_score
        )
        VALUES (
            :rfq_id,
            :pos_nr,
            :drawing_mark,
            :product_type,
            :quantity,
            CAST(:extracted_specs AS jsonb),
            CAST(:missing_fields AS jsonb),
            :confidence_score,
            :position_status,
            :completeness_score
        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "pos_nr": pos_nr,
            "drawing_mark": drawing.filename,
            "product_type": product_type,
            "quantity": quantity,
            "extracted_specs": json_dumps(specs),
            "missing_fields": json_dumps(missing_fields),
            "confidence_score": parsed.get("confidence_score") or 50,
            "position_status": completeness["position_status"],
            "completeness_score": completeness["completeness_score"],
        },
    )

    update_rfq_workflow_status(rfq_id)

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position": position,
        "parsed": parsed,
        "write_actions_available": True,
    }


@router.post("/{rfq_id}/positions")
def create_rfq_position(
    rfq_id: str,
    payload: RfqPositionCreateIn,
):
    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    row = fetch_one(
        """
        SELECT COUNT(*) AS position_count
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    next_nr = int(row.get("position_count") or 0) + 1
    pos_nr = f"POS-{next_nr:03d}"

    initial_missing_fields = [
        "diameter",
        "trommelbreedte",
        "asdiameter",
        "lagerhuis",
        "lagering",
        "materiaal_mantel",
        "asmateriaal",
    ]

    temp_position = {
        "extracted_specs": payload.extracted_specs or {},
        "missing_fields": initial_missing_fields,
    }

    completeness = calculate_position_completeness(temp_position)

    position = execute_one(
        """
        INSERT INTO rfq.position (
            rfq_id,
            pos_nr,
            drawing_mark,
            product_type,
            quantity,
            extracted_specs,
            missing_fields,
            confidence_score,
            position_status,
            completeness_score
        )
        VALUES (
            :rfq_id,
            :pos_nr,
            :drawing_mark,
            :product_type,
            :quantity,
            CAST(:extracted_specs AS jsonb),
            CAST(:missing_fields AS jsonb),
            :confidence_score,
            :position_status,
            :completeness_score
        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "pos_nr": pos_nr,
            "drawing_mark": payload.drawing_mark,
            "product_type": payload.product_type,
            "quantity": payload.quantity,
            "extracted_specs": json_dumps(payload.extracted_specs or {}),
            "missing_fields": json_dumps(initial_missing_fields),
            "confidence_score": 10,
            "position_status": completeness["position_status"],
            "completeness_score": completeness["completeness_score"],
        },
    )

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            user_override
        )
        VALUES (
            :rfq_id,
            'POSITION_CREATED',
            CAST(:user_override AS jsonb)
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq_id,
            "user_override": json_dumps({
                "position_id": position["position_id"],
                "pos_nr": pos_nr,
                "product_type": payload.product_type,
                "reason": "Handmatig positie toegevoegd",
            }),
        },
    )

    update_rfq_workflow_status(rfq_id)

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position": position,
        "write_actions_available": True,
    }


@router.delete("/{rfq_id}/positions/{position_id}")
def delete_rfq_position(
    rfq_id: str,
    position_id: str,
    deleted_by: str = Query(default="DEV_TEST"),
):
    position = fetch_one(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not position:
        raise HTTPException(status_code=404, detail="RFQ position not found")

    execute_one(
        """
        DELETE FROM rfq.position
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        RETURNING position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            user_override,
            approved_by,
            approved_at
        )
        VALUES (
            :rfq_id,
            'POSITION_DELETED',
            CAST(:user_override AS jsonb),
            :approved_by,
            now()
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq_id,
            "approved_by": deleted_by,
            "user_override": json_dumps({
                "position_id": position_id,
                "pos_nr": position.get("pos_nr"),
                "product_type": position.get("product_type"),
                "reason": "Testfase positie verwijderd",
            }),
        },
    )

    update_rfq_workflow_status(rfq_id)

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "deleted_position_id": position_id,
        "write_actions_available": True,
    }


@router.post("/{rfq_id}/positions/{position_id}/technical-specs")
def update_rfq_position_technical_specs(
    rfq_id: str,
    position_id: str,
    payload: RfqPositionTechnicalSpecsIn,
):
    
    updated = execute_one(
        """
        UPDATE rfq.position
        SET
            drawing_mark = COALESCE(:source_file_name, drawing_mark),
            extracted_specs = COALESCE(extracted_specs, '{}'::jsonb)
                || CAST(:extracted_fields AS jsonb),
            missing_fields = CAST(:missing_fields AS jsonb),
            confidence_score = :confidence_score
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,

            "source_file_name": (
                payload.extracted_specs.get("source_file")
                if payload.extracted_specs
                else None
            ),

            "extracted_fields": json_dumps(payload.extracted_specs),

            "missing_fields": json_dumps(
                payload.missing_fields or []
            ),

            "confidence_score": payload.confidence_score,
        },
    )

    if not updated:
        raise HTTPException(status_code=404, detail="RFQ position not found")

    completeness = calculate_position_completeness(updated)

    updated = execute_one(
        """
        UPDATE rfq.position
        SET
            position_status = :position_status,
            completeness_score = :completeness_score
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "position_status": completeness["position_status"],
            "completeness_score": completeness["completeness_score"],
        },
    )

    update_rfq_workflow_status(rfq_id)

    return {
        "status": "ok",
        "message": "Technical specs updated",
        "position": dict(updated),
        "write_actions_available": True,
    }

def extract_text_from_pdf_file(path: Path, max_pages: int = 5) -> str:
    try:
        reader = PdfReader(str(path))
        texts = []
        for page in reader.pages[:max_pages]:
            texts.append(page.extract_text() or "")
        return "\n".join(texts).strip()
    except Exception as exc:
        return f"PDF_TEXT_EXTRACTION_FAILED: {exc}"


