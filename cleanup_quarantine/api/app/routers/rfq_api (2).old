@router.delete("/{rfq_id}/positions/{position_id}/documents/{document_id}")
def delete_position_document(
    rfq_id: str,
    position_id: str,
    document_id: str,
):
    document = fetch_one(
        """
        SELECT *
        FROM rfq.position_document
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
          AND document_id = :document_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "document_id": document_id,
        },
    )

    if not document:
        raise HTTPException(status_code=404, detail="Document not found")

    storage_path = document.get("storage_path")

    if storage_path:
        try:
            minio_client.remove_object(
                MINIO_BUCKET,
                storage_path,
            )
        except Exception:
            pass

    execute_one(
        """
        DELETE FROM rfq.position_document_text
        WHERE document_id = :document_id
        RETURNING text_id
        """,
        {"document_id": document_id},
    )

    deleted = execute_one(
        """
        DELETE FROM rfq.position_document
        WHERE document_id = :document_id
        RETURNING document_id
        """,
        {"document_id": document_id},
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "deleted_document_id": deleted["document_id"],
        "storage_path": storage_path,
        "write_actions_available": True,
    }


@router.post("/{rfq_id}/positions/{position_id}/documents/analyze")
def analyze_position_documents(
    rfq_id: str,
    position_id: str,
):
    documents = fetch_all(
        """
        SELECT *
        FROM rfq.position_document
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        ORDER BY extracted_at ASC
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not documents:
        raise HTTPException(
            status_code=404,
            detail="No documents found for this position",
        )

    document_types = [d["document_type"] for d in documents]

    has_drawing = "DRAWING" in document_types
    has_tech_spec = "TECH_SPEC" in document_types
    has_datasheet = "DATASHEET" in document_types

    missing_document_types = []

    if not has_drawing:
        missing_document_types.append("DRAWING")

    if not has_tech_spec:
        missing_document_types.append("TECH_SPEC")

    completeness_score = 0

    if has_drawing:
        completeness_score += 50

    if has_tech_spec:
        completeness_score += 35

    if has_datasheet:
        completeness_score += 15

    analysis = {
        "has_drawing": has_drawing,
        "has_tech_spec": has_tech_spec,
        "has_datasheet": has_datasheet,
        "missing_document_types": missing_document_types,
        "completeness_score": completeness_score,
        "document_count": len(documents),
        "recommendation": (
            "Ready for technical document analysis"
            if has_drawing and has_tech_spec
            else "Upload missing documents before full analysis"
        ),
    }

    execute_one(
        """
        INSERT INTO rfq.position_document_analysis (
            rfq_id,
            position_id,
            completeness_score,
            missing_document_types,
            recommendation,
            document_count
        )
        VALUES (
            :rfq_id,
            :position_id,
            :completeness_score,
            CAST(:missing_document_types AS jsonb),
            :recommendation,
            :document_count
        )
        RETURNING analysis_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "completeness_score": completeness_score,
            "missing_document_types": json_dumps(missing_document_types),
            "recommendation": analysis["recommendation"],
            "document_count": len(documents),
        },
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "documents": documents,
        "analysis": analysis,
        "write_actions_available": False,
    }


@router.post(
    "/{rfq_id}/positions/{position_id}/documents/{document_id}/extract-text"
)
def extract_position_document_text(
    rfq_id: str,
    position_id: str,
    document_id: str,
    ocr_enabled: bool = Query(default=False),
    ocr_engine: str = Query(default="tesseract"),
):
    if ocr_engine not in ["tesseract", "openai"]:
        raise HTTPException(
            status_code=400,
            detail="Invalid OCR engine. Use 'tesseract' or 'openai'.",
        )

    document = fetch_one(
        """
        SELECT *
        FROM rfq.position_document
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
          AND document_id = :document_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "document_id": document_id,
        },
    )

    if not document:
        raise HTTPException(
            status_code=404,
            detail="Document not found",
        )

    object_name = document["storage_path"]

    response = minio_client.get_object(
        MINIO_BUCKET,
        object_name,
    )

    pdf_bytes = response.read()

    reader = PdfReader(BytesIO(pdf_bytes))

    pages_text = []

    for page in reader.pages:
        try:
            text = page.extract_text() or ""
            pages_text.append(text)
        except Exception:
            pages_text.append("")

    extracted_text = "\n\n".join(pages_text)

    stored_ocr_pages = []

    if len(extracted_text.strip()) < 50:
        if ocr_enabled:
            extraction_status = "OCR_ENABLED"

            images = render_pdf_pages_to_images(
                pdf_bytes=pdf_bytes,
                dpi=200,
                max_pages=5,
            )

            stored_ocr_pages = store_ocr_page_images(
                rfq_id=rfq_id,
                position_id=position_id,
                document_id=document_id,
                images=images,
            )
            ocr_text_pages = []

            if ocr_engine in ["openai", "tesseract"]:
                for image in images:
                    if ocr_engine == "openai":
                        page_text = run_openai_ocr_on_image(image["image_bytes"])
                    else:
                        page_text = run_tesseract_ocr_on_image(image["image_bytes"])

                    ocr_text_pages.append(
                        f"--- PAGE {image['page_number']} ---\n{page_text}"
                    )

                extracted_text = "\n\n".join(ocr_text_pages)

                if "[OPENAI_QUOTA_EXCEEDED]" in extracted_text:
                    extraction_status = "OCR_FAILED_QUOTA"
                else:
                    extraction_status = "EXTRACTED_OCR"
        else:
            extraction_status = "OCR_REQUIRED"
    else:
        extraction_status = "EXTRACTED"

    execute_one(
        """
        INSERT INTO rfq.position_document_text (
            document_id,
            rfq_id,
            position_id,
            extracted_text,
            page_count,
            extraction_status,
            extraction_model,
            ocr_pages,
            extraction_context
        )
        VALUES (
            :document_id,
            :rfq_id,
            :position_id,
            :extracted_text,
            :page_count,
            :extraction_status,
            :extraction_model,
            CAST(:ocr_pages AS jsonb),
            CAST(:extraction_context AS jsonb)
        )
        RETURNING text_id
        """,
        {
            "document_id": document_id,
            "rfq_id": rfq_id,
            "position_id": position_id,
            "extracted_text": extracted_text,
            "page_count": len(reader.pages),
            "extraction_status": extraction_status,
            "extraction_model": f"pypdf+{ocr_engine}" if ocr_enabled else "pypdf",
            "ocr_pages": json_dumps(stored_ocr_pages),
            "extraction_context": json_dumps({
                "source": "extract_position_document_text",
                "ocr_enabled": ocr_enabled,
                "ocr_engine": ocr_engine,
                "has_page_images": bool(stored_ocr_pages),
                "vision_ready": bool(stored_ocr_pages),
            }),
        },
    )

    return {
        "status": "ok",
        "document_id": document_id,
        "page_count": len(reader.pages),
        "text_length": len(extracted_text.strip()),
        "extraction_status": extraction_status,
        "ocr_pages": stored_ocr_pages,
        "preview": extracted_text[:1000],
        "write_actions_available": False,
        "ocr_engine": ocr_engine,
    }


@router.post("/{rfq_id}/positions/{position_id}/documents/extract-specs")
def extract_position_specs_from_documents(
    rfq_id: str,
    position_id: str,
):
    latest_text = fetch_one(
        """
        SELECT
            t.*,
            d.file_name
        FROM rfq.position_document_text t
        LEFT JOIN rfq.position_document d
            ON d.document_id = t.document_id
        WHERE t.rfq_id = :rfq_id
          AND t.position_id = :position_id
          AND t.extraction_status IN ('EXTRACTED', 'EXTRACTED_OCR')
        ORDER BY t.extracted_at DESC
        LIMIT 1
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not latest_text:
        raise HTTPException(
            status_code=400,
            detail="No extracted document text available",
        )

    result = extract_structured_specs_from_text(
        latest_text.get("extracted_text") or ""
    )

    fields = result["extracted_fields"]

    fields["source_file"] = latest_text.get("file_name")
    fields["extracted_text_preview"] = latest_text.get("extracted_text")
    fields["source_document_id"] = latest_text.get("document_id")

    saved = execute_one(
        """
        INSERT INTO rfq.position_extracted_specs (
            rfq_id,
            position_id,
            source_document_id,
            extraction_method,
            extraction_model,
            diameter_mm,
            drum_width_mm,
            shaft_diameter_mm,
            shaft_end_diameter_mm,
            bearing_type,
            bearing_housing,
            adapter_type,
            seal_type,
            balancing_norm,
            tolerance_class,
            surface_roughness,
            extracted_fields,
            missing_fields,
            warnings,
            assumptions,
            confidence_score,
            source_file_name,
            part_number,
            doc_number,
            drawing_description
        )
        VALUES (
            :rfq_id,
            :position_id,
            :source_document_id,
            'regex_ocr',
            :extraction_model,
            :diameter_mm,
            :drum_width_mm,
            :shaft_diameter_mm,
            :shaft_end_diameter_mm,
            :bearing_type,
            :bearing_housing,
            :adapter_type,
            :seal_type,
            :balancing_norm,
            :tolerance_class,
            :surface_roughness,
            CAST(:extracted_fields AS jsonb),
            CAST(:missing_fields AS jsonb),
            CAST(:warnings AS jsonb),
            CAST(:assumptions AS jsonb),
            :confidence_score,
            :source_file_name,
            :part_number,
            :doc_number,
            :drawing_description

        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "source_document_id": latest_text["document_id"],
            "extraction_model": latest_text["extraction_model"],
            "diameter_mm": fields.get("diameter_mm"),
            "drum_width_mm": fields.get("drum_width_mm"),
            "shaft_diameter_mm": fields.get("shaft_diameter_mm"),
            "shaft_end_diameter_mm": fields.get("shaft_end_diameter_mm"),
            "bearing_type": fields.get("bearing_type"),
            "bearing_housing": fields.get("bearing_housing"),
            "adapter_type": fields.get("adapter_type"),
            "seal_type": fields.get("seal_type"),
            "balancing_norm": fields.get("balancing_norm"),
            "tolerance_class": fields.get("tolerance_class"),
            "surface_roughness": fields.get("surface_roughness"),
            "extracted_fields": json_dumps(fields),
            "missing_fields": json_dumps(result["missing_fields"]),
            "warnings": json_dumps(result["warnings"]),
            "assumptions": json_dumps(result["assumptions"]),
            "confidence_score": result["confidence_score"],
            "source_file_name": latest_text.get("file_name"),
            "part_number": fields.get("part_number"),
            "doc_number": fields.get("doc_number"),
            "drawing_description": fields.get("drawing_description"),
        },
    )

    execute_one(
        """
        UPDATE rfq.position
        SET
            drawing_mark = COALESCE(:source_file_name, drawing_mark),
            extracted_specs = CAST(:extracted_fields AS jsonb),
            missing_fields = CAST(:missing_fields AS jsonb),
            confidence_score = :confidence_score
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        RETURNING position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "extracted_fields": json_dumps(fields),
            "missing_fields": json_dumps(result["missing_fields"]),
            "source_file_name": latest_text.get("file_name"),
            "confidence_score": result["confidence_score"],
        }
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "structured_specs": saved,
        "write_actions_available": True,
    }


@router.post("/{rfq_id}/positions/{position_id}/engineering-review")
def engineering_review_position(
    rfq_id: str,
    position_id: str,
):
    latest_specs = fetch_one(
        """
        SELECT *
        FROM rfq.position_extracted_specs
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not latest_specs:
        raise HTTPException(
            status_code=400,
            detail="No structured specs available",
        )

    specs = latest_specs.get("extracted_fields") or {}

    review = run_engineering_review_on_specs(specs)

    saved = execute_one(
        """
        INSERT INTO rfq.position_engineering_review (
            rfq_id,
            position_id,
            spec_id,
            review_status,
            warnings,
            missing_fields,
            recommendations,
            risk_score
        )
        VALUES (
            :rfq_id,
            :position_id,
            :spec_id,
            :review_status,
            CAST(:warnings AS jsonb),
            CAST(:missing_fields AS jsonb),
            CAST(:recommendations AS jsonb),
            :risk_score
        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "spec_id": latest_specs["spec_id"],
            "review_status": review["review_status"],
            "warnings": json_dumps(review["warnings"]),
            "missing_fields": json_dumps(review["missing_fields"]),
            "recommendations": json_dumps(review["recommendations"]),
            "risk_score": review["risk_score"],
        },
    )

    execute_one(
        """
        UPDATE rfq.position
        SET
            position_status = :position_status,
            missing_fields = CAST(:missing_fields AS jsonb)
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        RETURNING position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "position_status": review["review_status"],
            "missing_fields": json_dumps(review["missing_fields"]),
        },
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "engineering_review": saved,
        "write_actions_available": True,
    }


@router.post("/{rfq_id}/positions/{position_id}/documents")
async def upload_position_document(
    rfq_id: str,
    position_id: str,
    document_type: str = Form(...),
    file: UploadFile = File(...),
    uploaded_by: str = Form(default="John"),
):
    allowed_types = {
        "DRAWING",
        "TECH_SPEC",
        "DATASHEET",
        "CUSTOMER_TEXT",
        "QUOTE",
    }

    if document_type not in allowed_types:
        raise HTTPException(
            status_code=400,
            detail=f"Invalid document_type. Allowed: {sorted(allowed_types)}",
        )

    position = fetch_one(
        """
        SELECT position_id
        FROM rfq.position
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not position:
        raise HTTPException(status_code=404, detail="Position not found")

    content = await file.read()

    file.file.seek(0)
    file_bytes = file.file.read()

    upload_result = upload_position_document_to_minio(
        rfq_id=rfq_id,
        position_id=position_id,
        document_type=document_type,
        filename=file.filename,
        file_bytes=file_bytes,
        content_type=file.content_type,
    )

    storage_path = upload_result["storage_path"]
    file_size = upload_result["file_size"]

    document = execute_one(
        """
        INSERT INTO rfq.position_document (
            rfq_id,
            position_id,
            document_type,
            file_name,
            content_type,
            file_size,
            storage_path,
            uploaded_by
        )
        VALUES (
            :rfq_id,
            :position_id,
            :document_type,
            :file_name,
            :content_type,
            :file_size,
            :storage_path,
            :uploaded_by
        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
            "document_type": document_type,
            "file_name": file.filename,
            "content_type": file.content_type,
            "file_size": len(content),
            "storage_path": storage_path,
            "uploaded_by": uploaded_by,
        },
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "document": document,
        "write_actions_available": True,
    }