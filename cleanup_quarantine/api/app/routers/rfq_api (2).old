    }


@router.get("/{rfq_id}/pdf-url/{language}")
def get_rfq_pdf_url_v2(
    rfq_id: str,
    language: str,
):
    if language not in {"nl", "en", "de", "fr"}:
        raise HTTPException(status_code=400, detail="Ongeldige taal")

    pdf = fetch_one(
        """
        SELECT
            pdf_id,
            rfq_id,
            input_snapshot->>'language' AS language,
            pdf_hash_sha256
        FROM rfq.pdf_output
        WHERE rfq_id = :rfq_id
          AND input_snapshot->>'language' = :language
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        {"rfq_id": rfq_id, "language": language},
    )

    if not pdf:
        raise HTTPException(status_code=404, detail="Geen PDF gevonden")

    return {
        "intent": "rfq_pdf_url_v2",
        "rfq_id": rfq_id,
        "language": language,
        "pdf_id": str(pdf["pdf_id"]),
        "pdf_hash_sha256": pdf.get("pdf_hash_sha256"),
        "absolute_download_url": f"https://uninveighing-nguyet-hilly.ngrok-free.dev/analysis/rfq/{rfq_id}/pdf/latest?language={language}",
    }


@router.get("/{rfq_id}/positions/{position_id}/technical-review")
def technical_review_rfq_position(rfq_id: str, position_id: str):
    position = fetch_one(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    if not position:
        raise HTTPException(status_code=404, detail="RFQ position not found")

    product_type = (position.get("product_type") or "").lower()

    if "trommel" in product_type:
        doc_filter = "product_type=trommel"
        review_question = (
            "Beoordeel deze trommelpositie volgens Promati trommelstandaard. "
            "Welke specificaties ontbreken voor datasheet, offerte en technische beoordeling? "
            "Let op diameter, mantellengte, asdiameter, lagering, lagging, balancering, TIR, "
            "materiaal, FAT en OEM/Premium classificatie."
        )
    elif "rol" in product_type or "idler" in product_type:
        doc_filter = "product_type=rol"
        review_question = (
            "Beoordeel deze rol/idler positie volgens Promati rolstandaard. "
            "Welke specificaties ontbreken voor datasheet, offerte en technische beoordeling? "
            "Let op roldiameter, rollengte, asdiameter, lagering, afdichting, belasting, "
            "materiaal, toepassing en OEM/Premium classificatie."
        )
    else:
        doc_filter = "promati_technical_reference_v1"
        review_question = (
            "Beoordeel deze RFQ positie volgens Promati technische standaarden. "
            "Welke specificaties ontbreken?"
        )

    extracted_specs = position.get("extracted_specs") or {}
    missing_fields = position.get("missing_fields") or []

    rag_body = {
        "vraag": review_question,
        "top_k": 8,
        "rerank_candidates": 500,
        "doc_id_contains": doc_filter,
        "doc_id_not_contains": "MASTER_DOKUMENT",
    }

    rag_result = rag_query(RAGQuery(**rag_body))

    required_fields_trommel = [
        "trommel_type",
        "diameter_de_mm",
        "mantel_lengte_mm",
        "as_diameter_mm",
        "lagering",
        "lagging_type",
        "lagging_dikte_mm",
        "balancering",
        "tir_mm",
        "materiaal_mantel",
        "materiaal_as",
        "fat_required",
    ]

    required_fields_rol = [
        "rol_type",
        "diameter_mm",
        "lengte_mm",
        "as_diameter_mm",
        "lagering",
        "afdichting",
        "belasting",
        "materiaal_buis",
        "toepassing",
    ]

    required_fields = (
        required_fields_trommel
        if "trommel" in product_type
        else required_fields_rol
        if "rol" in product_type or "idler" in product_type
        else []
    )

    computed_missing_fields = [
        field for field in required_fields
        if not extracted_specs.get(field)
    ]

    rule_evaluation = evaluate_engineering_rules(extracted_specs)

    computed_missing_fields = sorted(
        set(
            computed_missing_fields
            + rule_evaluation["missing_fields"]
        )
    )

    technical_review = {
        "position_id": position["position_id"],
        "rfq_id": position["rfq_id"],
        "pos_nr": position["pos_nr"],
        "product_type": position["product_type"],
        "quantity": float(position["quantity"] or 0),
        "extracted_specs": extracted_specs,
        "stored_missing_fields": missing_fields,
        "computed_missing_fields": computed_missing_fields,
        "engineering_warnings": rule_evaluation["warnings"],
        "rag_reference": {
            "question": review_question,
            "doc_filter": doc_filter,
            "answer": rag_result.get("antwoord"),
            "context_hits": rag_result.get("context_hits", []),
        },
        "advies": {
            "ready_for_datasheet": len(computed_missing_fields) == 0,
            "ready_for_pdf": len(computed_missing_fields) == 0,
            "recommended_action": (
                "Specificaties compleet genoeg voor datasheet."
                if len(computed_missing_fields) == 0
                else "Vul ontbrekende technische specificaties aan voordat datasheet/PDF definitief wordt."
            ),
        },
    }

    return {
        "status": "ok" if len(computed_missing_fields) == 0 else "warning",
        "domain": "rfq",
        "check": "technical_review",
        "technical_review": technical_review,
        "write_actions_available": False,
    }


@router.post("/assistant/process-drawing-rfq")
def assistant_process_drawing_rfq(payload: RfqAssistantProcessIn):
    customer_norm_row = fetch_one(
        "SELECT rfq.norm_txt(:customer_name) AS customer_norm",
        {"customer_name": payload.customer_name_internal},
    )
    customer_norm = customer_norm_row["customer_norm"] if customer_norm_row else None

    context = classify_customer_from_crm(payload.customer_name_internal)
    memory = load_customer_memory(payload.customer_name_internal)
    route = propose_route(
        context["customer_type"],
        payload.request_type,
        memory,
    )

    # NIEUW: commerciële intake gate vóór engineering
    if payload.customer_name_internal and payload.verkoper:
        intake_evaluation = evaluate_rfq_intake_gate(
            customer_name=payload.customer_name_internal,
            verkoper=payload.verkoper,
            expected_value=0,
        )
    else:
        intake_evaluation = {
            "status": "warning",
            "domain": "rfq",
            "type": "intake_evaluation",
            "customer_name": payload.customer_name_internal,
            "verkoper": payload.verkoper,
            "expected_value": 0,
            "combined_score": 0,
            "decision": "COMMERCIAL_GATE_REQUIRED",
            "recommended_action": "Klantnaam en/of verkoper ontbreekt. Eerst commerciële kwalificatie uitvoeren.",
            "engineering_gate": {
                "allow_technical_review": False,
                "allow_datasheet": False,
                "allow_supplier_package": False,
                "commercial_approval_required": True,
            },
            "write_actions_available": False,
        }

    intake_decision = intake_evaluation.get("decision", "COMMERCIAL_GATE_REQUIRED")

    # Alleen FULL_ENGINEERING mag direct OEM/PREMIUM route volgen.
    # Alles daaronder blijft REVIEW.
    if intake_decision == "FULL_ENGINEERING":
        selected_route = route["selected_route"]
    else:
        selected_route = "REVIEW"

    enriched_route = {
        **route,
        "selected_route_before_gate": route["selected_route"],
        "selected_route_after_gate": selected_route,
        "intake_decision": intake_decision,
        "intake_combined_score": intake_evaluation.get("combined_score"),
        "engineering_gate": intake_evaluation.get("engineering_gate"),
    }

    rfq = execute_one(
        """
        INSERT INTO rfq.request (
            odoo_reference,
            customer_name_internal,
            customer_norm,
            verkoper,
            request_type,
            customer_type,
            selected_route,
            customer_value_score,
            customer_context,
            intake_summary
        )
        VALUES (
            :odoo_reference,
            :customer_name_internal,
            :customer_norm,
            :verkoper,
            :request_type,
            :customer_type,
            :selected_route,
            :customer_value_score,
            CAST(:customer_context AS jsonb),
            CAST(:intake_summary AS jsonb)
        )
        RETURNING *
        """,
        {
            "odoo_reference": payload.odoo_reference,
            "customer_name_internal": payload.customer_name_internal,
            "customer_norm": customer_norm,
            "verkoper": payload.verkoper,
            "request_type": payload.request_type,
            "customer_type": context["customer_type"],
            "selected_route": selected_route,
            "customer_value_score": context["customer_value_score"],
            "customer_context": json_dumps(context),
            "intake_summary": json_dumps(enriched_route),
        },
    )

    proposed_positions = []

    if payload.positions:
        for i, p in enumerate(payload.positions, start=1):
            proposed_positions.append({
                "pos_nr": p.pos_nr or f"POS-{i:03d}",
                "drawing_mark": p.drawing_mark or payload.drawing_reference,
                "product_type": p.product_type,
                "quantity": p.quantity,
                "extracted_specs": p.extracted_specs,
                "missing_fields": p.missing_fields,
                "confidence_score": p.confidence_score,
            })
    else:
        proposed_positions.append({
            "pos_nr": "POS-001",
            "drawing_mark": payload.drawing_reference,
            "product_type": "UNKNOWN",
            "quantity": 1,
            "extracted_specs": {},
            "missing_fields": [
                "product_type",
                "diameter",
                "lengte",
                "asdiameter",
                "materiaal",
                "lagering",
                "balancering",
                "aantal",
            ],
            "confidence_score": 20,
        })

    # POSITIES OPSLAAN IN DATABASE
    for p in proposed_positions:
        execute_one(
            """
            INSERT INTO rfq.position (
                rfq_id,
                pos_nr,
                drawing_mark,
                product_type,
                quantity,
                extracted_specs,
                missing_fields,
                confidence_score
            )
            VALUES (
                :rfq_id,
                :pos_nr,
                :drawing_mark,
                :product_type,
                :quantity,
                CAST(:extracted_specs AS jsonb),
                CAST(:missing_fields AS jsonb),
                :confidence_score
            )
            RETURNING position_id
            """,
            {
                "rfq_id": rfq["rfq_id"],
                "pos_nr": p["pos_nr"],
                "drawing_mark": p["drawing_mark"],
                "product_type": p["product_type"],
                "quantity": p["quantity"],
                "extracted_specs": json_dumps(p["extracted_specs"]),
                "missing_fields": json_dumps(p["missing_fields"]),
                "confidence_score": p["confidence_score"],
            },
        )

    # NIEUW: intake gate apart loggen
    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            gpt_suggestion
        )
        VALUES (
            :rfq_id,
            'INTAKE_EVALUATION',
            CAST(:gpt_suggestion AS jsonb)
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq["rfq_id"],
            "gpt_suggestion": json_dumps(intake_evaluation),
        },
    )

    suggestion = {
        "rfq_id": rfq["rfq_id"],
        "odoo_reference": payload.odoo_reference,
        "drawing_reference": payload.drawing_reference,
        "drawing_text": payload.drawing_text,
        "customer_context": context,
        "customer_memory": memory,
        "route_proposal": enriched_route,
        "intake_evaluation": intake_evaluation,
        "engineering_gate": intake_evaluation.get("engineering_gate"),
        "positions_proposal": proposed_positions,
        "rules": {
            "customer_name_on_supplier_pdf": False,
            "odoo_reference_required": True,
            "approval_required_before_pdf": True,
            "positions_must_be_approved": True,
            "commercial_gate_required_before_full_engineering": True,
        },
    }

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            gpt_suggestion
        )
        VALUES (
            :rfq_id,
            'ASSISTANT_RFQ_PROPOSAL',
            CAST(:gpt_suggestion AS jsonb)
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq["rfq_id"],
            "gpt_suggestion": json_dumps(suggestion),
        },
    )

    return {
        "intent": "rfq_assistant_process_drawing_rfq",
        "message": "RFQ-voorstel gemaakt met commerciële intake gate. Controleer gate, posities, route en ontbrekende gegevens voordat engineering/PDF’s worden gemaakt.",
        "rfq_id": rfq["rfq_id"],
        "intake_evaluation": intake_evaluation,
        "engineering_gate": intake_evaluation.get("engineering_gate"),
        "voor_medewerker": {
            "odoo_reference": payload.odoo_reference,
            "klantnaam_intern": payload.customer_name_internal,
            "verkoper": payload.verkoper,
            "klanttype": context["customer_type"],
            "klantwaarde_score": context["customer_value_score"],
            "voorgestelde_route_vóór_gate": route["selected_route"],
            "voorgestelde_route_na_gate": selected_route,
            "intake_decision": intake_decision,
            "intake_score": intake_evaluation.get("combined_score"),
            "reden_route": route["reason"],
            "recommended_action": intake_evaluation.get("recommended_action"),
            "historische_eisen": memory,
            "posities_voorstel": proposed_positions,
            "ontbrekende_gegevens": sorted({
                field
                for p in proposed_positions
                for field in (p.get("missing_fields") or [])
            }),
            "belangrijk": [
                "Commercial gate bepaalt of volledige engineering is toegestaan.",
                "Bij LIMITED_ENGINEERING of lager: nog geen datasheet/supplier package zonder commerciële bevestiging.",
                "Klantnaam komt niet op leveranciers-PDF.",
                "Na akkoord kan fase 9B alles vastleggen en PDF’s maken.",
            ],
        },
    }


@router.post("/assistant/upload-drawing-rfq")
async def assistant_upload_drawing_rfq(
    odoo_reference: str = Form(...),
    customer_name_internal: Optional[str] = Form(default=None),
    verkoper: Optional[str] = Form(default=None),
    request_type: str = Form(default="Trommels en rollen aanvraag"),
    drawing_reference: Optional[str] = Form(default=None),
    drawing_file: UploadFile = File(...),
):
    upload_dir = Path(os.getenv("RFQ_UPLOAD_DIR", "/app/generated/rfq_uploads"))
    upload_dir.mkdir(parents=True, exist_ok=True)

    safe_odoo = safe_file_part(odoo_reference)
    safe_name = safe_file_part(drawing_file.filename or "drawing.pdf")
    file_path = upload_dir / f"{safe_odoo}_{safe_name}"

    content = await drawing_file.read()
    file_path.write_bytes(content)

    file_hash = sha256_file(file_path)
    extracted_text = extract_text_from_pdf_file(file_path)

    customer_norm_row = fetch_one(
        "SELECT rfq.norm_txt(:customer_name) AS customer_norm",
        {"customer_name": customer_name_internal},
    )
    customer_norm = customer_norm_row["customer_norm"] if customer_norm_row else None

    context = classify_customer_from_crm(customer_name_internal)
    memory = load_customer_memory(customer_name_internal)
    route = propose_route(context["customer_type"], request_type, memory)

    if customer_name_internal and verkoper:
        intake_evaluation = evaluate_rfq_intake_gate(
            customer_name=customer_name_internal,
            verkoper=verkoper,
            expected_value=0,
        )
    else:
        intake_evaluation = {
            "status": "warning",
            "domain": "rfq",
            "type": "intake_evaluation",
            "customer_name": customer_name_internal,
            "verkoper": verkoper,
            "expected_value": 0,
            "combined_score": 0,
            "decision": "COMMERCIAL_GATE_REQUIRED",
            "recommended_action": "Klantnaam en/of verkoper ontbreekt. Eerst commerciële kwalificatie uitvoeren.",
            "engineering_gate": {
                "allow_technical_review": False,
                "allow_datasheet": False,
                "allow_supplier_package": False,
                "commercial_approval_required": True,
            },
            "write_actions_available": False,
        }

    intake_decision = intake_evaluation.get("decision", "COMMERCIAL_GATE_REQUIRED")

    if intake_decision == "FULL_ENGINEERING":
        selected_route = route["selected_route"]
    else:
        selected_route = "REVIEW"

    enriched_route = {
        **route,
        "selected_route_before_gate": route["selected_route"],
        "selected_route_after_gate": selected_route,
        "intake_decision": intake_decision,
        "intake_combined_score": intake_evaluation.get("combined_score"),
        "engineering_gate": intake_evaluation.get("engineering_gate"),
    }

    rfq = execute_one(
        """
        INSERT INTO rfq.request (
            odoo_reference,
            customer_name_internal,
            customer_norm,
            verkoper,
            request_type,
            customer_type,
            selected_route,
            customer_value_score,
            customer_context,
            intake_summary
        )
        VALUES (
            :odoo_reference,
            :customer_name_internal,
            :customer_norm,
            :verkoper,
            :request_type,
            :customer_type,
            :selected_route,
            :customer_value_score,
            CAST(:customer_context AS jsonb),
            CAST(:intake_summary AS jsonb)
        )
        RETURNING *
        """,
        {
            "odoo_reference": odoo_reference,
            "customer_name_internal": customer_name_internal,
            "customer_norm": customer_norm,
            "verkoper": verkoper,
            "request_type": request_type,
            "customer_type": context["customer_type"],
            "selected_route": selected_route,
            "customer_value_score": context["customer_value_score"],
            "customer_context": json_dumps(context),
            "intake_summary": json_dumps(enriched_route),
        },
    )

    parsed_position = parse_pulley_specs_from_text(
        extracted_text,
        drawing_reference=drawing_reference or safe_name,
    )

    parsed_position["extracted_specs"]["source_file"] = drawing_file.filename
    parsed_position["extracted_specs"]["file_path"] = str(file_path)
    parsed_position["extracted_specs"]["file_hash_sha256"] = file_hash
    parsed_position["extracted_specs"]["extracted_text_preview"] = extracted_text[:3000]

    proposed_positions = [parsed_position]

    for p in proposed_positions:
        execute_one(
            """
            INSERT INTO rfq.position (
                rfq_id,
                pos_nr,
                drawing_mark,
                product_type,
                quantity,
                extracted_specs,
                missing_fields,
                confidence_score
            )
            VALUES (
                :rfq_id,
                :pos_nr,
                :drawing_mark,
                :product_type,
                :quantity,
                CAST(:extracted_specs AS jsonb),
                CAST(:missing_fields AS jsonb),
                :confidence_score
            )
            RETURNING position_id
            """,
            {
                "rfq_id": rfq["rfq_id"],
                "pos_nr": p["pos_nr"],
                "drawing_mark": p["drawing_mark"],
                "product_type": p["product_type"],
                "quantity": p["quantity"],
                "extracted_specs": json_dumps(p["extracted_specs"]),
                "missing_fields": json_dumps(p["missing_fields"]),
                "confidence_score": p["confidence_score"],
            },
        )

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            gpt_suggestion
        )
        VALUES (
            :rfq_id,
            'INTAKE_EVALUATION',
            CAST(:gpt_suggestion AS jsonb)
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq["rfq_id"],
            "gpt_suggestion": json_dumps(intake_evaluation),
        },
    )

    suggestion = {
        "rfq_id": rfq["rfq_id"],
        "odoo_reference": odoo_reference,
        "drawing_reference": drawing_reference,
        "uploaded_file": {
            "filename": drawing_file.filename,
            "content_type": drawing_file.content_type,
            "file_path": str(file_path),
            "file_hash_sha256": file_hash,
        },
        "drawing_text": extracted_text,
        "customer_context": context,
        "customer_memory": memory,
        "route_proposal": enriched_route,
        "intake_evaluation": intake_evaluation,
        "engineering_gate": intake_evaluation.get("engineering_gate"),
        "positions_proposal": proposed_positions,
        "rules": {
            "customer_name_on_supplier_pdf": False,
            "odoo_reference_required": True,
            "approval_required_before_pdf": True,
            "positions_must_be_approved": True,
        },
    }

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            gpt_suggestion
        )
        VALUES (
            :rfq_id,
            'ASSISTANT_RFQ_UPLOAD_PROPOSAL',
            CAST(:gpt_suggestion AS jsonb)
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq["rfq_id"],
            "gpt_suggestion": json_dumps(suggestion),
        },
    )

    return {
        "intent": "rfq_assistant_upload_drawing_rfq",
        "message": "PDF-tekening opgeslagen, tekst geëxtraheerd en RFQ-voorstel gemaakt. Controleer posities voordat PDF’s worden gemaakt.",
        "rfq_id": rfq["rfq_id"],
        "voor_medewerker": {
            "verkoper": verkoper,
            "voorgestelde_route_vóór_gate": route["selected_route"],
            "voorgestelde_route_na_gate": selected_route,
            "intake_decision": intake_decision,
            "intake_score": intake_evaluation.get("combined_score"),
            "recommended_action": intake_evaluation.get("recommended_action"),            
            "odoo_reference": odoo_reference,
            "klantnaam_intern": customer_name_internal,
            "klanttype": context["customer_type"],
            "klantwaarde_score": context["customer_value_score"],
            "voorgestelde_route": selected_route,
            "reden_route": route["reason"],
            "historische_eisen": memory,
            "uploaded_file": {
                "filename": drawing_file.filename,
                "file_hash_sha256": file_hash,
                "file_path": str(file_path),
            },
            "drawing_text_preview": extracted_text[:3000],
            "posities_voorstel": proposed_positions,
            "ontbrekende_gegevens": sorted({
                field
                for p in proposed_positions
                for field in (p.get("missing_fields") or [])
            }),
            "belangrijk": [
                "Controleer de extractie uit de tekening.",
                "Klantnaam komt niet op leveranciers-PDF.",
                "Na akkoord kan approve-and-generate PDF’s maken.",
            ],
        },
    }


@router.get("/commercial/kpi")
def rfq_commercial_kpi():
    row = fetch_one(
        """
        SELECT
            COUNT(*)::int AS rfq_count,

            COUNT(*) FILTER (
                WHERE quoted_value_eur IS NOT NULL
                   OR rfq_value_eur IS NOT NULL
                   OR awarded_value_eur IS NOT NULL
            )::int AS rfq_count_with_value_data,

            COUNT(*) FILTER (
                WHERE commercial_status ILIKE 'WON'
                   OR commercial_status ILIKE 'GEWONNEN'
            )::int AS won_count,

            COALESCE(SUM(quoted_value_eur), 0) AS quoted_value_total,
            COALESCE(SUM(awarded_value_eur), 0) AS awarded_value_total,
            COALESCE(SUM(rfq_value_eur), 0) AS rfq_value_total
        FROM rfq.request 
        """
    ) or {}

    rfq_count = int(row.get("rfq_count") or 0)
    won_count = int(row.get("won_count") or 0)
    rfq_count_with_value_data = int(row.get("rfq_count_with_value_data") or 0)

    quoted_value_total = float(row.get("quoted_value_total") or 0)
    awarded_value_total = float(row.get("awarded_value_total") or 0)
    rfq_value_total = float(row.get("rfq_value_total") or 0)

    winrate_count_pct = round((won_count / rfq_count) * 100, 1) if rfq_count else 0
    value_conversion_pct = round((awarded_value_total / quoted_value_total) * 100, 1) if quoted_value_total else 0
    rfq_to_order_value_pct = round((awarded_value_total / rfq_value_total) * 100, 1) if rfq_value_total else 0

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "commercial_kpi",
        "metrics": {
            "rfq_count": rfq_count,
            "rfq_count_with_value_data": rfq_count_with_value_data,
            "won_count": won_count,
            "winrate_count_pct": winrate_count_pct,
            "quoted_value_total_eur": quoted_value_total,
            "awarded_value_total_eur": awarded_value_total,
            "rfq_value_total_eur": rfq_value_total,
            "value_conversion_pct": value_conversion_pct,
            "rfq_to_order_value_pct": rfq_to_order_value_pct,
            "conversion_gap_pct": round(winrate_count_pct - value_conversion_pct, 1),
        },
        "interpretation": {
            "count_vs_value": (
                "Aantal-winrate ligt hoger dan waardeconversie: mogelijk winnen we relatief kleinere opdrachten."
                if winrate_count_pct > value_conversion_pct + 10
                else "Waardeconversie ligt in lijn met of boven aantal-winrate."
            )
        },
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/positions/{position_id}/generate-supplier-package")
def generate_supplier_package(
    rfq_id: str,
