        "intent": "rfq_get",
        "rfq": rfq,
        "positions": fetch_all("SELECT * FROM rfq.position WHERE rfq_id = :rfq_id ORDER BY pos_nr", {"rfq_id": rfq_id}),
        "decision_log": fetch_all("SELECT * FROM rfq.decision_log WHERE rfq_id = :rfq_id ORDER BY extracted_at", {"rfq_id": rfq_id}),
    }


@router.post("/{rfq_id}/approve-intake")
def approve_rfq_intake(rfq_id: str, payload: RfqApproveIn):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    updated = execute_one(
        """
        UPDATE rfq.request
        SET selected_route = :selected_route, customer_type = :customer_type,
            status = 'INTAKE_APPROVED', updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING *
        """,
        {"rfq_id": rfq_id, "selected_route": payload.selected_route, "customer_type": payload.customer_type},
    )
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, user_override, final_decision, approved_by, approved_at)
        VALUES (:rfq_id, 'INTAKE_APPROVED', CAST(:user_override AS jsonb), CAST(:final_decision AS jsonb), :approved_by, now())
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "user_override": json_dumps(payload.user_override), "final_decision": json_dumps(payload.final_decision), "approved_by": payload.approved_by},
    )
    return {"intent": "rfq_intake_approved", "rfq": updated, "message": "Intake goedgekeurd. Volgende stap: posities uit tekening structureren."}


@router.get("/customer/context")
def customer_context(customer_name: str = Query(..., min_length=1)):
    context = classify_customer_from_crm(customer_name)
    memory = load_customer_memory(customer_name)
    route = propose_route(context["customer_type"], "UNKNOWN", memory)
    return {"intent": "rfq_customer_context", "customer_name_internal": customer_name, "customer_context": context, "customer_memory": memory, "route_proposal": route}


@router.get("/customer/evaluation")
def evaluate_customer_requester(
    customer_name: str = Query(..., min_length=1),
):
    customer_context = classify_customer_from_crm(customer_name)

    order_status_filter = """
        status IN ('GEWONNEN', 'GEFACTUREERD')
        OR status ILIKE '%gewonnen%'
        OR status ILIKE '%won%'
        OR status ILIKE '%order%'
        OR status ILIKE '%invoiced%'
        OR status ILIKE '%gefactureerd%'
    """

    rows = fetch_all(
        f"""
        SELECT
            account_name,
            klanttype,
            status,

            COUNT(*) AS requests_count,
            COALESCE(SUM(verwachte_omzet), 0) AS pipeline_value,
            COALESCE(AVG(verwachte_omzet), 0) AS avg_pipeline_value,

            COUNT(*) FILTER (
                WHERE {order_status_filter}
            ) AS orders_count,

            COALESCE(SUM(verwachte_omzet) FILTER (
                WHERE {order_status_filter}
            ), 0) AS order_value,

            COUNT(*) FILTER (
                WHERE aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS requests_count_24m,

            COUNT(*) FILTER (
                WHERE ({order_status_filter})
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS orders_count_24m,

            COALESCE(SUM(verwachte_omzet) FILTER (
                WHERE ({order_status_filter})
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ), 0) AS order_value_24m,

            COALESCE(SUM(verwachte_omzet) FILTER (
                WHERE aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ), 0) AS pipeline_value_24m,

            COUNT(*) FILTER (
                WHERE status ILIKE '%open%'
            ) AS open_count,

            COUNT(*) FILTER (
                WHERE status ILIKE '%open%'
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS open_count_24m,

            COUNT(*) FILTER (
                WHERE status ILIKE '%verloren%'
                   OR status ILIKE '%lost%'
            ) AS lost_count,

            COUNT(*) FILTER (
                WHERE (status ILIKE '%verloren%' OR status ILIKE '%lost%')
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS lost_count_24m

        FROM crm.vw_crm_pipeline_quality_v1
        WHERE account_norm ILIKE '%' || rfq.norm_txt(:customer_name) || '%'
           OR account_name ILIKE '%' || :customer_name || '%'
        GROUP BY account_name, klanttype, status
        ORDER BY pipeline_value DESC
        LIMIT 100
        """,
        {"customer_name": customer_name},
    )

    total_requests = sum(int(r.get("requests_count") or 0) for r in rows)
    total_orders = sum(int(r.get("orders_count") or 0) for r in rows)
    total_pipeline_value = sum(float(r.get("pipeline_value") or 0) for r in rows)
    total_order_value = sum(float(r.get("order_value") or 0) for r in rows)
    open_count = sum(int(r.get("open_count") or 0) for r in rows)
    lost_count = sum(int(r.get("lost_count") or 0) for r in rows)

    requests_24m = sum(int(r.get("requests_count_24m") or 0) for r in rows)
    orders_24m = sum(int(r.get("orders_count_24m") or 0) for r in rows)
    pipeline_value_24m = sum(float(r.get("pipeline_value_24m") or 0) for r in rows)
    order_value_24m = sum(float(r.get("order_value_24m") or 0) for r in rows)
    open_count_24m = sum(int(r.get("open_count_24m") or 0) for r in rows)
    lost_count_24m = sum(int(r.get("lost_count_24m") or 0) for r in rows)

    conversion_rate = round((total_orders / total_requests) * 100, 1) if total_requests else 0
    conversion_rate_24m = round((orders_24m / requests_24m) * 100, 1) if requests_24m else 0

    avg_request_value = round(total_pipeline_value / total_requests, 2) if total_requests else 0
    avg_order_value = round(total_order_value / total_orders, 2) if total_orders else 0

    avg_request_value_24m = round(pipeline_value_24m / requests_24m, 2) if requests_24m else 0
    avg_order_value_24m = round(order_value_24m / orders_24m, 2) if orders_24m else 0

    customer_type = customer_context.get("customer_type")

    def score_block(conv, avg_order, orders, requests, open_items, cust_type):
        score = 0

        # Conversie
        if conv >= 70:
            score += 25
        elif conv >= 50:
            score += 18
        elif conv >= 30:
            score += 12
        elif conv >= 20:
            score += 10
        elif conv >= 15:
            score += 7
        elif conv >= 5:
            score += 3

        # Gemiddelde orderwaarde
        if avg_order >= 50000:
            score += 35
        elif avg_order >= 25000:
            score += 28
        elif avg_order >= 10000:
            score += 18
        elif avg_order >= 5000:
            score += 10
        elif avg_order >= 2500:
            score += 6
        elif avg_order > 0:
            score += 2

        # Ordervolume
        if orders >= 100:
            score += 18
        elif orders >= 50:
            score += 18
        elif orders >= 20:
            score += 10
        elif orders >= 10:
            score += 6
        elif orders >= 3:
            score += 3

        # Klanttype
        if cust_type == "ASSET_OWNER":
            score += 20
        elif cust_type == "OEM":
            score -= 2
        elif cust_type == "CONTRACTOR":
            score -= 4

        # Veel aanvragen met lage orderwaarde
        if requests >= 200 and avg_order < 5000:
            score -= 6
        elif requests >= 50 and avg_order < 5000:
            score -= 4
        elif requests >= 20 and avg_order < 5000:
            score -= 2

        # Open workload
        if open_items >= 200:
            score -= 15
        elif open_items >= 75:
            score -= 8
        elif open_items >= 10 and avg_order < 5000:
            score -= 5

        return max(0, min(100, round(score, 1)))

    lifetime_score = score_block(
        conversion_rate,
        avg_order_value,
        total_orders,
        total_requests,
        open_count,
        customer_type,
    )

    recent_score = score_block(
        conversion_rate_24m,
        avg_order_value_24m,
        orders_24m,
        requests_24m,
        open_count_24m,
        customer_type,
    )

    evaluation_score = round((recent_score * 0.6) + (lifetime_score * 0.4), 1)

    workload_risk = "low"
    if open_count_24m >= 200 or (requests_24m >= 300 and conversion_rate_24m < 10):
        workload_risk = "high"
    elif open_count_24m >= 75 or (requests_24m >= 100 and conversion_rate_24m < 15):
        workload_risk = "medium"

    if conversion_rate_24m + 15 < conversion_rate:
        trend = "declining"
    elif conversion_rate_24m > conversion_rate + 15:
        trend = "improving"
    else:
        trend = "stable"

    if evaluation_score >= 75:
        recommendation = "FULL_ENGINEERING"
        recommended_action = "Volledig technisch uitwerken inclusief datasheets en leverancierspakket."
        status = "ok"
    elif evaluation_score >= 55:
        recommendation = "LIMITED_REVIEW"
        recommended_action = "Beperkt uitwerken; eerst commerciële check vóór volledige engineering."
        status = "review"
    elif evaluation_score >= 18:
        recommendation = "COMMERCIAL_REVIEW"
        recommended_action = "Eerst commerciële goedkeuring vragen; geen volledige datasheet/FAT uitwerken."
        status = "warning"
    else:
        recommendation = "REJECT_OR_HOLD"
        recommended_action = "Aanvraag parkeren of afwijzen tenzij strategisch gemotiveerd."
        status = "warning"

    return {
        "status": status,
        "domain": "rfq",
        "type": "customer_evaluation",
        "customer_name": customer_name,
        "evaluation_score": evaluation_score,
        "lifetime_score": lifetime_score,
        "recent_24m_score": recent_score,
        "trend": trend,
        "recommendation": recommendation,
        "recommended_action": recommended_action,
        "metrics": {
            "requests_count": total_requests,
            "orders_count": total_orders,
            "conversion_rate": conversion_rate,
            "total_pipeline_value": round(total_pipeline_value, 2),
            "total_order_value": round(total_order_value, 2),
            "avg_request_value": avg_request_value,
            "avg_order_value": avg_order_value,
            "open_count": open_count,
            "lost_count": lost_count,
            "workload_risk": workload_risk,
            "customer_type": customer_type,
            "customer_value_score": evaluation_score,
        },
        "lifetime": {
            "requests_count": total_requests,
            "orders_count": total_orders,
            "conversion_rate": conversion_rate,
            "pipeline_value": round(total_pipeline_value, 2),
            "order_value": round(total_order_value, 2),
            "avg_request_value": avg_request_value,
            "avg_order_value": avg_order_value,
            "open_count": open_count,
            "lost_count": lost_count,
        },
        "last_24_months": {
            "requests_count": requests_24m,
            "orders_count": orders_24m,
            "conversion_rate": conversion_rate_24m,
            "pipeline_value": round(pipeline_value_24m, 2),
            "order_value": round(order_value_24m, 2),
            "avg_request_value": avg_request_value_24m,
            "avg_order_value": avg_order_value_24m,
            "open_count": open_count_24m,
            "lost_count": lost_count_24m,
        },
        "crm_rows": rows[:20],
        "write_actions_available": False,
    }


@router.get("/salesperson/evaluation")
def evaluate_salesperson_intake_quality(
    verkoper: str = Query(..., min_length=1),
):
    order_status_filter = """
        status IN ('GEWONNEN', 'GEFACTUREERD')
        OR status ILIKE '%gewonnen%'
        OR status ILIKE '%won%'
        OR status ILIKE '%order%'
        OR status ILIKE '%invoiced%'
        OR status ILIKE '%gefactureerd%'
    """

    rows = fetch_all(
        f"""
        SELECT
            verkoper,
            status,

            COUNT(*) AS requests_count,
            COALESCE(SUM(verwachte_omzet), 0) AS pipeline_value,
            COALESCE(AVG(verwachte_omzet), 0) AS avg_pipeline_value,

            COUNT(*) FILTER (
                WHERE {order_status_filter}
            ) AS orders_count,

            COALESCE(SUM(verwachte_omzet) FILTER (
                WHERE {order_status_filter}
            ), 0) AS order_value,

            COUNT(*) FILTER (
                WHERE aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS requests_count_24m,

            COUNT(*) FILTER (
                WHERE ({order_status_filter})
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS orders_count_24m,

            COALESCE(SUM(verwachte_omzet) FILTER (
                WHERE ({order_status_filter})
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ), 0) AS order_value_24m,

            COALESCE(SUM(verwachte_omzet) FILTER (
                WHERE aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ), 0) AS pipeline_value_24m,

            COUNT(*) FILTER (
                WHERE status ILIKE '%open%'
            ) AS open_count,

            COUNT(*) FILTER (
                WHERE status ILIKE '%open%'
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS open_count_24m,

            COUNT(*) FILTER (
                WHERE status ILIKE '%verloren%'
                   OR status ILIKE '%lost%'
            ) AS lost_count,

            COUNT(*) FILTER (
                WHERE (status ILIKE '%verloren%' OR status ILIKE '%lost%')
                  AND aangemaakt_op >= CURRENT_DATE - INTERVAL '24 months'
            ) AS lost_count_24m

        FROM crm.vw_crm_pipeline_quality_v1
        WHERE verkoper ILIKE '%' || :verkoper || '%'
        GROUP BY verkoper, status
        ORDER BY pipeline_value DESC
        LIMIT 100
        """,
        {"verkoper": verkoper},
    )

    total_requests = sum(int(r.get("requests_count") or 0) for r in rows)
    total_orders = sum(int(r.get("orders_count") or 0) for r in rows)
    total_pipeline_value = sum(float(r.get("pipeline_value") or 0) for r in rows)
    total_order_value = sum(float(r.get("order_value") or 0) for r in rows)
    open_count = sum(int(r.get("open_count") or 0) for r in rows)
    lost_count = sum(int(r.get("lost_count") or 0) for r in rows)

    requests_24m = sum(int(r.get("requests_count_24m") or 0) for r in rows)
    orders_24m = sum(int(r.get("orders_count_24m") or 0) for r in rows)
    pipeline_value_24m = sum(float(r.get("pipeline_value_24m") or 0) for r in rows)
    order_value_24m = sum(float(r.get("order_value_24m") or 0) for r in rows)
    open_count_24m = sum(int(r.get("open_count_24m") or 0) for r in rows)
    lost_count_24m = sum(int(r.get("lost_count_24m") or 0) for r in rows)

    conversion_rate = round((total_orders / total_requests) * 100, 1) if total_requests else 0
    conversion_rate_24m = round((orders_24m / requests_24m) * 100, 1) if requests_24m else 0

    avg_request_value = round(total_pipeline_value / total_requests, 2) if total_requests else 0
    avg_order_value = round(total_order_value / total_orders, 2) if total_orders else 0

    avg_request_value_24m = round(pipeline_value_24m / requests_24m, 2) if requests_24m else 0
    avg_order_value_24m = round(order_value_24m / orders_24m, 2) if orders_24m else 0

    # Score: 60% recent, 40% historisch
    def score_block(conv, avg_order, orders, requests, open_items):
        score = 0

        if conv >= 30:
            score += 40
        elif conv >= 15:
            score += 25
        elif conv >= 5:
            score += 10

        if avg_order >= 25000:
            score += 25
        elif avg_order >= 10000:
            score += 15
        elif avg_order >= 2500:
            score += 0

        if orders >= 20:
            score += 20
        elif orders >= 10:
            score += 15
        elif orders >= 3:
            score += 8

        if requests >= 300 and conv < 10:
            score -= 25
        elif requests >= 100 and conv < 15:
            score -= 15

        if open_items >= 200:
            score -= 15
        elif open_items >= 75:
            score -= 8

        return max(0, min(100, round(score, 1)))

    lifetime_score = score_block(
        conversion_rate,
        avg_order_value,
        total_orders,
        total_requests,
        open_count,
    )

    recent_score = score_block(
        conversion_rate_24m,
        avg_order_value_24m,
        orders_24m,
        requests_24m,
        open_count_24m,
    )

    intake_quality_score = round((recent_score * 0.6) + (lifetime_score * 0.4), 1)

    workload_risk = "low"
    if open_count_24m >= 200 or (requests_24m >= 300 and conversion_rate_24m < 10):
        workload_risk = "high"
    elif open_count_24m >= 75 or (requests_24m >= 100 and conversion_rate_24m < 15):
        workload_risk = "medium"

    if conversion_rate_24m + 15 < conversion_rate:
        trend = "declining"
    elif conversion_rate_24m > conversion_rate + 15:
        trend = "improving"
    else:
        trend = "stable"

    if intake_quality_score >= 70:
        recommendation = "GOOD_INTAKE_QUALITY"
        recommended_action = "Aanvragen van deze verkoper mogen normaal door naar engineering, mits klant/aanvraag ook positief scoort."
        status = "ok"
    elif intake_quality_score >= 45:
        recommendation = "MONITOR_INTAKE"
        recommended_action = "Aanvragen toestaan, maar workload en conversie monitoren."
        status = "review"
    elif intake_quality_score >= 25:
        recommendation = "COMMERCIAL_GATE_REQUIRED"
        recommended_action = "Nieuwe aanvragen eerst commercieel laten kwalificeren vóór volledige engineering."
        status = "warning"
    else:
        recommendation = "INTAKE_RESTRICTION_RECOMMENDED"
        recommended_action = "Beperk engineering workload; verkoper moet aanvraagwaarde en kans op opdracht onderbouwen."
        status = "warning"

    return {
        "status": status,
        "domain": "rfq",
        "type": "salesperson_evaluation",
        "verkoper": verkoper,
        "intake_quality_score": intake_quality_score,
        "lifetime_score": lifetime_score,
        "recent_24m_score": recent_score,
        "trend": trend,
        "recommendation": recommendation,
        "recommended_action": recommended_action,
        "metrics": {
            "requests_count": total_requests,
            "orders_count": total_orders,
            "conversion_rate": conversion_rate,
            "total_pipeline_value": round(total_pipeline_value, 2),
            "total_order_value": round(total_order_value, 2),
            "avg_request_value": avg_request_value,
            "avg_order_value": avg_order_value,
            "open_count": open_count,
            "lost_count": lost_count,
            "workload_risk": workload_risk,
        },
        "lifetime": {
            "requests_count": total_requests,
            "orders_count": total_orders,
            "conversion_rate": conversion_rate,
            "pipeline_value": round(total_pipeline_value, 2),
            "order_value": round(total_order_value, 2),
            "avg_request_value": avg_request_value,
            "avg_order_value": avg_order_value,
            "open_count": open_count,
            "lost_count": lost_count,
        },
        "last_24_months": {
            "requests_count": requests_24m,
            "orders_count": orders_24m,
            "conversion_rate": conversion_rate_24m,
            "pipeline_value": round(pipeline_value_24m, 2),
            "order_value": round(order_value_24m, 2),
            "avg_request_value": avg_request_value_24m,
            "avg_order_value": avg_order_value_24m,
            "open_count": open_count_24m,
            "lost_count": lost_count_24m,
        },
        "crm_rows": rows[:20],
        "write_actions_available": False,
    }


@router.get("/intake/evaluation")
def evaluate_rfq_intake_gate(
    customer_name: str = Query(..., min_length=1),
    verkoper: str = Query(..., min_length=1),
    expected_value: float = Query(0),
):
    customer_eval = evaluate_customer_requester(customer_name)
    salesperson_eval = evaluate_salesperson_intake_quality(verkoper)

    customer_score = float(customer_eval.get("evaluation_score") or 0)
    salesperson_score = float(salesperson_eval.get("intake_quality_score") or 0)

    customer_type = customer_eval.get("metrics", {}).get("customer_type")
    customer_workload = customer_eval.get("metrics", {}).get("workload_risk")
    salesperson_workload = salesperson_eval.get("metrics", {}).get("workload_risk")

    combined_score = round((customer_score * 0.75) + (salesperson_score * 0.25), 1)

    if expected_value >= 25000:
        combined_score += 8
    elif expected_value >= 10000:
        combined_score += 5
    elif expected_value > 0 and expected_value < 2500:
        combined_score -= 5

    if customer_type == "ASSET_OWNER":
        combined_score += 5

    if customer_workload == "high" or salesperson_workload == "high":
        combined_score -= 10
    elif customer_workload == "medium" or salesperson_workload == "medium":
        combined_score -= 5

    combined_score = max(0, min(100, round(combined_score, 1)))

    if combined_score >= 75:
        decision = "FULL_ENGINEERING"
        status = "ok"
        recommended_action = "Aanvraag mag volledig naar engineering: technical review, datasheets, PDF en leverancierspakket."
    elif combined_score >= 55:
        decision = "LIMITED_ENGINEERING"
        status = "review"
        recommended_action = "Beperkt technisch uitwerken. Volledige engineering pas na commerciële bevestiging."
    elif combined_score >= 35:
        decision = "COMMERCIAL_GATE_REQUIRED"
        status = "warning"
        recommended_action = "Eerst commerciële kwalificatie verplicht. Nog geen volledige datasheet/FAT/PDF uitwerken."
    else:
        decision = "HOLD_OR_REJECT"
        status = "warning"
        recommended_action = "Aanvraag parkeren of afwijzen tenzij strategisch gemotiveerd."

    return {
        "status": status,
        "domain": "rfq",
        "type": "intake_evaluation",
        "customer_name": customer_name,
        "verkoper": verkoper,
        "expected_value": expected_value,
        "combined_score": combined_score,
        "decision": decision,
        "recommended_action": recommended_action,
        "components": {
            "customer_score": customer_score,
            "salesperson_score": salesperson_score,
            "customer_weight": 0.65,
            "salesperson_weight": 0.35,
            "customer_type": customer_type,
            "customer_workload_risk": customer_workload,
            "salesperson_workload_risk": salesperson_workload,
        },
        "customer_evaluation": {
            "recommendation": customer_eval.get("recommendation"),
            "trend": customer_eval.get("trend"),
            "lifetime": customer_eval.get("lifetime"),
            "last_24_months": customer_eval.get("last_24_months"),
        },
        "salesperson_evaluation": {
            "recommendation": salesperson_eval.get("recommendation"),
            "trend": salesperson_eval.get("trend"),
            "lifetime": salesperson_eval.get("lifetime"),
            "last_24_months": salesperson_eval.get("last_24_months"),
        },
        "engineering_gate": {
            "allow_technical_review": decision in ["FULL_ENGINEERING", "LIMITED_ENGINEERING"],
            "allow_datasheet": decision == "FULL_ENGINEERING",
            "allow_supplier_package": decision == "FULL_ENGINEERING",
            "commercial_approval_required": decision in [
                "LIMITED_ENGINEERING",
                "COMMERCIAL_GATE_REQUIRED",
                "HOLD_OR_REJECT",
            ],
        },
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/positions/propose")
def propose_rfq_positions(rfq_id: str, payload: RfqPositionsProposeIn):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")

    proposed_positions = []
    if payload.positions:
        for i, p in enumerate(payload.positions, start=1):
            proposed_positions.append({
                "pos_nr": p.pos_nr or f"POS-{i:03d}",
                "drawing_mark": p.drawing_mark,
                "product_type": p.product_type,
                "quantity": p.quantity,
                "extracted_specs": p.extracted_specs,
                "missing_fields": p.missing_fields,
                "confidence_score": p.confidence_score,
            })
    else:
        proposed_positions.append({
            "pos_nr": "POS-001",
            "drawing_mark": payload.drawing_reference,
            "product_type": "UNKNOWN",
            "quantity": 1,
            "extracted_specs": {},
            "missing_fields": ["product_type", "diameter", "lengte", "asdiameter", "materiaal", "lagering", "afdichting", "lagging", "aantal"],
            "confidence_score": 20,
        })

    suggestion = {
        "drawing_reference": payload.drawing_reference,
        "raw_text": payload.raw_text,
        "positions": proposed_positions,
        "rules": {"customer_name_on_pdf": False, "position_numbers_required": True, "drawing_mark_required_if_available": True, "approval_required_before_pdf": True},
    }
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, gpt_suggestion)
        VALUES (:rfq_id, 'POSITIONS_PROPOSAL', CAST(:gpt_suggestion AS jsonb))
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "gpt_suggestion": json_dumps(suggestion)},
    )
    return {"intent": "rfq_positions_proposal", "rfq_id": rfq_id, "message": "Positievoorstel gemaakt. Controleer en leg daarna vast met /positions/add.", "proposal": suggestion}


@router.post("/{rfq_id}/positions/add")
def add_rfq_positions(rfq_id: str, positions: list[RfqPositionIn]):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    inserted = []
    for p in positions:
        row = execute_one(
            """
            INSERT INTO rfq.position (rfq_id, pos_nr, drawing_mark, product_type, quantity, extracted_specs, missing_fields, confidence_score)
            VALUES (
                :rfq_id,
                :pos_nr,
                :drawing_mark,
                :product_type,
                :quantity,
                CAST(:extracted_specs AS jsonb),
                CAST(:missing_fields AS jsonb),
                :confidence_score
            )
            RETURNING *
            """,
            {"rfq_id": rfq_id, "pos_nr": p.pos_nr, "drawing_mark": p.drawing_mark, "product_type": p.product_type, "quantity": p.quantity, "extracted_specs": json_dumps(p.extracted_specs), "missing_fields": json_dumps(p.missing_fields), "confidence_score": p.confidence_score},
        )
        inserted.append(row)
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, final_decision)
        VALUES (:rfq_id, 'POSITIONS_ADDED', CAST(:final_decision AS jsonb))
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "final_decision": json_dumps({"positions_added": inserted})},
    )
    return {"intent": "rfq_positions_added", "rfq_id": rfq_id, "positions": inserted}


@router.get("/{rfq_id}/positions")
def get_rfq_positions(rfq_id: str):
    rfq = fetch_one("SELECT rfq_id FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    return {"intent": "rfq_positions", "rfq_id": rfq_id, "positions": fetch_all("SELECT * FROM rfq.position WHERE rfq_id = :rfq_id ORDER BY pos_nr", {"rfq_id": rfq_id})}


@router.delete("/{rfq_id}/positions/{position_id}")
def delete_rfq_position(rfq_id: str, position_id: str):
    deleted = execute_one(
        """DELETE FROM rfq.position WHERE rfq_id = :rfq_id AND position_id = :position_id RETURNING *""",
        {"rfq_id": rfq_id, "position_id": position_id},
    )
    if not deleted:
        raise HTTPException(status_code=404, detail="Positie niet gevonden")
    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, final_decision)
        VALUES (:rfq_id, 'POSITION_DELETED', CAST(:final_decision AS jsonb))
        RETURNING decision_id
        """,
        {"rfq_id": rfq_id, "final_decision": json_dumps({"deleted_position": deleted})},
    )
    return {"intent": "rfq_position_deleted", "deleted": deleted}





@router.post("/suppliers/{supplier_id}/score")
def update_supplier_score(supplier_id: str, payload: SupplierScoreIn):
    supplier = fetch_one("SELECT * FROM rfq.supplier WHERE supplier_id = :supplier_id", {"supplier_id": supplier_id})
    if not supplier:
        raise HTTPException(status_code=404, detail="Leverancier niet gevonden")
    score = execute_one(
        """
        INSERT INTO rfq.supplier_score (supplier_id, oem_score, premium_score, price_score, delivery_score, quality_score, documentation_score, response_score, updated_at)
        VALUES (:supplier_id, :oem_score, :premium_score, :price_score, :delivery_score, :quality_score, :documentation_score, :response_score, now())
        ON CONFLICT (supplier_id) DO UPDATE SET oem_score = EXCLUDED.oem_score, premium_score = EXCLUDED.premium_score, price_score = EXCLUDED.price_score, delivery_score = EXCLUDED.delivery_score, quality_score = EXCLUDED.quality_score, documentation_score = EXCLUDED.documentation_score, response_score = EXCLUDED.response_score, updated_at = now()
        RETURNING *
        """,
        {"supplier_id": supplier_id, **payload.model_dump()},
    )
    return {"intent": "rfq_supplier_score_updated", "supplier": supplier, "score": score}


@router.get("/{rfq_id}/suppliers/propose")
def propose_suppliers_for_rfq(rfq_id: str, limit: int = Query(default=5, ge=1, le=20)):
    rfq = fetch_one("SELECT * FROM rfq.request WHERE rfq_id = :rfq_id", {"rfq_id": rfq_id})
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")
    positions = fetch_all("SELECT * FROM rfq.position WHERE rfq_id = :rfq_id ORDER BY pos_nr", {"rfq_id": rfq_id})
    product_types = sorted({p.get("product_type") for p in positions if p.get("product_type") and p.get("product_type") != "UNKNOWN"})
    product_type = product_types[0] if len(product_types) == 1 else None
    route = rfq.get("selected_route") or "UNDECIDED"
    route_score = """
        CASE WHEN :route = 'PREMIUM' THEN premium_score WHEN :route = 'OEM' THEN oem_score ELSE ((oem_score + premium_score) / 2) END
    """
    suppliers = fetch_all(
        f"""
        SELECT *,
               ROUND((({route_score}) * 0.35 + price_score * 0.15 + delivery_score * 0.15 + quality_score * 0.15 + documentation_score * 0.10 + response_score * 0.10)::numeric, 1) AS supplier_fit_score,
               CASE
                   WHEN rfq_sent_count >= 10 AND rfq_to_order_conversion < 5 THEN 'WAARSCHUWING: veel aanvragen, weinig orders. Controleer mismatch.'
                   WHEN rfq_sent_count >= 5 AND order_won_count = 0 THEN 'LET OP: leverancier kreeg meerdere RFQ’s zonder opdracht.'
                   ELSE NULL
               END AS supplier_load_warning
        FROM rfq.vw_supplier_performance_v1
        WHERE active = true AND (:product_type IS NULL OR :product_type = ANY(categories))
        ORDER BY supplier_fit_score DESC, supplier_name
        LIMIT :limit
        """,
        {"route": route, "product_type": product_type, "limit": limit},
    )
    suggestion = {"rfq_id": rfq_id, "selected_route": route, "product_types": product_types, "product_type_filter": product_type, "suppliers": suppliers, "rules": {"do_not_overload_suppliers_without_orders": True, "compare_oem_vs_premium_fit": True, "approval_required_before_sending": True}}
    execute_one("INSERT INTO rfq.decision_log (rfq_id, step, gpt_suggestion) VALUES (:rfq_id, 'SUPPLIER_PROPOSAL', CAST(:gpt_suggestion AS jsonb)) RETURNING decision_id", {"rfq_id": rfq_id, "gpt_suggestion": json_dumps(suggestion)})
    return {"intent": "rfq_supplier_proposal", "proposal": suggestion}


def get_latest_intake_gate_for_rfq(rfq_id: str) -> dict[str, Any] | None:
    row = fetch_one(
        """
        SELECT gpt_suggestion
        FROM rfq.decision_log
        WHERE rfq_id = :rfq_id
          AND step = 'INTAKE_EVALUATION'
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        {"rfq_id": rfq_id},
    )

    if not row:
        return None

    return row.get("gpt_suggestion")



@router.get("/{rfq_id}/positions/{position_id}/datasheet")
def get_rfq_position_datasheet(
    rfq_id: str,
    position_id: str,
    commercial_approved: bool = Query(default=False),
):
    intake_gate = get_latest_intake_gate_for_rfq(rfq_id)
    engineering_gate = (intake_gate or {}).get("engineering_gate") or {}

    if not commercial_approved and engineering_gate.get("allow_datasheet") is False:
        raise HTTPException(
            status_code=403,
            detail={
                "message": "Datasheet generatie geblokkeerd door commerciële intake gate.",
                "decision": intake_gate.get("decision") if intake_gate else None,
                "recommended_action": intake_gate.get("recommended_action") if intake_gate else None,
                "commercial_approval_required": True,
                "override": "Gebruik commercial_approved=true alleen na expliciete commerciële goedkeuring.",
            },
        )
    review_response = technical_review_rfq_position(rfq_id, position_id)
    review = review_response["technical_review"]

    if review["product_type"].upper() != "TROMMEL":
        raise HTTPException(
            status_code=400,
            detail="Datasheet endpoint is currently only implemented for TROMMEL positions",
        )

    extracted_specs = review["extracted_specs"] or {}

    rule_evaluation = evaluate_engineering_rules(extracted_specs)

    rfq_row = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    ) or {}

    intake_summary = rfq_row.get("intake_summary") or {}
    commercial_gate = engineering_gate

    datasheet = {
        "title": "Trommel specificatieblad",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "pos_nr": review["pos_nr"],
        "product_type": review["product_type"],
        "quantity": review["quantity"],
        "status": "concept" if not review["advies"]["ready_for_datasheet"] else "ready",
        "technical_specs": {
            "classification": extracted_specs.get("classification") or {},

            "trommel_type": extracted_specs.get("trommel_type"),
            "diameter_de_mm": extracted_specs.get("diameter_de_mm"),
            "mantel_lengte_mm": extracted_specs.get("mantel_lengte_mm"),
            "as_diameter_mm": extracted_specs.get("as_diameter_mm"),

            "lagering": extracted_specs.get("lagering"),
            "lagerhuis": extracted_specs.get("lagerhuis"),

            "lagging_type": extracted_specs.get("lagging_type"),
            "lagging_dikte_mm": extracted_specs.get("lagging_dikte_mm"),

            "balancering": extracted_specs.get("balancering"),

            "tir_mm": extracted_specs.get("tir_mm"),

            "materiaal_mantel": extracted_specs.get("materiaal_mantel"),
            "materiaal_as": extracted_specs.get("materiaal_as"),

            "fat_required": extracted_specs.get("fat_required"),

            "geometrie": {
                "DE": extracted_specs.get("diameter_de_mm"),
                "D1": extracted_specs.get("d1_mm"),
                "D2": extracted_specs.get("d2_mm"),
                "D4": extracted_specs.get("d4_mm"),

                "L": extracted_specs.get("mantel_lengte_mm"),
                "LA": extracted_specs.get("la_mm"),
                "L1": extracted_specs.get("l1_mm"),
                "L2": extracted_specs.get("l2_mm"),

                "A": extracted_specs.get("a_mm"),
                "M": extracted_specs.get("m_mm"),
                "N": extracted_specs.get("n_mm"),

                "spie": extracted_specs.get("spie"),
                "spiebaan": extracted_specs.get("spiebaan"),
                "klembus_type": extracted_specs.get("adapter"),
            },

            "passingen_en_toleranties": {
                "aspassing": extracted_specs.get("shaft_fit") or "n.n.b.",
                "lagerpassing": extracted_specs.get("bearing_fit") or "n.n.b.",
                "tolerantieklasse": extracted_specs.get("tolerance_class") or "n.n.b.",
            },

            "normen_en_standaarden": [
                "Promati trommelstandaard",
                "ISO passingstelsel",
                "ISO 1940 balancing standaard",
            ],

            "technische_aannames": [
                (
                    "Balancering voorlopig statisch aangenomen."
                    if not extracted_specs.get("balancering")
                    else None
                ),
                (
                    "Materiaal mantel voorstel: S355."
                    if not extracted_specs.get("materiaal_mantel")
                    else None
                ),
                (
                    "Materiaal as voorstel: C45."
                    if not extracted_specs.get("materiaal_as")
                    else None
                ),
                (
                    "TIR voorstel max. 0,5 mm."
                    if not extracted_specs.get("tir_mm")
                    else None
                ),
            ],

            "engineering_advies": [
                "Controleer lagerpassing en aspassing.",
                "Controleer balancering conform toepassing.",
                "Controleer coating/paint specification.",
                "Controleer FAT requirement.",
            ],
        },
        "quality_review": {
            "ready_for_datasheet": review["advies"]["ready_for_datasheet"],
            "ready_for_pdf": review["advies"]["ready_for_pdf"],
            "missing_fields": sorted(
                set(review["computed_missing_fields"] + rule_evaluation["missing_fields"])
            ),
            "engineering_warnings": rule_evaluation["warnings"],
            "recommended_action": review["advies"]["recommended_action"],
        },
        "internal_review": {
            "customer_type": rfq_row.get("customer_type"),
            "selected_route": rfq_row.get("selected_route"),

            "commercial_gate": intake_summary.get("intake_decision"),

            "customer_score": (
                (intake_gate.get("components") or {}).get("customer_score")
                if isinstance(intake_gate, dict)
                else None
            ),

            "salesperson_score": (
                (intake_gate.get("components") or {}).get("salesperson_score")
                if isinstance(intake_gate, dict)
                else None
            ),

            "engineering_allowed": (
                commercial_gate.get("allow_datasheet")
                if commercial_gate
                else False
            ),
        },
        "rag_sources": review["rag_reference"]["context_hits"],
        "write_actions_available": False,
    }

    datasheet["technical_specs"]["technische_aannames"] = [
        x
        for x in datasheet["technical_specs"]["technische_aannames"]
        if x
    ]
    return {
        "status": "ok",
        "domain": "rfq",
        "type": "trommel_datasheet",
        "datasheet": datasheet,
    }


def build_pulley_geometry_svg(geometry: dict[str, Any]) -> str:
    def v(key: str) -> str:
        value = geometry.get(key)
        return "n.n.b." if value in [None, ""] else str(value)

    return f"""
    <div class="pulley-svg-wrap">
      <svg viewBox="0 0 900 300" width="100%" height="260" xmlns="http://www.w3.org/2000/svg">
        <style>
          .line {{ stroke:#1f2933; stroke-width:2; fill:none; }}
          .thin {{ stroke:#52616b; stroke-width:1; fill:none; }}
          .dim {{ stroke:#1f2933; stroke-width:1; marker-start:url(#arrow); marker-end:url(#arrow); }}
          .txt {{ font-family:Arial,sans-serif; font-size:14px; fill:#1f2933; }}
          .lbl {{ font-family:Arial,sans-serif; font-size:13px; fill:#1f4e79; font-weight:bold; }}
          .missing {{ fill:#9a3412; }}
          .shaft {{ fill:#e5e7eb; stroke:#1f2933; stroke-width:2; }}
          .drum {{ fill:#f8fafc; stroke:#1f2933; stroke-width:2; }}
          .lagging {{ fill:#111827; }}
          .bearing {{ fill:#fef3c7; stroke:#1f2933; stroke-width:2; }}
        </style>

        <defs>
          <marker id="arrow" markerWidth="8" markerHeight="8" refX="4" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 Z" fill="#1f2933"/>
          </marker>
        </defs>

        <!-- shaft -->
        <rect x="90" y="135" width="700" height="28" class="shaft"/>

        <!-- drum body -->
        <rect x="230" y="80" width="410" height="140" class="drum"/>
        <rect x="245" y="74" width="380" height="12" class="lagging"/>

        <!-- hubs / side plates -->
        <rect x="215" y="115" width="55" height="70" class="drum"/>
        <rect x="600" y="115" width="55" height="70" class="drum"/>

        <!-- bearings -->
        <rect x="80" y="120" width="70" height="60" class="bearing"/>
        <rect x="720" y="120" width="70" height="60" class="bearing"/>

        <!-- keyway / end -->
        <rect x="790" y="142" width="75" height="12" class="shaft"/>

        <!-- center line -->
        <line x1="50" y1="149" x2="870" y2="149" class="thin" stroke-dasharray="8,5"/>

        <!-- dimensions top -->
        <line x1="80" y1="35" x2="790" y2="35" class="dim"/>
        <text x="425" y="25" text-anchor="middle" class="lbl">A = {v("A")} mm</text>

        <line x1="230" y1="58" x2="640" y2="58" class="dim"/>
        <text x="435" y="50" text-anchor="middle" class="lbl">L = {v("L")} mm</text>

        <!-- dimensions bottom -->
        <line x1="80" y1="255" x2="790" y2="255" class="dim"/>
        <text x="435" y="278" text-anchor="middle" class="lbl">LA = {v("LA")} mm</text>

        <line x1="80" y1="235" x2="230" y2="235" class="dim"/>
        <text x="155" y="228" text-anchor="middle" class="lbl">L1 = {v("L1")} mm</text>

        <line x1="640" y1="235" x2="790" y2="235" class="dim"/>
        <text x="715" y="228" text-anchor="middle" class="lbl">L2 = {v("L2")} mm</text>

        <line x1="790" y1="210" x2="865" y2="210" class="dim"/>
        <text x="827" y="203" text-anchor="middle" class="lbl">N = {v("N")} mm</text>

        <!-- vertical diameter labels -->
        <line x1="38" y1="80" x2="38" y2="220" class="dim"/>
        <text x="22" y="155" transform="rotate(-90 22,155)" text-anchor="middle" class="lbl">DE = {v("DE")} mm</text>

        <line x1="460" y1="120" x2="460" y2="180" class="dim"/>
        <text x="480" y="154" class="lbl">D1 = {v("D1")} mm</text>

        <line x1="705" y1="128" x2="705" y2="172" class="dim"/>
        <text x="675" y="154" class="lbl">D2 = {v("D2")} mm</text>

        <line x1="865" y1="136" x2="865" y2="160" class="dim"/>
        <text x="884" y="152" class="lbl">D4 = {v("D4")} mm</text>

        <text x="30" y="292" class="txt">Schematische maatvoering — niet op schaal</text>
      </svg>
    </div>
    """


def build_engineering_validation(specs: dict[str, Any]) -> list[str]:
    warnings = []

    geometry = specs.get("geometrie") or {}
    classification = specs.get("classification") or {}

    DE = geometry.get("DE")
    D1 = geometry.get("D1")
    D2 = geometry.get("D2")
    L = geometry.get("L")

    duty = classification.get("duty_class")
    function_type = classification.get("function_type")

    lagging = specs.get("lagging_type")
    balancing = specs.get("balancering")
    tir = specs.get("tir_mm")

    # geometrie plausibiliteit

    if DE and D1 and D1 > DE:
        warnings.append(
            "D1 groter dan DE — controleer asdiameter/extractie."
        )

    if DE and D2 and D2 > DE:
        warnings.append(
            "D2 groter dan DE — controleer lager-/tapdiameter."
        )

    if DE and L and L < DE:
        warnings.append(
            "Mantellengte kleiner dan trommeldiameter — controleer geometrie."
        )

    # engineering governance

    if function_type == "AANDRIJFTROMMEL" and not lagging:
        warnings.append(
            "Aandrijftrommel zonder lagging gedetecteerd."
        )

    if duty == "HEAVY_DUTY" and not balancing:
        warnings.append(
            "HEAVY DUTY zonder balancing-specificatie."
        )

    if duty == "HEAVY_DUTY" and not tir:
        warnings.append(
            "HEAVY DUTY zonder TIR-specificatie."
        )

    if D1 and D2 and D2 > D1:
        warnings.append(
            "Lager-/tapdiameter groter dan asdiameter midden."
        )

    return warnings


def apply_engineering_rules(specs: dict[str, Any]) -> list[str]:
    warnings = []

    classification = specs.get("classification") or {}

    function_type = classification.get("function_type")
    construction = classification.get("mechanical_construction")
    duty_class = classification.get("duty_class")

    rule_sets = [
        ENGINEERING_RULES.get("function_type", {}).get(function_type),
        ENGINEERING_RULES.get("mechanical_construction", {}).get(construction),
        ENGINEERING_RULES.get("duty_class", {}).get(duty_class),
    ]

    for rules in rule_sets:
        if not rules:
            continue

        # required specs

        for field in rules.get("required_specs", []):
            if not specs.get(field):
                warnings.append(
                    f"Ontbrekende vereiste specificatie: {field}"
                )

        # static warnings

        for warning in rules.get("warnings", []):
            warnings.append(warning)

    return warnings


@router.get("/{rfq_id}/positions/{position_id}/datasheet/html", response_class=HTMLResponse)
def get_rfq_position_datasheet_html(
    rfq_id: str,
    position_id: str,
    commercial_approved: bool = Query(default=False),
    view_mode: str = Query(default="internal", pattern="^(internal|supplier)$"),
):
    response = get_rfq_position_datasheet(
    rfq_id,
    position_id,
    commercial_approved=commercial_approved,
)
    datasheet = response["datasheet"]
    specs = datasheet["technical_specs"]
    engineering_warnings = (
        build_engineering_validation(specs)
        + apply_engineering_rules(specs)
    )
    review = datasheet["quality_review"]

    def esc(value):
        if value is None or value == "":
            return '<span class="muted">n.n.b.</span>'
        if str(value).strip().lower() == "n.n.b.":
            return '<span class="muted">n.n.b.</span>'
        return html.escape(str(value))

    def yes_no(value):
        return "Ja" if value is True else "Nee" if value is False else ""

    def list_html(items):
        if not items:
            return "<div>n.n.b.</div>"
        return "".join(f"<div>• {esc(item)}</div>" for item in items)

    geometry = specs.get("geometrie") or {}
    geometry_svg = build_pulley_geometry_svg(geometry)
    fits = specs.get("passingen_en_toleranties") or {}
    norms = specs.get("normen_en_standaarden") or []
    assumptions = specs.get("technische_aannames") or []
    advice = specs.get("engineering_advies") or []
    internal = datasheet.get("internal_review") or {}
    classification = specs.get("classification") or {}

    is_internal = view_mode == "internal"
    is_supplier = view_mode == "supplier"

    warnings_html = ""

    if is_internal and engineering_warnings:
        warnings_html += """
        <div class="section">
          <h2>Engineering validatie</h2>
          <ul>
        """

        for warning in engineering_warnings:
            warnings_html += f"<li>⚠ {warning}</li>"

        warnings_html += """
          </ul>
        </div>
        """

    internal_html = ""
    if is_internal:
        internal_html = f"""
        <div class="section">
          <h2>Interne beoordeling — niet naar leverancier</h2>
          <table>
            <tr><td class="label">Klanttype</td><td>{esc(internal.get("customer_type"))}</td></tr>
            <tr><td class="label">Route</td><td>{esc(internal.get("selected_route"))}</td></tr>
            <tr><td class="label">Commercial gate</td><td>{esc(internal.get("commercial_gate"))}</td></tr>
            <tr><td class="label">Klantscore</td><td>{esc(internal.get("customer_score"))}</td></tr>
            <tr><td class="label">Verkoperscore</td><td>{esc(internal.get("salesperson_score"))}</td></tr>
            <tr><td class="label">Engineering toegestaan</td><td>{yes_no(internal.get("engineering_allowed"))}</td></tr>
          </table>
        </div>
        """

    supplier_requirements_html = ""
    if is_supplier and commercial_approved:
        fat_text = (
            "Ja — leverancier moet FAT voorstel indienen."
            if specs.get("fat_required") is True
            else "Nee"
            if specs.get("fat_required") is False
            else "n.n.b."
        )

        coating_text = (
            specs.get("coating_specification")
            or specs.get("coating")
            or "Volgens Promati standaard tenzij anders opgegeven."
        )

        supplier_requirements_html = f"""
        <div class="section">
          <h2>Leveranciersvereisten</h2>
          <table>
            <tr><td class="label">FAT vereist</td><td>{esc(fat_text)}</td></tr>
            <tr><td class="label">Balancering</td><td>{esc(specs.get("balancering"))}</td></tr>
            <tr><td class="label">TIR eis</td><td>{esc(specs.get("tir_mm"))} mm</td></tr>
            <tr><td class="label">Materiaal mantel</td><td>{esc(specs.get("materiaal_mantel"))}</td></tr>
            <tr><td class="label">Materiaal as</td><td>{esc(specs.get("materiaal_as"))}</td></tr>
            <tr><td class="label">Coating / paint specification</td><td>{esc(coating_text)}</td></tr>
            <tr><td class="label">Levertijd / afleveradres</td><td>{esc(specs.get("delivery_requirement"))}</td></tr>
            <tr><td class="label">Kwaliteitsdocumenten</td><td>Materiaalcertificaten EN 10204 3.1 vereist indien van toepassing.</td></tr>
            <tr><td class="label">Afwijkingen</td><td><span class="supplier-note">Afwijkingen op tekening, toleranties, materiaal, balancing, coating of documentatie moeten vooraf schriftelijk gemeld en goedgekeurd worden.</span></td></tr>
          </table>
          </div>
        """
    elif is_supplier and not commercial_approved:
        supplier_requirements_html = """
        <div class="section">
          <h2>Leveranciersvereisten</h2>
          <div class="warning">
            Supplier RFQ document is geblokkeerd totdat commerciële goedkeuring is gegeven.
          </div>
        </div>
        """

    assumptions_html = ""
    if is_internal:
        assumptions_html = f"""
        <div class="section">
          <h2>Technische aannames</h2>
          {list_html(assumptions)}
        </div>
        """

    advice_html = ""
    if is_internal:
        advice_html = f"""
        <div class="section">
          <h2>Engineering advies</h2>
          {list_html(advice)}
        </div>
        """


    html_doc = f"""
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <title>{esc(datasheet["title"])}</title>
  <style>
    @page {{
