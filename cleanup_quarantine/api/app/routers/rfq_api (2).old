def classify_pulley_from_text(text: str) -> dict[str, Any]:
    raw = text or ""
    lower = raw.lower()

    function_type = "N_N_B"
    mechanical_construction = "N_N_B"
    flange_type = "N_N_B"
    duty_class = "N_N_B"
    lagging_class = "N_N_B"
    conveyor_position = "N_N_B"

    if "aandrijftrommel" in lower or "drive pulley" in lower:
        function_type = "AANDRIJFTROMMEL"
        conveyor_position = "HEAD_PULLEY"
    elif "keertrommel" in lower or "tail pulley" in lower:
        function_type = "KEERTROMMEL"
        conveyor_position = "TAIL_PULLEY"
    elif "spantrommel" in lower or "take-up" in lower or "take up" in lower:
        function_type = "SPANTROMMEL"
        conveyor_position = "TAKE_UP_PULLEY"
    elif "snub" in lower:
        function_type = "SNUBTROMMEL"
        conveyor_position = "SNUB_PULLEY"
    elif "bend pulley" in lower or "buigtrommel" in lower or "druktrommel" in lower:
        function_type = "DRUKTROMMEL"
        conveyor_position = "BEND_PULLEY"
    elif "magneet" in lower or "magnetic pulley" in lower:
        function_type = "MAGNEETTROMMEL"
    elif "wing pulley" in lower or "vleugeltrommel" in lower:
        function_type = "VLEUGELTROMMEL"
    elif "kooi" in lower or "cage pulley" in lower:
        function_type = "KOOINAAFTROMMEL"

    if "klembus" in lower or "clamping bush" in lower or "taper lock" in lower:
        mechanical_construction = "AS_MET_KLEMBUSSEN"
    elif "gelaste as" in lower or "welded shaft" in lower:
        mechanical_construction = "GELASTE_AS"
    elif "massieve as" in lower or "solid shaft" in lower:
        mechanical_construction = "MASSIEVE_AS"
    elif "stub shaft" in lower:
        mechanical_construction = "STUB_SHAFT"
    elif "doorgaande as" in lower or "through shaft" in lower:
        mechanical_construction = "DOORGAANDE_AS"

    if "massieve flens" in lower:
        flange_type = "MASSIEVE_FLENS"
    elif "flens met gelaste naaf" in lower or "welded hub" in lower:
        flange_type = "FLENS_MET_GELASTE_NAAF"

    if "diamant" in lower:
        lagging_class = "RUBBER_DIAMANT"
    elif "rubber bekleding" in lower or "rubberen bekleding" in lower:
        lagging_class = "GLAD_RUBBER"
    elif "keramisch" in lower or "ceramic" in lower:
        lagging_class = "KERAMISCH"
    elif "polyurethaan" in lower or "polyurethane" in lower:
        lagging_class = "POLYURETHAAN"
    elif "bare steel" in lower or "onbekleed" in lower:
        lagging_class = "BARE_STEEL"

    if any(x in lower for x in ["mine duty", "mijnbouw"]):
        duty_class = "MINE_DUTY"
    elif any(x in lower for x in ["heavy duty", "zwaar", "staalindustrie", "haven"]):
        duty_class = "HEAVY_DUTY"
    elif "extreme duty" in lower:
        duty_class = "EXTREME_DUTY"
    elif "light duty" in lower:
        duty_class = "LIGHT_DUTY"
    elif function_type in {"AANDRIJFTROMMEL", "SNUBTROMMEL", "DRUKTROMMEL"}:
        duty_class = "HEAVY_DUTY"
    elif function_type == "KEERTROMMEL":
        duty_class = "MEDIUM_DUTY"

    return {
        "function_type": function_type,
        "mechanical_construction": mechanical_construction,
        "flange_type": flange_type,
        "duty_class": duty_class,
        "lagging_class": lagging_class,
        "conveyor_position": conveyor_position,
    }


def parse_pulley_specs_from_text(text: str, drawing_reference: str | None = None) -> dict[str, Any]:
    raw = text or ""
    lower = raw.lower()

    normalized_context = build_normalized_drawing_context(raw)

    specs: dict[str, Any] = {}
    missing: list[str] = []

    pulley_classification = classify_pulley_from_text(raw)
    specs["classification"] = pulley_classification

    product_type = "UNKNOWN"

    if any(x in lower for x in [
        "aandrijftrommel",
        "keertrommel",
        "gebolleerde trommel",
        "crowned pulley",
        "pulley",
        "trommel",
    ]):
        product_type = "TROMMEL"

    if "aandrijftrommel" in lower:
        specs["trommel_type"] = "aandrijftrommel"
        specs["description"] = "Aandrijftrommel"
    elif "keertrommel" in lower:
        specs["trommel_type"] = "keertrommel"
        specs["description"] = "Keertrommel"
    elif "gebolleerde trommel" in lower or "crowned pulley" in lower:
        specs["trommel_type"] = "gebolleerde trommel"
        specs["description"] = "Gebol­leerde trommel / crowned pulley"

    # Diameter: herken Ø630, Ø 630, n630, n 630
    diameter_matches = re.findall(r"(?:Ø|ø|n)\s*(\d{2,4})", raw)
    diameter_values = [int(x) for x in diameter_matches if 100 <= int(x) <= 2000]

    if diameter_values:
        # Grote waarde als trommeldiameter; kleine waarden zijn vaak as/tapmaten
        specs["diameter_de_mm"] = max(diameter_values)
        specs["diameter_mm"] = max(diameter_values)
    else:
        missing.append("diameter")

    # Mantellengte / trommelbreedte: vaak 1100, 600, 610 etc.
    # Neem hoogste realistische waarde uit losse maatlijnen.
    numeric_values = [
        int(x) for x in re.findall(r"\b(\d{3,4})\b", raw)
        if 250 <= int(x) <= 3000
    ]

    drum_width_candidate = (
        normalized_context
        .get("selected_candidates", {})
        .get("drum_width_mm")
    )

    bearing_center_candidate = (
        normalized_context
        .get("selected_candidates", {})
        .get("bearing_center_distance_mm")
    )

    if drum_width_candidate:
        specs["mantel_lengte_mm"] = drum_width_candidate["value"]
        specs["drum_width_mm"] = drum_width_candidate["value"]
        specs.setdefault("field_confidence", {})
        specs["field_confidence"]["drum_width_mm"] = {
            "value": drum_width_candidate["value"],
            "confidence": drum_width_candidate.get("confidence", 50),
            "reason": drum_width_candidate.get("reason"),
        }
    else:
        missing.append("trommelbreedte")
    if bearing_center_candidate:
        specs["bearing_center_distance_mm"] = bearing_center_candidate["value"]
        specs.setdefault("field_confidence", {})
        specs["field_confidence"]["bearing_center_distance_mm"] = {
            "value": bearing_center_candidate["value"],
            "confidence": bearing_center_candidate.get("confidence", 50),
            "reason": bearing_center_candidate.get("reason"),
        }


    # Asdiameters: herken n125, n140, n100 etc.
    shaft_candidates = [
        int(x) for x in diameter_matches
        if 40 <= int(x) <= 250
    ]

    if shaft_candidates:
        specs["as_diameter_mm"] = max(shaft_candidates)
        specs["shaft_diameter_mm"] = max(shaft_candidates)
        specs["shaft_diameter_candidates_mm"] = sorted(set(shaft_candidates))
    else:
        missing.append("asdiameter")

    # Geometrie / maatvoering uit bekende tekeningtekst
    # Voorlopig pragmatisch: herken veelvoorkomende maatwaarden uit deze layout.
    if 140 in shaft_candidates:
        specs["d1_mm"] = 140
    if 125 in shaft_candidates:
        specs["d2_mm"] = 125
    if 100 in shaft_candidates:
        specs["d4_mm"] = 100

    # LA/A/L1/L2/M/N zijn lastig zonder visuele OCR-context.
    # Daarom voorlopig alleen invullen als expliciet gelabeld in tekst.
    # Gelabelde lengtematen alleen accepteren met duidelijke separator.
    # Voorkomt foutieve hits zoals A11/1 of n35.
    dimension_patterns = [
        ("LA", "la_mm", r"\bLA\s*[:=]\s*(\d{2,5})\b"),
        ("L1", "l1_mm", r"\bL1\s*[:=]\s*(\d{2,5})\b"),
        ("L2", "l2_mm", r"\bL2\s*[:=]\s*(\d{2,5})\b"),
        ("A", "a_mm", r"\bA\s*[:=]\s*(\d{2,5})\b"),
        ("M", "m_mm", r"\bM\s*[:=]\s*(\d{2,5})\b"),
        ("N", "n_mm", r"\bN\s*[:=]\s*(\d{2,5})\b"),
    ]

    for _label, field, pattern in dimension_patterns:
        match = re.search(pattern, raw, re.IGNORECASE)
        if match:
            specs[field] = int(match.group(1))

    # Lagerhuizen / lagering / adapter / afdichting
    bearing_housing = re.search(r"\bSNL\s*\d{3,4}(?:-\d{3,4})?\b", raw, re.IGNORECASE)
    if bearing_housing:
        specs["bearing_housing"] = bearing_housing.group(0).upper().replace("  ", " ")
        specs["lagerhuis"] = specs["bearing_housing"]
    else:
        missing.append("lagerhuis")

    bearing = re.search(r"\b2{3}\d{2}\s*(?:CCK|EK|E|K)?\b", raw, re.IGNORECASE)
    if bearing:
        specs["bearing"] = bearing.group(0).upper().replace("  ", " ")
        specs["lagering"] = specs["bearing"]
    else:
        missing.append("lagering")

    adapter = re.search(r"\bH\s*\d{3,5}\b", raw, re.IGNORECASE)
    if adapter:
        specs["adapter"] = adapter.group(0).upper().replace(" ", "")

    seal = re.search(r"\bTSN\s*\d{3,4}\s*[A-Z]?\b", raw, re.IGNORECASE)
    if seal:
        specs["seal"] = seal.group(0).upper().replace("  ", " ")

    if "frb" in lower:
        frb = re.search(r"\bFRB\s*\d+\s*/\s*\d+\b", raw, re.IGNORECASE)
        if frb:
            specs["frb_ring"] = frb.group(0).upper().replace(" ", "")

    # Lagging / bekleding
    if "rubber bekleding" in lower or "rubberen bekleding" in lower:
        specs["lagging_type"] = "rubber"
        if "diamant" in lower:
            specs["lagging_profile"] = "diamant patroon"
            specs["lagging_type"] = "rubber diamant patroon"

        lagging_thickness = re.search(
            r"(?:rubber(?:en)?\s+bekleding|bekleding)\s*(?:\n|\r|\s)*(\d{1,2})\s*(?:mm)?",
            raw,
            re.IGNORECASE,
        )
        if lagging_thickness:
            specs["lagging_dikte_mm"] = int(lagging_thickness.group(1))
        elif "10" in raw and "bekleding" in lower:
            specs["lagging_dikte_mm"] = 10
    else:
        missing.append("lagging_type")
        missing.append("lagging_dikte_mm")

    # Krachten
    force_match = re.search(r"T1\s*\+\s*T2\s*=\s*(\d+(?:[,.]\d+)?)\s*kN", raw, re.IGNORECASE)
    if force_match:
        specs["belt_pull_force"] = f"T1 + T2 = {force_match.group(1).replace(',', '.')} kN"

    torque_match = re.search(r"(\d+(?:[,.]\d+)?)\s*Nm", raw, re.IGNORECASE)
    if torque_match:
        specs["motor_torque"] = f"{torque_match.group(1).replace(',', '.')} Nm"

    speed_match = re.search(r"(\d+(?:[,.]\d+)?)\s*m/s", raw, re.IGNORECASE)
    if speed_match:
        specs["belt_speed"] = f"{speed_match.group(1).replace(',', '.')} m/s"

    # Materiaal
    if "ck45" in lower or "c45" in lower:
        specs["materiaal_as"] = "C45 / CK45"
        specs["shaft_material"] = "C45 / CK45"
    else:
        missing.append("asmateriaal")

    if "s355" in lower:
        specs["materiaal_mantel"] = "S355"

    # Leveranciersnotities
    supplier_notes = []

    if "klembus binnen trommel houden" in lower:
        supplier_notes.append("Klembus binnen trommel houden.")

    if "bearing housings need to be provided and installed by supplier" in lower:
        supplier_notes.append("Bearing housings to be provided and installed by supplier.")

    if "clamping bushes need to be kept on the inside of the drum" in lower:
        supplier_notes.append("Clamping bushes inside drum.")

    if "mid plates need to be installed if necessary" in lower:
        supplier_notes.append("Mid plates if necessary.")

    if supplier_notes:
        specs["supplier_notes"] = " ".join(supplier_notes)

    # Tekeninggegevens
    drawing_number = re.search(r"Drawing Number:\s*([^\n\r]+)", raw, re.IGNORECASE)
    if drawing_number:
        specs["drawing_number"] = drawing_number.group(1).strip()

    model_number = re.search(r"Model Number:\s*([^\n\r]+)", raw, re.IGNORECASE)
    if model_number:
        specs["model_number"] = model_number.group(1).strip()

    drawing_description = re.search(r"Drawing Description:\s*([^\n\r]+)", raw, re.IGNORECASE)
    if drawing_description:
        specs["drawing_description"] = drawing_description.group(1).strip()

    # Defaults / engineering aannames
    specs.setdefault("balancering", "statisch balanceren voorstel")
    specs.setdefault("fat_required", True)

    if "materiaal_mantel" not in specs:
        missing.append("materiaal_mantel")

    if "tir_mm" not in specs:
        missing.append("tir_mm")

    missing.extend([
        "coating/paint specification",
        "final delivery address",
        "required delivery date",
    ])

    # Verwijder missing fields die inmiddels gevuld zijn
    filled_field_map = {
        "diameter": ["diameter_de_mm", "diameter_mm"],
        "trommelbreedte": ["mantel_lengte_mm", "drum_width_mm"],
        "asdiameter": ["as_diameter_mm", "shaft_diameter_mm"],
        "lagerhuis": ["lagerhuis", "bearing_housing"],
        "lagering": ["lagering", "bearing"],
        "asmateriaal": ["materiaal_as", "shaft_material"],
        "lagging_type": ["lagging_type"],
        "lagging_dikte_mm": ["lagging_dikte_mm"],
        "materiaal_mantel": ["materiaal_mantel"],
    }

    cleaned_missing = []
    for field in missing:
        aliases = filled_field_map.get(field, [field])
        if not any(specs.get(alias) for alias in aliases):
            cleaned_missing.append(field)

    confidence = 50
    if product_type == "TROMMEL":
        confidence = 70

    important_fields = [
        "diameter_de_mm",
        "mantel_lengte_mm",
        "as_diameter_mm",
        "lagering",
        "lagerhuis",
        "lagging_type",
        "lagging_dikte_mm",
    ]
    filled_important = sum(1 for f in important_fields if specs.get(f))
    confidence = min(95, confidence + filled_important * 3)
    specs["normalized_context"] = normalized_context

    return {
        "pos_nr": "POS-001",
        "drawing_mark": drawing_reference,
        "product_type": product_type,
        "quantity": 1,
        "confidence_score": confidence,
        "extracted_specs": specs,
        "missing_fields": sorted(set(cleaned_missing)),
    }


from openai import RateLimitError

def run_openai_ocr_on_image(image_bytes: bytes) -> str:
    try:
        image_b64 = base64.b64encode(image_bytes).decode("utf-8")

        response = openai_client.responses.create(
            model="gpt-4.1-mini",
            input=[
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "input_text",
                            "text": (
                                "Extract all readable text from this "
                                "technical RFQ/document page. "
                                "Return only the extracted text."
                            ),
                        },
                        {
                            "type": "input_image",
                            "image_url": (
                                f"data:image/png;base64,{image_b64}"
                            ),
                        },
                    ],
                }
            ],
        )

        return response.output_text

    except RateLimitError:
        return "[OPENAI_QUOTA_EXCEEDED]"

def run_openai_vision_page_analysis(image_bytes: bytes) -> dict[str, Any]:
    try:
        image_b64 = base64.b64encode(image_bytes).decode("utf-8")

        response = openai_client.responses.create(
            model="gpt-4.1-mini",
            input=[
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "input_text",
                            "text": (
                                "Analyze this technical drawing page for RFQ engineering. "
                                "Return strict JSON with: "
                                "page_type, detected_components, detected_dimensions, "
                                "title_block, warnings, confidence. "
                                "Do not invent values. Use null when unclear."
                            ),
                        },
                        {
                            "type": "input_image",
                            "image_url": f"data:image/png;base64,{image_b64}",
                        },
                    ],
                }
            ],
        )

        return json.loads(response.output_text)

    except RateLimitError:
        return {
            "status": "OPENAI_QUOTA_EXCEEDED",
            "warnings": ["OpenAI quota exceeded"],
            "confidence": 0,
        }

    except Exception as exc:
        return {
            "status": "VISION_ANALYSIS_FAILED",
            "error": str(exc),
            "confidence": 0,
        }

def classify_customer_from_crm(customer_name: str | None) -> dict[str, Any]:
    if not customer_name:
        return {"customer_type": "UNKNOWN", "customer_value_score": 0, "crm_summary": {}, "history": []}

    customer_norm = customer_name.strip().upper()
    crm_rows = fetch_all(
        """
        SELECT account_name, klanttype, status, COUNT(*) AS n,
               COALESCE(SUM(verwachte_omzet), 0) AS waarde,
               ROUND(AVG(kwaliteit_score)::numeric, 1) AS avg_score
        FROM crm.vw_crm_pipeline_quality_v1
        WHERE account_norm ILIKE '%' || :customer_norm || '%'
           OR account_name ILIKE '%' || :customer_name || '%'
        GROUP BY account_name, klanttype, status
        ORDER BY waarde DESC
        LIMIT 20
        """,
        {"customer_norm": customer_norm, "customer_name": customer_name},
    )

    if not crm_rows:
        return {
            "customer_type": "UNKNOWN",
            "customer_value_score": 0,
            "crm_summary": {"message": "Geen CRM-historie gevonden."},
            "history": [],
        }

    total_value = sum(float(r.get("waarde") or 0) for r in crm_rows)
    total_n = sum(int(r.get("n") or 0) for r in crm_rows)
    type_scores: dict[str, float] = {}
    for r in crm_rows:
        kt = r.get("klanttype") or "UNKNOWN"
        type_scores[kt] = type_scores.get(kt, 0) + float(r.get("waarde") or 0)

    customer_type = max(type_scores, key=type_scores.get) if type_scores else "UNKNOWN"
    customer_value_score = min(100, round((total_value / 100000) + min(total_n, 50), 1))

    return {
        "customer_type": customer_type,
        "customer_value_score": customer_value_score,
        "crm_summary": {
            "total_opportunities": total_n,
            "total_value": round(total_value, 2),
            "dominant_customer_type": customer_type,
            "type_value_distribution": type_scores,
        },
        "history": crm_rows,
    }


def load_customer_memory(customer_name: str | None):
    if not customer_name:
        return []
    return fetch_all(
        """
        SELECT requirement_type, requirement_text, frequency_count, confidence_score,
               source_odoo_reference, last_seen_at
        FROM rfq.customer_requirement_memory
        WHERE customer_norm = rfq.norm_txt(:customer_name)
          AND active = true
        ORDER BY confidence_score DESC, frequency_count DESC, last_seen_at DESC
        LIMIT 50
        """,
        {"customer_name": customer_name},
    )


def propose_route(customer_type: str, request_type: str | None, memory: list[dict[str, Any]]) -> dict[str, Any]:
    request_type_l = (request_type or "").lower()
    if customer_type == "ASSET_OWNER":
        route = "PREMIUM"
        reason = "Asset owner: betrouwbaarheid, levensduur en TCO wegen zwaarder dan laagste prijs."
    elif customer_type in {"OEM", "CONTRACTOR"}:
        route = "OEM"
        reason = "OEM/projectkanaal: prijs, reproduceerbaarheid en levertijd zijn waarschijnlijk leidend."
    else:
        route = "REVIEW"
        reason = "Klanttype onbekend: eerst classificeren voordat PDF/RFQ wordt gemaakt."

    if "kritisch" in request_type_l or "premium" in request_type_l:
        route = "PREMIUM"
        reason = "Aanvraag bevat kritische/premium indicatie."

    return {"selected_route": route, "reason": reason, "memory_used": memory[:10]}


def infer_balancing(canonical: dict[str, Any]) -> dict[str, Any]:
    route = (canonical.get("selected_route") or "").upper()
    engineering = canonical.get("engineering_requirements") or {}
    product_scope = engineering.get("product_scope") or []
    missing = canonical.get("missing_data") or []

    if "TROMMEL" not in product_scope:
        return {"method": "NOT_APPLICABLE", "label": "Niet van toepassing", "reason": "Geen trommelpositie in scope."}
    if route == "PREMIUM":
        return {"method": "DYNAMIC_G6_3", "label": "Dynamisch balanceren G6.3", "reason": "Premium-route: dynamische balancering aanbevolen."}
    if any("balancering" in str(x).lower() for x in missing):
        return {"method": "STATIC", "label": "Statisch balanceren", "reason": "OEM-route / minder kritische trommel: statisch balanceren als standaard voorstel."}
    return {"method": "STATIC", "label": "Statisch balanceren", "reason": "Geen kritische toepassing opgegeven."}


def build_rfq_pdf_translated(
    rfq: dict[str, Any],
    positions: list[dict[str, Any]],
    suppliers: list[dict[str, Any]],
    output_path: Path,
    language: str,
    balancing: dict[str, Any],
):
    output_path.parent.mkdir(parents=True, exist_ok=True)
    t = RFQ_TEXT.get(language, RFQ_TEXT["nl"])
    styles = getSampleStyleSheet()
    title = styles["Title"]
    h2 = styles["Heading2"]
    normal = styles["BodyText"]
    small = ParagraphStyle("Small", parent=normal, fontSize=8, leading=10)

    doc = SimpleDocTemplate(
        str(output_path),
        pagesize=A4,
        rightMargin=15 * mm,
        leftMargin=15 * mm,
        topMargin=15 * mm,
        bottomMargin=15 * mm,
    )

    story = [Paragraph(t["title"], title), Spacer(1, 6 * mm), Paragraph(t["general"], h2)]

    header_data = [
        [t["odoo_reference"], rfq.get("odoo_reference") or ""],
        [t["rfq_id"], rfq.get("rfq_id") or ""],
        [t["request_type"], rfq.get("request_type") or ""],
        [t["classification"], rfq.get("selected_route") or ""],
        [t["customer_type"], rfq.get("customer_type") or ""],
        [t["template_version"], RFQ_TEMPLATE_VERSION],
        [t["balancing"], balancing.get("label") or t["not_registered"]],
    ]
    header_table = Table(header_data, colWidths=[45 * mm, 120 * mm])
    header_table.setStyle(TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.25, colors.grey),
        ("BACKGROUND", (0, 0), (0, -1), colors.lightgrey),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
    ]))
    story += [header_table, Spacer(1, 5 * mm), Paragraph(t["no_customer"], normal), Spacer(1, 5 * mm)]

    story.append(Paragraph(t["positions"], h2))
    pos_rows = [[t["position"], t["drawing"], t["type"], t["quantity"], t["specs"]]]
    for p in positions:
        specs = p.get("extracted_specs") or {}
        specs_text = ", ".join([f"{k}: {v}" for k, v in specs.items()])
        pos_rows.append([
            p.get("pos_nr") or "",
            p.get("drawing_mark") or "",
            p.get("product_type") or "",
            str(p.get("quantity") or ""),
            Paragraph(specs_text or "-", small),
        ])
    pos_table = Table(pos_rows, colWidths=[25 * mm, 35 * mm, 30 * mm, 20 * mm, 70 * mm])
    pos_table.setStyle(TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.25, colors.grey),
        ("BACKGROUND", (0, 0), (-1, 0), colors.lightgrey),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
    ]))
    story += [pos_table, Spacer(1, 6 * mm)]

    story.append(Paragraph(t["missing"], h2))
    missing_rows = [[t["position"], t["missing"]]]
    for p in positions:
        missing = p.get("missing_fields") or []
        missing_rows.append([p.get("pos_nr") or "", Paragraph(", ".join(missing) if missing else "-", small)])
    missing_table = Table(missing_rows, colWidths=[30 * mm, 140 * mm])
    missing_table.setStyle(TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.25, colors.grey),
        ("BACKGROUND", (0, 0), (-1, 0), colors.lightgrey),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
    ]))
    story += [missing_table, Spacer(1, 6 * mm)]

    story += [
        Paragraph(t["supplier_instruction"], h2),
        Paragraph(t["supplier_instruction_text"], normal),
        Spacer(1, 6 * mm),
        Paragraph(t["balancing"], h2),
        Paragraph(f"{balancing.get('label') or t['not_registered']} - {balancing.get('reason') or ''}", normal),
    ]

    doc.build(story)


def build_rfq_pdf(
    rfq: dict[str, Any],
    positions: list[dict[str, Any]],
    suppliers: list[dict[str, Any]],
    output_path: Path,
):
    build_rfq_pdf_translated(
        rfq=rfq,
        positions=positions,
        suppliers=suppliers,
        output_path=output_path,
        language="nl",
        balancing={"label": "Niet geregistreerd", "reason": "Legacy PDF route."},
    )


def build_rfq_pdf_from_canonical(canonical: dict[str, Any], output_path: Path, language: str = "nl"):
    language = language.lower()
    if language not in RFQ_TEXT:
        language = "nl"

    rfq = {
        "rfq_id": canonical.get("rfq_id"),
        "odoo_reference": canonical.get("odoo_reference"),
        "request_type": canonical.get("request_type"),
        "selected_route": canonical.get("selected_route"),
        "customer_type": canonical.get("customer_type"),
    }
    positions = canonical.get("position_summary") or []
    supplier_strategy = canonical.get("supplier_strategy") or {}
    suppliers = supplier_strategy.get("selected_suppliers") or []
    balancing = infer_balancing(canonical)

    build_rfq_pdf_translated(
        rfq=rfq,
        positions=positions,
        suppliers=suppliers,
        output_path=output_path,
        language=language,
        balancing=balancing,
    )


@router.post("/{rfq_id}/workflow/refresh")
def refresh_rfq_workflow_status(rfq_id: str):
    return update_rfq_workflow_status(rfq_id)


@router.post("/{rfq_id}/workflow/force-status")
def force_rfq_workflow_status(
    rfq_id: str,
    status: str = Query(...),
    changed_by: str = Query(default="DEV_TEST"),
):
    allowed_statuses = {
        "DRAFT",
        "ENGINEERING_REVIEW",
        "COMMERCIAL_GATE",
        "READY_FOR_RFQ",
        "SUPPLIER_PACKAGE_CREATED",
        "SUPPLIER_ROUTED",
        "SUPPLIER_RFQ_SENT",
        "QUOTATION_RECEIVED",
        "AWARDED",
        "CLOSED",
    }

    status = status.upper()

    if status not in allowed_statuses:
        raise HTTPException(
            status_code=400,
            detail=f"Invalid status. Allowed: {sorted(allowed_statuses)}",
        )

    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    updated = execute_one(
        """
        UPDATE rfq.request
        SET status = :status,
            updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "status": status,
        },
    )

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            user_override,
            approved_by,
            approved_at
        )
        VALUES (
            :rfq_id,
            'WORKFLOW_STATUS_FORCED',
            CAST(:user_override AS jsonb),
            :approved_by,
            now()
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq_id,
            "approved_by": changed_by,
            "user_override": json_dumps({
                "old_status": rfq.get("status"),
                "new_status": status,
                "reason": "Testfase handmatige statuswijziging",
            }),
        },
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "old_status": rfq.get("status"),
        "new_status": status,
        "rfq": updated,
        "warning": "Handmatige statuswijziging alleen bedoeld voor testfase.",
    }


@router.post("/intake/start")
def start_rfq_intake(payload: RfqStartIn):
    customer_norm_row = fetch_one("SELECT rfq.norm_txt(:customer_name) AS customer_norm", {"customer_name": payload.customer_name_internal})
    customer_norm = customer_norm_row["customer_norm"] if customer_norm_row else None
    context = classify_customer_from_crm(payload.customer_name_internal)
    memory = load_customer_memory(payload.customer_name_internal)
    route = propose_route(context["customer_type"], payload.request_type, memory)

    rfq = execute_one(
        """
        INSERT INTO rfq.request (
            odoo_reference, customer_name_internal, customer_norm, verkoper, request_type,
            customer_type, selected_route, customer_value_score, customer_context, intake_summary,
            quoted_value_eur, awarded_value_eur, rfq_value_eur, commercial_status
        ) VALUES (
            :odoo_reference, :customer_name_internal, :customer_norm, :verkoper, :request_type,
            :customer_type, :selected_route, :customer_value_score,
            CAST(:customer_context AS jsonb), CAST(:intake_summary AS jsonb),
            :quoted_value_eur, :awarded_value_eur, :rfq_value_eur, :commercial_status
        ) RETURNING *
        """,
        {
            "odoo_reference": payload.odoo_reference,
            "customer_name_internal": payload.customer_name_internal,
            "customer_norm": customer_norm,
            "verkoper": payload.verkoper,
            "request_type": payload.request_type,
            "customer_type": context["customer_type"],
            "selected_route": route["selected_route"],
            "customer_value_score": context["customer_value_score"],
            "customer_context": json_dumps(context),
            "intake_summary": json_dumps(route),
            "quoted_value_eur": payload.quoted_value_eur,
            "awarded_value_eur": payload.awarded_value_eur,
            "rfq_value_eur": payload.rfq_value_eur,
            "commercial_status": payload.commercial_status,
        },
    )

    execute_one(
        """
        INSERT INTO rfq.decision_log (rfq_id, step, gpt_suggestion)
        VALUES (:rfq_id, 'INTAKE_PROPOSAL', CAST(:gpt_suggestion AS jsonb))
        RETURNING decision_id
        """,
        {"rfq_id": rfq["rfq_id"], "gpt_suggestion": json_dumps({"customer_context": context, "customer_memory": memory, "route_proposal": route})},
    )

    return {
        "intent": "rfq_intake_start",
        "rfq_id": rfq["rfq_id"],
        "odoo_reference": payload.odoo_reference,
        "voor_medewerker": {
            "klantnaam_intern": payload.customer_name_internal,
            "klanttype": context["customer_type"],
            "klantwaarde_score": context["customer_value_score"],
            "crm_samenvatting": context["crm_summary"],
            "historische_eisen": memory,
            "voorgestelde_route": route["selected_route"],
            "reden": route["reason"],
            "let_op": ["Klantnaam komt later niet op leveranciers-PDF.", "PDF mag pas na goedkeuring worden gemaakt.", "Controleer of Odoo referentie correct is."],
        },
    }


@router.get("/suppliers")
def list_suppliers(route: Optional[str] = Query(default=None), product_type: Optional[str] = Query(default=None), limit: int = Query(default=50, ge=1, le=500)):
    route_score = """
        CASE
            WHEN :route = 'PREMIUM' THEN premium_score
            WHEN :route = 'OEM' THEN oem_score
            ELSE ((oem_score + premium_score) / 2)
        END
    """
    sql = f"""
        SELECT *, ROUND((({route_score}) * 0.35 + price_score * 0.15 + delivery_score * 0.15 + quality_score * 0.15 + documentation_score * 0.10 + response_score * 0.10)::numeric, 1) AS supplier_fit_score
        FROM rfq.vw_supplier_performance_v1
        WHERE active = true AND (:product_type IS NULL OR :product_type = ANY(categories))
        ORDER BY supplier_fit_score DESC, supplier_name
        LIMIT :limit
    """
    return {"intent": "rfq_suppliers", "route": route, "product_type": product_type, "suppliers": fetch_all(sql, {"route": route, "product_type": product_type, "limit": limit})}


@router.post("/suppliers")
def create_supplier(payload: SupplierIn):
    supplier_norm = fetch_one("SELECT rfq.norm_txt(:supplier_name) AS supplier_norm", {"supplier_name": payload.supplier_name})["supplier_norm"]
    supplier = execute_one(
        """
        INSERT INTO rfq.supplier (supplier_name, supplier_norm, categories, specialties, country, notes)
        VALUES (:supplier_name, :supplier_norm, :categories, :specialties, :country, :notes)
        ON CONFLICT (supplier_norm) DO UPDATE SET categories = EXCLUDED.categories, specialties = EXCLUDED.specialties, country = EXCLUDED.country, notes = EXCLUDED.notes
        RETURNING *
        """,
        {"supplier_name": payload.supplier_name, "supplier_norm": supplier_norm, "categories": payload.categories, "specialties": payload.specialties, "country": payload.country, "notes": payload.notes},
    )
    execute_one("INSERT INTO rfq.supplier_score (supplier_id) VALUES (:supplier_id) ON CONFLICT (supplier_id) DO NOTHING RETURNING supplier_id", {"supplier_id": supplier["supplier_id"]})
    return {"intent": "rfq_supplier_created", "supplier": supplier}


@router.post("/{rfq_id}/suppliers/{supplier_id}/send-package")
def send_supplier_package(
    rfq_id: str,
    supplier_id: str,
    request: Request,
):
    rfq = fetch_one(
        """
        SELECT *
        FROM rfq.request
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    supplier = fetch_one(
        """
        SELECT *
        FROM rfq.supplier
        WHERE supplier_id = :supplier_id
        """,
        {"supplier_id": supplier_id},
    )

    if not supplier:
        raise HTTPException(status_code=404, detail="Supplier not found")

    artifact = fetch_one(
        """
        SELECT *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
          AND artifact_type = 'supplier_package_pdf'
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        {"rfq_id": rfq_id},
    )

    if not artifact:
        raise HTTPException(
            status_code=400,
            detail="No supplier package artifact available"
        )

    supplier_rfq = execute_one(
        """
        INSERT INTO rfq.supplier_rfq (
            rfq_id,
            supplier_id,
            package_artifact_id,
            route_type,
            status,
            sent_at,
            sent_by
        )
        VALUES (
            :rfq_id,
            :supplier_id,
            :package_artifact_id,
            'REVIEW',
            'SENT',
            now(),
            'PROMATI_ASSISTANT'
        )
        RETURNING *
        """,
        {
            "rfq_id": rfq_id,
            "supplier_id": supplier_id,
            "package_artifact_id": artifact["artifact_id"],
        },
    )

    download_url = (
        str(request.base_url).rstrip("/")
        + f"/analysis/rfq/artifacts/{artifact['artifact_id']}/download"
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_rfq_sent",
        "rfq_id": rfq_id,
        "supplier_id": supplier_id,
        "supplier_rfq": dict(supplier_rfq),
        "supplier_package_download_url": download_url,
        "write_actions_available": True,
    }



@router.post("/suppliers/{supplier_id}/qualification")
def upsert_supplier_qualification(
    supplier_id: str,
    payload: SupplierQualificationIn,
):
    supplier = fetch_one(
        "SELECT * FROM rfq.supplier WHERE supplier_id = :supplier_id",
        {"supplier_id": supplier_id},
    )

    if not supplier:
        raise HTTPException(status_code=404, detail="Supplier not found")

    total_score = round(
        (
            payload.technical_score * 0.30
            + payload.response_score * 0.20
            + payload.engineering_score * 0.20
            + payload.commercial_score * 0.15
            + payload.strategic_score * 0.15
        ),
        2,
    )

    qualification = execute_one(
        """
        INSERT INTO rfq.supplier_qualification (
            supplier_id,
            classification,
            technical_score,
            response_score,
            engineering_score,
            commercial_score,
            strategic_score,
            approved_for,
            blocked_for,
            notes,
            total_score,
            updated_at
        )
        VALUES (
            :supplier_id,
            :classification,
            :technical_score,
            :response_score,
            :engineering_score,
            :commercial_score,
            :strategic_score,
            CAST(:approved_for AS jsonb),
            CAST(:blocked_for AS jsonb),
            CAST(:notes AS jsonb),
            :total_score,
            now()
        )
        ON CONFLICT (supplier_id)
        DO UPDATE SET
            classification = EXCLUDED.classification,
            technical_score = EXCLUDED.technical_score,
            response_score = EXCLUDED.response_score,
            engineering_score = EXCLUDED.engineering_score,
            commercial_score = EXCLUDED.commercial_score,
            strategic_score = EXCLUDED.strategic_score,
            approved_for = EXCLUDED.approved_for,
            blocked_for = EXCLUDED.blocked_for,
            notes = EXCLUDED.notes,
            total_score = EXCLUDED.total_score,
            updated_at = now()
        RETURNING *
        """,
        {
            "supplier_id": supplier_id,
            "classification": payload.classification,
            "technical_score": payload.technical_score,
            "response_score": payload.response_score,
            "engineering_score": payload.engineering_score,
            "commercial_score": payload.commercial_score,
            "strategic_score": payload.strategic_score,
            "approved_for": json_dumps(payload.approved_for),
            "blocked_for": json_dumps(payload.blocked_for),
            "notes": json_dumps(payload.notes),
            "total_score": total_score,
        },
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_qualification",
        "supplier": supplier,
        "qualification": qualification,
        "write_actions_available": True,
    }


@router.get("/{rfq_id}/supplier-routing")
def supplier_routing_for_rfq(
    rfq_id: str,
    limit: int = Query(default=3, ge=1, le=10),
):
    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    positions = fetch_all(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        ORDER BY pos_nr
        """,
        {"rfq_id": rfq_id},
    )

    product_types = sorted({
        p.get("product_type")
        for p in positions
        if p.get("product_type") and p.get("product_type") != "UNKNOWN"
    })

    route = (rfq.get("selected_route") or "REVIEW").upper()
    customer_name = (rfq.get("customer_name_internal") or "").upper()

    rows = fetch_all(
        """
        SELECT
            s.*,
            q.classification,
            q.technical_score,
            q.response_score,
            q.engineering_score,
            q.commercial_score,
            q.strategic_score,
            q.total_score,
            q.approved_for,
            q.blocked_for,
            q.notes
        FROM rfq.supplier s
        JOIN rfq.supplier_qualification q
          ON q.supplier_id = s.supplier_id
        WHERE s.active = true
          AND q.active = true
        """
    )

    classification_rank = {
        "PREFERRED_PREMIUM": 1,
        "PREMIUM_GOVERNED": 1,
        "APPROVED_OEM": 2,
        "CONDITIONAL": 3,
        "REVIEW": 4,
        "REVIEW_ONLY": 5,
        "BLOCKED": 99,
    }

    recommended = []

    for row in rows:
        categories = row.get("categories") or []
        approved_for = row.get("approved_for") or []
        blocked_for = row.get("blocked_for") or []

        if "BLOCKED" in (row.get("classification") or "").upper():
            continue

        if customer_name and customer_name in [str(x).upper() for x in blocked_for]:
            continue

        if route and route in [str(x).upper() for x in blocked_for]:
            continue

        if product_types:
            if not any(pt in categories for pt in product_types):
                continue

        reason_parts = []

        if route in [str(x).upper() for x in approved_for]:
            reason_parts.append(f"Approved for {route}")

        if customer_name and customer_name in [str(x).upper() for x in approved_for]:
            reason_parts.append(f"Approved for {customer_name}")

        if product_types:
            reason_parts.append("Product fit: " + ", ".join(product_types))

        if not reason_parts:
            reason_parts.append("General qualified supplier")

        recommended.append({
            "supplier_id": row["supplier_id"],
            "supplier_name": row["supplier_name"],
            "classification": row.get("classification"),
            "total_score": float(row.get("total_score") or 0),
            "technical_score": float(row.get("technical_score") or 0),
            "response_score": float(row.get("response_score") or 0),
            "engineering_score": float(row.get("engineering_score") or 0),
            "commercial_score": float(row.get("commercial_score") or 0),
            "strategic_score": float(row.get("strategic_score") or 0),
            "approved_for": approved_for,
            "blocked_for": blocked_for,
            "notes": row.get("notes") or [],
            "reason": " | ".join(reason_parts),
            "routing_rank": classification_rank.get(
                row.get("classification") or "REVIEW",
                50,
            ),
        })

    recommended = sorted(
        recommended,
        key=lambda x: (x["routing_rank"], -x["total_score"], x["supplier_name"]),
    )[:limit]

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_routing",
        "rfq_id": rfq_id,
        "selected_route": route,
        "customer_name_internal": rfq.get("customer_name_internal"),
        "product_types": product_types,
        "recommended_suppliers": recommended,
        "count": len(recommended),
        "rules": {
            "max_suppliers": limit,
            "blocked_suppliers_excluded": True,
            "category_match_required": bool(product_types),
            "classification_priority_enabled": True,
        },
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/supplier-routing/create")
def create_supplier_routing(
    rfq_id: str,
    limit: int = Query(default=3, ge=1, le=10),
):
    routing = supplier_routing_for_rfq(
        rfq_id=rfq_id,
        limit=limit,
    )

    recommended = routing["recommended_suppliers"]

    if not recommended:
        raise HTTPException(
            status_code=400,
            detail="No suppliers available for routing",
        )

    artifacts = fetch_all(
        """
        SELECT *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
          AND artifact_type = 'supplier_package_pdf'
        ORDER BY extracted_at DESC
        """,
        {"rfq_id": rfq_id},
    )

    latest_package_per_position = {}

    for artifact in artifacts:
        pos_id = str(artifact["position_id"])
        if pos_id not in latest_package_per_position:
            latest_package_per_position[pos_id] = artifact

    positions = fetch_all(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        ORDER BY pos_nr
        """,
        {"rfq_id": rfq_id},
    )

    created = []

    for supplier in recommended:

        for position in positions:

            package_artifact = latest_package_per_position.get(
                str(position["position_id"])
            )

            supplier_rfq = execute_one(
                """
                INSERT INTO rfq.supplier_rfq (
                    rfq_id,
                    supplier_id,
                    position_id,
                    package_artifact_id,
                    route_type,
                    status
                )
                VALUES (
                    :rfq_id,
                    :supplier_id,
                    :position_id,
                    :package_artifact_id,
                    :route_type,
                    'DRAFT'
                )
                ON CONFLICT (rfq_id, supplier_id, position_id)
                DO UPDATE SET
                    package_artifact_id = EXCLUDED.package_artifact_id,
                    route_type = EXCLUDED.route_type,
                    updated_at = now()
                RETURNING *
                """,
                {
                    "rfq_id": rfq_id,
                    "supplier_id": supplier["supplier_id"],
                    "position_id": position["position_id"],
                    "package_artifact_id": (
                        package_artifact["artifact_id"]
                        if package_artifact
                        else None
                    ),
                    "route_type": routing["selected_route"],
                },
            )

            created.append({
                "supplier_rfq_id": supplier_rfq["supplier_rfq_id"],
                "supplier_name": supplier["supplier_name"],
                "classification": supplier["classification"],
                "position_id": position["position_id"],
                "route_type": supplier_rfq["route_type"],
                "status": supplier_rfq["status"],
                "package_artifact_id": supplier_rfq["package_artifact_id"],
            })

    execute_one(
        """
        UPDATE rfq.request
        SET status = 'SUPPLIER_ROUTED',
            updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_routing_created",
        "rfq_id": rfq_id,
        "supplier_count": len(recommended),
        "supplier_rfqs_created": len(created),
        "supplier_rfqs": created,
        "rfq_status": "SUPPLIER_ROUTED",
        "write_actions_available": True,
    }


@router.post("/supplier-rfq/{supplier_rfq_id}/send")
def send_supplier_rfq(
    supplier_rfq_id: str,
    sent_by: str = Query(default="PROMATI_ASSISTANT"),
):
    supplier_rfq = fetch_one(
        """
        SELECT *
        FROM rfq.supplier_rfq
        WHERE supplier_rfq_id = :supplier_rfq_id
        """,
        {"supplier_rfq_id": supplier_rfq_id},
    )

    if not supplier_rfq:
        raise HTTPException(status_code=404, detail="Supplier RFQ not found")

    if not supplier_rfq.get("package_artifact_id"):
        raise HTTPException(
            status_code=400,
            detail="Supplier RFQ has no package artifact linked",
        )

    updated = execute_one(
        """
        UPDATE rfq.supplier_rfq
        SET status = 'SENT',
            sent_at = now(),
            sent_by = :sent_by,
            updated_at = now()
        WHERE supplier_rfq_id = :supplier_rfq_id
        RETURNING *
        """,
        {
            "supplier_rfq_id": supplier_rfq_id,
            "sent_by": sent_by,
        },
    )

    execute_one(
        """
        UPDATE rfq.request
        SET status = 'SUPPLIER_RFQ_SENT',
            updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING rfq_id
        """,
        {"rfq_id": updated["rfq_id"]},
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_rfq_sent",
        "supplier_rfq": updated,
        "rfq_status": "SUPPLIER_RFQ_SENT",
        "write_actions_available": True,
    }


@router.post("/supplier-rfq/{supplier_rfq_id}/response")
def register_supplier_rfq_response(
    supplier_rfq_id: str,
    quoted_amount: float | None = None,
    delivery_time: str | None = None,
    technical_deviations: str | None = None,
    commercial_deviations: str | None = None,
):
    supplier_rfq = fetch_one(
        """
        SELECT *
        FROM rfq.supplier_rfq
        WHERE supplier_rfq_id = :supplier_rfq_id
        """,
        {"supplier_rfq_id": supplier_rfq_id},
    )

    if not supplier_rfq:
        raise HTTPException(status_code=404, detail="Supplier RFQ not found")

    updated = execute_one(
        """
        UPDATE rfq.supplier_rfq
        SET status = 'RECEIVED',
            quoted_amount = :quoted_amount,
            delivery_time = :delivery_time,
            technical_deviations = :technical_deviations,
            commercial_deviations = :commercial_deviations,
            updated_at = now()
        WHERE supplier_rfq_id = :supplier_rfq_id
        RETURNING *
        """,
        {
            "supplier_rfq_id": supplier_rfq_id,
            "quoted_amount": quoted_amount,
            "delivery_time": delivery_time,
            "technical_deviations": technical_deviations,
            "commercial_deviations": commercial_deviations,
        },
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_rfq_response_registered",
        "supplier_rfq": updated,
        "write_actions_available": True,
    }


@router.get("/{rfq_id}/supplier-comparison")
def supplier_comparison_for_rfq(rfq_id: str):
    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    rows = fetch_all(
        """
        SELECT
            sr.*,
            s.supplier_name,
            q.classification,
            q.total_score,
            q.technical_score,
            q.response_score,
            q.engineering_score,
            q.commercial_score,
            q.strategic_score,
            q.notes
        FROM rfq.supplier_rfq sr
        JOIN rfq.supplier s
          ON s.supplier_id = sr.supplier_id
        LEFT JOIN rfq.supplier_qualification q
          ON q.supplier_id = sr.supplier_id
        WHERE sr.rfq_id = :rfq_id
        ORDER BY
            CASE WHEN sr.status = 'RECEIVED' THEN 0 ELSE 1 END,
            sr.quoted_amount ASC NULLS LAST,
            q.total_score DESC NULLS LAST
        """,
        {"rfq_id": rfq_id},
    )

    received = [r for r in rows if r.get("status") == "RECEIVED"]

    comparison = []
    for r in rows:
        risk_flags = []

        if r.get("status") not in ("RECEIVED", "CLOSED"):
            risk_flags.append("Nog geen offerte ontvangen")

        if r.get("technical_deviations") and str(r["technical_deviations"]).lower() not in ["geen", "none", "n/a"]:
            risk_flags.append("Technische afwijkingen aanwezig")

        if r.get("commercial_deviations"):
            risk_flags.append("Commerciële afwijking/opmerking aanwezig")

        comparison.append({
            "supplier_rfq_id": r["supplier_rfq_id"],
            "position_id": r.get("position_id"),
            "supplier_id": r["supplier_id"],
            "supplier_name": r["supplier_name"],
            "status": r["status"],
            "classification": r.get("classification"),
            "supplier_score": float(r.get("total_score") or 0),
            "quoted_amount": float(r["quoted_amount"]) if r.get("quoted_amount") is not None else None,
            "delivery_time": r.get("delivery_time"),
            "technical_deviations": r.get("technical_deviations"),
            "commercial_deviations": r.get("commercial_deviations"),
            "risk_flags": risk_flags,
            "notes": r.get("notes") or [],
        })

    best_price = None
    if received:
        priced = [r for r in received if r.get("quoted_amount") is not None]
        if priced:
            best_price = min(priced, key=lambda x: float(x["quoted_amount"]))

    best_technical_fit = None
    if received:
        best_technical_fit = max(received, key=lambda x: float(x.get("total_score") or 0))

    recommendation = None
    if best_price and best_technical_fit:
        recommendation = {
            "best_price_supplier": best_price["supplier_name"],
            "best_price_amount": float(best_price["quoted_amount"]),
            "best_technical_fit_supplier": best_technical_fit["supplier_name"],
            "best_technical_fit_score": float(best_technical_fit.get("total_score") or 0),
            "recommended_action": (
                "Vergelijk prijsverschil met technische/governance waarde voordat award wordt gekozen."
                if best_price["supplier_id"] != best_technical_fit["supplier_id"]
                else "Zelfde leverancier scoort beste prijs en beste technische fit."
            ),
        }

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_comparison",
        "rfq_id": rfq_id,
        "received_count": len(received),
        "supplier_count": len(rows),
        "comparison": comparison,
        "recommendation": recommendation,
        "write_actions_available": False,
    }


@router.post("/supplier-rfq/{supplier_rfq_id}/award")
def award_supplier_rfq(
    supplier_rfq_id: str,
    awarded_by: str = Query(default="PROMATI_ASSISTANT"),
    rejection_reason: str = Query(default="Niet geselecteerd"),
):
    supplier_rfq = fetch_one(
        """
        SELECT *
        FROM rfq.supplier_rfq
        WHERE supplier_rfq_id = :supplier_rfq_id
        """,
        {"supplier_rfq_id": supplier_rfq_id},
    )

    if not supplier_rfq:
        raise HTTPException(status_code=404, detail="Supplier RFQ not found")

    if supplier_rfq.get("status") != "RECEIVED":
        raise HTTPException(
            status_code=400,
            detail="Supplier RFQ can only be awarded after response is RECEIVED",
        )

    awarded = execute_one(
        """
        UPDATE rfq.supplier_rfq
        SET selected = true,
            status = 'AWARDED',
            updated_at = now()
        WHERE supplier_rfq_id = :supplier_rfq_id
        RETURNING *
        """,
        {"supplier_rfq_id": supplier_rfq_id},
    )

    execute_one(
        """
        UPDATE rfq.supplier_rfq
        SET selected = false,
            status = CASE
                WHEN status = 'RECEIVED' THEN 'LOST'
                ELSE status
            END,
            rejection_reason = :rejection_reason,
            updated_at = now()
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
          AND supplier_rfq_id <> :supplier_rfq_id
        RETURNING supplier_rfq_id
        """,
        {
            "rfq_id": awarded["rfq_id"],
            "position_id": awarded["position_id"],
            "supplier_rfq_id": supplier_rfq_id,
            "rejection_reason": rejection_reason,
        },
    )

    all_positions = fetch_all(
        """
        SELECT position_id
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": awarded["rfq_id"]},
    )

    awarded_positions = fetch_all(
        """
        SELECT DISTINCT position_id
        FROM rfq.supplier_rfq
        WHERE rfq_id = :rfq_id
          AND selected = true
          AND status = 'AWARDED'
        """,
        {"rfq_id": awarded["rfq_id"]},
    )

    if len(awarded_positions) >= len(all_positions) and len(all_positions) > 0:
        execute_one(
            """
            UPDATE rfq.request
            SET status = 'AWARDED',
                updated_at = now()
            WHERE rfq_id = :rfq_id
            RETURNING rfq_id
            """,
            {"rfq_id": awarded["rfq_id"]},
        )
    else:
        update_rfq_workflow_status(awarded["rfq_id"])

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_rfq_awarded_by_position",
        "rfq_id": awarded["rfq_id"],
        "position_id": awarded["position_id"],
        "supplier_rfq": awarded,
        "awarded_by": awarded_by,
        "write_actions_available": True,
    }


@router.get("/{rfq_id}/award")
def get_rfq_award(rfq_id: str):

    awarded = fetch_one(
        """
        SELECT
            sr.*,
            s.supplier_name,
            sq.classification,
            sq.total_score
        FROM rfq.supplier_rfq sr
        JOIN rfq.supplier s
            ON s.supplier_id = sr.supplier_id
        LEFT JOIN rfq.supplier_qualification sq
            ON sq.supplier_id = s.supplier_id
           AND sq.active = true
        WHERE sr.rfq_id = :rfq_id
          AND sr.selected = true
        LIMIT 1
        """,
        {"rfq_id": rfq_id},
    )

    if not awarded:
        return {
            "status": "ok",
            "domain": "rfq",
            "type": "rfq_award",
            "rfq_id": rfq_id,
            "awarded": False,
            "write_actions_available": False,
        }

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "rfq_award",
        "rfq_id": rfq_id,
        "awarded": True,
        "award": awarded,
        "write_actions_available": False,
    }


@router.get("/suppliers/kpi")
def supplier_kpi(
    limit: int = Query(default=100, ge=1, le=500),
):
    rows = fetch_all(
        """
        SELECT
            s.supplier_id,
            s.supplier_name,
            s.country,
            s.categories,
            s.specialties,

            q.classification,
            q.total_score,

            COUNT(sr.supplier_rfq_id)::int AS rfq_count,

            COUNT(sr.supplier_rfq_id) FILTER (
                WHERE sr.status IN ('SENT', 'RECEIVED', 'CLOSED')
            )::int AS sent_count,

            COUNT(sr.supplier_rfq_id) FILTER (
                WHERE sr.status IN ('RECEIVED', 'CLOSED')
                  AND sr.quoted_amount IS NOT NULL
            )::int AS quote_received_count,

            COUNT(sr.supplier_rfq_id) FILTER (
                WHERE sr.selected = true
            )::int AS award_count,

            COUNT(sr.supplier_rfq_id) FILTER (
                WHERE sr.status = 'DRAFT'
            )::int AS draft_count,

            COUNT(sr.supplier_rfq_id) FILTER (
                WHERE sr.status = 'SENT'
            )::int AS waiting_count,

            COALESCE(AVG(sr.quoted_amount), 0) AS avg_quoted_amount,
            COALESCE(SUM(sr.quoted_amount), 0) AS total_quoted_amount,

            AVG(
                EXTRACT(EPOCH FROM (sr.updated_at - sr.sent_at)) / 86400
            ) FILTER (
                WHERE sr.sent_at IS NOT NULL
                  AND sr.status IN ('RECEIVED', 'CLOSED')
            ) AS avg_response_days

        FROM rfq.supplier s
        LEFT JOIN rfq.supplier_qualification q
          ON q.supplier_id = s.supplier_id
         AND q.active = true
        LEFT JOIN rfq.supplier_rfq sr
          ON sr.supplier_id = s.supplier_id

        WHERE s.active = true

        GROUP BY
            s.supplier_id,
            s.supplier_name,
            s.country,
            s.categories,
            s.specialties,
            q.classification,
            q.total_score

        ORDER BY
            q.total_score DESC NULLS LAST,
            award_count DESC,
            quote_received_count DESC,
            s.supplier_name

        LIMIT :limit
        """,
        {"limit": limit},
    )

    result = []

    for r in rows:
        sent_count = int(r.get("sent_count") or 0)
        quote_received_count = int(r.get("quote_received_count") or 0)
        award_count = int(r.get("award_count") or 0)

        response_rate_pct = (
            round((quote_received_count / sent_count) * 100, 1)
            if sent_count
            else 0
        )

        award_rate_pct = (
            round((award_count / quote_received_count) * 100, 1)
            if quote_received_count
            else 0
        )

        result.append({
            "supplier_id": r["supplier_id"],
            "supplier_name": r["supplier_name"],
            "country": r.get("country"),
            "categories": r.get("categories") or [],
            "specialties": r.get("specialties") or [],
            "classification": r.get("classification"),
            "qualification_score": float(r.get("total_score") or 0),

            "rfq_count": int(r.get("rfq_count") or 0),
            "sent_count": sent_count,
            "quote_received_count": quote_received_count,
            "award_count": award_count,
            "draft_count": int(r.get("draft_count") or 0),
            "waiting_count": int(r.get("waiting_count") or 0),

            "response_rate_pct": response_rate_pct,
            "award_rate_pct": award_rate_pct,
            "avg_quoted_amount": float(r.get("avg_quoted_amount") or 0),
            "total_quoted_amount": float(r.get("total_quoted_amount") or 0),
            "avg_response_days": (
                round(float(r["avg_response_days"]), 1)
                if r.get("avg_response_days") is not None
                else None
            ),
        })

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "supplier_kpi",
        "count": len(result),
        "suppliers": result,
        "write_actions_available": False,
    }


@router.get("/list")
def list_rfqs(
    limit: int = Query(default=50, ge=1, le=500),
):
    rows = fetch_all(
        """
        SELECT
            r.rfq_id,
            r.odoo_reference,
            r.customer_name_internal,
            r.request_type,
            r.customer_type,
            r.selected_route,
            r.status,
            r.commercial_status,
            r.extracted_at,
            r.updated_at,

            COUNT(DISTINCT p.position_id)::int AS position_count,
            STRING_AGG(DISTINCT p.product_type, ', ') AS product_types,

            COUNT(DISTINCT sr.supplier_rfq_id)::int AS supplier_rfq_count,
            COUNT(DISTINCT sr.supplier_rfq_id) FILTER (
                WHERE sr.status = 'RECEIVED'
            )::int AS received_count,

            MAX(s.supplier_name) FILTER (
                WHERE sr.selected = true
            ) AS awarded_supplier,

            MAX(sr.quoted_amount) FILTER (
                WHERE sr.selected = true
            ) AS awarded_amount

        FROM rfq.request r
        LEFT JOIN rfq.position p
          ON p.rfq_id = r.rfq_id
        LEFT JOIN rfq.supplier_rfq sr
          ON sr.rfq_id = r.rfq_id
        LEFT JOIN rfq.supplier s
          ON s.supplier_id = sr.supplier_id

        GROUP BY
            r.rfq_id,
            r.odoo_reference,
            r.customer_name_internal,
            r.request_type,
            r.customer_type,
            r.selected_route,
            r.status,
            r.commercial_status,
            r.extracted_at,
            r.updated_at

        ORDER BY r.extracted_at DESC
        LIMIT :limit
        """,
        {"limit": limit},
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "rfq_list",
        "count": len(rows),
        "rfqs": rows,
        "write_actions_available": False,
    }


@router.get("/{rfq_id}/timeline")
def rfq_timeline(rfq_id: str):
    rfq = fetch_one(
        """
        SELECT *
        FROM rfq.request
        WHERE rfq_id = :rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    events = []

    events.append({
        "event_time": rfq["extracted_at"],
        "event_type": "RFQ_CREATED",
        "actor": "SYSTEM",
        "description": f"RFQ aangemaakt voor {rfq.get('customer_name_internal') or 'onbekende klant'}",
    })

    if rfq.get("status"):
        events.append({
            "event_time": rfq["updated_at"],
            "event_type": f"RFQ_STATUS_{rfq['status']}",
            "actor": "SYSTEM",
            "description": f"RFQ status is {rfq['status']}",
        })

    supplier_events = fetch_all(
        """
        SELECT
            sr.*,
            s.supplier_name
        FROM rfq.supplier_rfq sr
        JOIN rfq.supplier s
          ON s.supplier_id = sr.supplier_id
        WHERE sr.rfq_id = :rfq_id
        ORDER BY sr.extracted_at
        """,
        {"rfq_id": rfq_id},
    )

    for sr in supplier_events:
        events.append({
            "event_time": sr["extracted_at"],
            "event_type": "SUPPLIER_RFQ_CREATED",
            "actor": "SYSTEM",
            "description": f"Supplier RFQ aangemaakt voor {sr['supplier_name']}",
        })

        if sr.get("sent_at"):
            events.append({
                "event_time": sr["sent_at"],
                "event_type": "SUPPLIER_RFQ_SENT",
                "actor": sr.get("sent_by") or "UNKNOWN",
                "description": f"RFQ verzonden naar {sr['supplier_name']}",
            })

        if sr.get("quoted_amount") is not None:
            events.append({
                "event_time": sr["updated_at"],
                "event_type": "SUPPLIER_RESPONSE_RECEIVED",
                "actor": sr["supplier_name"],
                "description": f"Offerte ontvangen van {sr['supplier_name']} voor EUR {float(sr['quoted_amount'])}",
            })

        if sr.get("selected"):
            events.append({
                "event_time": sr["updated_at"],
                "event_type": "SUPPLIER_AWARDED",
                "actor": "PROMATI",
                "description": f"Award gekozen: {sr['supplier_name']}",
            })

    artifacts = fetch_all(
        """
        SELECT *
        FROM rfq.artifact
        WHERE rfq_id = :rfq_id
        ORDER BY extracted_at
        """,
        {"rfq_id": rfq_id},
    )

    for a in artifacts:
        events.append({
            "event_time": a["extracted_at"],
            "event_type": "ARTIFACT_CREATED",
            "actor": "SYSTEM",
            "description": f"Artifact gegenereerd: {a['artifact_type']}",
        })

    events = sorted(
        events,
        key=lambda x: x["event_time"] or rfq["extracted_at"],
    )

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "rfq_timeline",
        "rfq_id": rfq_id,
        "count": len(events),
        "events": events,
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/supplier-quote/import-text")
def preview_supplier_quote_import(
    rfq_id: str,
    payload: SupplierQuoteImportTextIn,
):
    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )

    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ not found")

    supplier = fetch_one(
        "SELECT * FROM rfq.supplier WHERE supplier_id = :supplier_id",
        {"supplier_id": payload.supplier_id},
    )

    if not supplier:
        raise HTTPException(status_code=404, detail="Supplier not found")

    positions = fetch_all(
        """
        SELECT *
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        ORDER BY pos_nr
        """,
        {"rfq_id": rfq_id},
    )

    text_raw = payload.quote_text or ""
    lines = [line.strip() for line in text_raw.splitlines() if line.strip()]

    preview_lines = []

    for line in lines:
        lower = line.lower()

        price_match = re.search(
            r"(?:EUR|€)\s*([0-9]+(?:[.,][0-9]{2})?)",
            line,
            re.IGNORECASE,
        )

        delivery_match = re.search(
            r"(\d+)\s*(?:weeks|week|wks|dagen|days|dgn)",
            line,
            re.IGNORECASE,
        )

        best_match = None
        best_score = 0

        for pos in positions:
            score = 0
            specs = pos.get("extracted_specs") or {}

            pos_nr = str(pos.get("pos_nr") or "").lower()
            drawing_mark = str(pos.get("drawing_mark") or "").lower()
            product_type = str(pos.get("product_type") or "").lower()

            if pos_nr and pos_nr in lower:
                score += 45

            if drawing_mark and drawing_mark.replace(".pdf", "") in lower:
                score += 45

            if product_type and product_type in lower:
                score += 10

            diameter = specs.get("diameter_de_mm") or specs.get("diameter_mm")
            width = specs.get("drum_width_mm") or specs.get("mantel_lengte_mm")

            if diameter and str(diameter) in lower:
                score += 20

            if width and str(width) in lower:
                score += 20

            if score > best_score:
                best_score = score
                best_match = pos

        preview_lines.append({
            "raw_line": line,
            "matched_position_id": best_match.get("position_id") if best_match else None,
            "matched_pos_nr": best_match.get("pos_nr") if best_match else None,
            "match_confidence": min(best_score, 100),
            "quoted_amount": (
                float(price_match.group(1).replace(".", "").replace(",", "."))
                if price_match
                else None
            ),
            "delivery_time": (
                delivery_match.group(0)
                if delivery_match
                else None
            ),
            "needs_review": best_score < 70,
        })

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "supplier": {
            "supplier_id": supplier["supplier_id"],
            "supplier_name": supplier["supplier_name"],
        },
        "quote_lines": preview_lines,
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/supplier-quote/confirm")
def confirm_supplier_quote_import(
    rfq_id: str,
    payload: SupplierQuoteConfirmIn,
):
    updated_lines = []

    for line in payload.lines:
        updated = execute_one(
            """
            UPDATE rfq.supplier_rfq
            SET
                status = 'RECEIVED',
                quoted_amount = :quoted_amount,
                delivery_time = :delivery_time,
                technical_deviations = :technical_deviations,
                commercial_deviations = :commercial_deviations,
                updated_at = now()
            WHERE rfq_id = :rfq_id
              AND supplier_id = :supplier_id
              AND position_id = :position_id
            RETURNING *
            """,
            {
                "rfq_id": rfq_id,
                "supplier_id": line.supplier_id,
                "position_id": line.position_id,
                "quoted_amount": line.quoted_amount,
                "delivery_time": line.delivery_time,
                "technical_deviations": line.technical_deviations,
                "commercial_deviations": line.commercial_deviations,
            },
        )

        if updated:
            updated_lines.append(updated)

            execute_one(
                """
                INSERT INTO rfq.decision_log (
                    rfq_id,
                    step,
                    user_override,
                    approved_by,
                    approved_at
                )
                VALUES (
                    :rfq_id,
                    'SUPPLIER_QUOTE_IMPORTED',
                    CAST(:user_override AS jsonb),
                    :approved_by,
                    now()
                )
                RETURNING decision_id
                """,
                {
                    "rfq_id": rfq_id,
                    "approved_by": "John",
                    "user_override": json_dumps({
                        "supplier_id": line.supplier_id,
                        "position_id": line.position_id,
                        "quoted_amount": line.quoted_amount,
                        "delivery_time": line.delivery_time,
                        "source": "text_import_confirm",
                    }),
                },
            )

    update_rfq_workflow_status(rfq_id)

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "updated_count": len(updated_lines),
        "updated_supplier_rfqs": updated_lines,
        "write_actions_available": True,
    }


@router.get("/{rfq_id}/positions/duplicates")
def detect_duplicate_positions(rfq_id: str):
    positions = fetch_all(
        """
        SELECT
            position_id,
            pos_nr,
            drawing_mark,
            product_type,
            extracted_specs,
            extracted_at
        FROM rfq.position
        WHERE rfq_id = :rfq_id
        ORDER BY extracted_at
        """,
        {"rfq_id": rfq_id},
    )

    groups = {}

    for p in positions:
        specs = p.get("extracted_specs") or {}

        key = (
            specs.get("source_document_id")
            or specs.get("part_number")
            or specs.get("doc_number")
            or specs.get("drawing_number")
            or p.get("drawing_mark")
            or "UNKNOWN"
        )

        groups.setdefault(str(key), []).append(p)

    duplicates = [
        {
            "duplicate_key": key,
            "count": len(items),
            "positions": items,
        }
        for key, items in groups.items()
        if len(items) > 1
    ]

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "duplicate_count": len(duplicates),
        "duplicates": duplicates,
        "write_actions_available": False,
    }


@router.get("/{rfq_id}/positions/duplicates/cleanup-preview")
def preview_duplicate_cleanup(rfq_id: str):
    duplicate_result = detect_duplicate_positions(rfq_id)

    cleanup_plan = []

    for group in duplicate_result["duplicates"]:
        positions = group["positions"]

        sorted_positions = sorted(
            positions,
            key=lambda p: p.get("extracted_at") or "",
            reverse=True,
        )

        keep = sorted_positions[0]
        remove = sorted_positions[1:]

        cleanup_plan.append({
            "duplicate_key": group["duplicate_key"],
            "keep_position_id": keep["position_id"],
            "keep_pos_nr": keep["pos_nr"],
            "remove_position_ids": [
                p["position_id"] for p in remove
            ],
            "remove_pos_nrs": [
                p["pos_nr"] for p in remove
            ],
            "reason": "Nieuwste positie behouden; oudere duplicate verwijderen.",
        })

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "cleanup_group_count": len(cleanup_plan),
        "cleanup_plan": cleanup_plan,
        "write_actions_available": False,
    }


@router.post("/{rfq_id}/positions/duplicates/cleanup-confirm")
def confirm_duplicate_cleanup(
    rfq_id: str,
    confirm: bool = Query(default=False),
):
    if not confirm:
        raise HTTPException(
            status_code=400,
            detail="Cleanup not confirmed. Add ?confirm=true",
        )

    preview = preview_duplicate_cleanup(rfq_id)
    cleanup_plan = preview.get("cleanup_plan") or []

    deleted_positions = []

    for group in cleanup_plan:
        for position_id in group.get("remove_position_ids", []):
            deleted = execute_one(
                """
                DELETE FROM rfq.position
                WHERE rfq_id = :rfq_id
                  AND position_id = :position_id
                RETURNING position_id
                """,
                {
                    "rfq_id": rfq_id,
                    "position_id": position_id,
                },
            )

            if deleted:
                deleted_positions.append(position_id)

    update_rfq_workflow_status(rfq_id)

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "deleted_count": len(deleted_positions),
        "deleted_position_ids": deleted_positions,
        "write_actions_available": True,
    }

@router.delete("/{rfq_id}/positions/{position_id}")
def delete_rfq_position(
    rfq_id: str,
