@router.post("/{rfq_id}/positions/{position_id}/generate-complete-package")
def generate_complete_package(
    rfq_id: str,
    position_id: str,
    request: Request,
):
    internal_result = generate_rfq_position_datasheet_pdf_artifact(
        rfq_id=rfq_id,
        position_id=position_id,
        commercial_approved=True,
        view_mode="internal",
    )

    supplier_result = generate_rfq_position_datasheet_pdf_artifact(
        rfq_id=rfq_id,
        position_id=position_id,
        commercial_approved=True,
        view_mode="supplier",
    )

    execute_one(
        """
        UPDATE rfq.request
        SET status = 'PACKAGE_GENERATED',
            updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING rfq_id
        """,
        {"rfq_id": rfq_id},
    )

    def with_url(artifact):
        download_path = f"/analysis/rfq/artifacts/{artifact['artifact_id']}/download"
        artifact["absolute_download_url"] = str(request.base_url).rstrip("/") + download_path
        return artifact

    return {
        "status": "ok",
        "domain": "rfq",
        "type": "complete_rfq_package",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "rfq_status": "PACKAGE_GENERATED",
        "artifacts": {
            "internal_engineering_pdf": with_url(internal_result["artifact"]),
            "supplier_package_pdf": with_url(supplier_result["artifact"]),
        },
        "message": "Complete RFQ package generated and stored.",
        "write_actions_available": True,
    }


@router.post("/{rfq_id}/assistant/approve-and-generate")
def assistant_approve_and_generate(
    rfq_id: str,
    payload: RfqAssistantApproveGenerateIn,
):
    rfq = fetch_one(
        "SELECT * FROM rfq.request WHERE rfq_id = :rfq_id",
        {"rfq_id": rfq_id},
    )
    if not rfq:
        raise HTTPException(status_code=404, detail="RFQ niet gevonden")

    execute_one(
        """
        UPDATE rfq.request
        SET
            selected_route = :selected_route,
            customer_type = :customer_type,
            status = 'INTAKE_APPROVED',
            updated_at = now()
        WHERE rfq_id = :rfq_id
        RETURNING rfq_id
        """,
        {
            "rfq_id": rfq_id,
            "selected_route": payload.selected_route,
            "customer_type": payload.customer_type,
        },
    )

    if payload.positions:
        execute_one(
            "DELETE FROM rfq.position WHERE rfq_id = :rfq_id RETURNING rfq_id",
            {"rfq_id": rfq_id},
        )

        for p in payload.positions:
            execute_one(
                """
                INSERT INTO rfq.position (
                    rfq_id,
                    pos_nr,
                    drawing_mark,
                    product_type,
                    quantity,
                    extracted_specs,
                    missing_fields,
                    confidence_score
                )
                VALUES (
                    :rfq_id,
                    :pos_nr,
                    :drawing_mark,
                    :product_type,
                    :quantity,
                    CAST(:extracted_specs AS jsonb),
                    CAST(:missing_fields AS jsonb),
                    :confidence_score
                )
                RETURNING position_id
                """,
                {
                    "rfq_id": rfq_id,
                    "pos_nr": p.pos_nr,
                    "drawing_mark": p.drawing_mark,
                    "product_type": p.product_type,
                    "quantity": p.quantity,
                    "extracted_specs": json_dumps(p.extracted_specs),
                    "missing_fields": json_dumps(p.missing_fields),
                    "confidence_score": p.confidence_score,
                },
            )

    canonical_result = build_canonical_model(rfq_id)
    canonical_id = canonical_result["canonical_model"]["canonical_id"]

    approve_latest_canonical_model(
        rfq_id,
        CanonicalApproveIn(approved_by=payload.approved_by),
    )

    generated = []
    for language in payload.generate_languages:
        if language not in RFQ_LANGUAGES:
            continue

        result = generate_rfq_pdf_from_canonical(
            rfq_id=rfq_id,
            approved_by=payload.approved_by,
            require_approved=True,
            language=language,
        )
        generated.append({
            "language": language,
            "pdf_id": result["pdf"]["pdf_id"],
            "download_url": f"/analysis/rfq/{rfq_id}/pdf/latest?language={language}",
        })

    execute_one(
        """
        INSERT INTO rfq.decision_log (
            rfq_id,
            step,
            final_decision,
            approved_by,
            approved_at
        )
        VALUES (
            :rfq_id,
            'ASSISTANT_APPROVE_AND_GENERATE',
            CAST(:final_decision AS jsonb),
            :approved_by,
            now()
        )
        RETURNING decision_id
        """,
        {
            "rfq_id": rfq_id,
            "approved_by": payload.approved_by,
            "final_decision": json_dumps({
                "selected_route": payload.selected_route,
                "customer_type": payload.customer_type,
                "canonical_id": canonical_id,
                "generated": generated,
            }),
        },
    )

    return {
        "intent": "rfq_assistant_approve_and_generate",
        "message": "RFQ goedgekeurd, canonical model vastgelegd en PDF’s gegenereerd.",
        "rfq_id": rfq_id,
        "canonical_id": canonical_id,
        "generated": generated,
    }


@router.get("/{rfq_id}/supplier-rfqs")
def get_supplier_rfqs(rfq_id: str):
    rows = fetch_all(
        """
        SELECT
            sr.*,
            s.supplier_name,
            q.classification,
            p.pos_nr,
            p.product_type,
            p.drawing_mark
        FROM rfq.supplier_rfq sr
        LEFT JOIN rfq.supplier s
            ON s.supplier_id = sr.supplier_id
        LEFT JOIN rfq.supplier_qualification q
            ON q.supplier_id = sr.supplier_id
        LEFT JOIN rfq.position p
            ON p.position_id = sr.position_id
        WHERE sr.rfq_id = :rfq_id
        ORDER BY p.pos_nr, s.supplier_name
        """,
        {"rfq_id": rfq_id},
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "supplier_rfqs": rows,
    }


@router.get("/{rfq_id}/positions/{position_id}/documents/status")
def get_position_documents_status(
    rfq_id: str,
    position_id: str,
):
    documents = fetch_all(
        """
        SELECT *
        FROM rfq.position_document
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        ORDER BY extracted_at DESC
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    latest_text = fetch_one(
        """
        SELECT *
        FROM rfq.position_document_text
        WHERE rfq_id = :rfq_id
          AND position_id = :position_id
        ORDER BY extracted_at DESC
        LIMIT 1
        """,
        {
            "rfq_id": rfq_id,
            "position_id": position_id,
        },
    )

    return {
        "status": "ok",
        "rfq_id": rfq_id,
        "position_id": position_id,
        "document_count": len(documents),
        "latest_document": documents[0] if documents else None,
        "latest_text": latest_text,
        "has_documents": len(documents) > 0,
        "has_extracted_text": latest_text is not None,
        "write_actions_available": False,
    }


