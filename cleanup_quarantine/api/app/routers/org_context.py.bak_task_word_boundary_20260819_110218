@router.get("/function-info")
def function_info(
    q: str,
    person_name: str | None = None,
    functie_code: str | None = None,
):
    detected = detect_person_or_function_from_question(q)

    person_name = normalize(person_name) or detected.get("person_name")
    functie_code = normalize(functie_code) or detected.get("functie_code")

    if not person_name and not functie_code:
        return {
            "status": "not_found",
            "query": q,
            "person_name": None,
            "functie_code": None,
            "message": "Geen persoon of functie herkend in deze vraag.",
            "results": [],
            "write_actions_available": False,
        }

    params = {
        "person_name": person_name,
        "functie_code": functie_code,
    }

    sql = """
        SELECT
            p.person_id,
            p.weergavenaam,
            p.email,
            p.telefoon,
            p.mobiel,
            p.firma_naam,
            p.locatie,
            p.afdeling,
            p.officiele_functienaam,

            pf.persoon_functie_id,
            pf.primair,
            pf.geldig_vanaf,
            pf.geldig_tot,
            pf.opmerkingen AS koppeling_opmerkingen,

            f.functie_code,
            f.functie_naam,
            f.categorie,
            f.entiteit,
            f.rapporteert_aan,
            f.reikwijdte,
            f.kernfocus,
            f.doel,
            f.resultaatgebieden,
            f.kerntaken,
            f.bevoegdheden,
            f.kpis,
            f.veiligheid_vca,
            f.documentverantwoordelijkheden,
            f.bron_doc_id

        FROM org_persoon_functies pf

        JOIN org_personen p
            ON p.person_id = pf.person_id
           AND p.actief = TRUE

        JOIN org_functies f
            ON f.functie_code = pf.functie_code
           AND f.actief = TRUE

        WHERE pf.geldig_tot IS NULL
    """

    if person_name:
        sql += """
          AND (
                LOWER(p.weergavenaam) = LOWER(:person_name)
             OR LOWER(CONCAT_WS(' ', p.voornaam, p.achternaam)) = LOWER(:person_name)
             OR LOWER(p.weergavenaam) LIKE LOWER('%' || :person_name || '%')
          )
        """

    if functie_code:
        sql += """
          AND f.functie_code = :functie_code
        """

    sql += """
        ORDER BY
            p.weergavenaam,
            pf.primair DESC,
            f.functie_naam
        LIMIT 20
    """

    rows = fetch_all(sql, params)

    if not rows:
        return {
            "status": "not_found",
            "query": q,
            "person_name": person_name,
            "functie_code": functie_code,
            "message": "Geen actieve functieomschrijving gevonden voor deze vraag.",
            "write_actions_available": False,
        }

    return {
        "status": "ok",
        "query": q,
        "person_name": person_name,
        "functie_code": functie_code,
        "results": rows,
        "write_actions_available": False,
    }


@router.get("/location-info")
def location_info(
    firma: str | None = Query(default=None),
    locatie: str | None = Query(default=None),
    q: str | None = Query(default=None),
):
    q_norm = (q or "").lower()

    firma_norm = normalize(firma)
    locatie_norm = normalize(locatie)

    if not firma_norm or not locatie_norm:
        detected_scope = detect_scope_from_question(q or "")

        if not firma_norm:
            firma_norm = detected_scope.get("firma") or "Promati"

        if not locatie_norm:
            locatie_norm = detected_scope.get("locatie")

    sql = """
        SELECT
            firma_naam,
            locatie,
            telefoon,
            email,
            kvk_nummer,
            btw_nummer,
            ondernemingsnummer,
            straat,
            huisnummer,
            postcode,
            plaats,
            land,
            adres,
            openingstijden,
            noodnummer,
            alarm_instructie,
            opmerkingen
        FROM org_locaties
        WHERE actief = TRUE
          AND LOWER(firma_naam) = LOWER(:firma_naam)
    """

    params = {
        "firma_naam": firma_norm,
    }

    if locatie_norm:
        sql += """
          AND LOWER(locatie) = LOWER(:locatie)
        """
        params["locatie"] = locatie_norm

    sql += """
        ORDER BY locatie
        LIMIT 10
    """

    rows = fetch_all(sql, params)

    if not rows:
        return {
            "status": "not_found",
            "query": q,
            "firma": firma_norm,
            "locatie": locatie_norm,
            "message": "Geen actieve locatiegegevens gevonden.",
            "write_actions_available": False,
        }

    return {
        "status": "ok",
        "query": q,
        "firma": firma_norm,
        "locatie": locatie_norm,
        "results": rows,
        "write_actions_available": False,
    }