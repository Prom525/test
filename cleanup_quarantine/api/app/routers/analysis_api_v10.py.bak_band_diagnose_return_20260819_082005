            first_canonical_inspection_key,
            last_canonical_inspection_key,
            source_file,
            sheet_raw
        FROM vw_mes_cycle_analysis_clean
        WHERE {where_sql}
        ORDER BY
            CASE status_3mm
                WHEN 'NU VERVANGEN' THEN 1
                WHEN 'BINNEN 30 DAGEN' THEN 2
                WHEN 'BINNEN 60 DAGEN' THEN 3
                ELSE 4
            END,
