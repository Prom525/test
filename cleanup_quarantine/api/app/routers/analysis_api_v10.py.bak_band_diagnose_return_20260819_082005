    rows = [enrich_performance_6mm(row) for row in rows]

    urgent_3mm = [
        r for r in rows
        if r.get("status_3mm") in ("NU VERVANGEN", "BINNEN 30 DAGEN")
    ]

    risk_6mm = [
        r for r in rows
        if r.get("vervuilingsrisico")
    ]

    action = []

    if urgent_3mm:
