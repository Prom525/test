def _detect_belt_width_mm(vraag: str, explicit_width: int | None = None) -> int | None:
    if explicit_width:
        return explicit_width

    import re

    q = vraag or ""

    patterns = [
        r"\bbandbreedte\s*(?:van)?\s*(\d{3,4})\b",
        r"\bBB\s*(\d{3,4})\b",
        r"\bB\s*=\s*(\d{3,4})\b",
        r"\b(\d{3,4})\s*mm\s*(?:band|bandbreedte)\b",
        r"\bvoor\s*(\d{3,4})\b",
    ]

    for pattern in patterns:
        match = re.search(pattern, q, re.IGNORECASE)
        if match:
            width = int(match.group(1))
            if 300 <= width <= 3000:
                return width

    return None

def _detect_product_mode(
    vraag: str,
    explicit_mode: str | None = None,
    belt_width_mm: int | None = None,
) -> str:
    if explicit_mode and explicit_mode != "auto":
        return explicit_mode

    q = (vraag or "").lower()

    if belt_width_mm:
        return "article_specific"

    if any(term in q for term in ["artikel", "artikelen", "prijs", "voorraad", "bandbreedte", "welke uitvoering"]):
        return "article_specific"

    if any(term in q for term in ["kies", "kiezen", "verschil", "vergelijk", "welke schraper", "selectie"]):
        return "selection"

    return "family_general"

