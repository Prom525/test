@router.post("/org/assistant/ask")
def org_assistant_ask(payload: OrgAskRequest) -> dict[str, Any]:
    mode = _detect_org_mode(payload.vraag, payload.mode)

    common_params = {
        "q": payload.vraag,
        "firma": payload.firma,
        "locatie": payload.locatie,
        "afdeling": payload.afdeling,
    }

    # Lege waarden niet meesturen
    common_params = {
        key: value
        for key, value in common_params.items()
        if value not in (None, "")
    }

    if mode == "location_info":
        result = _get_internal(
            "/analysis/context/org/location-info",
            params={
                key: value
                for key, value in {
                    "firma": payload.firma,
                    "locatie": payload.locatie,
                    "q": payload.vraag,
                }.items()
                if value not in (None, "")
            },
        )

    elif mode == "function_info":
        # Werkt zodra je backend deze route heeft.
        # Als die route nog ontbreekt, krijg je nette error i.p.v. 404-crash.
        result = _get_internal(
            "/analysis/context/org/function-info",
            params=common_params,
        )

    else:
        # internal_help en procedure starten altijd met internal-help
        result = _get_internal(
            "/analysis/context/org/internal-help",
            params=common_params,
        )

        rag_result = None
        rag_document_code = result.get("rag_document_code")

        if (
            result.get("status") == "ok"
            and rag_document_code
            and _wants_procedure_context(payload.vraag, mode)
        ):
            rag_result = _post_internal(
                "/rag/query",
                json_body={
                    "vraag": payload.vraag,
                    "top_k": 5,
                    "doc_id": rag_document_code,
                },
            )

    response = {
        "status": result.get("status", "ok"),
        "context_type": "org_assistant",
        "mode": mode,
        "vraag": payload.vraag,
        "source_route": (
            "/analysis/context/org/location-info"
            if mode == "location_info"
            else "/analysis/context/org/function-info"
            if mode == "function_info"
            else "/analysis/context/org/internal-help"
        ),
        "result": result,
        "write_actions_available": False,
    }

    if "rag_result" in locals() and rag_result is not None:
        response["rag_source_route"] = "/rag/query"
        response["rag_document_code"] = rag_document_code
        response["rag_result"] = rag_result

    return response


