@router.post("/product/assistant/ask")
def product_assistant_ask(payload: ProductAskRequest) -> dict[str, Any]:
    """
    GPT-facing productrouter.

    Regel:
    - Geen bandbreedte bekend: alleen productfamilie/context/RAG, geen artikellijst.
    - Wel bandbreedte bekend: productfamilie + concrete artikel/configuratie uit artikelstam.
    """
    q = payload.q or payload.vraag

    family_code = _detect_product_family_code(
        vraag=q,
        explicit_family_code=payload.family_code,
    )

    belt_width_mm = _detect_belt_width_mm(
        vraag=q,
        explicit_width=payload.belt_width_mm,
    )

    mode = _detect_product_mode(
        vraag=q,
        explicit_mode=payload.mode,
        belt_width_mm=belt_width_mm,
    )

    family_params = {
        key: value
        for key, value in {
            "family_name": payload.family_name,
            "family_code": family_code,
            "q": q,
            "limit": payload.limit,
        }.items()
        if value not in (None, "")
    }

    family_context = _get_internal(
        "/products/family-context",
        params=family_params,
    )

    family_context = _sanitize_product_family_context(
        family_context=family_context,
        vraag=q,
        family_code=family_code,
        family_name=payload.family_name,
    )

    rag_context = None

    family_document_scope = _get_product_family_document_scope(
        family_code=family_code,
    )

    linked_doc_ids = []

    if isinstance(family_document_scope, dict):
        linked_doc_ids = family_document_scope.get("doc_ids") or []

    rag_context = None

    if _should_use_product_rag(
        mode=mode,
        family_context=family_context,
        vraag=q,
        linked_doc_ids=linked_doc_ids,
    ):
        rag_context = _fetch_product_rag_context(
            vraag=q,
            family_code=family_code,
            family_name=payload.family_name,
            limit=payload.limit,
            doc_ids=linked_doc_ids,
        )

    article_policy = {
        "articles_included": False,
        "reason": "Geen bandbreedte opgegeven; artikelstam niet getoond om te brede resultaten te vermijden.",
        "prefer_complete_system": True,
    }

    config_summary = None
    config_options = None
    choice_options = None
    article_search_v2 = None

    if mode == "article_specific" and belt_width_mm:
        article_policy = {
            "articles_included": True,
            "reason": "Bandbreedte bekend; concrete artikelen/configuratie opgehaald uit artikelstam.",
            "prefer_complete_system": True,
        }

        article_search_v2 = _get_internal(
            "/products/search-v2",
            params={
                "q": q,
                "limit": payload.limit,
            },
        )

        config_params = {
            key: value
            for key, value in {
                "family_name": payload.family_name,
                "family_code": family_code,
                "belt_width_mm": belt_width_mm,
                "component_group": payload.component_group,
                "limit": payload.limit,
            }.items()
            if value not in (None, "")
        }

        choice_params = {
            key: value
            for key, value in {
                "family_name": payload.family_name,
                "family_code": family_code,
                "belt_width_mm": belt_width_mm,
                "choice_type": payload.choice_type,
                "component_group": payload.component_group,
                "limit": payload.limit,
            }.items()
            if value not in (None, "")
        }

        config_summary = _get_internal(
            "/products/belt-cleaners/config/summary",
            params={
                key: value
                for key, value in {
                    "family_name": payload.family_name,
                    "family_code": family_code,
                    "belt_width_mm": belt_width_mm,
                }.items()
                if value not in (None, "")
            },
        )

        config_options = _get_internal(
            "/products/belt-cleaners/config/options",
            params=config_params,
        )

        choice_options = _get_internal(
            "/products/belt-cleaners/config/choice",
            params=choice_params,
        )

    elif family_code:
        # Conservatieve option-specific artikelzoeking zonder
        # expliciete bandbreedte.
        #
        # Dit opent de configurator NIET.
        # Alleen vooraf gevalideerde structured intents mogen
        # een kleine artikellijst exposen.

        option_probe = _get_internal(
            "/products/search-v2",
            params={
                "q": q,
                # Minstens 11 nodig om betrouwbaar te kunnen
                # weigeren wanneer er >10 matches zijn.
                "limit": max(payload.limit, 11),
            },
        )

        allowed_option_requirements = {
            ("material", "RVS 304"),
            ("material", "RVS 316"),
            ("temperature_grade", "HT"),
            ("compliance_grade", "food_grade"),
            ("service_life_grade", "long_life"),
            ("execution", "compact"),
        }

        requirements = (
            option_probe.get("requirements") or []
            if isinstance(option_probe, dict)
            else []
        )

        residual_terms = (
            option_probe.get("residual_terms") or []
            if isinstance(option_probe, dict)
            else []
        )

        try:
            probe_count = int(option_probe.get("count") or 0)
        except (TypeError, ValueError):
            probe_count = 0

        requirements_are_safe = (
            bool(requirements)
            and all(
                (
                    requirement.get("type"),
                    requirement.get("value"),
                )
                in allowed_option_requirements
                for requirement in requirements
                if isinstance(requirement, dict)
            )
            and all(
                isinstance(requirement, dict)
                for requirement in requirements
            )
        )

        option_specific_allowed = (
            isinstance(option_probe, dict)
            and option_probe.get("status") == "ok"
            and option_probe.get("hard_width") is None
            and not residual_terms
            and requirements_are_safe
            and probe_count <= 10
        )

        if option_specific_allowed:
            article_search_v2 = dict(option_probe)

            results = list(
                article_search_v2.get("results") or []
            )[: payload.limit]

            article_search_v2["results"] = results
            article_search_v2["count"] = len(results)
            article_search_v2["policy_match_count"] = probe_count
            article_search_v2["policy_mode"] = "option_specific"

            has_matching_articles = probe_count > 0

            article_policy = {
                "articles_included": has_matching_articles,
                "reason": (
                    (
                        "Veilige option-specific V2-zoeking: "
                        "gestructureerde optie herkend, geen vrije "
                        "resttermen en maximaal 10 matches."
                    )
                    if has_matching_articles
                    else (
                        "Veilige option-specific V2-zoeking uitgevoerd; "
                        "geen passende artikelen gevonden."
                    )
                ),
                "prefer_complete_system": True,
                "policy_mode": "option_specific",
            }

    return {
        "status": "ok",
        "context_type": "product_assistant",
        "vraag": payload.vraag,
        "query": q,
        "mode": mode,
        "detected_family_code": family_code,
        "detected_belt_width_mm": belt_width_mm,
        "family_context": family_context,
        "family_document_scope": family_document_scope,
        "rag_context": rag_context,
        "article_policy": article_policy,
        "article_search_v2": article_search_v2,
        "config_summary": config_summary,
        "config_options": config_options,
        "choice_options": choice_options,
        "write_actions_available": False,
    }


