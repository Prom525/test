@router.post("/technical/assistant/ask")
def technical_assistant_ask(payload: TechnicalAskRequest) -> dict[str, Any]:
    """
    Hybride technische ingang.
    Voor formulevragen item_type='formula' gebruiken.

    Verbetering:
    - Detecteert formulevragen automatisch.
    - Verbreedt brede formulevragen naar betere zoektermen.
    - Verbreedt CEMA/idler/trogrolvragen naar NL + EN termen.
    - Probeert CEMA eerst met source_code, daarna fallback zonder source_code.
    """
    q = payload.q or payload.vraag
    q_lower = q.lower()

    product_terms = [
        "belle banne",
        "bb-u",
        "bb-r",
        "bb-p",
        "bb-h",
        "proload",
        "flexal",
        "duo-seal",
        "duo seal",
        "tri-seal",
        "tri seal",
        "multi-seal",
        "multi seal",
        "impact bar",
        "impact bars",
        "sitec",
        "barrier",
        "rollax",
        "promati kf",
        "promati ks",
    ]

    if any(term in q_lower for term in product_terms):
        return {
            "status": "redirect",
            "context_type": "routing_guard",
            "vraag": payload.vraag,
            "query": q,
            "message": "Dit is een Promati-productvraag. Gebruik product_assistant_ask in plaats van technical_assistant_ask.",
            "recommended_action": "product_assistant_ask",
            "write_actions_available": False,
        }

    technical_q = q
    item_type = payload.item_type
    source_code = payload.source_code

    # Formulevragen automatisch als formula behandelen.
    if item_type is None and any(
        term in q_lower
        for term in ["formule", "formules", "berekening", "berekeningen", "bereken"]
    ):
        item_type = "formula"

    # Brede formulevragen beter vindbaar maken.
    if item_type == "formula" and any(
        term in q_lower
        for term in [
            "welke formules",
            "formules heb je",
            "transportbandberekeningen",
            "transportband berekeningen",
            "berekeningen voor transportband",
        ]
    ):
        technical_q = (
            "transportband formule bandsterkte bandsnelheid capaciteit "
            "aandrijfvermogen koppel trommel toerental"
        )

    if item_type == "formula" and any(
        term in q_lower
        for term in ["bandsnelheid", "band snelheid", "snelheid van de band"]
    ):
        technical_q = "bandsnelheid formule v pi d n trommeldiameter toerental"

    if item_type == "formula" and any(
        term in q_lower
        for term in ["bandsterkte", "benodigde bandsterkte", "kn", "tmax"]
    ):
        technical_q = "bandsterkte formule kn tmax veiligheidsfactor lasfactor bandbreedte"

    if item_type == "formula" and any(
        term in q_lower
        for term in ["capaciteit", "capaciteitsberekening", "transportcapaciteit"]
    ):
        technical_q = "capaciteit transportband formule q doorsnede snelheid stortgewicht"

    # CEMA / idler / trogrollen beter vindbaar maken.
    cema_query = "cema" in q_lower
    idler_query = any(
        term in q_lower
        for term in [
            "trogrol",
            "trogrollen",
            "trogrollenstel",
            "trogstel",
            "trogstellen",
            "idler",
            "idlers",
            "troughing idler",
            "troughing idlers",
            "carrying idler",
            "carrying idlers",
            "return idler",
            "return idlers",
        ]
    )

    if cema_query and source_code is None:
        source_code = "CEMA"

    if cema_query and idler_query:
        technical_q = (
            "CEMA trogrollen troughing idlers carrying idlers return idlers "
            "idler class idler classes troghoek 20 35 45 belt width spacing load rating"
        )

    result = get_technical_context(
        q=technical_q,
        topic_group=payload.topic_group,
        source_code=source_code,
        item_type=item_type,
        limit=payload.limit,
    )

    # Fallback: als source_code exact filtert op CEMA maar niets vindt,
    # probeer dezelfde query nog eens zonder source_code.
    result_count = 0
    if isinstance(result, dict):
        result_count = int(result.get("count") or 0)

    fallback_used = False

    if result_count == 0 and source_code:
        fallback_result = get_technical_context(
            q=technical_q,
            topic_group=payload.topic_group,
            source_code=None,
            item_type=item_type,
            limit=payload.limit,
        )

        fallback_count = 0
        if isinstance(fallback_result, dict):
            fallback_count = int(fallback_result.get("count") or 0)

        if fallback_count > 0:
            result = fallback_result
            fallback_used = True

    return {
        "status": "ok",
        "context_type": "technical_assistant",
        "vraag": payload.vraag,
        "query": q,
        "effective_query": technical_q,
        "item_type": item_type,
        "source_code": source_code,
        "topic_group": payload.topic_group,
        "fallback_without_source_code_used": fallback_used,
        "technical_context": result,
        "write_actions_available": False,
    }

