def _should_use_product_rag(
    mode: str,
    family_context: dict[str, Any] | None,
    vraag: str,
    linked_doc_ids: list[str] | None = None,
) -> bool:
    """
    Bronprioriteit:

    1. Structured SQL family_context blijft leidend.
    2. Als gevalideerde family-linked documenten bestaan,
       mag RAG aanvullend worden gebruikt.
    3. Zonder linked documenten blijft breed RAG alleen fallback
       wanneer structured family_context niets oplevert.

    RAG vervangt of overschrijft structured SQL dus niet.
    """

    linked_doc_ids = linked_doc_ids or []

    # Betrouwbare family-linked documenten mogen altijd
    # als aanvullende productbron worden gebruikt.
    if linked_doc_ids:
        return True

    count = 0

    if isinstance(family_context, dict):
        count = int(family_context.get("count") or 0)

    # Structured context gevonden en geen specifieke documenten:
    # breed RAG niet toevoegen.
    if count > 0:
        return False

    # Geen structured context en geen linked documenten:
    # bestaand breed product-RAG als fallback.
    return True


def _fetch_product_rag_context(
    vraag: str,
    family_code: str | None = None,
    family_name: str | None = None,
    limit: int = 5,
    doc_ids: list[str] | None = None,
) -> dict[str, Any]:
    """
    Haalt aanvullende productkennis uit RAG.

    Prioriteit:
    - family-linked doc_ids indien beschikbaar;
    - anders bestaande brede product-RAG fallback.

    SQL/artikelstam blijft leidend voor gestructureerde
    producteigenschappen, artikelen, prijzen en voorraad.
    """

    rag_query = " ".join(
        [
            vraag or "",
            family_name or "",
            family_code or "",
            "Promati productkennis voordelen toepassingen brochure",
        ]
    ).strip()

    linked_doc_ids = [
        str(doc_id).strip()
        for doc_id in (doc_ids or [])
        if str(doc_id).strip()
    ]

    rag_body = {
        "vraag": rag_query,
        "top_k": min(max(limit, 3), 8),
        "answer_mode": "extractive",
        "rerank_candidates": 50,
    }

    # Eerste keuze: uitsluitend gevalideerde documenten
    # van de gedetecteerde productfamilie.
    if linked_doc_ids:
        rag_body["doc_ids"] = linked_doc_ids
    else:
        # Bestaande brede fallback behouden.
        rag_body["doc_id_contains"] = "product_"

    try:
        result = _post_internal(
            "/rag/query",
            json_body=rag_body,
        )

        if not isinstance(result, dict):
            return result

        result = dict(result)

        if linked_doc_ids:
            result["scope_mode"] = "family_linked_documents"
            result["scope_doc_ids"] = linked_doc_ids
        else:
            result["scope_mode"] = "broad_product_fallback"
            result["scope_doc_ids"] = []

        return result
        

    except Exception as exc:
        return {
            "status": "error",
            "message": "RAG-context kon niet worden opgehaald.",
            "error": str(exc),
            "context_hits": [],
            "used_context": [],
            "scope_doc_ids": linked_doc_ids,
        }

def _sanitize_product_family_context(
    family_context: dict[str, Any] | None,
    vraag: str,
    family_code: str | None = None,
    family_name: str | None = None,
) -> dict[str, Any] | None:
    """
    Voorkomt dat algemene productvragen zoals Proload/Flexal
    terugvallen op irrelevante bandschraperfamilies.
    """
    if not isinstance(family_context, dict):
        return family_context

    results = family_context.get("results") or []
    if not isinstance(results, list) or not results:
        return family_context

    q = (vraag or "").lower()
    requested_terms = set()

    product_terms = [
        # Stof / laadzone / impact
        "proload",
        "flexal",
        "impact bar",
        "impact bars",
        "impactzone",
        "impact zone",
        "blu-tec",
        "blutec",

        # Afdichtingen
        "afdichting",
        "afdichtingen",
        "duo-seal",
        "duo seal",
        "tri-seal",
        "tri seal",
        "multi-seal",
        "multi seal",
        "snel klemsysteem",
        "klemsysteem",

        # Bandbeveiliging
        "sitec",
        "trekkoord",
        "trekkoordschakelaar",
        "scheefloop",
        "scheefloopschakelaar",
        "eindloop",
        "eindloopschakelaar",
        "werkschakelaar",
        "bandbeveiliging",

        # Rollen / stuurrollen / trommels
        "gurtec",
        "rol",
        "rollen",
        "trogstel",
        "trogstellen",
        "hdpe rol",
        "hdpe rollen",
        "cerapro",
        "rollax",
        "stuurrol",
        "stuurrollen",
        "trommel",
        "trommels",
        "aandrijftrommel",
        "keertrommel",
        "spantrommel",
        "insnoertrommel",
        "kooitrommel",

        # Slijtvast / detectie / overkapping
        "slijtvast",
        "slijtagebescherming",
        "keramiek",
        "aluminiumoxide",
        "belle liner",
        "sancic",
        "barrier",
        "metaaldetector",
        "metaaldetectoren",
        "overkapping",
        "overkappingen",

        # Schrapers
        "belle banne",
        "belle",
        "banne",
        "schraper",
        "schrapers",
        "bandschraper",
        "bandschrapers",
        "cleanscrape",
        "tpl",
        "tph",
        "kf",
        "ks",
        "bb-u",
        "bb-r",
        "bb-p",
        "bb-h",
        "prom-kf",
        "prom-ks",
        "prom-tph-hd",
        "prom-tph-nd",
    ]

    for term in product_terms:
        if term in q:
            requested_terms.add(term)
    if family_code:
        requested_terms.add(family_code.lower())

    if family_name and not family_code:
        requested_terms.add(family_name.lower())

    # Als er geen duidelijke productterm is, laat context ongemoeid.
    if not requested_terms:
        return family_context

    scraper_terms = {
        "belle banne",
        "belle",
        "banne",
        "schraper",
        "schrapers",
        "bandschraper",
        "bandschrapers",
        "cleanscrape",
        "tpl",
        "tph",
        "kf",
        "ks",
        "bb-u",
        "bb-r",
        "bb-p",
        "bb-h",
        "prom-kf",
        "prom-ks",
        "prom-tph-hd",
        "prom-tph-nd",
    }

    non_scraper_terms = requested_terms - scraper_terms

    # Als de vraag duidelijk over niet-schraperproducten gaat,
    # mogen SQL-bandschraperfamilies niet als fallback terugkomen.
    block_scraper_fallback = bool(non_scraper_terms)

    filtered = []
    for row in results:
        haystack = " ".join(
            str(row.get(k) or "")
            for k in [
                "family_name",
                "family_code",
                "brand",
                "main_category",
                "product_type",
                "short_description",
                "application_profile",
            ]
        ).lower()

        is_scraper_row = (
            "bandschraper" in haystack
            or "schraper" in haystack
            or "belle banne" in haystack
            or "promati tph" in haystack
            or "promati kf" in haystack
            or "promati ks" in haystack
        )

        if block_scraper_fallback and is_scraper_row:
            continue

        if any(term in haystack for term in requested_terms):
            filtered.append(row)

    cleaned = dict(family_context)
    cleaned["results"] = filtered
    cleaned["count"] = len(filtered)
    cleaned["sanitized"] = True

    if block_scraper_fallback:
        cleaned["selection_matrix_included"] = False
        cleaned["selection_matrix"] = []

    if not filtered:
        cleaned["note"] = "SQL productfamiliecontext leeg na relevantiefilter; gebruik RAG of artikelstam als aanvullende bron."

    return cleaned

def _post_internal(path: str, json_body: dict[str, Any] | None = None) -> dict[str, Any]:
    url = f"{_api_base_url()}{path}"

    try:
        response = requests.post(url, json=json_body or {}, timeout=30)
        response.raise_for_status()
        return response.json()
    except Exception as exc:
        return {
            "status": "error",
            "context_type": "internal_http_call",
            "path": path,
            "json_body": json_body or {},
            "error": str(exc),
            "write_actions_available": False,
        }


def _wants_procedure_context(vraag: str, mode: str | None = None) -> bool:
    q = (vraag or "").lower()

    if mode in {"procedure", "rag", "policy"}:
        return True

    terms = [
        "procedure",
        "werkwijze",
        "stappenplan",
        "uitleg",
        "achtergrond",
        "beleid",
        "policy",
        "regels",
        "hoe moet",
        "wat moet ik doen",
        "wat zijn de stappen",
    ]

    return any(term in q for term in terms)

def _detect_rfq_mode(vraag: str, explicit_mode: str | None = None) -> str:
    q = (vraag or "").lower()

    if explicit_mode and explicit_mode != "auto":
        return explicit_mode

    if any(term in q for term in ["vergelijkbaar", "similar", "eerder", "historie"]):
        return "similar"

    if any(term in q for term in ["supplier package", "leverancierspakket", "pakket"]):
        return "supplier_package"

    if any(term in q for term in ["leverancier", "supplier", "advies", "aanbeveling"]):
        return "supplier_recommendation"

    if any(term in q for term in ["risico", "risk"]):
        return "risk_review"

    if any(term in q for term in ["ready", "readiness", "vrijgeven", "klaar"]):
        return "readiness"

    if any(term in q for term in ["actieplan", "volgende stap", "wat moet er gebeuren"]):
        return "action_plan"

    if any(term in q for term in ["status"]):
        return "status"

    if any(term in q for term in [
        "lijst",
        "list",
        "alle rfq",
        "alle rfq's",
        "rfq overzicht",
        "rfq-overzicht",
        "overzicht van alle rfq",
    ]):
        return "list"

    if any(term in q for term in ["dashboard", "overzicht"]):
        return "dashboard"

    if any(term in q for term in ["engineering", "technische review", "review"]):
        return "engineering_review"

    if any(term in q for term in ["timeline", "tijdlijn", "historiek"]):
        return "timeline"

    return "search"


