@router.post("/diagnostics/assistant/ask")
def diagnostics_assistant_ask(payload: DiagnosticsAskRequest) -> dict[str, Any]:
    """
    GPT-facing diagnostics router.

    Stuurt door naar de centrale /diagnostics/analyze route, zodat alle
    diagnostics_api modes beschikbaar zijn:
    - overview
    - database_object
    - view_definition
    - view_dependencies
    - view_health
    - inspection_pipeline
    - inspection_lineage
    - asset_model_health
    """
    filters = dict(payload.filters or {})
    limit = payload.limit

    explicit_filters = {
        "inspection_key": payload.inspection_key,
        "lijn_code": payload.lijn_code,
        "band_code": payload.band_code,
        "source_file_contains": payload.source_file_contains,
        "sheet": payload.sheet,
        "diagnosis_code": payload.diagnosis_code,
    }

    for key, value in explicit_filters.items():
        if value not in (None, ""):
            filters[key] = value

    if payload.mode == "view_health" and payload.depth == "deep":
        filters.setdefault("response_profile", "gpt_compact")
        filters.setdefault("schema", "public")

        if payload.objects:
            filters.setdefault("view_name", payload.objects[0])

        limit = min(limit or 25, 25)

    json_body = {
        "domain": payload.domain,
        "topic": payload.vraag,
        "mode": payload.mode,
        "question": payload.vraag,
        "depth": payload.depth,
        "objects": payload.objects,
        "filters": filters,
        "limit": limit,
    }

    return _post_internal(
        "/diagnostics/analyze",
        json_body=json_body,
    )

