def _api_base_url() -> str:
    return os.getenv("PROMATI_API_BASE_URL", "http://127.0.0.1:8000").rstrip("/")


def _get_internal(path: str, params: dict[str, Any] | None = None) -> dict[str, Any]:
    url = f"{_api_base_url()}{path}"

    try:
        response = requests.get(url, params=params or {}, timeout=20)
        response.raise_for_status()
        return response.json()
    except Exception as exc:
        return {
            "status": "error",
            "context_type": "internal_http_call",
            "path": path,
            "params": params or {},
            "error": str(exc),
            "write_actions_available": False,
        }

def _get_product_family_document_scope(
    family_code: str | None,
) -> dict[str, Any]:
    """
    Geeft de gevalideerde, doorzoekbare productdocumenten terug
    die via product_family_knowledge_link aan een concrete family_code hangen.

    Read-only.
    """

    if not family_code:
        return {
            "status": "ok",
            "family_code": None,
            "count": 0,
            "doc_ids": [],
            "documents": [],
        }

    try:
        with engine.connect() as conn:
            rows = conn.execute(
                sql_text("""
                    SELECT DISTINCT
                        doc_id,
                        title,
                        filename,
                        document_source_role,
                        chunk_count
                    FROM vw_gpt_product_family_documents
                    WHERE family_code = :family_code
                      AND searchable = TRUE
                    ORDER BY
                        document_source_role,
                        title,
                        doc_id
                """),
                {"family_code": family_code},
            ).mappings().all()

        documents = [
            {
                "doc_id": str(row["doc_id"]),
                "title": row["title"],
                "filename": row["filename"],
                "document_source_role": row["document_source_role"],
                "chunk_count": int(row["chunk_count"] or 0),
            }
            for row in rows
        ]

        return {
            "status": "ok",
            "family_code": family_code,
            "count": len(documents),
            "doc_ids": [
                document["doc_id"]
                for document in documents
            ],
            "documents": documents,
        }

    except Exception as exc:
        return {
            "status": "error",
            "family_code": family_code,
            "count": 0,
            "doc_ids": [],
            "documents": [],
            "error": str(exc),
        }

