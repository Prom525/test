    Write-Host ""
    Write-Host "=== VALIDATION ISSUES ===" `
        -ForegroundColor Yellow

    $ValidationErrors |
        Select-Object -First 50 |
        ForEach-Object {
            Write-Host "  $_"
        }

    Write-Host ""
    Write-Host "PHASE_A_TEST_CONTRACT_V2_REVIEW_REQUIRED" `
        -ForegroundColor Yellow
}
else {

    Write-Host ""
    Write-Host "PHASE_A_TEST_CONTRACT_V2_OK" `
        -ForegroundColor Green
}


Write-Host ""
Write-Host "Contract: $ContractPath"
Write-Host "Summary : $SummaryPath"