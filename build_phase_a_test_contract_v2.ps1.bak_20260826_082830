# ============================================================
# Helpers
# ============================================================

function Convert-CanonicalBoolean {
    param(
        [AllowNull()]
        [string]$Value
    )

    $Raw = ""

    if ($null -ne $Value) {
        $Raw = $Value.Trim()
    }

    if ($Raw -eq "") {
        return [pscustomobject]@{
            Canonical = ""
            Valid     = $true
        }
    }

    $Normalized = $Raw.ToLowerInvariant()

    switch ($Normalized) {

        { $_ -in @(
            "true",
            "t",
            "1",
            "yes",
            "y",
            "ja",
            "required"
        ) } {
            return [pscustomobject]@{
                Canonical = "true"
                Valid     = $true
            }
        }

        { $_ -in @(
            "false",
            "f",
            "0",
            "no",
            "n",
            "nee",
            "not_required"
        ) } {
            return [pscustomobject]@{
                Canonical = "false"
                Valid     = $true
            }
        }

        default {
            return [pscustomobject]@{
                Canonical = $Raw
                Valid     = $false
            }
        }
    }
}


function Convert-CanonicalQueryClass {
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ""
    }

    $Result = $Value.Trim().ToUpperInvariant()

    $Result = $Result `
        -replace '[\s\-]+', '_'

    return $Result
}


function Convert-CanonicalIntent {
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ""
    }

    return $Value.Trim().ToLowerInvariant()
}


function Get-CanonicalDomains {
    param(
        [AllowNull()]
        [string]$Value
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return @()
    }

    $Raw = $Value.Trim()

    $Parts = @()


    # JSON array support:
    # ["product","technical"]
    if (
        $Raw.StartsWith("[") `
        -and $Raw.EndsWith("]")
    ) {

        try {
            $Json = ConvertFrom-Json $Raw

            if ($Json -is [System.Array]) {
                $Parts = @($Json)
            }
            else {
                $Parts = @($Json)
            }
        }
        catch {
            # Fallback naar delimiter parsing.
            $Clean = $Raw `
                -replace '^\s*\[', '' `
                -replace '\]\s*$', ''

            $Parts = @(
                $Clean -split '\s*(?:,|;|\||\+)\s*'
            )
        }
    }
    else {

        $Parts = @(
            $Raw -split '\s*(?:,|;|\||\+)\s*'
        )
    }


    $Seen = @{}
    $Result = @()

    foreach ($Part in $Parts) {

        if ($null -eq $Part) {
            continue
        }

        $Domain = (
            [string]$Part
        ).Trim()

        $Domain = $Domain.Trim(
            '"',
            "'",
            " ",
            "`t"
        )

        $Domain = $Domain.ToLowerInvariant()

        if ($Domain -eq "") {
            continue
        }

        if (-not $Seen.ContainsKey($Domain)) {
            $Seen[$Domain] = $true
            $Result += $Domain
        }
    }

    return @($Result)
}


function Get-Distribution {
    param(
        [object[]]$Values
    )

    $Result = [ordered]@{}

    @(
        $Values |
            Where-Object {
                $null -ne $_ `
                -and ([string]$_).Trim() -ne ""
            } |
            Group-Object |
            Sort-Object Count -Descending, Name
    ) |
        ForEach-Object {
            $Result[[string]$_.Name] = $_.Count
        }

    return $Result
}


# ============================================================
# Load
# ============================================================

$Rows = @(
    Import-Csv $InputCsv
)

if ($Rows.Count -eq 0) {
    throw "Input CSV bevat geen records."
}


$RequiredColumns = @(
    "source_row",
    "id",
    "category",
    "question",
    "query_class",
    "expected_domains",
    "target_intent",
    "expected_entities",
    "research",
    "clarification",
    "note"
)

$ActualColumns = @(
    $Rows[0].PSObject.Properties.Name
)

$MissingColumns = @(
    $RequiredColumns |
        Where-Object {
            $_ -notin $ActualColumns
        }
)

if ($MissingColumns.Count -gt 0) {

    throw (
        "Ontbrekende kolommen: " +
        ($MissingColumns -join ", ")
    )
}


Write-Host ""
Write-Host "SOURCE_ROWS=$($Rows.Count)"


# ============================================================
# Normalize
# ============================================================

$ValidationErrors = New-Object `
    System.Collections.Generic.List[string]

$ContractRows = @()

$AllDomains = @()

$MultiDomainRows = 0
$BlankDomainRows = 0
$BlankIntentRows = 0
$BlankQueryClassRows = 0
$EntityLabelRows = 0


for ($i = 0; $i -lt $Rows.Count; $i++) {

    $Row = $Rows[$i]


    # --------------------------------------------------------
    # Test ID
    # --------------------------------------------------------

    $TestId = ([string]$Row.id).Trim()

    if ($TestId -eq "") {

        $TestId = "GOLDEN_{0:D4}" -f ($i + 1)

        $ValidationErrors.Add(
            "Row $($Row.source_row): missing id; generated $TestId"
        )
    }


    # --------------------------------------------------------
    # Question
    # --------------------------------------------------------

    $Question = ([string]$Row.question).Trim()

    if ($Question -eq "") {

        $ValidationErrors.Add(
            "Test $TestId: question is blank"
        )
    }


    # --------------------------------------------------------
    # Query class
    # --------------------------------------------------------

    $QueryClass = Convert-CanonicalQueryClass `
        $Row.query_class

    if ($QueryClass -eq "") {
        $BlankQueryClassRows++
    }


    # --------------------------------------------------------
    # Domains
    # --------------------------------------------------------

    $Domains = @(
        Get-CanonicalDomains `
            $Row.expected_domains
    )

    if ($Domains.Count -eq 0) {
        $BlankDomainRows++
    }

    if ($Domains.Count -gt 1) {
        $MultiDomainRows++
    }

    $AllDomains += $Domains

    $DomainsJson = ConvertTo-Json `
        -InputObject @($Domains) `
        -Compress

    $ExpectedPrimaryDomain = ""

    if ($Domains.Count -eq 1) {
        $ExpectedPrimaryDomain = $Domains[0]
    }


    # --------------------------------------------------------
    # Intent
    # --------------------------------------------------------

    $Intent = Convert-CanonicalIntent `
        $Row.target_intent

    if ($Intent -eq "") {
        $BlankIntentRows++
    }


    # --------------------------------------------------------
    # Entities
    # --------------------------------------------------------

    $EntitiesRaw = (
        [string]$Row.expected_entities
    ).Trim()

    if ($EntitiesRaw -ne "") {
        $EntityLabelRows++
    }


    # --------------------------------------------------------
    # Research / clarification
    # --------------------------------------------------------

    $Research = Convert-CanonicalBoolean `
        $Row.research

    if (-not $Research.Valid) {

        $ValidationErrors.Add(
            "Test $TestId: invalid research label '$($Row.research)'"
        )
    }


    $Clarification = Convert-CanonicalBoolean `
        $Row.clarification

    if (-not $Clarification.Valid) {

        $ValidationErrors.Add(
            "Test $TestId: invalid clarification label '$($Row.clarification)'"
        )
    }


    # --------------------------------------------------------
    # Contract row
    # --------------------------------------------------------

    $ContractRows += [pscustomobject]@{

        test_id = $TestId

        source_row = (
            [string]$Row.source_row
        ).Trim()

        test_category = (
            [string]$Row.category
        ).Trim()

        question = $Question

        expected_query_class = $QueryClass

        expected_domains_raw = (
            [string]$Row.expected_domains
        ).Trim()

        expected_domains_json = $DomainsJson

        expected_primary_domain = $ExpectedPrimaryDomain

        expected_intent = $Intent

        expected_entities_raw = $EntitiesRaw

        expected_research_required = `
            $Research.Canonical

        expected_clarification_required = `
            $Clarification.Canonical

        notes = (
            [string]$Row.note
        ).Trim()

        source = "GoldenTestSet200"
    }
}


# ============================================================
# Duplicate validation
# ============================================================

$DuplicateIds = @(
    $ContractRows |
        Group-Object test_id |
        Where-Object {
            $_.Count -gt 1
        }
)

foreach ($Duplicate in $DuplicateIds) {

    $ValidationErrors.Add(
        "Duplicate test_id: $($Duplicate.Name) ($($Duplicate.Count)x)"
    )
}


$DuplicateQuestions = @(
    $ContractRows |
        Group-Object {
            $_.question.Trim().ToLowerInvariant()
        } |
        Where-Object {
            $_.Name -ne "" `
            -and $_.Count -gt 1
        }
)


# ============================================================
# Write contract
# ============================================================

$ContractRows |
    Export-Csv `
        -Path $ContractPath `
        -NoTypeInformation `
        -Encoding UTF8


# ============================================================
# Summary
# ============================================================

$Summary = [ordered]@{

    contract_version = "phase_a_v2"

    source = [ordered]@{
        file = $InputCsv
        rows = $Rows.Count
    }

    output = [ordered]@{
        contract = $ContractPath
    }

    counts = [ordered]@{

        total_tests = $ContractRows.Count

        blank_query_class = `
            $BlankQueryClassRows

        blank_expected_domains = `
            $BlankDomainRows

        multi_domain_tests = `
            $MultiDomainRows

        blank_expected_intent = `
            $BlankIntentRows

        rows_with_expected_entities = `
            $EntityLabelRows

        duplicate_ids = `
            $DuplicateIds.Count

        duplicate_questions = `
            $DuplicateQuestions.Count

        validation_errors = `
            $ValidationErrors.Count
    }

    distributions = [ordered]@{

        test_category = Get-Distribution `
            @($ContractRows.test_category)

        query_class = Get-Distribution `
            @($ContractRows.expected_query_class)

        expected_domains = Get-Distribution `
            @($AllDomains)

        expected_intent = Get-Distribution `
            @($ContractRows.expected_intent)

        research_required = Get-Distribution `
            @($ContractRows.expected_research_required)

        clarification_required = Get-Distribution `
            @($ContractRows.expected_clarification_required)
    }

    validation_errors = @(
        $ValidationErrors
    )

    duplicate_questions = @(
        $DuplicateQuestions |
            ForEach-Object {

                [ordered]@{
                    normalized_question = $_.Name
                    count = $_.Count
                    test_ids = @(
                        $_.Group.test_id
                    )
                }
            }
    )
}


$Summary |
    ConvertTo-Json `
        -Depth 10 |
    Set-Content `
        -Path $SummaryPath `
        -Encoding UTF8


