def build_database_url() -> str:
    load_dotenv()

    db_url = os.getenv("DATABASE_URL")
    if db_url:
        return db_url

    user = os.getenv("POSTGRES_USER", "postgres")
    password = os.getenv("POSTGRES_PASSWORD", "SterkWachtwoord123")
    dbname = os.getenv("POSTGRES_DB", "promati")
    return f"postgresql://{user}:{password}@localhost:15432/{dbname}"


DATABASE_URL = build_database_url()
print("DATABASE_URL =", DATABASE_URL)

engine = create_engine(DATABASE_URL, future=True)

SIDE_PATTERN = re.compile(
    r"\b("
    r"west\s*2|oost|west|noord|zuid|midden|"
    r"aandrijfzijde|aandrijfkant|aandrijftrommel|"
    r"keerrol|retour|boven|onder"
    r")\b",
    re.IGNORECASE,
)

SIDE_NORMALIZATION = {
    "OOST": "OOST",
    "WEST": "WEST",
    "WEST2": "WEST2",
    "WEST 2": "WEST2",
    "NOORD": "NOORD",
    "ZUID": "ZUID",
    "MIDDEN": "MIDDEN",
    "AANDRIJFZIJDE": "AANDRIJFZIJDE",
    "AANDRIJFKANT": "AANDRIJFZIJDE",
    "AANDRIJFTROMMEL": "AANDRIJFZIJDE",
    "KEERROL": "KEERROL",
    "RETOUR": "KEERROL",
    "BOVEN": "BOVEN",
    "ONDER": "ONDER",
}
HOSCH_PATTERN = re.compile(r"\bhosch\b", re.IGNORECASE)

WIDTH_INLINE_PATTERN = re.compile(
    r"\b(UI|TPH|TPL|RI|RV|AF|H|U)\s*([0-9]{2,4})\b",
    re.IGNORECASE,
)

WIDTH_RANGE_PATTERN = re.compile(
    r"\b([0-9]{3,4})\s*[-/]\s*([0-9]{3,4})\b"
)

VARIANT_WORDS = [
    "REV",
    "HDI",
    "HD",
    "ND",
    "SP/M3",
    "LB",
    "VB",
    "LOW",
    "PUT",
    "TRIPPER",
    "UITHOUDER",
]

HEADER_WORDS = [
    "ONDERHOUDS-RAPPORT",
    "LOCATIE",
    "BAND-BREEDTE",
    "MERK + TYPE",
    "MESHOOGTE",
    "OPMERKING",
    "KLANTGEGEVENS",
    "UITGEVOERD DOOR",
    "DATUM",
    "HANDTEKENING",
]

LOCATION_LIKE_PATTERN = re.compile(
    r"""
    ^
    (
        [A-Z]{1,4}\s*[0-9]{1,5}\s*[A-Z]?
        |
        WG\s*[0-9]{2,5}
        |
        STACKER(\s*[0-9]{2,4})?
    )
    $
    """,
    re.IGNORECASE | re.VERBOSE,
)

PEFA_BANDCODE_PATTERN = re.compile(r"^[A-Z]{1,3}\s*\d{2,4}$", re.IGNORECASE)


def ensure_extra_columns(conn) -> None:
    """
    Breidt sb_excel_positions_v1 uit met kolommen voor bandblokken en scraperrollen.
    Veilig: add column if not exists.
    """
    ddl = [
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS customer_code text",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS site_code text",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS band_block_id text",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS band_block_start_row int",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS band_block_locatie_raw text",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS band_block_locatie_norm text",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS scraper_seq_in_block int",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS scraper_role text",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS active_flag boolean",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS inspectable_flag boolean",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS deprecated_flag boolean",
        "ALTER TABLE sb_excel_positions_v1 ADD COLUMN IF NOT EXISTS inspection_signal_flag boolean",
    ]
    for sql in ddl:
        conn.execute(text(sql))


def normalize_whitespace(value) -> str | None:
    if value is None:
        return None

    if isinstance(value, bool):
        value = str(value)
    elif isinstance(value, (int, float)):
        if isinstance(value, float) and value.is_integer():
            value = str(int(value))
        else:
            value = str(value)
    elif not isinstance(value, str):
        value = str(value)

    value = re.sub(r"\s+", " ", value).strip()
    return value or None


def normalize_location(value: str | None) -> str | None:
    value = normalize_whitespace(value)
    if not value:
        return None
    return re.sub(r"\s+", "", value).upper()


def normalize_performed_by(value: str | None) -> list[str] | None:
    value = normalize_whitespace(value)
    if not value:
        return None

    parts = re.split(r"\s*[&/\\]+\s*", value)
    parts = [p.strip() for p in parts if p and p.strip()]
    return parts or None


def extract_side(*values: str | None) -> tuple[str | None, str | None]:
    """
    Haalt fysieke positie uit tekst.

    Belangrijk:
    - OOST/WEST/NOORD/ZUID/AANDRIJFZIJDE/KEERROL zijn fysieke locaties.
    - Dit is dus géén scraper_role.
    """
    for value in values:
        if not value:
            continue

        # PATCH: side-detectie vastgeplakte TUSSENPARTSCHRAPER OOST/WEST
        # tussenpartschraperOost -> tussenpartschraper Oost
        # tussenpartschraperWest -> tussenpartschraper West
        value_for_side = normalize_whitespace(value) or value
        value_for_side = re.sub(
            r"(TUSSENPARTSCHRAPER)(OOST|WEST)\b",
            r"\1 \2",
            value_for_side,
            flags=re.IGNORECASE,
        )

        m = SIDE_PATTERN.search(value_for_side)
        if m:
            raw = m.group(1)
            norm = SIDE_NORMALIZATION.get(raw.upper(), raw.upper())
            return raw, norm

    return None, None


def strip_side_words(value: str | None) -> str | None:
    value = normalize_whitespace(value)
    if not value:
        return None
    value = SIDE_PATTERN.sub("", value)
    value = re.sub(r"\s+", " ", value).strip()
    return value or None


def expand_short_width(num: int) -> int:
    if num in {100, 120, 140, 160, 180}:
        return num * 10
    return num


def normalize_band_breedte(raw: str | None, scraper_type_raw: str | None) -> tuple[int | None, str | None]:
    raw = normalize_whitespace(raw)

    if raw:
        digits = re.sub(r"[^0-9]", "", raw)
        if digits:
            num = int(digits)
            return num, str(num)

    st = normalize_whitespace(scraper_type_raw)
    if st:
        m = WIDTH_INLINE_PATTERN.search(st)
        if m:
            num = int(m.group(2))
            num = expand_short_width(num)
            return num, str(num)

    return None, None


def infer_family(value: str | None) -> str | None:
    value = normalize_whitespace(value)
    if not value:
        return None

    upper = value.upper()

    for fam in ["UI", "TPH", "TPL", "RI", "RV", "AF", "H", "U"]:
        if re.search(rf"^\s*{re.escape(fam)}\b", upper):
            return fam
        if re.search(rf"^\s*{re.escape(fam)}(?=\d)", upper):
            return fam

    return None


def family_for_role(family: str | None) -> str | None:
    """
    Rol-afleiding:
    - TPH/TPHI/TPL = primaire kopschraper, typisch HOOG
    - H/HI = primaire Belle Banne H, kan HOOG of LAAG zijn
    - U/UI = secundair/tertiair onderschraper
    - R/RI/RV/AF voorlopig als secundaire/retourfamilies behandelen, tenzij later anders gewenst
    """
    if family is None:
        return None

    fam = family.upper().strip()

    if fam in {"TPH", "TPHI", "TPL"}:
        return "PRIMARY_TPH"

    if fam in {"H", "HI"}:
        return "PRIMARY_H"

    if fam in {"UI", "U"}:
        return "U"

    if fam in {"R", "RI", "RV", "AF"}:
        return "R"

    return fam


def infer_variant(value: str | None) -> str | None:
    value = normalize_whitespace(value)
    if not value:
        return None

    upper = value.upper()
    found: list[str] = []

    for patt in VARIANT_WORDS:
        if patt == "SP/M3":
            if "SP/M3" in upper:
                found.append("SP/M3")
        else:
            if re.search(rf"\b{re.escape(patt)}\b", upper):
                found.append(patt)

    if not found:
        return None

    return " ".join(dict.fromkeys(found))


def infer_position_suffix(scraper_type_norm: str | None, opmerking_raw: str | None) -> str | None:
    values = [scraper_type_norm or "", opmerking_raw or ""]
    upper = " | ".join(values).upper()

    found = []
    for patt in ["TRIPPER", "UITHOUDER", "LB", "REV", "VB", "PUT", "LOW"]:
        if re.search(rf"\b{re.escape(patt)}\b", upper):
            found.append(patt)

    if not found:
        return None

    return " ".join(dict.fromkeys(found))


def normalize_scraper_type(raw: str | None, opmerking_raw: str | None = None) -> tuple[str | None, str | None, str | None, str | None]:
    raw = normalize_whitespace(raw)
    if not raw:
        return None, None, None, None

    upper = raw.upper()
    upper = upper.replace(".", " ")
    upper = re.sub(r"\s+", " ", upper).strip()

    # PATCH: herstel ontbrekende spaties rond TRIPPER
    # U 140Tripper VB/LB  -> U 140 Tripper VB/LB
    # U 140 TripperVB/LB  -> U 140 Tripper VB/LB
    upper = re.sub(
        r"(\d)(TRIPPER)\b",
        r"\1 \2",
        upper,
        flags=re.IGNORECASE,
    )
    upper = re.sub(
        r"\b(TRIPPER)(VB|LB)\b",
        r"\1 \2",
        upper,
        flags=re.IGNORECASE,
    )

    # PATCH: REVERSIBLE en vastgeplakte VB/LB normaliseren
    # U 120 Reversible Noord -> U 120 REV Noord
    # RI 1000-750vb         -> RI 1000-750 VB
    upper = re.sub(
        r"\bREVERSIBLE\b",
        "REV",
        upper,
        flags=re.IGNORECASE,
    )

    upper = re.sub(
        r"(\d)(VB|LB)\b",
        r"\1 \2",
        upper,
        flags=re.IGNORECASE,
    )
    # PATCH: vastgeplakte HDI/HD/ND voor maatvoering
    # TPH HD1600-1350  -> TPH HD 1600-1350
    # TPH HDI1600-1350 -> TPH HDI 1600-1350
    # TPH ND1000-750   -> TPH ND 1000-750
    upper = re.sub(
        r"\b(HDI|HD|ND)(?=\d)",
        r"\1 ",
        upper,
        flags=re.IGNORECASE,
    )
    # PATCH: vastgeplakte HDI/HD/ND na maatvoering
    # TPH 1600-1350HDi -> TPH 1600-1350 HDI
    # TPH 1600-1350HD  -> TPH 1600-1350 HD
    # TPH 1600-1350ND  -> TPH 1600-1350 ND
    upper = re.sub(
        r"(\d)(HDI|HD|ND)\b",
        r"\1 \2",
        upper,
        flags=re.IGNORECASE,
    )
    # PATCH: vastgeplakte zijde bij TUSSENPARTSCHRAPER
    # tussenpartschraperOost -> TUSSENPARTSCHRAPER OOST
    # tussenpartschraperWest -> TUSSENPARTSCHRAPER WEST
    upper = re.sub(
        r"\b(TUSSENPARTSCHRAPER)(OOST|WEST)\b",
        r"\1 \2",
        upper,
        flags=re.IGNORECASE,
    )
    # PATCH: historische TPHi + HD naar TPH + HDI
    # TPHi 1400/1200 HD -> TPH 1400/1200 HDI
    # TPHi 1200/1050 HD -> TPH 1200/1050 HDI
    # TPHi 1600 blijft bewust ongemoeid
    if (
        re.match(r"^\s*TPHI\b", upper, flags=re.IGNORECASE)
        and re.search(r"\bHD\b", upper, flags=re.IGNORECASE)
    ):
        upper = re.sub(
            r"^\s*TPHI\b",
            "TPH",
            upper,
            flags=re.IGNORECASE,
        )
        upper = re.sub(
            r"\bHD\b",
            "HDI",
            upper,
            flags=re.IGNORECASE,
        )
    upper = strip_side_words(upper) or upper

    # PATCH: zelfstandige U 260 normaliseren naar U 2600
    # U 260       -> U 2600
    # U 260 LB    -> U 2600 LB
    # U260 LB     -> U 2600 LB
    # Niet geraakt: U 220 LB + U260 mes
    upper = re.sub(
        r"^U\s*260(?=\s|$)",
        "U 2600",
        upper,
        flags=re.IGNORECASE,
    )

    upper = re.sub(r"\bUI(?=\d)", "UI ", upper)
    upper = re.sub(r"\bTPH(?=\d)", "TPH ", upper)
    upper = re.sub(r"\bTPL(?=\d)", "TPL ", upper)
    upper = re.sub(r"\bRI(?=\d)", "RI ", upper)
    upper = re.sub(r"\bRV(?=\d)", "RV ", upper)
    upper = re.sub(r"\bAF(?=\d)", "AF ", upper)
    upper = re.sub(r"\bH(?=\d)", "H ", upper)
    upper = re.sub(r"\bU(?=\d)", "U ", upper)

    upper = re.sub(r"\s+", " ", upper).strip()

    family = infer_family(upper)
    variant = infer_variant(upper)

    material = "ONBEKEND"
    if family == "UI":
        material = "INOX"
    elif family == "U":
        material = "STANDAARD"

    # PATCH: TPH materiaal uit HD/ND/HDI
    # HDI = Heavy Duty INOX/RVS
    # HD  = Heavy Duty standaard materiaal
    # ND  = standaard materiaal
    if family == "TPH":
        variant_parts = set(variant.split()) if variant else set()

        if "HDI" in variant_parts:
            material = "INOX"
        elif "HD" in variant_parts or "ND" in variant_parts:
            material = "STANDAARD"

    # PATCH: expliciete INOX-vermelding heeft voorrang
    # TPH 1600 VB inox      -> materiaal INOX
    # TPH 800/750 inox      -> materiaal INOX
    # TPH 1200-900 HD inox  -> materiaal INOX
    #
    # Alleen materiaal wijzigen; type en variant blijven ongewijzigd.
    if re.search(r"\bINOX\b", upper, flags=re.IGNORECASE):
        material = "INOX"

    width_num = None
    m = WIDTH_INLINE_PATTERN.search(upper)
    if m:
        width_num = int(m.group(2))
        width_num = expand_short_width(width_num)

    range_match = WIDTH_RANGE_PATTERN.search(upper)
    width_range = None
    if range_match:
        width_range = f"{range_match.group(1)}-{range_match.group(2)}"

    if family and width_range:
        norm = f"{family} {width_range}"
        if variant:
            extra = " ".join([x for x in variant.split() if x not in norm.split()])
            if extra:
                norm = f"{norm} {extra}"
        return norm.strip(), family, material, variant

    if family and width_num:
        norm = f"{family} {width_num}"
        if variant:
            extra = " ".join([x for x in variant.split() if x not in norm.split()])
            if extra:
                norm = f"{norm} {extra}"
        return norm.strip(), family, material, variant

    return upper, family, material, variant

def normalize_scraper_mapping_key(value: str | None) -> str | None:
    """
    Normaliseert scraper type voor lookup in scraper_type_mapping.
    Houdt bewust '-' en '/' intact, omdat raw_scraper_type exact kan verschillen.
    """

    value = normalize_whitespace(value)

    if not value:
        return None

    return value.upper()


def load_scraper_type_mapping(conn) -> dict[str, dict[str, Any]]:
    """
    Laadt scraper_type_mapping als read-only lookup voor de parser.

    Belangrijk:
    - raw_scraper_type is de primaire sleutel voor Excel-waarden zoals HI 1200-1000 VB.
    - scraper_type_clean wordt ook als fallback-key geregistreerd.
    """

    rows = conn.execute(text("""
        SELECT
            raw_scraper_type,
            scraper_type_clean,
            scraper_family_clean,
            materiaal_clean,
            features_clean,
            mapping_source
        FROM scraper_type_mapping
    """)).mappings().all()

    mapping: dict[str, dict[str, Any]] = {}

    for row in rows:
        item = dict(row)

        for key_value in [
            item.get("raw_scraper_type"),
            item.get("scraper_type_clean"),
        ]:
            key = normalize_scraper_mapping_key(key_value)

            if key:
                mapping[key] = item

    return mapping


def apply_scraper_type_mapping(
    scraper_type_raw: str | None,
    scraper_type_norm: str | None,
    scraper_family: str | None,
    scraper_material: str | None,
    scraper_variant: str | None,
    scraper_type_mapping: dict[str, dict[str, Any]],
) -> tuple[str | None, str | None, str | None, str | None, dict | None]:
    """
    Verrijkt parserresultaat met scraper_type_mapping.

    Deze functie overschrijft alleen classificatievelden:
    - family
    - materiaal
    - optioneel variant als die uit features herkenbaar is

    scraper_type_norm blijft bewust de parser-normalisatie / ruwe type-identiteit houden.
    """

    lookup_keys = [
        normalize_scraper_mapping_key(scraper_type_raw),
        normalize_scraper_mapping_key(scraper_type_norm),
    ]

    mapping_row = None

    for key in lookup_keys:
        if key and key in scraper_type_mapping:
            mapping_row = scraper_type_mapping[key]
            break

    if not mapping_row:
        return scraper_type_norm, scraper_family, scraper_material, scraper_variant, None

    mapped_family = normalize_whitespace(mapping_row.get("scraper_family_clean")) or scraper_family
    mapped_material = normalize_whitespace(mapping_row.get("materiaal_clean")) or scraper_material

    features = mapping_row.get("features_clean") or []
    mapped_variant = scraper_variant

    # PATCH: mapping-varianten verrijken, niet overschrijven
    # Parservariant blijft leidend.
    # HDI is specifieker dan HD en mag nooit teruggezet worden naar HD.
    # Overige mapping-varianten worden toegevoegd, bijvoorbeeld HDI + PUT.
    if isinstance(features, list):
        variant_candidates = [
            str(value).strip().upper()
            for value in features
            if value is not None and str(value).strip().upper() in VARIANT_WORDS
        ]

        if variant_candidates:
            existing_parts = [
                part.strip().upper()
                for part in (scraper_variant or "").split()
                if part and part.strip()
            ]

            mapped_parts = [
                part
                for part in variant_candidates
                if part
            ]

            if "HDI" in existing_parts:
                mapped_parts = [
                    part
                    for part in mapped_parts
                    if part != "HD"
                ]

            combined_parts = list(dict.fromkeys(
                existing_parts + mapped_parts
            ))

            mapped_variant = (
                " ".join(combined_parts)
                if combined_parts
                else scraper_variant
            )

    return scraper_type_norm, mapped_family, mapped_material, mapped_variant, mapping_row

def parse_mes(raw: str | None) -> tuple[float | None, str | None, str | None]:
    raw = normalize_whitespace(raw)
    if not raw:
        return None, None, None

    if re.fullmatch(r"[0-9]+(?:[.,][0-9]+)?", raw):
        val = float(raw.replace(",", "."))
        return val, None, None

    code = raw.upper()

    if code == "G":
        return None, "G", "GOED"
    if code == "M":
        return None, "M", "MONITOREN"
    if code == "V":
        return None, "V", "VERVANGEN"

    return None, code, "ONBEKEND"


def is_empty_row(
    locatie: str | None,
    band_breedte: str | None,
    scraper_type: str | None,
    mes_raw: str | None,
    opmerking: str | None,
    demontage: bool | None,
    reinigen: bool | None,
    vervangen: bool | None,
    montage: bool | None,
    afstellen: bool | None,
) -> bool:
    return not any([
        normalize_whitespace(locatie),
        normalize_whitespace(band_breedte),
        normalize_whitespace(scraper_type),
        normalize_whitespace(mes_raw),
        normalize_whitespace(opmerking),
        bool(demontage),
        bool(reinigen),
        bool(vervangen),
        bool(montage),
        bool(afstellen),
    ])


def is_header_like(locatie: str | None, scraper_type: str | None, opmerking: str | None) -> bool:
    blob = " | ".join([
        normalize_whitespace(locatie) or "",
        normalize_whitespace(scraper_type) or "",
        normalize_whitespace(opmerking) or "",
    ]).upper()

    if not blob.strip():
        return False

    return any(word in blob for word in HEADER_WORDS)


def looks_like_location(value: str | None) -> bool:
    value = normalize_whitespace(value)
    if not value:
        return False
    return bool(LOCATION_LIKE_PATTERN.match(value))

WG024_SUBPOSITION_TO_BAND = {
    "OPVOERBAND": "WG024",
    "TRIPPER": "WG02401",
    "UITHOUDER": "WG02402",
}


def detect_wg024_subposition(
    locatie_raw: str | None,
    scraper_type_raw: str | None,
    opmerking_raw: str | None,
    current_block_locatie_norm: str | None,
    source_file: str | None,
    wg024_context_active: bool = False,
) -> tuple[str | None, str | None, str | None]:
    """
    Specifieke correctie voor Ertsopslag E300 / WG024.

    Return:
    - positie_label: OPVOERBAND / TRIPPER / UITHOUDER
    - band_alias: WG024 / WG02401 / WG02402
    - parent_band: WG024
    """

    blob = " ".join([
        normalize_whitespace(locatie_raw) or "",
        normalize_whitespace(scraper_type_raw) or "",
        normalize_whitespace(opmerking_raw) or "",
    ]).upper()

    current_norm = normalize_location(current_block_locatie_norm)

    is_wg024_context = (
        wg024_context_active
        or current_norm == "WG024"
        or normalize_location(locatie_raw) in {"WG024", "WG02401", "WG02402"}
        or "WG024" in blob
    )

    if not is_wg024_context:
        return None, None, None

    for label, band_code in WG024_SUBPOSITION_TO_BAND.items():
        if label in blob:
            return label, band_code, "WG024"

    # Legacy WG024-regels:
    # oudere sheets gebruiken soms alleen "U 1400 REV" zonder expliciet "Uithouder".
    # Voor Ertsopslag WG024 behandelen we die als Uithouder / WG02402.
    if is_wg024_context:
        if "REV" in blob and re.search(r"\bU\s*1400\b|\bU\s*140\b", blob):
            return "UITHOUDER", "WG02402", "WG024"

        # TPH HDI hoort bij WG024 meestal bij de Tripper.
        if "TPH" in blob and "HDI" in blob:
            return "TRIPPER", "WG02401", "WG024"

    return None, None, None


def looks_like_real_scraper_type(value: str | None) -> bool:
    value = normalize_whitespace(value)
    if not value:
        return False
    fam = infer_family(value)
    return fam is not None


def has_action_columns(demontage: bool, reinigen: bool, vervangen: bool, montage: bool, afstellen: bool) -> bool:
    return any([demontage, reinigen, vervangen, montage, afstellen])


def has_inspection_signal(
    scraper_type_raw: str | None,
    mes_raw: str | None,
    opmerking_raw: str | None,
    demontage: bool,
    reinigen: bool,
    vervangen: bool,
    montage: bool,
    afstellen: bool,
) -> bool:
    """
    Bepaalt of deze regel echte inspectiedata bevat.

    Sterk bewijs:
    - X/V in actie-kolommen
    - meshoogte / mescode ingevuld

    Zwakker bewijs:
    - opmerking telt alleen mee als er op dezelfde regel ook een echte scraper staat.
      Zo wordt een algemene bandopmerking niet per ongeluk een actieve scraperpositie.
    """
    has_strong_signal = any([
        normalize_whitespace(mes_raw),
        demontage,
        reinigen,
        vervangen,
        montage,
        afstellen,
    ])

    if has_strong_signal:
        return True

    has_note_on_real_scraper = bool(
        normalize_whitespace(opmerking_raw)
        and looks_like_real_scraper_type(scraper_type_raw)
    )

    return has_note_on_real_scraper


def classify_record_role(
    locatie_raw: str | None,
    band_breedte_raw: str | None,
    scraper_type_raw: str | None,
    opmerking_raw: str | None,
    is_header_achtig: bool,
    is_lege_regel: bool,
    inherited_locatie: bool,
    inspection_signal_flag: bool,
) -> str:
    if is_header_achtig:
        return "HEADER"
    if is_lege_regel:
        return "EMPTY"

    has_loc = bool(normalize_whitespace(locatie_raw))
    has_bw = bool(normalize_whitespace(band_breedte_raw))
    has_type = bool(normalize_whitespace(scraper_type_raw))
    has_note = bool(normalize_whitespace(opmerking_raw))

    real_loc = looks_like_location(locatie_raw)
    real_type = looks_like_real_scraper_type(scraper_type_raw)

    if real_loc and not has_type and not inspection_signal_flag:
        return "BAND_HEADER"

    if (real_loc and (has_bw or real_type)) or (has_loc and real_type):
        if inspection_signal_flag:
            return "POSITION"
        return "CONFIG_ONLY"

    if inherited_locatie and (has_bw or has_type or has_note):
        if real_type or has_bw:
            if inspection_signal_flag:
                return "SUB_POSITION"
            return "SUB_CONFIG"
        return "COMMENT_ONLY"

    if has_note and not has_type and not has_bw:
        return "COMMENT_ONLY"

    if has_type or has_bw:
        if inspection_signal_flag:
            return "SUB_POSITION"
        return "SUB_CONFIG"

    return "COMMENT_ONLY"


def extract_pefa_band_code(row_json: dict) -> str | None:
    if not row_json:
        return None

    candidate_keys = [
        "Promati sa/nv ",
        "Promati sa/nv",
    ]

    for key in candidate_keys:
        value = normalize_whitespace(row_json.get(key))
        if not value:
            continue

        value = re.sub(r"\s+", " ", value).strip().upper()

        if PEFA_BANDCODE_PATTERN.match(value):
            return value

    return None

def extract_location_from_row_json(row_json: dict) -> str | None:
    """
    Haalt locatie uit row_json voor Excel-sheets waarbij de eerste kolom
    niet als 'locatie' is gepromoveerd maar onder de originele headernaam staat.

    Voorbeeld HOO6/HOO7:
    row_json["Promati sa/nv"] = "TB 70"
    """

    if not row_json:
        return None

    candidate_keys = [
        "Promati sa/nv",
        "Promati sa/nv ",
    ]

    for key in candidate_keys:
        value = normalize_whitespace(row_json.get(key))
        if not value:
            continue

        if looks_like_location(value):
            return value

    return None

def has_minimal_data(
    locatie_raw: str | None,
    band_breedte_raw: str | None,
    scraper_type_raw: str | None,
    mes_raw: str | None,
    opmerking_raw: str | None,
    demontage: bool,
    reinigen: bool,
    vervangen: bool,
    montage: bool,
    afstellen: bool,
) -> bool:
    return any([
        locatie_raw,
        band_breedte_raw,
        scraper_type_raw,
        mes_raw,
        opmerking_raw,
        demontage,
        reinigen,
        vervangen,
        montage,
        afstellen,
    ])


def role_physical_position(row: dict[str, Any], fallback: str | None = None) -> str:
    """
    Fysieke locatie voor rolbepaling.

    Oost/west/noord/zuid/aandrijfzijde/keerrol zijn fysieke locaties.
    Als een subregel geen locatie noemt, mag hij de vorige fysieke locatie binnen
    hetzelfde actieve bandblok erven. Dat is belangrijk bij combinaties zoals:

    U 120 Reversible Zuid
    TPH HD 1200-900
    RV 1200-1050 LB

    waarbij TPH/RV bij dezelfde fysieke groep horen.
    """
    pos = row.get("zijde_norm")

    if pos:
        return str(pos)

    suffix = row.get("positie_suffix")
    if suffix:
        return str(suffix)

    if fallback:
        return fallback

    return "POS_ONBEKEND"


def infer_scraper_role_for_block(block_rows: list[dict[str, Any]]) -> None:
    """
    Bepaalt scraper_role per fysieke locatie binnen een bandblok.

    Nieuwe hoofdregels:
    - Alleen actieve inspectieregels bepalen de rol.
    - OOST/WEST/NOORD/ZUID/AANDRIJFZIJDE/KEERROL zijn fysieke locaties, geen rollen.
    - Binnen dezelfde fysieke locatie:
        PRIMARY_FAMILY => PRIMAIR
        H              => SECUNDAIR
        U/UI           => SECUNDAIR als daar geen actieve H staat, anders TERTIAIR
    """

    # Eerst alles neutraal zetten. Inactieve/configregels mogen de rol niet vervuilen.
    for r in block_rows:
        r["scraper_seq_in_block"] = None
        r["scraper_role"] = None

    active_rows = [
        r for r in block_rows
        if r.get("active_flag")
        and r.get("inspection_signal_flag")
        and r.get("scraper_type_effective_norm")
        and not r.get("is_header_achtig")
        and not r.get("is_lege_regel")
    ]

    if not active_rows:
        return

    # Fysieke locatie erven binnen actieve regels in rijvolgorde.
    last_physical_position: str | None = None
    rows_by_position: dict[str, list[dict[str, Any]]] = defaultdict(list)

    for r in sorted(active_rows, key=lambda x: (x.get("row_nr") or 0)):
        explicit_pos = r.get("zijde_norm") or r.get("positie_suffix")

        if explicit_pos:
            last_physical_position = str(explicit_pos)

        physical_pos = role_physical_position(r, fallback=last_physical_position)
        rows_by_position[physical_pos].append(r)

    # Rol bepalen per fysieke locatie, niet per hele band.
    global_seq = 0

    for physical_pos, rows in rows_by_position.items():
        families_in_position = {
            family_for_role(r.get("scraper_family"))
            for r in rows
            if r.get("scraper_type_effective_norm")
        }

        has_primary = any(
            fam in {"PRIMARY_TPH", "PRIMARY_H"}
            for fam in families_in_position
        )

        for r in rows:
            global_seq += 1
            fam = family_for_role(r.get("scraper_family"))

            role = "ONBEKEND"

            if fam in {"PRIMARY_TPH", "PRIMARY_H"}:
                role = "PRIMAIR"
            elif fam == "U":
                role = "TERTIAIR" if has_primary else "SECUNDAIR"
            elif fam == "R":
                role = "SECUNDAIR"

            r["scraper_seq_in_block"] = global_seq
            r["scraper_role"] = role

def build_block_id(inspection_key: str, start_row: int | None, locatie_norm: str | None) -> str:
    return f"{inspection_key}|{start_row or 0}|{locatie_norm or 'ONBEKEND'}"

def finalize_block(block_rows: list[dict[str, Any]]) -> None:
    """
    Sluit een bandblok af.

    Nieuwe regel:
    - Als een bandblok géén enkele actieve inspectieregel heeft, dan is de band
      op deze sheet niet geïnspecteerd. Dan verwijderen we het hele blok uit
      sb_excel_positions_v1.
    - Als een bandblok wél inspectiedata heeft, blijven actieve regels actief.
      Regels zonder inspectiedata binnen dat bezochte bandblok worden inactive/deprecated.
    """

    if not block_rows:
        return

    band_visit_has_inspection = any(
        r.get("inspection_signal_flag")
        and r.get("scraper_type_effective_norm")
        and not r.get("is_header_achtig")
        and not r.get("is_lege_regel")
        for r in block_rows
    )

    if not band_visit_has_inspection:
        # Band stond wel op sheet, maar is niet geïnspecteerd.
        # Niets opslaan als inspectiepositie.
        block_rows.clear()
        return

    kept_rows: list[dict[str, Any]] = []

    for r in block_rows:
        has_type = bool(r.get("scraper_type_effective_norm"))
        has_signal = bool(r.get("inspection_signal_flag"))

        # Header/lege/comment-only regels niet als positie bewaren.
        if r.get("is_header_achtig") or r.get("is_lege_regel"):
            continue

        if not has_type and not has_signal:
            continue

        if has_type and has_signal:
            r["active_flag"] = True
            r["inspectable_flag"] = True
            r["deprecated_flag"] = False
        elif has_type and not has_signal:
            # Er is wel een bandvisit, maar deze specifieke regel is niet bekeken.
            # Dus hij mag niet actief worden en mag geen rolbepaling vervuilen.
            r["active_flag"] = False
            r["inspectable_flag"] = False
            r["deprecated_flag"] = True

            notes = r.get("parse_notes")
            extra = "Niet geïnspecteerd binnen bezochte band; inactive/deprecated"
            r["parse_notes"] = f"{notes} | {extra}" if notes else extra

        kept_rows.append(r)

    block_rows[:] = kept_rows

    active_rows = [
        r for r in block_rows
        if r.get("active_flag") is True
        and r.get("inspectable_flag") is True
        and r.get("inspection_signal_flag") is True
        and r.get("deprecated_flag") is not True
    ]

    infer_scraper_role_for_block(active_rows)

    role_by_key = {
        (
            r.get("row_nr"),
            r.get("scraper_type_effective_norm"),
            r.get("locatie_effective"),
        ): {
            "scraper_seq_in_block": r.get("scraper_seq_in_block"),
            "scraper_role": r.get("scraper_role"),
        }
        for r in active_rows
    }

    for r in block_rows:
        key = (
            r.get("row_nr"),
            r.get("scraper_type_effective_norm"),
            r.get("locatie_effective"),
        )

        if key in role_by_key:
            r["scraper_seq_in_block"] = role_by_key[key]["scraper_seq_in_block"]
            r["scraper_role"] = role_by_key[key]["scraper_role"]
        else:
            r["scraper_seq_in_block"] = None
            r["scraper_role"] = None

def enrich_position_keys_with_slot(block_rows: list[dict[str, Any]]) -> None:
    """
    Maakt position_key uniek voor dubbele identieke schrapers
    binnen hetzelfde bandblok, bijvoorbeeld WG02402 UITHOUDER U 1400 REV.
    """
    for r in block_rows:
        seq = r.get("scraper_seq_in_block")
        if seq is None:
            seq = r.get("row_nr") or "ONBEKEND"

        base_key = r.get("position_key") or ""
        if "|SLOT_" not in base_key:
            r["position_key"] = f"{base_key}|SLOT_{seq}"

def main(mode: str = "incremental") -> None:
    with engine.begin() as conn:
        ensure_extra_columns(conn)

        if mode == "full-rebuild":
            print("[INFO] FULL REBUILD: Leegmaken sb_excel_positions_v1 ...")
            conn.execute(text("TRUNCATE TABLE sb_excel_positions_v1 RESTART IDENTITY"))
        else:
            print("[INFO] INCREMENTAL: alleen posities voor changed sheets verwerken ...")

        scraper_type_mapping = load_scraper_type_mapping(conn)
        print(f"[INFO] scraper_type_mapping loaded: {len(scraper_type_mapping)} keys")

        base_rows_sql = """
            SELECT
                COALESCE(it.customer_code, i.customer_code) AS customer_code,
                COALESCE(it.site_code, i.site_code) AS site_code,
                it.inspection_key,
                COALESCE(it.lijn_code, i.lijn_code) AS lijn_code,
                i.inspected_on,
                i.title,
                i.performed_by,
                it.source_file,
                it.sheet,
                it.section_idx,
                it.row_nr,
                it.locatie,
                it.band_breedte,
                it.merk_type,
                it.demontage,
                it.reinigen,
                it.vervangen,
                it.row_json
            FROM sb_inspection_items_v0 it
            LEFT JOIN sb_inspections_v0 i
              ON i.inspection_key = it.inspection_key
        """

        if mode == "incremental":
            rows_sql = base_rows_sql + """
                JOIN vw_changed_inspection_sheets_todo_v1 c
                  ON c.customer_code = COALESCE(it.customer_code, i.customer_code)
                 AND c.site_code = COALESCE(it.site_code, i.site_code)
                 AND c.source_file = it.source_file
                 AND c.sheet_norm = it.sheet
            """
        else:
            rows_sql = base_rows_sql

        rows_sql += """
            ORDER BY COALESCE(it.lijn_code, i.lijn_code), it.inspection_key, it.section_idx, it.row_nr, it.id
        """

        rows = conn.execute(text(rows_sql)).mappings().all()

        print(f"[INFO] bronregels: {len(rows)}")

        if mode == "incremental" and not rows:
            print("[INFO] Geen changed sheets met inspection items gevonden. Niets te doen.")
            return

        if mode == "incremental":
            delete_result = conn.execute(text("""
                DELETE FROM sb_excel_positions_v1 p
                USING vw_changed_inspection_sheets_todo_v1 c
                WHERE p.customer_code = c.customer_code
                  AND p.site_code = c.site_code
                  AND p.source_file = c.source_file
                  AND p.sheet = c.sheet_norm
            """))
            print(f"[INFO] Oude posities voor changed sheets verwijderd: {delete_result.rowcount}")

        by_inspection: dict[str, list[dict[str, Any]]] = defaultdict(list)
        for row in rows:
            by_inspection[row["inspection_key"]].append(dict(row))

        prepared_rows: list[dict[str, Any]] = []
        inserted = 0
        lost_location = 0
        kept_unknown_location = 0

        for inspection_key, items in by_inspection.items():
            items = sorted(items, key=lambda x: ((x.get("section_idx") or 1), (x.get("row_nr") or 0)))

            # bandblok-context: start alléén op expliciete locatie
            current_block_start_row: int | None = None
            current_block_locatie_raw: str | None = None
            current_block_locatie_norm: str | None = None
            current_block_band_breedte_raw: str | None = None
            current_block_band_breedte_num: int | None = None

            block_rows: list[dict[str, Any]] = []
            wg024_context_active = False

            for r in items:
                row_json = r.get("row_json") or {}
                if isinstance(row_json, str):
                    try:
                        row_json = json.loads(row_json)
                    except Exception:
                        row_json = {}

                lijn_code = (r.get("lijn_code") or "").upper()

                locatie_raw = normalize_whitespace(r.get("locatie"))
                band_breedte_raw = normalize_whitespace(r.get("band_breedte"))
                scraper_type_raw = normalize_whitespace(r.get("merk_type"))

                if not locatie_raw:
                    locatie_from_json = extract_location_from_row_json(row_json)
                    if locatie_from_json:
                        locatie_raw = locatie_from_json

                mes_raw = normalize_whitespace((row_json or {}).get("Unnamed: 8"))
                opmerking_raw = normalize_whitespace((row_json or {}).get("Unnamed: 9"))
                if not opmerking_raw:
                    opmerking_raw = normalize_whitespace((row_json or {}).get("Klantgegevens "))

                if lijn_code == "PEFA":
                    pefa_band_code = extract_pefa_band_code(row_json)
                    if pefa_band_code:
                        locatie_raw = pefa_band_code

                demontage = bool(r.get("demontage"))
                reinigen = bool(r.get("reinigen"))
                vervangen = bool(r.get("vervangen"))
                montage = str((row_json or {}).get("Unnamed: 6")).strip().upper() in {"X", "V", "TRUE"}
                afstellen = str((row_json or {}).get("Unnamed: 7")).strip().upper() in {"X", "V", "TRUE"}

                if not has_minimal_data(
                    locatie_raw,
                    band_breedte_raw,
                    scraper_type_raw,
                    mes_raw,
                    opmerking_raw,
                    demontage,
                    reinigen,
                    vervangen,
                    montage,
                    afstellen,
                ):
                    continue

                lege_regel = is_empty_row(
                    locatie_raw,
                    band_breedte_raw,
                    scraper_type_raw,
                    mes_raw,
                    opmerking_raw,
                    demontage,
                    reinigen,
                    vervangen,
                    montage,
                    afstellen,
                )

                header_achtig = is_header_like(locatie_raw, scraper_type_raw, opmerking_raw)

                band_breedte_num, band_breedte_norm = normalize_band_breedte(
                    band_breedte_raw,
                    scraper_type_raw,
                )

                scraper_type_norm, scraper_family, scraper_material, scraper_variant = normalize_scraper_type(
                    scraper_type_raw,
                    opmerking_raw,
                )

                (
                    scraper_type_norm,
                    scraper_family,
                    scraper_material,
                    scraper_variant,
                    scraper_type_mapping_row,
                ) = apply_scraper_type_mapping(
                    scraper_type_raw=scraper_type_raw,
                    scraper_type_norm=scraper_type_norm,
                    scraper_family=scraper_family,
                    scraper_material=scraper_material,
                    scraper_variant=scraper_variant,
                    scraper_type_mapping=scraper_type_mapping,
                )

                inspection_signal_flag = has_inspection_signal(
                    scraper_type_raw=scraper_type_raw,
                    mes_raw=mes_raw,
                    opmerking_raw=opmerking_raw,
                    demontage=demontage,
                    reinigen=reinigen,
                    vervangen=vervangen,
                    montage=montage,
                    afstellen=afstellen,
                )

                wg024_position_label, wg024_band_alias, wg024_parent_band = detect_wg024_subposition(
                    locatie_raw=locatie_raw,
                    scraper_type_raw=scraper_type_raw,
                    opmerking_raw=opmerking_raw,
                    current_block_locatie_norm=current_block_locatie_norm,
                    source_file=r.get("source_file"),
                    wg024_context_active=wg024_context_active,
                )

                # Als WG024 voor het eerst binnen een bestaand blok wordt herkend,
                # sluit dan het vorige blok af en start een logisch WG024-blok.
                if wg024_position_label and not wg024_context_active:
                    finalize_block(block_rows)
                    enrich_position_keys_with_slot(block_rows)
                    prepared_rows.extend(block_rows)
                    block_rows = []

                    current_block_start_row = r.get("row_nr")
                    current_block_locatie_raw = "WG024"
                    current_block_locatie_norm = "WG024"

                    if band_breedte_raw:
                        current_block_band_breedte_raw = band_breedte_raw
                    if band_breedte_num is not None:
                        current_block_band_breedte_num = band_breedte_num

                    wg024_context_active = True

                # Een nieuw bandblok start alleen op echte bandcodes.
                # WG024 Tripper/Uithouder zijn subposities en mogen dus geen nieuw blok starten.
                starts_new_block = (
                    not header_achtig
                    and not lege_regel
                    and bool(locatie_raw)
                    and looks_like_location(locatie_raw)
                    and wg024_position_label is None
                )

                if starts_new_block:
                    finalize_block(block_rows)
                    enrich_position_keys_with_slot(block_rows)
                    prepared_rows.extend(block_rows)
                    block_rows = []

                    current_block_start_row = r.get("row_nr")
                    current_block_locatie_raw = locatie_raw
                    current_block_locatie_norm = normalize_location(locatie_raw)

                    current_block_band_breedte_raw = band_breedte_raw
                    current_block_band_breedte_num = band_breedte_num

                    wg024_context_active = normalize_location(locatie_raw) == "WG024"

                # Een locatie op de huidige rij is alleen een nieuwe bandlocatie
                # wanneer die rij ook werkelijk een nieuw bandblok start.
                inherited_locatie = bool(
                    current_block_locatie_raw
                    and (
                        not starts_new_block
                        or wg024_position_label is not None
                    )
                )

                band_locatie_top = wg024_parent_band or current_block_locatie_raw

                if wg024_band_alias:
                    # Bestaande speciale WG024-logica behouden.
                    band_locatie_final = wg024_band_alias
                elif starts_new_block:
                    # Alleen een bewezen bandcode mag de bandlocatie veranderen.
                    band_locatie_final = locatie_raw
                else:
                    # Niet-bandtekst blijft context binnen het actieve bandblok.
                    band_locatie_final = current_block_locatie_raw

                band_locatie_norm = normalize_location(band_locatie_final)

                if not band_locatie_norm:
                    lost_location += 1
                    band_locatie_norm = "ONBEKEND"
                    kept_unknown_location += 1

                band_breedte_effective_raw = band_breedte_raw or current_block_band_breedte_raw
                band_breedte_effective_num = (
                    band_breedte_num
                    if band_breedte_num is not None
                    else current_block_band_breedte_num
                )

                # BELANGRIJK:
                # scraper_type NOOIT van bovenliggende regel overnemen.
                # Elke subregel representeert een eigen schraper; als type leeg is, blijft hij leeg.
                scraper_type_effective_raw = scraper_type_raw
                scraper_type_effective_norm = scraper_type_norm

                overgenomen_van_bovenliggend = bool(
                    (not locatie_raw and current_block_locatie_raw)
                    or (not band_breedte_raw and current_block_band_breedte_raw)
                )

                locatie_effective = band_locatie_final or "ONBEKEND"

                zijde_raw, zijde_norm = extract_side(
                    scraper_type_raw,
                    scraper_type_effective_raw,
                    opmerking_raw,
                )

                positie_suffix = infer_position_suffix(
                    scraper_type_effective_norm or scraper_type_norm,
                    opmerking_raw,
                )

                # Niet-bandtekst in locatiekolom bewaren als subpositie/context.
                # Voorbeelden: Kap Br.1700, Opvoerband, Tripper, Uithouder.
                if (
                    not positie_suffix
                    and locatie_raw
                    and not starts_new_block
                    and current_block_locatie_raw
                    and wg024_position_label is None
                ):
                    positie_suffix = normalize_whitespace(locatie_raw)

                if wg024_position_label:
                    positie_suffix = wg024_position_label

                mes_num, mes_code, mes_interpretatie = parse_mes(mes_raw)

                hosch_flag = bool(
                    HOSCH_PATTERN.search(scraper_type_raw or "")
                    or HOSCH_PATTERN.search(scraper_type_effective_raw or "")
                    or HOSCH_PATTERN.search(opmerking_raw or "")
                )
                concurrent_naam = "HOSCH" if hosch_flag else None

                performed_by_norm = normalize_performed_by(r.get("performed_by"))

                record_role = classify_record_role(
                    locatie_raw=locatie_raw,
                    band_breedte_raw=band_breedte_raw,
                    scraper_type_raw=scraper_type_raw,
                    opmerking_raw=opmerking_raw,
                    is_header_achtig=header_achtig,
                    is_lege_regel=lege_regel,
                    inherited_locatie=inherited_locatie,
                    inspection_signal_flag=inspection_signal_flag,
                )

                # Nieuwe flags
                active_flag = bool(
                    scraper_type_effective_norm
                    and inspection_signal_flag
                    and not header_achtig
                    and not lege_regel
                )

                inspectable_flag = bool(
                    scraper_type_effective_norm
                    and (
                        normalize_whitespace(mes_raw)
                        or has_action_columns(demontage, reinigen, vervangen, montage, afstellen)
                    )
                )

                # Heuristiek: kan vervallen/historisch zijn als type bestaat,
                # maar er géén inspectiesignaal is.
                deprecated_flag = bool(
                    scraper_type_effective_norm
                    and not inspection_signal_flag
                    and record_role in {"CONFIG_ONLY", "SUB_CONFIG"}
                )

                data_quality_flag = "OK"
                parse_notes: list[str] = []

                if band_locatie_norm == "ONBEKEND":
                    data_quality_flag = "GEEN_LOCATIE"
                    parse_notes.append("Geen locatie of bovenliggende locatie gevonden; ONBEKEND gebruikt")

                if inherited_locatie:
                    parse_notes.append("Locatie aangevuld vanuit bandblok")

                if not band_breedte_raw and band_breedte_effective_raw:
                    parse_notes.append("Bandbreedte aangevuld vanuit bandblok")

                if not scraper_type_effective_raw and record_role in {"POSITION", "SUB_POSITION", "SUB_CONFIG"}:
                    parse_notes.append("Geen scraper type beschikbaar")

                if not mes_raw and record_role in {"POSITION", "SUB_POSITION"}:
                    parse_notes.append("Geen meshoogte ingevuld")

                if hosch_flag:
                    parse_notes.append("Concurrent Hosch gedetecteerd")

                if scraper_type_mapping_row:
                    parse_notes.append(
                        f"Scraper type mapping toegepast: {scraper_type_mapping_row.get('mapping_source') or 'unknown'}"
                    )

                if lijn_code == "PEFA" and locatie_raw:
                    parse_notes.append("PEFA bandcode uit 'Promati sa/nv ' gebruikt")

                if wg024_position_label and wg024_band_alias:
                    parse_notes.append(
                        f"WG024 subpositie herkend: {wg024_position_label} -> {wg024_band_alias}"
                    )

                if deprecated_flag:
                    parse_notes.append("Waarschijnlijk configuratieregel / vervallen schraper zonder inspectiesignaal")

                if record_role == "COMMENT_ONLY":
                    parse_notes.append("Commentaarregel binnen bandblok")

                parse_confidence = 1.00
                if inherited_locatie:
                    parse_confidence = 0.90
                if record_role in {"COMMENT_ONLY", "CONFIG_ONLY", "SUB_CONFIG"}:
                    parse_confidence = min(parse_confidence, 0.75)
                if band_locatie_norm == "ONBEKEND":
                    parse_confidence = min(parse_confidence, 0.50)

                band_key = None
                if r.get("customer_code") and r.get("site_code") and r.get("lijn_code") and band_locatie_norm:
                    band_key = (
                        f"{r['customer_code']}|{r['site_code']}|"
                        f"{r['lijn_code']}|{band_locatie_norm}"
                    )

                # position_key met echt schrapertype per regel
                position_key = "|".join([
                    r.get("customer_code") or "UNKNOWN_CUSTOMER",
                    r.get("site_code") or "UNKNOWN_SITE",
                    r.get("lijn_code") or "UNKNOWN_LINE",
                    band_locatie_top or "GEEN_PARENT_BAND",
                    band_locatie_norm or "ONBEKEND",
                    positie_suffix or zijde_norm or "GEEN_POSITIE",
                    scraper_type_effective_norm or "GEEN_TYPE",
                ])

                band_block_id = build_block_id(
                    inspection_key=inspection_key,
                    start_row=current_block_start_row,
                    locatie_norm=wg024_parent_band or current_block_locatie_norm,
                )

                prepared = {
                    "customer_code": r.get("customer_code"),
                    "site_code": r.get("site_code"),

                    "inspection_key": r["inspection_key"],
                    "lijn_code": r["lijn_code"],
                    "source_file": r.get("source_file"),
                    "sheet": r.get("sheet"),
                    "row_nr": r.get("row_nr"),
                    "section_idx": r.get("section_idx") or 1,

                    "effective_date": r.get("inspected_on"),
                    "report_title": r.get("title"),
                    "performed_by_raw": r.get("performed_by"),
                    "performed_by_norm": performed_by_norm,

                    "locatie_raw": locatie_raw,
                    "band_breedte_raw": band_breedte_raw,
                    "scraper_type_raw": scraper_type_raw,
                    "mes_raw": mes_raw,
                    "opmerking_raw": opmerking_raw,

                    "band_locatie_top": band_locatie_top,
                    "band_locatie_final": band_locatie_final,
                    "band_locatie_norm": band_locatie_norm,

                    "zijde_raw": zijde_raw,
                    "zijde_norm": zijde_norm,
                    "positie_suffix": positie_suffix,

                    "band_breedte_num": band_breedte_num,
                    "band_breedte_norm": band_breedte_norm,

                    "scraper_family": scraper_family,
                    "scraper_material": scraper_material,
                    "scraper_type_norm": scraper_type_norm,
                    "scraper_variant": scraper_variant,

                    "mes_num": mes_num,
                    "mes_code": mes_code,
                    "mes_interpretatie": mes_interpretatie,

                    "demontage": demontage,
                    "reinigen": reinigen,
                    "vervangen": vervangen,
                    "montage": montage,
                    "afstellen": afstellen,

                    "hosch_flag": hosch_flag,
                    "concurrent_naam": concurrent_naam,

                    "is_subregel": inherited_locatie,
                    "is_header_achtig": header_achtig,
                    "is_lege_regel": lege_regel,
                    "parse_confidence": parse_confidence,
                    "data_quality_flag": data_quality_flag,
                    "parse_notes": " | ".join(parse_notes) if parse_notes else None,

                    "band_key": band_key,
                    "position_key": position_key,

                    "locatie_effective": locatie_effective,
                    "band_breedte_effective_raw": band_breedte_effective_raw,
                    "band_breedte_effective_num": band_breedte_effective_num,
                    "scraper_type_effective_raw": scraper_type_effective_raw,
                    "scraper_type_effective_norm": scraper_type_effective_norm,
                    "overgenomen_van_bovenliggend": overgenomen_van_bovenliggend,
                    "record_role": record_role,

                    "band_block_id": band_block_id,
                    "band_block_start_row": current_block_start_row,
                    "band_block_locatie_raw": current_block_locatie_raw,
                    "band_block_locatie_norm": current_block_locatie_norm,
                    "scraper_seq_in_block": None,
                    "scraper_role": None,
                    "active_flag": active_flag,
                    "inspectable_flag": inspectable_flag,
                    "deprecated_flag": deprecated_flag,
                    "inspection_signal_flag": inspection_signal_flag,
                }

                # Alleen regels die binnen een bandblok vallen toevoegen.
                # Losse regels zonder bandblok willen we niet als schrapersysteem analyseren.
                if current_block_locatie_raw:
                    block_rows.append(prepared)
                else:
                    prepared_rows.append(prepared)

            finalize_block(block_rows)
            enrich_position_keys_with_slot(block_rows)
            prepared_rows.extend(block_rows)

        for row in prepared_rows:
            conn.execute(text("""
                INSERT INTO sb_excel_positions_v1 (
                    customer_code,
                    site_code,
                    inspection_key,
                    lijn_code,
                    source_file,
                    sheet,
                    row_nr,
                    section_idx,

                    effective_date,
                    report_title,
                    performed_by_raw,
                    performed_by_norm,

                    locatie_raw,
                    band_breedte_raw,
                    scraper_type_raw,
                    mes_raw,
                    opmerking_raw,

                    band_locatie_top,
                    band_locatie_final,
                    band_locatie_norm,

                    zijde_raw,
                    zijde_norm,
                    positie_suffix,

                    band_breedte_num,
                    band_breedte_norm,

                    scraper_family,
                    scraper_material,
                    scraper_type_norm,
                    scraper_variant,

                    mes_num,
                    mes_code,
                    mes_interpretatie,

                    demontage,
                    reinigen,
                    vervangen,
                    montage,
                    afstellen,

                    hosch_flag,
                    concurrent_naam,

                    is_subregel,
                    is_header_achtig,
                    is_lege_regel,
                    parse_confidence,
                    data_quality_flag,
                    parse_notes,

                    band_key,
                    position_key,

                    locatie_effective,
                    band_breedte_effective_raw,
                    band_breedte_effective_num,
                    scraper_type_effective_raw,
                    scraper_type_effective_norm,
                    overgenomen_van_bovenliggend,
                    record_role,

                    band_block_id,
                    band_block_start_row,
                    band_block_locatie_raw,
                    band_block_locatie_norm,
                    scraper_seq_in_block,
                    scraper_role,
                    active_flag,
                    inspectable_flag,
                    deprecated_flag,
                    inspection_signal_flag
                )
                VALUES (
                    :customer_code,
                    :site_code,
                    :inspection_key,
                    :lijn_code,
                    :source_file,
                    :sheet,
                    :row_nr,
                    :section_idx,

                    :effective_date,
                    :report_title,
                    :performed_by_raw,
                    :performed_by_norm,

                    :locatie_raw,
                    :band_breedte_raw,
                    :scraper_type_raw,
                    :mes_raw,
                    :opmerking_raw,

                    :band_locatie_top,
                    :band_locatie_final,
                    :band_locatie_norm,

                    :zijde_raw,
                    :zijde_norm,
                    :positie_suffix,

                    :band_breedte_num,
                    :band_breedte_norm,

                    :scraper_family,
                    :scraper_material,
                    :scraper_type_norm,
                    :scraper_variant,

                    :mes_num,
                    :mes_code,
                    :mes_interpretatie,

                    :demontage,
                    :reinigen,
                    :vervangen,
                    :montage,
                    :afstellen,

                    :hosch_flag,
                    :concurrent_naam,

                    :is_subregel,
                    :is_header_achtig,
                    :is_lege_regel,
                    :parse_confidence,
                    :data_quality_flag,
                    :parse_notes,

                    :band_key,
                    :position_key,

                    :locatie_effective,
                    :band_breedte_effective_raw,
                    :band_breedte_effective_num,
                    :scraper_type_effective_raw,
                    :scraper_type_effective_norm,
                    :overgenomen_van_bovenliggend,
                    :record_role,

                    :band_block_id,
                    :band_block_start_row,
                    :band_block_locatie_raw,
                    :band_block_locatie_norm,
                    :scraper_seq_in_block,
                    :scraper_role,
                    :active_flag,
                    :inspectable_flag,
                    :deprecated_flag,
                    :inspection_signal_flag
                )
            """), row)
            inserted += 1

        print(f"[DONE] inserted: {inserted}")
        print(f"[INFO] lost_location: {lost_location}")
        print(f"[INFO] kept_unknown_location: {kept_unknown_location}")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Laad sb_excel_positions_v1 vanuit sb_inspection_items_v0"
    )
    parser.add_argument(
        "--mode",
        choices=["incremental", "full-rebuild"],
        default="incremental",
        help="incremental = alleen changed sheets; full-rebuild = volledige herbouw",
    )
    args = parser.parse_args()

    main(mode=args.mode)



